InWorldMessage DLC2_C_MQ_030 < uid=ACAEF5AB6746EFFF000CDA9222B423C3 >
{
	myHeader "branch = \"DLC2\", contextComment = \"title description\", enabled = true, guid = #ACAEF5AB6746EFE6000CDA903837535E, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 12387, text = \"Admiral Kryder intel\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"message description\", enabled = true, guid = #ACAEF5AB6746EFE6000CDA916DCE1FB4, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 12387, text = \"ND-5! Didn't expect to hear from you again, but a favor's a favor so here's what I know:\n\nThe databanks will tell you Admiral Gallia Kryder is a loyal officer in the Imperial Fleet. The real story? She's Alderaanian and only managed to survive the purge by slicing her citizenship records and then transferring her command to the edge of Wild Space. I guess Gallis figures she's owed, because she's set up a nice little network for herself and runs it all from her flagship, the Reviler. So stay on her good side or the fleet might show up for unscheduled bombardment practice.\n\nOh, and I heard about Jaylen. Couldn't have happened to a nicer sleemo. Take care of yourself, old man.\", type = \"MenuLine\"}"
}

InWorldMessage DLC2_C_MQ40_KhepiGuardians_Databank < uid=49CE584F678A24D7000255E795103227 >
{
	myHeader "branch = \"DLC2\", contextComment = \"title description\", enabled = true, guid = #49CE584F678A2357000255E5ED9AA022, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 12392, text = \"Khepi Guardians\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"message description\", enabled = true, guid = #49CE584F678A2357000255E690592F56, lineVersion = 10, maxLength = 0, productId = -1, sectionId = 12392, text = \"Kay,\n\nI recovered this deleted data from what you transmitted from Stinger's terminal in the tomb.\n\n- ND-5\n\n//DELETED ENTRY//\n\nKhepi Chronicles p. 215\n\nWith all of this evidence in mind, everything points to one answer. The Khepi built sentry droids using the same roxodium alloys as the tomb itself. As such, they had guardians that would last for thousands of years until the Sayma Nebula eventually collapses into a proton star.\n\nJopeem, Molo. Khepi Chronicles. 7963\", type = \"MenuLine\"}"
}

InWorldMessage DLC2_C_MQ40_KhepiLore_01 < uid=ACAEF5AB678F56720004854A3DA59958 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #ACAEF5AB678F55D50004853C757F415D, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 12392, text = \"The Final Rest p. 75\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #ACAEF5AB678F55D50004853DB8FC7B8C, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 12392, text = \"The simple truth is that there was no crisis to manage. No mass exodus of Khepi seeking shelter. In fact, when the news eventually reached the Khepi envoys on Coruscant, they all returned home. Elder A'shora reflected: \\"We stand together and our faith in the Light is absolute. The Great Tomb will be completed as planned.\\"\n\nYe-Gimu, Lento. The Final Rest. 7918.\", type = \"MenuLine\"}"
}

InWorldMessage DLC2_C_MQ40_KhepiLore_02 < uid=ACAEF5AB678F56720004854BEFB20F85 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #ACAEF5AB678F55F30004853F33B2383B, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 12392, text = \"History of the Khepi p. 152\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #ACAEF5AB678F55F300048540183D678D, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 12392, text = \"It is difficult to grasp the scope of the Great Tomb since we have yet to find any concrete records of its construction. However, High Priestess O'lona stated in a message to the clergy that \\"it is imperative that everyone is invited into the fold. Our very essence depends on it.\\" The logistics of achieving that in such a short time is truly a testament of the Khepi's dedication to the Final Ritual.\n\nSan Tekka, Lor. History of the Khepi. 7957.\", type = \"MenuLine\""
}

InWorldMessage DLC2_C_MQ40_KhepiLore_03 < uid=ACAEF5AB678F56720004854C062C4508 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #ACAEF5AB678F55FC00048542BCB4A0F9, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 12392, text = \"The Lost Tomb p. 190\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #ACAEF5AB678F55FC0004854355DD7898, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 12392, text = 'The choice of the Sayma Nebula as their final resting place was not arbitrary. As Lento Ye-Gimu explains, \"a central tenet in the Khepi faith was to send their deceased to the stars.\" So, faced with impending doom, the clergy understood what their next chapter involved. As the Sayma Nebula would eventually collapse into a star, so too would the Khepi become one with the Light.\n\nGraf, Rhyssa. The Lost Tomb. 7945.', type = \"MenuLine\""
}

InWorldMessage DLC2_C_MQ40_KhepiLore_04 < uid=ACAEF5AB678F56720004854DFD717B89 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #ACAEF5AB678F56030004854501FBB2CA, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 12392, text = \"Khepi Chronicles p. 38\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #ACAEF5AB678F5603000485460A497FF5, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 12392, text = \"While the Khepi were in regular contact with the High Republic and the Jedi Order, they declined their invitations to Coruscant on several occasions. High Priestess O'lona wrote in her journals after one such invitation that \\"the Jedi have shown a great interest in our faith and organization. Their only mistake is thinking the interest is mutual.\\"\n\nJopeem, Molo. Khepi Chronicles. 7963\", type = \"MenuLine\"}"
}

InWorldMessage DLC2_C_MQ40_KhepiLore_05 < uid=ACAEF5AB678F56720004854EEC0F5226 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #ACAEF5AB678F560A000485488D780B7E, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 12392, text = \"Secrets of the Khepi p. 340\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #ACAEF5AB678F560A0004854990A25A25, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 12392, text = \"The question is not whether or not the Khepi built the tomb. Everything points to this being factually true, even if it was not fully completed. No, the question is what measures the Khepi took to keep it safe until the nebula collapsed into a star. The Khepi were magnificent engineers and craftspeople, with advanced relics still being discovered across the galaxy. So what did they do to protect the tomb?\n\nCharoo, Suna. Secrets of the Khepi. 7932.\", type = \"MenuLine\""
}

InWorldMessage DLC2_C_MQ_040_ForgeMessage < uid=ACAEF5AB67A219CF0005CB8DFB98075C >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a message page, about a secret in the forge area.\", enabled = true, guid = #ACAEF5AB67A219CF0005CB8EFEC05970, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 12392, text = \"Don't go in there\", type = \"MenuLine\"}"
	myDescription "branch = \"DLC2\", contextComment = \"Content of a message page, about a secret in the forge area.\", enabled = true, guid = #ACAEF5AB67A219CF0005CB8F514DC2E3, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 12392, text = \"It's no good, Adden. Forget about the stash. I tried to get the keycard from scrapper but I couldn't get it's panels open. Hell, now that they cut the lights, I can't even find the bloody droid anymore! It's all dusty and strange, this place. And the sound... Something's off here, lad.\n \nLet's go back to the tavern and forget our losses. Better not to mess with this place.\", type = \"MenuLine\"}"
}

