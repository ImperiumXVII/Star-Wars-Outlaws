InWorldMessage DLC2_C_MQ_010_KhepiLore_01 < uid=381EA52767A36C5500054F2C8808A9D7 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #381EA52767A36B9500054F2AC9C45568, lineVersion = 15, maxLength = 0, productId = -1, sectionId = 12377, text = \"Khepi Chronicles p. 240\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #381EA52767A36B9500054F2B61A5EC49, lineVersion = 14, maxLength = 0, productId = -1, sectionId = 12377, text = \"Perhaps the best way to capture this moment is by looking at High Priestess O’lona’s own journals. On the day of the discovery, she writes: “Every day, the Sky tells us what we need to know. But it has never been more important than now to listen.” With exact accuracy, the Khepi calculated that the asteroid would reach them ten years later – and that their world would be destroyed.\n\nJopeem, Molo. Khepi Chronicles. 7963.\", type = \"MenuLine\""
}

InWorldMessage DLC2_C_MQ_010_KhepiLore_02 < uid=381EA52767A36C8900054F4AA27DDBB3 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #381EA52767A36C6100054F485536C531, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 12377, text = \"Secrets of the Khepi p. 86\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #381EA52767A36C6100054F49CF253336, lineVersion = 15, maxLength = 0, productId = -1, sectionId = 12377, text = \"While no complete schematics exist, there are corroborating records that mention an Architect’s Scepter that was involved in the construction. We can only speculate what it was used for, but a theory popularized by Dr. Lobo Ri suggests it was a multidimensional measurement tool to expediate construction. Some sources claim that it was later found on the relic markets of Mon Gazza. These days, however, those markets are filled with forgeries and replicas.\n\nCharoo, Suna. Secrets of the Khepi. 7932.\", type = \"MenuLine\""
}

InWorldMessage DLC2_C_MQ_010_KhepiLore_03 < uid=381EA52767A36CB700054F686EED0137 >
{
	myHeader "branch = \"DLC2\", contextComment = \"Title of a journal page, with the page number.\", enabled = true, guid = #381EA52767A36C9100054F663A184BEF, lineVersion = 17, maxLength = 0, productId = -1, sectionId = 12377, text = \"The Lost Tomb p. 78\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Content of a journal page, about Khepi lore.\", enabled = true, guid = #381EA52767A36C9100054F675BB23E95, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 12377, text = \"The exact location of the Great Tomb remains unknown. All we know is that it’s somewhere deep in the ionized clouds of the Sayma nebula. Over the years, countless explorers and fortune seekers have attempted to breach the nebula, but no one has ever returned. It has become something of a legend in the Outer Rim and a measurement of challenge. As the saying goes, “at least we’re not going into the Sayma.”\n\nGraf, Rhyssa. The Lost Tomb. 7945.\", type = \"MenuLine\""
}

