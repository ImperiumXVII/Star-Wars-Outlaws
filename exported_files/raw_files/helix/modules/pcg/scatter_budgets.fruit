list ScatterStatTags
{
	ScatterStatTag
}

class BudgetOverrides
{
	int myNone -1 < tooltip="-1 implies no budget." >
	int myLow -1 < tooltip="-1 implies no budget." >
	int myMedium -1 < tooltip="-1 implies no budget." >
	int myHigh -1 < tooltip="-1 implies no budget." >
	int myFull -1 < tooltip="-1 implies no budget." >
}

class ScatterStatTag < uid=auto >
{
	int myDefaultBudget -1 < tooltip="The number of instances of this tag and it's sub tags, allowed to appear in a single scatter sector. -1 implies no budget." >
	BudgetOverrides myDensityBudgetOverrides < tooltip="Overrides for the scatter budget for each scatter density setting." >
	ScatterStatTags mySubTags < tooltip="Sub tags, these also count towards this tag's budget." >
}

class ScatterBudgets
{
	float myRealtimeScatterBudget -1 < tooltip="Max time allowed to scatter a sector with any realtime scattering. -1 implies no budget. (ms)" >
	float myBakedScatterBudget -1 < tooltip="Max time allowed to scatter a sector with any baked scattering. -1 implies no budget. (ms)" >
	int myNonFillerObjectBudget -1 < toolTop="Max number of non-filler objects allowed in a sector before it is considered over budget.  -1 implies no budget." >
	ScatterStatTag Total
	ScatterStatTag Untagged
}