include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/fruit/reward/reward.fruit"
include "helix/game system data/fruit/input/rumble.fruit"
include "helix/game system data/fruit/interactionpoints/interactionpointminigames.fruit"
include "helix/game system data/fruit/interactionpoints/interactionpointtags.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/interactionpoints/interactionpointtelemetrytypes.fruit"
include "helix/game system data/fruit/animation/gesturetypes.fruit"
include "helix/game system data/fruit/camera/animatedcameradata.fruit"
include "helix/game system data/fruit/camera/cameralookatpreset.fruit"
include "helix/game system data/fruit/player/prohibitedaction.fruit"

enum InteractionPointPersistenceType
{
	None
	Session
	SaveGame
}

enum InteractionPointRequiredVOState
{
	Ignore
	Active
	Inactive
}

enum InteractionPointAutosaveTriggerType
{
	None
	OnPerform
	OnRelease
	OnReleaseAfterPerform
}

enum InteractionPointLOSRequirement
{
	NotRequired
	RequiredAllowingTransparency
	RequiredBlockingTransparency
}

enum InteractionPointForcedPlayerContext
{
	None
	Standing
	Crouching
}

// This enum needs to be kept in sync with the HC_InteractionInterruptionSourceType enum in code/helix/HClient/HC_InteractionPointConstantData.h
enum InteractionInterruptionSourceType
{
	None
	PlayerDamaged
	PlayerArrested
	Input
	LoadingTransition
	PlayerPushed
	PlayerAim
	PlayerMelee
	ThrownAway
}

list InteractionInterruptionSources
{
	InteractionInterruptionSourceType
}

list InteractionConditionList
{
	InteractionConditionGroup
	GameConditionContextAgentHasStatusEffect
	GameConditionContextAgentIsTargetedByPet
	GameConditionPlayerHasItem
	GameConditionPlayerHasIntel
	GameConditionPlayerHasReputation
	GameConditionContextPlayerHasReputation
	GameConditionPlayerCanAddItem
	GameConditionPlayerHasWantedLevel
	GameConditionPlayerHasPickupWeapon
	GameConditionPlayerIsClass
	GameConditionPlayerIsDoingBlabberMouth
	GameConditionPlayerIsNotRestricted
	GameConditionGroup // Should be removed once all usages are removed
	GameConditionPlayerIsInCombatWithNPCs
	GameConditionFathierRacesAreInCooldown
	GameConditionFathierRacesProceduralEnigmasAreInCooldown
	GameConditionPlayerHasUnclaimedMailboxItems
	GameConditionPlayerEnvironmentState
	GameConditionPlayerIsInMovementState
	GameConditionIsInCriticalNarrativeMode
	GameConditionBroadcastIsNotPlaying
	GameConditionFlag
	GameConditionIsSpaceTravelEnabled
	GameConditionQuestBeatState
	GameConditionPlayerHasGearItemEquipped
	GameConditionPlayerRelativePosition
	GameConditionFormula
	GameConditionQuestIsCompleted
	GameConditionContextAgentHasFaction
	GameConditionContextAgentIsDazed
	GameConditionIsStoreAddonActive
	GameConditionContextAgentHasItemEquipped
	GameConditionPlayerIsRokanaSpaceShip
	GameConditionPlayerIsTrailblazerSpaceShip
}

class InteractionConditionGroup : GameConditionGroupBase
{
	InteractionConditionList myConditions
}

list ForbiddenInteractionConditionList
{
	ForbiddenInteractionConditionGroup
	GameConditionPlayerHasItem
	GameConditionPlayerHasIntel
	GameConditionFlag
	GameConditionContextPlayerHasReputation
	GameConditionContextFactionIsOfType
}

class ForbiddenInteractionConditionGroup : GameConditionOverridableGroupBase
{
	ForbiddenInteractionConditionList myConditions
}

class GameConditionInteractionConsumedItem : GameCondition
{
	GameConditionType myType PlayerHasItem < hidden=1 >

	Item* myItem
	int myAmount 1
	GameConditionOperator myOperator GreaterThanOrEqual < hidden=1 >
}

class InteractionPointSetup
{
	varmap myLabel < bhv="localization" tooltip="Name of the interaction command for UI purposes." >
	varmap myForbiddenInteractionLabel < bhv="localization" tooltip="Name of the interaction command when it's forbidden for UI purposes. Leave empty if the interaction can't be forbidden." >
	string myIcon < bhv=sprite >
	bool myShouldWaitForGestureAnimation true < tooltip="If Gesture animation is set, interaction perform will wait until gesture animation has ended or Interaction start animation event has been triggered" >
	int myStep 1 < min="-128" max="127" tooltip="When going to the next step, this value will be used. Can be for example -1 to go backwards or 2 to skip an entry." >
}

list InteractionPointSetupList
{
	InteractionPointSetup
}

class HapticFeedback
{
	float myNearRange
	uid myNearRumble < bhv="constantData" constantDataType="rumble" >
	uid myOnInteractRumble < bhv="constantData" constantDataType="rumble" >
}

class VisibilityProfile
{
	bool myIsVisible FALSE < tooltip="If disabled, the interaction point will not appear when this type of visibility is requested in the game." >
	float myRadius 6.0 < tooltip="Radius of the visibility by default." >
}

class VisibilityProfileBinocularsDefaults : VisibilityProfile
{
	bool myIsVisible FALSE
	float myRadius 400.0
}

class VisibilityProfileUnarmedAimingInsideNonCombatAreaDefaults : VisibilityProfile
{
	bool myIsVisible TRUE
	float myRadius 50.0
}

class PetCommandSetup
{
	bool myCanBeUsedInQuickPetCommandMode FALSE < tooltip="If enabled, the interaction will show up as a quick pet command too." >
}

list InteractionPointTags
{
	InteractionPointTag
}

class InteractionPointMinigameSetup
{
	InteractionPointMinigameType myType None < tooltip="The type of minigame required for the interaction.\nNone = No minigame\nAny other option: Relevant minigame will be used" >
	InteractionPointMinigameDifficulty myDifficulty < tooltip="Difficulty of the minigame. Only used if myRequiredMinigameType is set to something other than None." >
	InteractionPointMinigame* myBespokeOverride < tooltip="If set, the minigame will be explicitly this setup and both myRequiredMinigameType and myRequiredMinigameDifficulty will be ignored." >
}

class InteractionPointAudio
{
	uid mySelectionAudio < tooltip="Played when the interaction has been selected and the UI prompt appears." bhv="AudioID" type="Event" >
	uid myActivationAudio < tooltip="Played when the interaction activates or starts being performed." bhv="AudioID" type="Event" >

	uid myActivationFailAudio < tooltip="Played if the player tries to activate an interaction point which cannot be." bhv="AudioID" type="Event" >

	uid myHoldBeginAudio < tooltip="Played when a hold-interaction point starts to get progress by holding the button down." bhv="AudioID" type="Event" >
	uid myHoldCancelAudio < tooltip="Played when a hold-interaction has been held but is released before activation. Does not play if activation succeeds." bhv="AudioID" type="Event" >
}

class InteractionPointPlayerEquipmentSettings
{
	bool myHolsterOnClaimed false
	bool myHolsterOnClaimedSkipSequence false
	bool myIgnorePickables false
	bool myHolsterPickablesEnabled false < tooltip="While the interaction is selected, a pickable weapon has a chance to trigger holster instead of throw away if possible" >
}

class InteractionPointAnimatedCameraSettings
{
	bool myHasAnimatedCamera false
	vec3f myClearanceCheckSourceOffset 0.0;0.5;0.0
	float myClearanceCheckRadius 1.0
	float myClearanceCheckHeight 1.0
	
	bool myEnablePhantomCheck false					< tooltip="As collision detection doesn't count character phantom collision, we need a dedicated phantom check. This is the toggle to enable phantom check." >
	vec3f myPhantomCheckSourceOffset 0.0;0.5;0.0
	float myPhantomCheckRadius 1.5
	
	AnimatedCameraData* myAnimatedCameraData
	CameraLookAtPreset* myFallbackLooatPreset		< tooltip="A fallback lookat camera setup when animated camera is not available." >
}

class InteractionPoint < uid=auto >
{
	InteractionPointSetup myDefaultSetup
	InteractionPointSetupList myExtraStepsSetupList
	InteractionPointTags myTags < tooltip="Tags used to differentiate this interaction from others in the same graph object. Does not replace interaction types or constant data.\nUse it only when the other cases don't fit!" >
	float myDefaultInteractionRadius 3.0 < tooltip="Radius of the interaction by default." >
	bool myDefaultUseInteractionRadiusIn2D false < tooltip="If enabled, the interaction radius will be ignored when calculating height." >
	vec3f myDefaultInteractionDirection 0.0;0.0;1.0 < tooltip="Direction of the interaction by default, in local space. Takes the game entity's orientation into account." >
	float myDefaultInteractionAngleDegree 360.0 < bhv=degree_angle min=0 max=360 tooltip="Required angle between the interaction position/direction and the player position to allow interacting." >
	float myDefaultCameraAngleDegree 360.0 < bhv=degree_angle min=0 max=360 tooltip="Required angle between the camera position/direction and the interaction to allow interacting." >
	float myDefaultMinInteractionHeightOffset 0.0 < tooltip="Min offset height required for the interaction to be available. The position used depends on myDefaultUseGameEntityPositionForMinInteractionHeightOffset." >
	bool myDefaultUseGameEntityPositionForMinInteractionHeightOffset TRUE < tooltip="If enabled, the Min Height Offset will be compared with the game entity's position instead of the interaction position." >
	float myDefaultMaxInteractionHeightOffset 0.0 < tooltip="Max offset height required for the interaction to be available. The position used depends on myDefaultUseGameEntityPositionForMaxInteractionHeightOffset." >
	bool myDefaultUseGameEntityPositionForMaxInteractionHeightOffset TRUE < tooltip="If enabled, the Max Height Offset will be compared with the game entity's position instead of the interaction position." >
	float myDefaultMaxSlopeAngleDifference 90.0 < bhv=degree_angle min=0 max=90 tooltip="Max slope angle required for the interaction to be available. The angle difference is the ground normal difference between player and target." >

	float myDefaultVisibilityRadius 6.0 < tooltip="Radius of the visibility by default." >
	float myDefaultVisibilityAngleDegree 360.0 < bhv=degree_angle min=0 max=360 tooltip="Required angle between the camera position and the interaction position/direction to make the interaction visible." >
	VisibilityProfileBinocularsDefaults myBinocularsVisibilityProfile < tooltip="Visibility settings for when the player is using the Binoculars." >
	VisibilityProfileUnarmedAimingInsideNonCombatAreaDefaults myUnarmedAimingInsideNonCombatAreaVisibilityProfile < tooltip="Visibility settings for when the player is aiming without a weapon and inside a non combat area." >

	PetCommandSetup myPetCommandSetup < tooltip="Values only related to Pet Commands. Not used for normal interactions." >

	file mySpawnUIMenu < bhv="asset" assettype="GUI" tooltip="UI Menu to spawn when succesfully interacted." >
	file myUILooseGraph < bhv="asset" assettype="GUI" tooltip="UI Loose graph to spawn while the interaction is happening." >
	InteractionPointAudio myAudio
	HapticFeedback myHapticFeedback
	GameConditionInteractionConsumedItem myConsumedItem < tooltip="If the item is valid, the interaction will require the player to have the item and the item will be removed when the interaction is performed." >

	InteractionPointMinigameSetup myRequiredMinigame < tooltip="The minigame required for the interaction" >
	InteractionPointMinigameProcessType myMinigameProcessType AutomaticPreInteraction < tooltip="The way the minigame of the interaction is going to be processed" >

	GestureType myInteractionGestureAnimationType None < tooltip="Gesture animation type to be played on interaction" >

	bool myAllowUpdateFromManagerIfDisabled FALSE < tooltip="Optimization flag. While not enabled, the Conditions won't be checked until the interaction has been enabled at least once by any other source. Only should be enabled for valid cases where the interaction needs to evaluate conditions/restrictions/forbidden conditions while being disabled by any other source." >
	InteractionConditionList myConditions < tooltip="Will disable the interaction if any condition is false, meaning it won't show up in UI. Ignored if empty." >
	InteractionConditionList myPlayerConditions < tooltip="If any condition is false, the interaction will not be available for the player, but won't disable the interaction. Ignored if empty." >
	InteractionConditionList myRestrictions < tooltip="Will restrict the interaction if any condition is false, meaning it will show up in UI but not be interactable. Ignored if empty." >
	GameAction myGameAction Interact < tooltip="Is only used for visually showing what game action an interaction point belongs to." >
	GameAction myHoldToPressGameAction None < tooltip="Is used instead of myGameAction when `Change hold actions to press` is set in user options menu" >
	bool myRequiresGameActionHoldToPath FALSE < tooltip="If false, releasing the GameAction input will not interrupt Pathing to Interaction" >
	bool myIsAutoInteract FALSE < tooltip="If true, the interaction will be automatically interated with without the player pressing any button." >
	InteractionPointLOSRequirement myLOSRequirement NotRequired < tooltip="The Line of Sight requirement for the interaction point to be valid." >
	bool myIgnoreSelfCollisionOnLoSCheck TRUE < tooltip="If true, the collisions from the graph object won't interfere when doing a LoS check. This means the interaction could be inside of the object without blocking LoS." >
	bool myIsClearanceCheckRequired FALSE < tooltip="If true, the interaction will be require a clearance check from interaction starting point to host agent of this interaction point." >
	InteractionPointRequiredVOState myRequiredVOState Ignore < tooltip="The required scripted VO state for the interaction point to be active." >
	float myClearanceCheckRadius 0.2f < tooltip="The clearance sphere cast radius." >
	float myClearanceCheckOriginHeightOffset 0.0f < tooltip="Height offset of the sphere cast start point." >
	float myClearanceCheckTargetHeightOffset 0.0f < tooltip="Height offset of the sphere cast end point." >
	float myHoldDuration 0.0f < tooltip="How much time in seconds the player needs to hold the interaction. This is not meant to be used for input, but for gameplay situations where continuosly doing an interaction will give different results like healing more over time." >
	InteractionPointPersistenceType myPersistenceType None < tooltip="The type of persistence this interaction should use.\nNone = No persistence\nSession = Will be saved in memory until new/load game or game is closed.\nSaveGame = Stored as part of the save game. Lasts forever until reset." >
	InteractionPointPersistenceType myCoopPersistenceType None < tooltip="The type of persistence this interaction should use in coop.\nNone = No persistence\nSession = The state is not lost when the object is streamed out.\nSaveGame = Stored as part of the coop save game/checkpoint." >
	InteractionPointAutosaveTriggerType myAutosaveTriggerType None < tooltip="In what case the interaction should trigger an autosave." >
	int myStartAtStep 0 < min="0" max="255" tooltip="Start at this step index. 0 is the default setup." >
	InteractionInterruptionSources myPossibleInterruptionSources < tooltip="All the possible sources of interruption that should interrupt this interaction" >

	ForbiddenInteractionConditionList myIsForbiddenConditions < tooltip="If true the interaction is forbidden.">
	Reward* myForbiddenInteractionConsequence < tooltip = "Reward given when an npc sees the player performing a forbidden interaction.">
	ProhibitedActionType myForbiddenInteractionProhibitedActionType PlayerPerformedForbiddenInteraction < tooltip = "Used to change how much reputation is lost and what the loss reason looks in the reputation notification." >
	PlayerRestriction* myPlayerRestrictionsDuringInteraction
	PlayerRestriction* myPlayerRestrictionsPreparingInteraction < tooltip="Set the restrictions to apply during the preparation of the interaction, which may involve: path to interaction, holding the interaction, waiting the end of a synched animation, and waiting script confirmation" >
	InteractionPointPlayerEquipmentSettings myPlayerEquipmentSettings
	InteractionPointAnimatedCameraSettings myAnimatedCameraSettings
	
	bool myShouldTrackDialogueReputationOpportunity false < tooltip = "Set this to true if this interaction leads to a dialogue and has reputation requirements \nand should show up as a reputation opportunity. \nOnly works on interactions on NPCs.">
	
	string myEditorMenuStructure < tooltip="Used for constant data menus in the editor. Use '/' to add deeper categories: Pet/Defensive" >

	InteractionPointTelemetryType myInteractionPointTelemetryType < tooltip = "The type used by telemetry." >
	InteractionPointForcedPlayerContext myForcedPlayerContext < tooltip = "Select a context to force on the player when starting the interaction (including pathing there)." >

	float myCooldownDuration 0.5 < tooltip="Time in between an interaction is perfomed until it can be selected by the player again. This is NOT persisted and only meant for small values" >

	bool myCanInteractionInterruptSyncedAnimation false < tooltip = "Turn this to true if we want the current synced animation to be interrupted when we perform an interaction." >

	float myRequiredHorizontalDistanceToPath 0.0 < tooltip="If the character should path to the interaction point, set the required distance from the interaction point to actually request a path. If the character distance to the interaction point is less than this value, then it is considered that the character has arrived at the interaction" >
	bool myShouldCreatePathFocusArea true < tooltip="When the character should path to the interaction point, it will create a path focus area if this is set to True" >
	bool myCancelInteractionIfPathFails false < tooltip="If true, the interaction is canceled if a path to the interaction point is required and the path request fails or the path is interrupted" >
	bool myCheckRequiredDistanceToPathFromPureInteractionPosition false < tooltip="If true, the Required Horizontal Distance To Path check is made from the pure interaction point position" >
	bool myShouldWaitForFinalFacing false < tooltip="If true, the pathing to Interaction will only finish after Final Facing reorientation" >
	bool myShouldRemoveFocusArea true < tooltip="If true, the focus area will be removed when the pathing ends" >
}
