// Keep in sync with HC_InteractionPointMinigameTypes.h
enum InteractionPointMinigameType
{
	None
	Lockpicking
	Slicing
}

// Keep in sync with HC_InteractionPointMinigameTypes.h
enum InteractionPointMinigameProcessType
{
	AutomaticPreInteraction
	ManuallyHandledInInteraction
}

// Keep in sync with HC_InteractionPointType.h
enum InteractionPointMinigameResult
{
	Abort
	Success
	Fail
}

// Keep in sync with HC_InteractionPointMinigameTypes.h
enum InteractionPointMinigameDifficulty
{
	Bespoke
	Onboarding
	Easy
	Normal
	Hard
	Extreme
}

class InteractionPointMinigame < uid=auto abstract=1 >
{
	InteractionPointMinigameDifficulty myDifficulty Bespoke < ui_info=0 >
}

// Keep in sync with HC_InteractionPointMinigameConstantData.h
enum LockpickingLayerSectionType
{
	Gap
	Block
	Fail
	Punish
}

class InteractionPointMinigameLockpickingLayerSection
{
	LockpickingLayerSectionType myType < tooltip="Type of the section" >

	float myAngleStart 0.0 < tooltip="Which angle the section starts" >
	float myAngleEnd 360.0 < tooltip="Which angle the section ends" >
}

list InteractionPointMinigameLockpickingLayerSectionList
{
	InteractionPointMinigameLockpickingLayerSection
}

class InteractionPointMinigameLockpickingLayer < ui_info=1 >
{
	InteractionPointMinigameLockpickingLayerSectionList mySections < ui_info=0 >
	string myTimeToRotateInSeconds 2 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Time for the layer to complete a 360º rotation" ui_info=0 >
	float myDirection 1.0 < min=-1.0 max=1.0 tooltip="Direction of the layer. Positive goes clockwise, negative counterclockwise" ui_info=0 >
	float myLockpickSizeInDegrees 10.0 < min=0.0 max=360.0 tooltip="Lockpick size for this layer in degrees." ui_info=0 >
	float myCoyotePercent 0.3 < min=0.0 max=1.0 tooltip="Percentage of lockpick size in which hitting a gap with an offset less than this value will be considered a valid gap hit." ui_info=0 >
}

list InteractionPointMinigameLockpickingLayerList
{
	InteractionPointMinigameLockpickingLayer
}

class LockpickingSetup
{
	string myGameplayBeatPattern "0000 0001 0000 0001" < tooltip="The pattern that gives the active slots the players needs to press to be able to win the lockpicking minigame." >
	string myRhythmBeatPattern "0001 0001 0001 0001" < tooltip="The pattern that gives the rhythm to the lockpicking minigame." >
	float myPatternTempo 0.5 < min=0.1 tooltip="The time in seconds we want to go from one slot to the next." >
	int myMaxTicksPerPattern 16 < min=8 tooltip="The number of slots we want out pattern to have." >
	int myMaxAttempts 0 < min=0 tooltip="Maximum number of attempts available for the player to be able to win the lockpicking. \n If this is 0, it means that the player doesn't have a limit in tries." >
}

class InteractionPointMinigameLockpicking : InteractionPointMinigame < ui_info=1 >
{
	LockpickingSetup myLockpickingSetup < ui_info=0 >
	int myNumberOfAttemptsBeforeLock 0 < tooltip="Set 0 for infinite attempts" >

	InteractionPointMinigameLockpickingLayerList myLayers < ui_info=0 >
}

class SlicingSetup
{
    uid mySuccessOrCriticalSuccessWithoutWarningReward < bhv="constantdata" constantDataType="reward" tooltip="Reward given when the player has a success or critical success with an attempt count inferior to Maximum Attempt Count Before Warning. No reward will be given if set to Invalid." >
	float myAttemptRatioThresholdForCriticalSuccess 0.75 < min=0.0 max=1.0 bhv="percent" tooltip="If the player finishes the slicing with an attempt count inferior or equal to this threshold, the slicing result will be a critical success." >
	int myMaximumAttemptCountBeforeWarning 5 < min=1 tooltip="Maximum number of attempt available for the player to finish the slicing board. Will not exceed the limit set in the interactionpointsettings file." >
	int myMaximumAttemptCountBeforeFinish 5 < min=1 tooltip="Maximum number of attempt available for the player to finish the slicing board before it fails because of too many attempts." >
	// maximum limit must match with the length of HC_SlicingBoard::ourCompleteCharacterPool in HC_SlicingBoard.cpp
	int myGlyphCount 10 < min=1 max= 24 tooltip="Number of unique different glyphs available to create the slicing board." >
	int myKeyboardRowCount 4 < min=1 tooltip="Number of rows/keys per column in the glyph keyboard." >
	int myKeyboardColumnCount 4 < min=1 tooltip="Number of columns/keys per row in the glyph keyboard.">
	int mySolutionLength 4 < min=1 tooltip="Number of glyphs to find in the slicing board." >
	int myUselessGlyphGroupCountToAdd 0 < min=0 tooltip="Number of glyph groups without any glyph of the solution to add in addition to the glyph groups created for each solution's glyph." >
	int myTimeSpentThresholdForCriticalFailureInSeconds 30 < min=1 tooltip="If the player finishes the slicing with an elapsed time inferior or equal to this threshold, the slicing result will be a critical failure." >
}

class InteractionPointMinigameSlicing : InteractionPointMinigame < ui_info=1 >
{
	SlicingSetup mySlicingSetup < ui_info=0 >
}
