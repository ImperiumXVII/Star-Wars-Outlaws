include "helix/game system data/fruit/player/movement.fruit"
include "helix/game system data/fruit/player/playeragentstate.fruit"

enum TimeOfDay
{
	Dawn
	Day
	Dusk
	Night
}

enum EnvironmentReactionState
{
	None
	IsFreezing
	IsHeating
	IsRainWet
	IsSunblinded
	IsWindPushed
	IsWaterfallWet
}

class BlackListLevel
{
	uid myLevel < bhv=asset assettype=level >
}

class ReactionAnimationData
{
	MovementStanceList myMovementStances < tooltip="Set the list of stances to bind with a Reaction ID and a duration. The reaction ID is provided to the Animation System to play the proper animation and the duration must be equal than the involved animation's duration in order to keep alive the reaction state in the PlayerEnvironmentReactionsComponent" >
	int myReactionAnimationID < min=0 tooltip="It's the reaction ID provided to the Animation System to play the proper animation according to the player stance" >
	float myDuration 1.0 < min=0.0 tooltip="It's the reaction duration for the related stance and animation ID" >
	bool myInterruptReactionOnStanceChange true < tooltip="If true, the reaction is interrupted when the player stance changes" >
}

list ReactionAnimationDataList
{
	ReactionAnimationData
}

list BlackListLevelList
{
	BlackListLevel
}

class EnvironmentReactionettings
{
	bool myReactIndoor false < tooltip="If true, the reaction can be triggered also in indoor environments" >
	ReactionAnimationDataList myReactionAnimationDataList < tooltip="This structure allows to set the animations IDs and durations according to the player stance and how the involved reactions animations are indexed in the Animation System. If the list is empty, the animation duration is considered infinite and the Animation System will take care to loop on the possible animation variations" >
	float myBreakIdleTimeInterval 5.0 < min=0.0 tooltip="Set the time interval in seconds for which the idle state should be break by the environment phenomenon. Ignore this field if IsContinuous is true" >
	bool myTriggerReactionImmediately false < tooltip="If true, the reaction is triggered as soon as the environment conditions are met" >
	bool myShouldReactOutdoorTransition false < tooltip="If true, the reaction is immediately triggered once the player moves to an outdoor area if the OutDoorTimeInterval is expired" >
	float myOutDoorTimeInterval 5.0 < min=0.0 tooltip="It's the minimum time interval to wait in order to trigger the reaction again when moving to an outdoor area" >
	BlackListLevelList myBlackListLevels < tooltip="Set the levels list for which this reaction is forbidden" >
	PlayerAgentStates myBlackListPlayerAgentStates < toolltip="Set the player agent states for which this particular reaction is forbidden" >
	float myMaxPlayerSpeed 2.9 < min=0.0 tooltip="Set the maximum player speed threshold to play the reaction" >
	int myPriority 0 < min=0 tooltip="Set the reaction priority to proper trigger the best reaction when multiple reactions' conditions are satisfied" >
}

class TemperatureReactionSettings : EnvironmentReactionettings
{
	float myMaxTemperature 0.0 < tooltip="Set the maximum temperature to trigger this reaction" >
	float myMinTemperature 0.0 < tooltip="Set the minimum temperature to trigger this reaction" >
}

class SunblindedReactionSettings : EnvironmentReactionettings
{
}

class RainReactionSettings : EnvironmentReactionettings
{
	float myMinRainAmount 0.5 < min=0.0 max=1.0 tooltip="Set the minimum of rain amount required to trigger this reaction" >
	bool myCheckObstaclesAbovePlayer false < tooltip="If true, a vertical ray cast from the player is made to check obstacles that block the reaction" > 
	float myMaxObstaclesDetectionDistance 0.0 < min=0.0 tooltip="It's the maximum distance range used to check the presence of any obstacle" >
}

class WindReactionSettings : EnvironmentReactionettings
{
	float myMaxFacingToWindDirectionAngle 180.0 < min=0.0 tooltip="Set the maximum angle between the player facing and the wind direction for which this reaction is detected" >
	float myMinFacingToWindDirectionAngle 180.0 < min=0.0 tooltip="Set the minimum angle between the player facing and the wind direction for which this reaction is detected" >
	float myMinWindStrength 5.0 < min=0.0 tooltip="Set the minimum wind strength to trigger this reaction" >
	bool myCheckObstaclesAgainstWindDirection false < tooltip="If true, a ray cast from the player toward the direction against the wind vector is made to detect the presence of any obstacle that blocks the reaction" > 
	float myMaxObstaclesDetectionDistance 0.0 < min=0.0 tooltip="It's the maximum distance range used to check the presence of any obstacle" >
}

class WaterfallWetReactionSettings : EnvironmentReactionettings
{
}

class PlayerEnvironmentReactionSettings
{
	TemperatureReactionSettings myFreezingReactionSettings
	TemperatureReactionSettings myHeatingReactionSettings
	SunblindedReactionSettings mySunblindReactionSettings
	RainReactionSettings myRainReactionSettings
	WaterfallWetReactionSettings myWaterfallWetReactionSettings
	WindReactionSettings myWindReactionSettings
	PlayerAgentStates mySharedBlackListPlayerAgentStates < toolltip="Set the player agent states for which the environment reactions are forbidden" >
}