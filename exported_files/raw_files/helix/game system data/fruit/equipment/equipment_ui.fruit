include "helix/game system data/fruit/equipment/equipment_conditions.fruit"

class EquipmentUIByConditions
{
	GameConditionEquipmentGroup myConditions
	file myUIGraph "" < bhv=asset assettype=GUI >
}

list EquipmentUIByConditionsList
{
	EquipmentUIByConditions
}

// Sync with values from UIState in settings/uisettings.fruit
class EquipmentUIStates
{
	bool myFrontend false
	bool myPlanet true
	bool mySpace false
	bool mySystemMenu false
	bool myGameMenu false
	bool myCinematic false
}

class EquipmentUI
{
	file myDefaultUIGraph "" < bhv=asset assettype=GUI >
	EquipmentUIByConditionsList myUIGraphByConditions
	EquipmentUIStates myUIStates
}
