include "helix/game system data/fruit/equipment/equipment.fruit"
include "helix/game system data/fruit/equipment/equipment_attachment.fruit"
include "helix/game system data/fruit/equipment/equipment_chain.fruit"
include "helix/game system data/fruit/equipment/equipment_slot_types.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"

list RequirementList
{
	GameConditionPlayerHasItem
	GameConditionPlayerHasLegendRank
	GameConditionNumberOfChaptersCompleted
}

class EquipmentSlotUnlockConditionGroup : GameConditionGroupBase
{
	RequirementList myConditions
}

class EquipmentSlotUnlockRequirement
{
	EquipmentSlotUnlockConditionGroup myConditions
	varmap myLockedReason < bhv="localization" >
}

list SlotUnlockRequirementList < size=1 >
{
	EquipmentSlotUnlockRequirement
}

class EquipmentSlot
{
	EquipmentSlotGroupType myGroup Unassigned
	EquipmentSlotTag myTag Main
	bool myIsHidden true
	bool myIsConst false < tooltip="If true, we can't change the slotted equipment runtime" >
	bool myIsAutoSlotEnabled false < tooltip="If true, as soon there is a compatible equipment will be slotted" >
	bool myIsDefaultActive false < tooltip="If true, the equipment will be active by default)" >
	EquipmentAttachment myAttachment
	EquipmentItem* myDefault
	SlotUnlockRequirementList myUnlockRequirements
}

list EquipmentSlotList
{
	EquipmentSlot
}

class EquipmentSlotGroupUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" >
	varmap myDescription < bhv="localization" >
	string myIcon < bhv="sprite" >
}

enum EquipmentSlotGroupBehavior
{
	OnlyTarget
	All
}

class EquipmentSlotGroup
{
	EquipmentSlotGroupType myGroup Unassigned
	bool myIsHidden false
	EquipmentSlotGroupUIInfo myUIInfo
	EquipmentSlotGroupBehavior myGroupBehavior OnlyTarget
}

list EquipmentSlotGroupList
{
	EquipmentSlotGroup
}

list EquipmentChainDataList < size=16 >
{
	EquipmentChainData
}

class EquipmentSet < uid=auto >
{
	EquipmentSlotList mySlotList
	EquipmentSlotGroupList myGroupList
	EquipmentChainDataList myChainList
}
