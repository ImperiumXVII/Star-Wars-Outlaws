include "helix/game system data/fruit/audio/stimulus.fruit"
include "helix/game system data/fruit/input/rumble.fruit"
include "snowdrop/modules/core/audio/audio.fruit"

enum EquipmentOverHeatingMode
{
	Disabled
	PerUse
	Overtime
	Charge
}

class EquipmentOverHeatActiveCoolingSection
{
	string myStartOfSection 0.0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Percentage of start of the section" ui_info=0 >
	string myLengthOfSection 1.0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Percentage of length of the section" ui_info=0 >
	string mySuperChargeBonusTime 0.0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Super charge amount of time as a result of hitting this section" ui_info=0 >
	bool myIsPerfect false < tooltip="If true then this is a perfect active cooling" >
}

list EquipmentOverHeatActiveCoolingSectionList
{
	EquipmentOverHeatActiveCoolingSection
}

class EquipmentOverHeatActiveCooling
{
	EquipmentOverHeatActiveCoolingSectionList mySections
	float myFailurePenalizationTime 2.0 < tooltip="Extra time we add into the overheat cooling process in case the player failes the active cooling" >
	float mySuccessReactionTime 0.3 < tooltip="Time that blocks and penalizes the player's actions after a success active cooling i.e. in the case of Kay, when she tries to fire just after the weapon has been succesfully cooled" >
}

class EquipmentOverHeatAudioData
{
	AudioRTPC myHeatAudioRTPC < tooltip="Audio RTPC for the heat build up progress, ranges from 0 to 1" >
	AudioEvent myOverHeatAudioEvent < tooltip="Audio event to post at the overheat moment" >
	AudioEvent myActiveCoolingPerfectSuccessAudioEvent < tooltip="Audio event to post when the result of active cooling is perfect success" >
	AudioEvent myActiveCoolingSuccessAudioEvent < tooltip="Audio event to post when the result of active cooling is success" >
	AudioEvent myActiveCoolingFailedAudioEvent < tooltip="Audio event to post when the result of active cooling is failed" >
	AudioEvent myActiveCoolingTimeOutAudioEvent < tooltip="Audio event to post when the cooling is over because the time is over and the player didn't interact" >
}

class EquipmentOverHeatRumbleData
{
	string myHeatingUpRumbleIntensityCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="X[0-1], Y[0-1]. Sets the heating up rumble intensity according to the heating up progress" >
	uid myHeatingUpRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played in a loop when ramping up. Intensity is set by curve" >
	uid myOverHeatRumble < bhv="constantData" constantDataType="rumble" >
	uid myEnterCoolingSectionRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble plays when entering a regular cooling section" >
	uid myEnterPerfectCoolingSectionRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble plays when entering a perfect cooling section" >
}

class EquipmentOverHeatTriggerEffectData
{
	file myOverHeatTriggerEffect < bhv="asset" constantDataType="trigger effect" tooltip="This must be a MultiPositionFeedback" >
}

class EquipmentOverHeat
{
	EquipmentOverHeatingMode myHeatingMode Disabled
	string myMaxHeatFormula 100.0 < tooltip="Amount of heating points to reach over heat state" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myHeatPerUseFormula 20.0 < tooltip="Amount of heating points added per bullet" bhv=formulaEditor formulaResolveContextType=EquipmentHeat >
	string myHeatOverTimeFormula 5.0 < tooltip="Amount of heating points added per second / If in charge mode will add this heat after charge is full" bhv=formulaEditor formulaResolveContextType=EquipmentHeat >
	string myCoolingOverTimeFormula 3.0 < tooltip="Amount of heating points reduced per second" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myCoolingTimeToStartFormula 0.0 < tooltip="If cooling is possible, this is the time ( in seconds ) it takes to start the process." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myOverHeatCoolingTimeToStartFormula 0.0 < tooltip="This is the time ( in seconds ) it takes to start the process of cooling while in OverHeat." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myOverHeatCoolingTime 5.0 < tooltip="Time to cooling an overheated equipment" >
	string myOverHeatCoolingOvertimeTime 5.0 < tooltip="Cooling points per second" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myOverHeatCoolingOvertimeHeldMultiplier 1.0 < tooltip="Multiplier applied to OverHeatCoolingOvertimeTime while the player held the equipment" >
	float myOverHeatCoolingOvertimeHolsterMultiplier 1.0 < tooltip="Multiplier applied to OverHeatCoolingOvertimeTime while the player equipment remains in the holster" >
	float myOverHeatReactionTime 1.0 < tooltip="Time that blocks and penalizes the player's actions while in OverHeat i.e. in the case of Kay, when she tries to fire while in overheat" >
	bool myAddHeatWhileCharging false < tooltip= "Build heat while charging the weapon" >
	EquipmentOverHeatActiveCooling myActiveCooling
	float myMinHeatForManualCooling 0.0 < tooltip="Manual reload/cooling will be available to the player once the amount of heat accumulated is more than this value" >
	StimulusIdentifier* myOverHeatBarkStimulus
	EquipmentOverHeatAudioData myAudioData
	uid myAllowPerfectCoolingAttributeUID < tooltip="Used in talents to allow perfect cooling" bhv=attribute >
	EquipmentOverHeatRumbleData myRumbleData
	EquipmentOverHeatTriggerEffectData myTriggerEffectData
}
