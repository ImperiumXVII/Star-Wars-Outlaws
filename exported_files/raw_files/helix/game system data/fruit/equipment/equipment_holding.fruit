include "helix/game system data/fruit/timesequence/time_sequence.fruit"
include "helix/game system data/fruit/player/movement.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"

enum EquipmentHandlingMode
{
	OneHand
	TwoHands
}

enum EquipmentHoldingPlayerStateConfig
{
	StateAllowed
	StateAllowedButRestricted
	StateNotAllowedButRemoved
	HeldNotAllowed
	HeldNotAllowedButStateRestricted
	HeldNotAllowedAndKeepHolstered
	HeldNotAllowedAndKeepHolsteredButStateRestricted
}

enum EquipmentHoldingMovementOverrideTrigger
{
	None
	UnHolstering
	Held
	Raised
}

enum EquipmentVisualsHoldMode
{
	RightHand
	LeftHand
	GrapplingHookBone
	BinocularsBone
	HolsterAttachment
	TakedownWeaponBone
}

enum EquipmentHoldingPlayerState
{
	Melee
	Traversal
	OverHeat
	Roll
	Crouch
	Sprint
	Jump
	WeaponModuleSelection
	AutoWalk
	GadgetSelection
	Interact
	PowerSlide
	ForcedSlide
	SlopeSlide
	HangingTraversal
}

class EquipmentHoldingPlayerStateBehaviorCustom
{
	GameConditionGroup myConditions < tooltip="Supports player centric conditions only." >
	EquipmentHoldingPlayerState myState Melee
	EquipmentHoldingPlayerStateConfig myConfig StateAllowed
}

list EquipmentHoldingPlayerStateBehaviorCustomList
{
	EquipmentHoldingPlayerStateBehaviorCustom
}

class EquipmentHoldingPlayerStateBehavior
{
	EquipmentHoldingPlayerStateConfig myMelee StateAllowed
	EquipmentHoldingPlayerStateConfig myTraversal StateAllowed
	EquipmentHoldingPlayerStateConfig myOverHeat StateAllowed
	EquipmentHoldingPlayerStateConfig myRoll StateAllowed
	EquipmentHoldingPlayerStateConfig myCrouch StateAllowed
	EquipmentHoldingPlayerStateConfig mySprint StateAllowed
	EquipmentHoldingPlayerStateConfig myJump StateAllowed
	EquipmentHoldingPlayerStateConfig myWeaponModuleSelection StateAllowed
	EquipmentHoldingPlayerStateConfig myAutoWalk StateAllowed
	EquipmentHoldingPlayerStateConfig myGadgetSelection StateAllowed
	EquipmentHoldingPlayerStateConfig myInteract StateAllowed
	EquipmentHoldingPlayerStateConfig myPowerSlide StateAllowed
	EquipmentHoldingPlayerStateConfig myForcedSlide HeldNotAllowed
	EquipmentHoldingPlayerStateConfig mySlopeSlide StateAllowed
	EquipmentHoldingPlayerStateConfig myHangingTraversal StateAllowed
	EquipmentHoldingPlayerStateBehaviorCustomList myCustomConfigs
}

class EquipmentHoldingTimedEvent
{
	bool myEnabled false
	float myTime 5
}

class EquipmentHoldingTimedEventWithRadius : EquipmentHoldingTimedEvent
{
	float myRadius 5
}

class EquipmentHoldingSequenceSpecializations
{
	bool myLowCoverUnHolsterAndUseEnabled false
	TimeSequence myLowCoverUnHolsterAndUse
}

class EquipmentHoldingSequences
{
	TimeSequence myHolster
	bool myHolsterLongEnabled false
	TimeSequence myHolsterLong < tooltip="Like a normal holster but longer" >
	TimeSequence myUnHolster
	TimeSequence myUnHolsterAndUse
	TimeSequence myUnHolsterAndAim
	TimeSequence myUnHolsterAndScope
	TimeSequence myThrowAway
	TimeSequence myThrowAwayOutOfAmmo
	TimeSequence myPick
	
	TimeSequence myFromIdleToHip
	
	bool myIdleToQuickHipFireEnabled true
	TimeSequence myFromIdleToQucikHipFire
	TimeSequence myFromQuickHipFireToHipFire
	
	TimeSequence myFromQuickHipFireToIdle
	TimeSequence myFromHipFireToIdle
	
	TimeSequence myFromIdleToADS
	TimeSequence myFromHipFireToADS
	TimeSequence myFromQuickHipFireToADS
	TimeSequence myFromADSToIdle
	TimeSequence myFromADSToHipFire
	
	TimeSequence myUnholsterAndUseSpeeder
	
	EquipmentHoldingSequenceSpecializations mySpecializations
}

class EquipmentHoldingHolsterConfig
{
	float myHolsterMinTime 5 < tooltip="If any autholster value conditions are enabled this will be the min time we support for holster the equipment" >
	
	EquipmentHoldingTimedEvent myHolsterInCombatConstant < tooltip="The autoholster timer for when you are in combat" >
	EquipmentHoldingTimedEvent myHolsterAfterLastUsePulse < tooltip="The autoholster timer after using the equipment" >
	EquipmentHoldingTimedEvent myHolsterAfterLastUseIntentionPulse < tooltip="The autoholster timer getting intent to use" >
	EquipmentHoldingTimedEvent myHolsterAfterAimingConstant < tooltip="The autoholster timer will constantly refresh when aiming" >
	EquipmentHoldingTimedEvent myHolsterAfterWeaponModifiedConstant < tooltip="The autoholster timer will constantly refresh when have changed the weapon module or fire mode (in case the equipment is a weapon and can change modules ofc)" >
	EquipmentHoldingTimedEvent myHolsterInAlarmZoneConstant < tooltip="The autoholster time will constanstly refresh while in alarm zone" >
	EquipmentHoldingTimedEvent myHolsterNearMissPulse < tooltip="The autoholster time after the enemy does a near miss" >
	EquipmentHoldingTimedEvent myHolsterTookDamagePulse < tooltip="The autoholster time after taking damage" >
	EquipmentHoldingTimedEventWithRadius myHolsterNearAlertedEnemiesConstant < tooltip="The autoholster time will constanstly refresh while being near alerted enemies" >
	EquipmentHoldingTimedEventWithRadius myHolsterNearHostileEnemiesConstant < tooltip="The autoholster time will constanstly refresh while being near hostile enemies" >
	
	float myLongHolsterAfterKillAllTime 8.0 < tooltip="Once Kay has killed all the npcs, if the holster is executed into this time window it will be long if available" >
	float myLongAutoHolsterChance 0.05 < min=0.0 max=1.0 tooltip="When auto holster is triggered we roll the dice and if the value is less than the value, long holster will be executed instead of normal">
	float myLongManualHolsterChance 0.1 < min=0.0 max=1.0 tooltip="When manual holster is triggered we roll the dice and if the value is less than the value, long holster will be executed instead of normal">
	bool myHolsterAllowed true < tooltip="If false and the equipment is pickable, it will be always trigger ThrowAway. If true, depending the circumstances it will trigger Holster instead." >
    bool myThrowAwayAllowed true < tooltip="If false, at times when we want to throw the weapon, we will always instead holster it" >
}

class EquipmentHoldingRaiseTimeModifiers
{
	float mySprintModifier 1.0 < tooltip="This modifer is applied while the player is sprinting on the final raise time" >
	float myMoveSpeedThreshold 1.0 < tooltip="If the player speed is above the threshold, the movement modifier is applied" >
	float myMoveModifier 1.0 < tooltip="This modifer is applied while the player is moving at a higher speed than the threshold on the final raise time" >
	float myCoverModifier 0.5 < tooltip="This modifer is applied while the player is behind cover on the final raise time" >
}

class EquipmentHoldingRaiseConfig
{
	bool myUseRaiseEquipment false
	
	float myRaiseMinTime 0.25 < tooltip="This is the min time we raise the equipment/weapon" >
	
	EquipmentHoldingTimedEvent myRaiseAfterLastUse < tooltip="This is the time we keep the raise state after the player has used the equipment/fired the weapon" >
	EquipmentHoldingTimedEvent myRaiseAfterAimUse < tooltip="This is the time we keep the raise state after the player has used while aiming this equipment" >
	EquipmentHoldingTimedEvent myRaiseAfterHipFireUse < tooltip="This is the time we keep the raise state after the player has used in HipFire aim mode the equipment/fired the weapon" >
	EquipmentHoldingTimedEvent myRaiseAfterQuickHipFireUse < tooltip="This is the time we keep the raise state after the player has used in QuickHipFire aim mode the equipment/fired the weapon" >
	EquipmentHoldingTimedEvent myRaiseAfterDraw < tooltip="This is the time we keep the raise state after the player has aimed with this equipment" >
	
	EquipmentHoldingRaiseTimeModifiers myTimeModifiers
	
	bool myRaiseTransitionFromQuickHipFireToHipFireEnabled true < tooltip="If true, after raise the gun in the QuickHipFire mode will do a transition into HipFire raise mode after the amount of time defined by ChangeRaiseFromQuickHipFireToHipFireTime" >
	float myChangeRaiseFromQuickHipFireToHipFireTime 3 < tooltip="Time used for the transition between QuickHipFire raise mode and the HipFire raise mode" >
}

class EquipmentHoldingMovementConfig
{
	bool myTurnWhileUsingIfNoMovementEnabled false < tooltip="If true and the feature is enabled in the player settings, then as soon the player stop using (i.e. shooting) and stop moving, the character will rotate" >
	bool myTurnWhilePickingEnabled false < tooltip="If true, the player will turn towards the cmaera direction while picking the equipment" >
	EquipmentHoldingMovementOverrideTrigger myMovementUnholsteringOverrideTrigger < tooltip="movement config change state while using an equipment" >
	PlayerMovementConfig* myUnholsterTransitionMovementConfig	
	PlayerMovementConfig* myMovementConfig
	PlayerMovementConfig* myADSAimMovementConfig
	float myADSAimMovementPersistOnUseDuration 0.0 < min=0.0 tooltip="The time the ADS movement config will be kept if aiming when starting to use." >
	bool myADSAimMovementPersistOnEndOfUse FALSE < tooltip="If ticked timer will be started on end of use instead" >
	PlayerMovementConfig* myHipFireAimMovementConfig	
	float myHipFireAimMovementPersistOnUseDuration 0.0 < min=0.0 tooltip="The time the Hip Fire movement config will be kept if aiming when starting to use." >
	bool myHipFireAimMovementPersistOnEndOfUse FALSE < tooltip="If ticked timer will be started on end of use instead" >
	PlayerMovementConfig* myScopeAimMovementConfig
	float myScopeAimMovementPersistOnUseDuration 0.0 < min=0.0 tooltip="The time the Scope movement config will be kept if aiming when starting to use." >
	bool myScopeAimMovementPersistStartOnEndOfUse FALSE < tooltip="If ticked timer will be started on end of use instead" >
}

class EquipmentHoldingHeldConfig
{
	bool myHeldIfEquipmentNotReady true
	bool myHeldIfOutOfAmmo false
}

class EquipmentHoldingQuickHipFirePoseConfig
{
	bool myEnabled false
	int myMaxNumConsecutiveUseTimes 3 < tooltip="Max number of time the player can use the equipment using this pose. If the value is negative, the number of potential quickhipfire shots is infinite." >
	bool myCheckMoveSpeedThresholdEnabled false < tooltip="If true, quick hip fire is not allowed if player is moving" >
	float myMinTimeSinceLastUse 0.5 < tooltip="If the time between consecutive uses is longer than this value, quick hip fire pose will end" >
	bool myCheckAimAngleEnabled false < tooltip="If true, quick hip fire is not allowed if the aim angle is too differnet from the forward player direction" >
	float myMaxAimAngle 15.0
}

class EquipmentHoldingConfig < uid=auto >
{
	EquipmentHandlingMode myHandlingMode OneHand
	
	bool myAlwaysHold false
	bool myAlwaysRaise false
	bool mySkipPreviousHolstering false < tooltip="If set to true, the holstering animation of the previous held equipment will be skipped when switching to this one." >
	bool mySkipUnholstering false < tooltip="If set to true, the unholstering animation will be skipped." >
	bool myCanCancelUnholster false < tooltip="If set to true, the player will be able to cancel unholsters by pressing hold input during transition." >
	
	EquipmentHoldingQuickHipFirePoseConfig myQuickHipFireConfig
	EquipmentHoldingSequences mySequences
	EquipmentHoldingHolsterConfig myHolsterConfig
	EquipmentHoldingHolsterConfig mySpeederHolsterConfig
	EquipmentHoldingRaiseConfig myRaiseConfig
	EquipmentHoldingRaiseConfig mySpeederRaiseConfig
	EquipmentHoldingMovementConfig myMovement
	EquipmentHoldingPlayerStateBehavior myPlayerStateBehavior
	EquipmentHoldingHeldConfig myHeldConfig
	EquipmentVisualsHoldMode myHoldMode
}
