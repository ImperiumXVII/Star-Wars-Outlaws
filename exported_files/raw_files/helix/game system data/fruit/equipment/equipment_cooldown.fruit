
enum EquipmentCooldownStartType
{
	OnEndUse
	OnBeginUse
}


class EquipmentCooldown
{
	EquipmentCooldownStartType myStartType OnEndUse
	float myDuration 0
	int myNumberOfSegments 1 < min=1 tooltip="The numbers of segments that make up the cooldown." >
	string myFinalCooldownFormula "Equipment.BaseCooldown" < bhv=formulaEditor formulaResolveContextType=Equipment >
	bool myKeepCooldownOnSwitch false < tooltip="Keep the cooldown from the previously equipped item on the new one when in progress" >
}
