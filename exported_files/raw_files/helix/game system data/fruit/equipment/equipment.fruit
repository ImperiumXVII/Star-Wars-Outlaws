class LuminRodLightPresetsByConditions
{
	GameConditionGroup myConditions < tooltip="Supports player centric conditions only. Leave empty for default preset" >
	string myLightAnchorBone "RightHand" < tooltip="Bone to use to attach the light to." >
	vec3f myLightPositionOffset 0.0;0.0;0.0 < tooltip="Offset to apply to the bone position." >
	float myShadowStartDistance 0.01 < min=0.01 tooltip="Anything closer to the light than this value will not cast shadows and will be ignored for occlusion tests." >
	bool myEnableLightLookAt TRUE < tooltip="If set to true, the player will be able to orient the light cone using the camera." >
	float myMaxLightLookAtHorizontalAngle 70.0 < min=0 max=90 hidden=1 tooltip="Light look at will be clamped once the angle between camera facing and player facing reaches this angle." >
	float myLightConeAngleCameraAlignedToPlayerFacing 80.0 < min=1 max=150 tooltip="Light cone angle used when camera is right behind player's back." >
	float myConsideredAlignedMaximumAngle 90.0 < min=0 max=90 hidden=1 tooltip="Angle tolerance value for the camera to be considered fully aligned behind player's back and use LightConeAngleCameraAlignedToPlayerFacing." >
	float myLightConeAngleCameraNotAlignedToPlayerFacing 80.0 < min=1 max=150 hidden=1 tooltip="Light cone angle used when camera is not behind Kay's back." >
	float myConsideredNotAlignedMinimalAngle 90.0 < min=0 max=90 hidden=1 tooltip="Angle threshold above which camera will be considered fully not aligned behind Kay's back and use myLightConeAngleCameraNotAlignedToPlayerFacing." >
	bool myDisableNixShadows FALSE 
}

list LuminRodLightPresetsByConditionsList
{
	LuminRodLightPresetsByConditions
}

class LuminRodEquipmentItem : EquipmentItem
{
	file myGraphObject "" < bhv=asset assettype=object/gameplayobject >
	float myLightLifeTime 0.0 < min=0 tooltip="The life time (in seconds) of the light once the lumin is sparked. Set to 0 for infinite duration." >
	bool myUseinHandRemaingTimeWhenThrowing FALSE < tooltip="If ticked, the in hand light remaining life time will be transmitted to the light life time after throw." >
	float myLightLifeTimeAfterThrow 120.0 < min=0 tooltip="if UseinHandRemaingTimeWhenThrowing is not ticked, When throwing a lumin rod, the remaining life time will be reset with this value." >
	float myLifeTimeOnceConsumed 10.0 < min=0 tooltip="The duration the lumin rod will remain in the world once the light turned off." >
	ThrowableModule myThrowableModule < tooltip="Optional, fill to make the equipment throwable." >
	int myMaxNumberOfActiveRods 4
	bool myAutoSpark TRUE < tooltip="If ticked, the lumin rod will automatically be sparked when the player unholsters it." >
	bool myDiscardOnStow TRUE < tooltip="If ticked, Kay will discard the current held lumin rod instead of stowing it." >
	float myDiscardThrowSpeed 5.0 < min=0 >
	vec3f myDiscardThrowDirection 0.1;-1.0;0.1
	PlayerAgentStates myAutoUnholsterStates < tooltip="If the player had to stow the lumin rod because they entered in one of those states, it will be auto unholstered upon exit." >
	TimeSequence myHolsterFromBeltToPouchSequence < tooltip="Put a EquipmentHolding custom track here to control at what point the lumin rod is attached and detached from the hand when holstering the rod from the belt to the pouch." >
	float myUnholsterFromBeltWaitTime 0.5 < min=0.0 tooltip="The time it takes before the player automatically unholster the lumin rod from the belt once both hands are free." >
	float mySwitchLightPresetBlendingTime 0.1 < min=0 tooltip="The time it takes for blending between 2 light presets." >
	LuminRodLightPresetsByConditionsList myLightPresetsByConditions < tooltip="Order matters as first valid item in the list will be selected without checking the next ones. Don't forget to include a default preset with an empty condition in last position of the list!" >
	TimeSequence myUnholsterFromPouchSequence < tooltip="Put a EquipmentHolding custom track here to control at what point the light will be turned on when unholstering the rod from pouch." >
}

