class TrickShotEquipmentItem : EquipmentItem
{
	EquipmentSlotGroupType myDefaultSlotGroup Skills < hidden=1 >
	
	file myGraphObject "" < hidden=1 bhv=asset assettype=object/gameplayobject >
	
	float myCandidateDistance 50.0
	int myMaxNumTargets 8
	
	TrickShotScore myScore
	
	float myIntroductionTime 3.0
	float myMiniGameWaitTime 0.15 < tooltip="This corresponds with the waiting stage before the UI minigame with multiple/single circles starts per target." >
	
	float myMiniGameUIInputMaxTime 0.35
	float myMiniGameUIInputMinTime 0.25
	
	CameraModifierInOutTransitions myLookAtCamTransition
	CameraModifierInOutTransitions myGeneralFOVCamTransition
	CameraModifierInOutTransitions myMiniGameFOVCamTransition
	
	AimScreenTargetsOrderType myOrderType LeftToRight
	
	TimeSequenceTracks myMiniGameTracks
	TimeSequence myShotSequence
	TimeSequence myFailSequence
	
	float mySlowDownTimeScale 0.2
	float myShotTimeScale 0.7
	float myGeneralFOV -25.0 < tooltip="FOV modifier value applied during the whole Trick SHot mechanic." >
	
	bool myInterruptIfFailInput true
	
	float myMiniGameUIFakeMultiplier 0.7 < min=0.0 tooltip="This multiplier is applied to the minmigame time to produce the value to display for the player, inidependent from the logic values." >
	
	AudioEvent myInitAudioEvent
	AudioEvent myEndAudioEvent
	AudioEvent myCancelAudioEvent
	AudioEvent myShotAudioEvent
}

