class EquipmentItem < uid=auto abstract=1 > : Item
{
	ItemCategory myCategory Equipment
	EquipmentCooldown myCooldown
	EquipmentOverHeat myOverHeat
	AimConfig* myAimConfig
	EquipmentHoldingConfig* myHoldingConfig
	bool myAlwaysAim false < tooltip="If true, if the player holds the equipment always want to activley aim, no matter the input." >
	EquipmentRampUpAndDown myUseRampUpAndDown
	EquipmentUI myUI
	Item* myConsumedItem < tooltip="If set the player needs to have this item to be able to use the equipment and one will be consumed on use." >
	ConsumedItemConfig myConsumedItemConfig < tooltip="Configurations for the item consumed when using the equipment" >
	EquipmentSlotGroupType myDefaultSlotGroup Unassigned < tooltip="The equipment will be slotted in this group by default (unless the game intentionally slot it in a different one)." >
	bool myIsPickable false < tooltip="If enabled, item will be automatically equipped in the pickable slot." >
	bool myResetAmmoOnRemove true < tooltip="If this item has ammo and this is true, it will remove the ammo from the players inventory when removed" >
	int myMaxNumberOfActivePickables 3 < tooltip="The max number of pickables of this item type that can be active within radius when this item is spawned." >
	float myPickableDeactivationRadius 40.0 < tooltip="When spawned, if there are more than the max allowed active pickables within this radius from the item, some of the pickables will be disabled for pickup." >
	TalentList myTalents < tooltip="Applied when equipment is equipped" >
	TalentList myActiveDurationTalents < tooltip="Applied while equipment is active and removed when equipment goes in cooldown" >
	GearSetlist myGearSets
	ThrowableModule myThrowableModule < hidden=1 tooltip="Optional, fill to make the equipment throwable." >
	bool myShouldAutoSave TRUE
	bool myIsDisabledByDefault FALSE < tooltip="If set to true this item will not be usable until it's enabled by contextual gameplay systems." >
	bool myDeployOnPickup TRUE < tooltip="if true when item is added to inventory, deploy automatically. (NOTE: If this is false, it will break unless given through script)" >
	StimulusIdentifier* myActivationBark < tooltip="Bark to be played when the item is used." >
	uid myActivationRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble plays when the equipment is activated, if it's owned by the player or spaceship." >
	file myActivationParticleEffect < bhv=asset assettype=particles tooltip="Particle Effect to be triggered upon activation" >
}

