{
	FrequencyBasedOnDistance
	IntensityBasedOnDistance
}

class HoloReaderEquipmentItem : EquipmentItem
{
	file myGraphObject "" < bhv=asset assettype=object/gameplayobject >
	PlayerRestriction* myCompassModeRestrictions < tooltip="Prevented actions while in a compass mode" >
	PlayerRestriction* myProjectionModeRestrictions < tooltip="Prevented actions while in a projection mode" >
	PlayerRestriction* myLandscapeModeRestrictions < tooltip="Prevented actions while in a landscape mode" >
	uid myDistanceToTargetRumble < bhv="constantData" constantDataType="rumble" >
	AudioEvent myEnterTargetZoneSound
	uid myEnterTargetZoneRumble < bhv="constantData" constantDataType="rumble" >
	AudioEvent myExitTargetZoneSound
	uid myExitTargetZoneRumble < bhv="constantData" constantDataType="rumble" >
	AudioEvent myEnterTargetZoneSmugglerCrateSound
	uid myEnterTargetZoneSmugglerCrateRumble < bhv="constantData" constantDataType="rumble" >
	AudioEvent myExitTargetZoneSmugglerCrateSound
	uid myExitTargetZoneSmugglerCrateRumble < bhv="constantData" constantDataType="rumble" >
	uid myOnHologramOpen < bhv="constantData" constantDataType="rumble" >
	uid myOnHologramClose < bhv="constantData" constantDataType="rumble" >
	uid myOnRotateHolomap < bhv="constantData" constantDataType="rumble" >
	file myTriggerEffect < bhv="asset" constantDataType="trigger effect" tooltip="The Trigger FX applied on turning the hologram" >
	AudioEvent myTargetPingSound
	AudioEvent myStartUsingGadgetSound
	AudioEvent myEndUsingGadgetSound
	AudioEvent myStartUsingGadgetSoundOnSpeeder
	AudioEvent myEndUsingGadgetSoundOnSpeeder
	AudioEvent myAutoHolsterSound
	AudioEvent myStartTurnHoloSound
	AudioEvent myEndTurnHoloSound
	AudioEvent myEnterLandscapeMode
	AudioEvent myExitLandscapeMode
	AudioRTPC myAngleToTargetRtpc
	AudioRTPC myDistanceToTargetRtpc
	TutorialHint* myFindDiskOnThisPlanetMessage < tooltip="There is disk on this planet" >
	TutorialHint* myFindDiskOnAnotherPlanetMessage < tooltip="There are unfinished disks on another planet" >
	TutorialHint* myActiveDiskOnAnotherPlanetMessage < tooltip="Has an unlocked disk for another planet" >
	TutorialHint* myAllDisksCompletedMessage < tooltip="All disks are completed" >
	TutorialHint* myNoDiskMessage < tooltip="I have no disks yet" >
	TutorialHint* myInitialDiskIsOnAnotherPlanetMessage < tooltip="Hint Message for the first disk on another planet" >
	StimulusIdentifier* myInitialDiskIsOnAnotherPlanetMessageVO
	StimulusIdentifier* myFindDiskOnThisPlanetMessageVO
	StimulusIdentifier* myFindDiskOnAnotherPlanetMessageVO
	StimulusIdentifier* myActiveDiskOnAnotherPlanetMessageVO
	StimulusIdentifier* myAllDisksCompletedMessageVO
	StimulusIdentifier* myNoDiskMessageVO
	StimulusIdentifier* myEnterSearchAreaCacheVO
	StimulusIdentifier* myExitSearchAreaCacheVO
	StimulusIdentifier* myManualHolsterCacheVO
	StimulusIdentifier* myManualUnholsterCacheVO
	StimulusIdentifier* myEnterSearchAreaCrateVO
	StimulusIdentifier* myExitSearchAreaCrateVO
	StimulusIdentifier* myManualHolsterCrateVO
	StimulusIdentifier* myManualUnholsterCrateVO
	float myNoDiskHintDuration 5.0 < min=0.0 tooltip="How much time the empty disk stays on screen" >
	float myRumbleIntensityWhenHolstered 0.5 < min=0.0 tooltip="A mutlipler to the rumble feedback of the gadget when hosltered" >
	float myZoneHysteresis 1.0 < min=0.0 tooltip="The hysteresis of reentry to the discovery zone" >
	float myFacingTimeHysteresis 1.0 < min=0.0 tooltip="Time after Orienting in the right direction before we start the feedback rumble and sound" >
	float myEnterZoneTimeHysteresis 5.0 < min=0.0 tooltip="Time after exiting the discovery zone after which consider the character needs to auto unhoster the gadget" >
	float myGadgetLightOnTime 0.8 < min=0.0 tooltip="Blink time for the gadget light" >
	float myInnerAngleThresholdAtMinDistance 15 < min=0.0 tooltip="The half angle of the cone at the min distance. The further away you are the bigger the cone" >
	float myInnerAngleThresholdAtMaxDistance 80 < min=0.0 tooltip="The half angle of the cone at the max distance. The further away you are the bigger the cone" >
	float myOuterAngleThresholdAtMinDistance 35 < min=0.0 tooltip="The half angle of the cone at the min distance. The further away you are the bigger the cone" >
	float myOuterAngleThresholdAtMaxDistance 90 < min=0.0 tooltip="The half angle of the cone at the max distance. The further away you are the bigger the cone" >
	float myMinDistanceForRumble 2 < min=0.0 tooltip="The minimum distance for the rumble to trigger" >
	float myMaxDistanceForRumble 100 < min=0.0 tooltip="The maximum distance for the rumble to trigger" >
	HoloReaderHotAndColdFeedbackType myHoloReaderHotAndColdFeedbackType FrequencyBasedOnDistance	
	bool myUseFlatDirection false
	string myRumbleCooldownCurve < bhv=inputgraph >
	string myOrientationAngleFeedbackCurve < bhv=inputgraph hidden=1 >
	string myDistanceIntensityFeedbackCurve < bhv=inputgraph hidden=1 >
	float myMinDistanceRumbleCooldown 0.5 < min=0.0 tooltip="The time between triggering rumble event at the min distance" hidden=1 >
	float myMaxDistanceRumbleCooldown 3.0 < min=0.0 tooltip="The time between triggering rumble event at the max distance" hidden=1 >
	float myMinAngleRumbleCooldown 0.5 < min=0.0 tooltip="The time between triggering rumble event at the min angle" hidden=1 >
	float myMaxAngleRumbleCooldown 3.0 < min=0.0 tooltip="The time between triggering rumble event at the max angle" hidden=1 >
	float myLandscapeThresholdValue 0.5 < min=0.0 tooltip="The stick value we consider the stick to be pressed up" >
	float myRotationInputThresholdValue 0.3 < min=0.0 tooltip="The stick value we consider the stick to be pressed left or right" >
	string myHoloNoiseAmplitudeCurve < bhv=inputgraph hidden=1 >
	string myHoloNoiseAmplitudeModifierCurve < bhv=inputgraph hidden=1 >
	string myHoloNoisePlaySpeedModifierCurve < bhv=inputgraph hidden=1 >
	string myMouseSpeedToStickValueRemap "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.2 0.001, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	bool myIsHologramAttachedToTheGadget false
	float myDistanceFromCamera 0.0 < min=0.0 tooltip="Hologram distance from the camera" hidden=1 >
	float myVerticalOffset 0.0 < tooltip="Vertical offset of the hologram" >
	float myHorizontalOffset 0.0 < tooltip="Horizontal offset of the hologram" >
	float myMinRotationSpeed 2.0 < min=0.0 >
	float myMaxRotationSpeed 3.0 < min=0.0 >
	vec3f myConePositionOffset -0.02;0.15;0.0 < tooltip="The local offset of the cone tip related to the gadget" >
	float myConeAngle 60.0 < min=0.0  tooltip="The half angle of the holo map light cone" >
	float myConeFadeStart 80.0 < min=0.0 tooltip="The start percentage of fade for the cone of light" >
	float myConeFadeEnd 100.0 < min=0.0 tooltip="The end percentage of fade for the cone of light"  >
	float myProjectionModeTransitionTime 1.2 < min=0.0 tooltip="Time needed to transition to the projection mode. It is used for the effect of the hologram" >
	float myCompassModeTransitionTime 0.2 < min=0.0 tooltip="Time needed to transition to the compass mode. It is used for the effect of the hologram" >
	float myCollisionTransitionTime 0.8 < min=0.0 tooltip="Time needed to transition to the collision mode. It is used for the effect of the hologram" >
	float myLandscapeToProjectionTransitionTime 0.2 < min=0.0 tooltip="Time needed to transition from Landscape to Projection mode." >
	float myProjectionToLandscapeTransitionTime 0.0 < min=0.0 tooltip="Time needed to transition from Projection to Landscape mode." >
	float myInactiveTransitionTime 1.0 < min=0.0 tooltip="Time needed to transition to Projection to Inactive mode" >
	float myCollisionCastRadius 0.2 < min=0.0 tooltip="Size Of the cast sphere" >
	float myCollisionPhaseEnd 0.98 < min=0.0 max=1.0 tooltip="The phase represents the effect of the hologram. 0 would be hologram out and 1 will be completly hidden" >
	bool myRestrictMoveInFocus false < tooltip="When this is on the character will not be able to move when projecting the hologram" >
}

