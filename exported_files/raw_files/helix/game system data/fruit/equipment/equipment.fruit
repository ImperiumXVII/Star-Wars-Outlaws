class SkinEquipmentItem : EquipmentItem
{
	EquipmentSlotGroupType myDefaultSlotGroup Skin < hidden=1 >

	file myL1NormalMap < bhv="asset" assettype="texture" >
	file myL1ColorMap < bhv="asset" assettype="texture" >
