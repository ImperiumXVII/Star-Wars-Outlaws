
class WeaponAnimationRecoil
{
	float myWristRotation 0.5f < tooltip="Vertical rotation mainly in the wrist." >
	float myTorsoPushbackStrength 1.0f < min=0 tooltip="Whole body gradually pushes back." >
	float myTorsoPushbackStartTime 0.0f < min=0 >
	float myShoulderPushbackStrength 1.0f < min=0 tooltip="Hand and arm pushes up." >
	float myShoulderPushbackStartTime 0.0f < min=0 >
	float myArmKickupStrength 1.0f < min=0 tooltip="A clear kick upwards in the hand and arm." >
	float myArmKickupStartTime 0.0f < min=0 >
	bool myHorizontalAngleAlignedWithCamera true < tooltip="If true, the horizontal angle sign will be provided by the reocil camera, otherwise will be random" >
	float myMinHorizontalAngle 5.0f < min=0 max=180 >
	float myMaxHorizontalAngle 15.0f  < min=0 max=180 >
}

class WeaponAnimationRecoilConfig
{
	WeaponAnimationRecoil myInitialShot
	WeaponAnimationRecoil myContinuesShot
	WeaponAnimationRecoil myFinalBurstShot
	float myCeaseFireTime 1.0f < min=0 tooltip="Time after cease fire that the inital shot can be played again" >
}

class WeaponAnimationConfig < uid=auto >
{
	WeaponAnimationRecoilConfig myRecoil
	string myChargeWristShakeStrength "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
}
