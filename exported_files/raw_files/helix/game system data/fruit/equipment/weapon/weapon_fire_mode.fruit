class WeaponFireModeUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" >
	varmap myDescription < bhv="localization" >
	varmap myDescriptionController < bhv="localization" >
	string myIcon < bhv="sprite" >
	file myVideo < bhv="asset" assettype="webm" ui_info=1 >
}

class WeaponCustomProjectileConfig
{
	bool myIsCustomInitialSpeedEnabled false
	string myCustomInitialSpeedFormula 1 < tooltip="Custom initial speed for the projectile" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	ProjectileActionList myCustomActions
}

class WeaponFireModeConfig
{
    bool myShouldTurnOnUse true < tooltip="if true, the agent will turn when the angle is too big from firing the weapon with this firemode active" >
	bool myReplaceIfCooldown false < tooltip="if true, if the fire mode is in cooldown it will be replaced" >
	float myStartToReplaceTime 1.0 < tooltip="Time it takes to start the process to change the module once the current one is no longer operational" >
}

class WeaponFireModeProperties
{
	WeaponAnimationConfig* myAnimation
	RecoilCameraModifier* myRecoil < tooltip="Default recoil preset" >
	WeaponInputController myInputController
}

class WeaponFireModeSpecialization
{
	AimModeType myAimMode HipFire
	WeaponFireModeProperties myProperties
}

list WeaponFireModeSpecializationList
{
    WeaponFireModeSpecialization
}

class WeaponFireMode < uid=auto >
{
	FireEventList myFireEvent
	WeaponFireModeProperties myBaseProperties
	WeaponFireModeSpecializationList mySpecializations
	WeaponTargetCollectorList myTargetCollector
	EquipmentRampUpAndDown myFireRampUpAndDown
	AimConfig* myAimConfig
	bool myAlwaysAim false < tooltip="If true, if the player holds the equipment always want to activley aim, no matter the input." >
	Projectile* myProjectile
	WeaponCustomProjectileConfig myCustomProjectileConfig
	bool myHasIndependentCooldown false < tooltip="If true the fire mode will have its own instance of cooldown instead of using the shared one">
	EquipmentCooldown myCooldown
	EquipmentOverHeat myOverHeat
	WeaponDamage myDamage
	WeaponSeeking mySeeking
	WeaponSpread mySpread
	WeaponLockOn myLockOn < tooltip="Controls the lock on feature on the firemode. User needs to spend some time on target before certain features are activated" >
	WeaponMuzzle myMuzzle
	ShakeCameraModifier* myFireShake
	MultiCameraShake* myFireMultiShake < tooltip="If multi shake is provided, fire shake will be ignored" >
	EquipmentUI myUI
	WeaponFireModeUIInfo myUIInfo
	AudioWeapon* myAudioData
	StimulusIdentifier* myStimulusIdentifier
	NPCDetectionSoundEvent* myNPCDetectionSoundEvent
	WeaponFireModeConfig myConfig
	file myMuzzleEffect "" < bhv=asset assettype=particles >
}
