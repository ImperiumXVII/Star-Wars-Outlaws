include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/combat/combat.fruit"
include "helix/game system data/fruit/equipment/equipment_overheat.fruit"
include "helix/game system data/fruit/equipment/aiming_modifiers.fruit"
include "helix/game system data/fruit/bodypart/bodypart.fruit"
include "helix/game system data/fruit/equipment/aiming.fruit"

class WeaponDamageValue
{
	string myDamageFormula 5 < tooltip="Calculation for the base damage this weapon will deal" bhv=formulaEditor formulaResolveContextType=SourceAgentAndTarget >
	string myDamageMultiplierFormula 1.0 < tooltip="Calculation for the base damage multiplier this weapon will use" bhv=formulaEditor formulaResolveContextType=SourceAgentAndTarget >
	float myVariation 5.0  < tooltip="The added random damage (ranges from -Variation to +Variation) the weapon will inflict at any range up to Max Range" >
	DamageType myDamageType Physical < tooltip="The damage type the weapon is dealing; used to determine which damage modifiers to apply" >
}

class WeaponDamageRange
{
	bool myEnabled false
	float myOptimal 50.0 < tooltip="The weapon does (max damage +- variation) up to this range. After this points the value tends to myMinDamagePercentatge as close is to Max" >
	float myMax 100.0 < tooltip="The weapon does myMinDamagePercentatge damage above this range" >
	float myMinDamagePercentatge 0.0 < min=0.0 max=1.0 tooltip="Once the range is beyond Max, the damage will be this percentatge of the full damage" >
}

class WeaponDamageBodyMultiplier
{
	BodyPart* myBodyPart
	string myMultiplierFormula 1.0 < bhv=formulaEditor formulaResolveContextType=SourceAgentAndTarget >
}

list WeaponDamageBodyMultiplierList
{
	WeaponDamageBodyMultiplier
}

class WeaponDamage
{	
	WeaponDamageValue myDamage < tooltip="Damage value used against enemies. It's the most generic value, used when there is no more specific value available" >
	
	WeaponDamageRange myRange < tooltip="The weapon does damage based on this range" >
	
	bool myNeedCustomHitReaction false < tooltip="If true, Agent hit by this weapon will be able to play a custom hit reaction" >

	string myCriticalHitChance 0.0 < tooltip="The chance each bullet will cause a critical hit"  bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 >
	float myCriticalHitChanceDistanceMin 0.0 < tooltip="The minimum distance at which a bullet can cause a critical hit" >
	float myCriticalHitChanceDistanceMax 100.0 < tooltip="The maximum distance at which a bullet can cause a critical hit" >
	float myCriticalHitDamageModifier 1.0 < tooltip="Multiplier for the damage caused by a critical hit" >
	
	WeaponDamageBodyMultiplierList myBodyDamageMultipliers
	
	string myFullChargeBonusFormula 0.0 < bhv=formulaEditor formulaResolveContextType=SourceAgentAndTarget tooltip="This value will appear as part of the weapon formula context as Weapon.FullChargeBonus and ideally cxan be used in combination with Weapon.IsFullCharge" >
}

class WeaponSeeking
{
	float myMaxDistanceFromTargetModifier 1.0 < tooltip="Distance modifier for when the projectile seeking will be enabled" >
}

class WeaponSpreadValue
{
	float myMin 0.0 < tooltip="Min Spread Angle" >
	float myMax 0.0 < tooltip="Max Spread Angle" >
	bool myIsUniform FALSE < tooltip="If checked uses uniform spread" >
}

class WeaponSpreadValues
{
	WeaponSpreadValue mySpread < tooltip="Spread in Default Third Person Mode" >
	
	// TODO - asm: until the attribute system is implemented, we don't know yet how will implement this
	// WeaponSpreadValue myCoverSpread < tooltip="Spread in Default Third Person Mode while in Cover" >
	// WeaponSpreadValue myAimSpread < tooltip="Spread in Aim Mode" >
	// WeaponSpreadValue myCoverAimSpread < tooltip="Spread in Aim Mode while in Cover" >
}

class WeaponSpread
{
	WeaponSpreadValues mySpreadValues
	
	float mySpreadIncreaseTime 0.1 < tooltip="This value determines how long a weapon spread should increase after a round has been fired" >
	
	float myTimeToMinAccuracy 0.5 < tooltip="Blend time it takes to get to Max Spread (Growth while firing)" >
	float myTimeToMaxAccuracy 1.0 < tooltip="Blend time it takes to get to Min Spread (Shrink while not firing)" >
	
	float mySpreadIncreaseSpeed 0.1 < tooltip="How fast the spread adjusts to a larger spread value" hidden=1 > // Not needed unless we add more Spread values /asm
	float mySpreadReductionSpeed 0.05 < tooltip="How fast the spread adjusts to a lower spread value" hidden=1 > // Not needed unless we add more Spread values /asm
	
	float myMovementModifier 1.5 < tooltip="Spread angle multiplier while moving" >
	float myMovementSpreadThreshold 0.0 < tooltip="Only speeds above the threshold will count towards spread." >
	float myMovementSpreadAcceleration 6.0 < tooltip="How quickly movement spread increases." >
	float myMovementSpreadDeceleration 6.0 < tooltip="How quickly movement spread decreases." >

	float myAimChangeModifier 2.0 < tooltip="Spread angle multiplier while turning" >
	float myMovementModifierSpeedCap 3.0 < tooltip="The fastest player speed that counts into movement spread." >
	float myAimChangeSensitivity 1.0 < tooltip="" >
	float myAimChangeAccuracyRecoveryTime 0.5 < tooltip="Recovery time to adjust the spread after the turning stopped" >

	float myUIMinimumSpread < tooltip="The minimum value that needs to be met before crosshair starts to change." >

	int myAmountOfAccuracyLockedRounds 0 < min=0 tooltip="Determines how many rounds you can firing before accuracy spread kicks in." >
	float myAmountOfAccuracyLockedRoundsRecoveryTime 0.f < tooltip="The locked rounds avilable once the player stop shooting will be restored using this timer. This time is required for restore 1 single round." >
	
	bool myUseAimChangeSpread false < tooltip="Lowers the spread accuracy when moving the aim." >
	bool myUseReverseSpread false < tooltip="The projectile spread will shrink instead of expand while firing." >
	
	AimModifierData myAimModifierData
}

class WeaponLockOn
{
	bool myIsLockOnEnabled false < tooltip="Enables Lock On mechanic. This prevents fire prediction and seeking if not fully locked on" >
	bool myIsLockOnRequired false < tooltip="When lock on is enabled, enabling this setting will prevent shooting unless fully locked on" >
	bool myAllowOutsidePursuitMode true < tooltip="Allow lock on outside pursuit mode" >
	bool myResetAfterShot true < tooltip="Reset lock on after shooting" >
	bool myResetOnNoAmmo true < tooltip="Reset lock on when there is no ammo left" >
	string myLockOnDurationSeconds 2.0 < min=0.01 tooltip="Lock on duration" bhv=formulaEditor formulaResolveContextType=AgentAttributes >

	int myMaximumLockOnTargets 5 < tooltip="Maximum number of targets that can be locked on at a time" >
	vec2f myTagRangeAngles 12;12 < tooltip="Horizontal and vertical apperture of range elliptical cone" >
	vec2f myPursuitModeTagRangeAngles 12;12 < tooltip="Horizontal and vertical apperture of range elliptical cone duing pursuit mode" >
}
