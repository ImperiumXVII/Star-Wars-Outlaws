
enum WeaponModuleFamilyType
{
	Plasma
	Ion
	Power
}

enum WeaponModuleColor
{
	Yellow
	Blue
	Orange
}

class WeaponModuleFamily
{
	varmap myName < bhv="localization" ui_info=1 >
	varmap myDescription < bhv="localization" ui_info=1 >
	string myIcon < bhv="sprite" ui_info=1 >
	WeaponModuleFamilyType myType < ui_info=1 referenced_by_code=1 >
	WeaponModuleColor myColor < ui_info=1 referenced_by_code=1 >	
}

list WeaponModuleFamilyList
{
    WeaponModuleFamily
}
