
enum WeaponTargetCollectorShapeType
{
	Line
	Cylinder
	Pie
}

enum WeaponTargetCollectorShapeCastType
{
	None
	DynamicOnly
	StaticOnly
	All
}

enum WeaponTargetCollectorCandidateCastType
{
	None
	LOS
}

class WeaponTargetCollectorShape
{
	WeaponTargetCollectorShapeType myType Line
	float myRadius 0.25f < tooltip="This value is only used if the shape type is Cylinder" >
	float myHeight 1.0f < tooltip="This value is only used if the shape type is Pie" >
	float myAngle 45.0f < tooltip="This value is only used if the shape type is Pie" >
	float myMaxDistance 100.0f
	bool myGrowOverTimeEnabled true
	float myGrowSpeed 50.0f < tooltip="meters per second" >
	WeaponTargetCollectorShapeCastType myCastType StaticOnly < tooltip="This cast will define how long is the shape" >
}

class WeaponTargetCollector
{
	WeaponTargetCollectorShape myShape
	WeaponTargetCollectorCandidateCastType myCandidateCastType None
	int myMaxVictims 5 < min=1 >
	
	// Realization
	file myShapeGraphObject "" < bhv=asset assettype=object/gameplayobject >
}

list WeaponTargetCollectorList < size=1 >
{
	WeaponTargetCollector
}