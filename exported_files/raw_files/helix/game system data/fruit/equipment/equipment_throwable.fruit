include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/projectile/projectile.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/timesequence/time_sequence.fruit"

class EquipmentThrowAction
{
	float myMaxAngle 90.0 < min=-90.0 max=90.0 tooltip="This Throw action will be candidate if the current throw angle is lower than this angle.">
	TimeSequence myThrowSequence
}

list EquipmentThrowActionList
{
	EquipmentThrowAction
}

class EquipmentThrowCurveByCondition
{
	GameConditionGroup myConditions < tooltip="Supports player centric conditions only." >
	string myAngleOffsetCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -13.3333 -2, -2.66667 -6.33333, }, outTangents = { 13.3333 2, 2.66667 6.33333, 0 0, }, properties = { 203, 2250, 1226, }, values = { -30 10, 10 16, 18 35, }, }, maxValueBounds = 180, minValueBounds = -180, numKeys = 3, }" < bhv=inputgraph >
	string myThrowSpeedCurve < bhv=inputgraph tooltip="The throw speed (in m/s) depending on the the throw angle." >
	bool myOverrideMaxAngle
	float myMaxAngle 90.0 < min=-90.0 max=90.0 hidden=1 >
	bool myOverrideMinAngle
	float myMinAngle -90.0 < min=-90.0 max=90.0 hidden=1 >
	bool myAllowIncreasingAnglePastCameraMinPitch FALSE < tooltip="If ticked, the player will be able to keep increasing the angle even though camera min pitch (looking up) has been reached." >
	bool myAllowDecreasingAnglePastCameraMaxPitch FALSE < tooltip="If ticked, the player will be able to keep decreasing the angle even though camera max pitch (looking down) has been reached." >
}

list EquipmentThrowCurvesByConditionsList
{
	EquipmentThrowCurveByCondition
}

class EquipmentThrowPositionValuesByCondition
{
	GameConditionGroup myConditions < tooltip="Supports player centric conditions only." >
	vec3f myLocalThrowPositionTop
	bool myOverrideMinCameraPitch FALSE
	float myMinCameraPitch < hidden=1 >
	vec3f myLocalThrowPositionBottom
	bool myOverrideMaxCameraPitch FALSE
	float myMaxCameraPitch < hidden=1 >
	float mySideThrowsMinAngle 45.0 < min=0 max=180 tooltip="The minimum angle between player's and camera's facings to perform side throws." >
	float mySideThrowsMaxAngle 100.0 < min=0 max=180 tooltip="The maximum angle between player's and camera's facings to perform side throws." >
	float myFacingAdjustMinAngle 100.0 < min=0.0 max=180.0 tooltip="Will rotate the player so their facing matches the camera's if the angle to camera facing is above this value." >
	bool myAlwaysAdjustPlayerFacingWhenNotMoving TRUE < tooltip="If ticked the angle to camera will be ignored and the player will always rotate on throw when not moving." >
	float myAdjustFacingAngle 0.0 < min=0.0 max=180.0 tooltip="Angle to use when adjusting player facing on throw." >
	bool myDisableADSFacing FALSE < tooltip="Will prevent Kay to rotate towards the camera direction when ADSing." >
}

list EquipmentThrowPositionValuesByConditionList
{
	EquipmentThrowPositionValuesByCondition
}

class EquipmentQuickThrowConfig
{
	bool myAllowQuickThrow TRUE
	string myThrowBoneAlias "ThrowPosition" < tooltip="Bone to use to instantiate the thrown projectile in quickthrow." >
	bool myAimAtFeet TRUE < tooltip="If set to false, will aim at enemies aim point instead." >
	float myRadius 15.0 < min=0 tooltip="If an agent is within this range of the player it might be considered as a valid target for the quick throw." >
	float myMaxSpeed 30.0 < min=0 >
	bool myIncreaseSpeedOverDistance TRUE < tooltip="If ticked, the quick throw speed will be proportional to the distance to target." >
	float myTargetDetectionConeAngle 30.0 < min=0 tooltip="The angle of the cone used to determine if an agent is a valid target for quick throw." >
	float myTargetDetectionAimWeight 1.f < min=0 max=1 tooltip="The weight given to the sight of the camera when determining the best possible candidate for a quick throw, set 0 to only consider distance to target." >
	float myTargetDetectionMaxHeightDifference 10.f < min=0 tooltip="The max height difference between the player and an agent for it to be considered a valid target." >
	float mySwitchTargetHysteresis 0.5f < min=0 tooltip="The time it takes to change to a new quick throw target once one has been selected." >
}


class EquipmentThrowableConfig < uid=auto >
{
	EquipmentThrowActionList myThrowActions < tooltip="To be ordered by ascending max angles." >
	float myDefaultMaxAngle 90.0 < min=-90.0 max=90.0 tooltip="The max allowed angle for the throw if no conditionned data overrides it." >
	float myDefaultMinAngle -90.0 < min=-90.0 max=90.0 tooltip="The min allowed angle for the throw if no conditionned data overrides it." >
	EquipmentQuickThrowConfig myQuickThrowConfig
	file myPressTriggerEffect < bhv="asset" assettype="trigger effect" >
	PlayerRestriction* myEquipmentThrowRestrictions < tooltip="The actions prevented when you perform throw" >
	bool myShowUITrajectoryInADSOnly FALSE
	int myUITrajectoryFilterLastBouncesAmount 0 < min=0 tooltip="This is the number of bounces, starting from last, that will be filtered out of the displayed UI trajectory." >
	float myUITrajectoryFilterMinSubsequentBounceDistance 0.0 < min=0.0 tooltip="Last bounces will be filtered out if their distance from the previous one is lower than this value." >
	bool myEnableCodeDrivenThrowOrigin TRUE < tooltip="If disabled the throw origin will be determined by a bone position provided by animations." hidden=1 >
	string myThrowBoneAlias "ThrowPosition" < tooltip="Bone to use to instantiate the thrown projectile." hidden=1 >
	float myLowObstacleHeightCheck 0.5 < hidden=1 tooltip="Will raycast to find an obstacle from that height. Will consider it's a low obstacle if that raycast finds something and the clearance one doesn't." >
	float myLowObstacleClearanceHeightCheck 1.2 < hidden=1 tooltip="Will raycast to find a clearance from that height. Will consider it's a low obstacle if that raycast finds nothing and the obstacle one does." >
	float myLowObstacleDistanceCheck 1.0 < hidden=1 tooltip="Obstacle detection raycast length." >
	float myDefaultMinCameraPitch < hidden=1 tooltip="The camera pitch matching the top throw position when throwing if no conditionned data overrides it." >
	float myDefaultMaxCameraPitch < hidden=1 tooltip="The camera pitch matching the bottom throw position when throwing if no conditionned data overrides it." >
	string myShoulderBone < tooltip="If the throw origin point is lower than this bone, will trigger a underhand throw anim." hidden=1 >
	float myMiddleThrowXLowerBound < tooltip="If the throw origin point x value is lower than this value, will trigger a left throw anim." hidden=1 >
	float myMiddleThrowXUpperBound < tooltip="If the throw origin point x value is higher than this value, will trigger a right throw anim." hidden=1 >
	float myThrowPositionBlendTime 0.1 < hidden=1 tooltip="Blend time it takes to swith from one throw position preset to another." >
	EquipmentThrowCurvesByConditionsList myEquipmentThrowCurvesByConditions < tooltip="Order matters as first valid item in the list will be selected without checking the next ones. Needs to include one default preset with empty conditons at the end of the list." >
	EquipmentThrowPositionValuesByConditionList myEquipmentThrowPositionValuesByConditions < tooltip="Order matters as first valid item in the list will be selected without checking the next ones. Needs to include one default preset with empty conditons at the end of the list." hidden=1 >
	TimeSequence myUnholsterSequence
}

class ThrowableModule
{
	EquipmentThrowableConfig* myConfig < tooltip="If provided, the equipment will become throwable." >
	Projectile* myProjectile
	StimulusIdentifier* myUsageBark
}