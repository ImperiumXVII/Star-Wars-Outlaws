include "helix/game system data/fruit/attachments/attachments.fruit"

class EquipmentAttachment
{
	AttachmentSlot mySlot None
	bool myMultipleInstances false < tooltip="If true, the slot will check the number of instances and will create multiple visual instances that can be set through the graph object node and will match the number of currency the player has left" >
	int myNumInstances 1 < min=1 tooltip="If >1, the slot will check the number of currency and will create multiple visual instances that can be set through the grpah object" >
}
