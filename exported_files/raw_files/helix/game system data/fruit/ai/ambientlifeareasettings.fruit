include "helix/game system data/fruit/character/charactervisuals.fruit"
include "helix/game system data/fruit/npc/npc.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"

list RequiredRBTagsReferenceList
{
    RBTagsTag* < compact_view=1 bhv=rbtags rbtags_filter="~+Agent ~+Group" >
}

class AmbientSequenceCharacterDistributionElement
{
	float myRatio < min=0 max=1 tooltip="Distribution ratio for current element" >
	CharacterVisualsBase* myCharacterVisuals < tooltip="If empty Base Character visual will be taken" >
	RequiredRBTagsReferenceList myRBTags
}

class AmbientNPCCharacterDistributionElement < uid=auto >
{
	float myRatio < min=0 max=1 tooltip="Distribution ratio for current element" >
	NPC* myNPC < tooltip="If empty Base NPC will be taken" >
	RBTagsTag* myGender < bhv=rbtags rbtags_filter="~+Agent ~+Gender" >
	RBTagsTag* mySpecies < bhv=rbtags rbtags_filter="~+Agent ~+Species" >
	RequiredRBTagsReferenceList myExtraRBTags
}

list AmbientSequenceDistributionElementList < uid=auto >
{
	AmbientSequenceCharacterDistributionElement
}

list AmbientNPCDistributionElementList < uid=auto >
{
	AmbientNPCCharacterDistributionElement
}

class AmbientSequenceCharacterDistribution < uid=auto >
{
	CharacterVisuals* myBaseCharacterVisual
	CharacterVisuals* myAllTargetCharacterVisual < tooltip="It will be the default used CharacterVisual if not set in element. If empty, Base CharacterVisual is used" >
	RequiredRBTagsReferenceList myDefaultRBTags < tooltip="Tags added by default to all" >
	AmbientSequenceDistributionElementList myElements
}

class AmbientNPCCharacterDistribution < uid=auto >
{
	NPC* myBaseNPC
	NPC* myAllTargetNPC < tooltip="It will be the default used NPC if not set in element. If empty, Base NPC is used" >
	RBTagsTag* myDefaultGender < bhv=rbtags rbtags_filter="~+Agent ~+Gender" tooltip="Gender taken if not set in Element" >
	RBTagsTag* myDefaultSpecies < bhv=rbtags rbtags_filter="~+Agent ~+Species" tooltip="Species taken if not set in Element">
	RequiredRBTagsReferenceList myDefaultExtraRBTags < tooltip="Tags added by default to all element Extra Tags" >
	AmbientNPCDistributionElementList myElements
}

class AmbientDistributionOtherLevel < uid=auto >
{
	uid myOtherLevelInfo < bhv="constantData" constantDataType="levelinfo" tooltip="[Optional] Applied to an entire level. Only one per level" >
}

list AmbientSequenceCharacterDistributionList < uid=auto >
{
	AmbientSequenceCharacterDistribution
}

list AmbientNPCCharacterDistributionList < uid=auto >
{
	AmbientNPCCharacterDistribution
}

list AmbientNPCCharacterDistributionLevelList < uid=auto >
{
	AmbientDistributionOtherLevel
}

class AmbientLifeAreaSetting < uid=auto >
{
	uid myLevelInfo < bhv="constantData" constantDataType="levelinfo" tooltip="[Optional] Applied to an entire level. Only one per level" >
	AmbientNPCCharacterDistributionLevelList myOtherLevelTarget
	AmbientSequenceCharacterDistributionList mySequenceDistribution
	AmbientNPCCharacterDistributionList myNPCDistribution
}