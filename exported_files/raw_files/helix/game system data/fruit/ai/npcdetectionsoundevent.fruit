include "helix/game system data/fruit/ai/detection.fruit"

enum NPCSoundEventType
{
	Default  					// Referenced In Code
	Footsteps 					//
	SprintingFootsteps			//
	DodgingFootsteps			//
	JumpingFootsteps			//
	NPCFootsteps				//
	NPCSprintingFootsteps		//
	EnterCombat					//
	PetBlind					//
	PetShove					//
	Takedown    				// 
	FallImpact_Short			//
	FallImpact_High				//
	WeaponTrigger_Default		//
	WeaponTrigger_StunGun		// 
	VehicleMoving				//
	PlayerMelee					// 
	PlayerMeleeHit				//
	PlayerMeleeMiss				//
	ProjectileImpact			//
	WildlifeUnburrow			// Update Code If Changed
	PlayerSliding				//
	PlayerClimbing				//
	FallImpact_Light			//
	FallImpact_Medium			//
	WeaponTrigger_Loud			// 
}

class NPCDetectionSoundEvent < uid=auto >
{
	NPCSoundEventType myNPCSoundEventType Default
	float myHorizontalRadius 0.0 < tooltip ="The horizontal radius of the sound event. Resulting shape is a cylinder." >
	float myHeight 0.0 < tooltip ="The height limit of the sound event. Resulting shape is a cylinder." >
	string myHorizontalRadiusFormula < tooltip="Overrides myHorizontalRadius if set and there is a source agent . Formula resolved with the source agent's attributes" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myHeightFormula < tooltip="Overrides myHeight if set and there is a source agent. Formula resolved with the source agent's attributes" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
}