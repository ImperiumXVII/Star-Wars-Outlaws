class NPCSuppressionProfile < uid=auto >
{
	float myOnShootNearIncrement < tooltip="Amount of suppression added when the player shoot close to the npc." >
	float myOnHitIncrement < tooltip="Amount of suppression added when the player shoot directly to the npc (it's a bonus on top of the OnShootNearIncrement)." >
	float myDecayDelay < tooltip="Time in seconds, since last hit (both direct or near hit), to start the suppression decay." >
	float myDecayRate < tooltip="Amount of suppression removed in one second." >
	float myThreshold < tooltip="Total amount of suppression to reach to set the npc as suppressed." >
	float myDuration < tooltip="Duration of the suppression status." >
	float mySuppressionDetectionRadius < tooltip="SphereCollision radius to detect suppression projectiles." >
}

