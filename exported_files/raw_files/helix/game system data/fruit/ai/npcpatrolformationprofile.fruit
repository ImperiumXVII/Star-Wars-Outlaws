list PatrolPositionsList
{
	vec3f
}

class PatrolFormation
{
	PatrolPositionsList myPatrolPositions < tooltip="Positions are defined in local space relative to a leader." >
}

list PatrolFormationList
{
	PatrolFormation
}

class NPCPatrolFormationProfile < uid=auto >
{
	PatrolFormationList myPatrolFormations
	bool myIgnorePatrolPauseFacing False
	float myMaxRandomPauseDelayInSeconds 0 < min=0 tooltip="Adds a small random pause offset to desynchronize patrols in formation.">
	float myTakedownOpportunityDelayInSeconds 0 < min=0 tooltip="Adds a delay to a paused formation if the player can perform a takedown on one of the npcs.">
}
