include "helix/game system data/fruit/bodypart/bodypart.fruit"
include "helix/game system data/fruit/combat/combat.fruit"
include "helix/game system data/fruit/combat/damageresistance.fruit"
include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/statuseffect/status_effect.fruit"
include "helix/game system data/fruit/equipment/weapon/weapon_module.fruit"

class NPCStatusEffectResistance
{
	StatusEffectType myStatusEffect
	BodyPartType myBodyPart
	bool myIsImmune
	float myTimeMultiplier 1
}

class FactionRelationDamageResistance
{
	FactionRelation myRelation < tooltip="Relation from dealer to victim self" >
	float myMultiplier 1.0 
}

list FactionRelationDamageResistanceList
{
	FactionRelationDamageResistance
}

list NPCDamageResistanceList
{
	DamageResistance
}

list NPCStatusEffctResistanceList
{
	NPCStatusEffectResistance
}

class WeaponModuleAffiliationSpecilization
{
	WeaponModuleFamilyType myWeaponModuleAffiliation Plasma < tooltip="This value is mainly used by UI and represents the type of weapon module that is effective against this class if enabled" >
	BodyPartType myBodyPart
}

list WeaponModuleAffiliationSpecilizationList
{
	WeaponModuleAffiliationSpecilization
}

class NPCWeaponModuleAffiliation
{
	bool myBaseAffiliationEnabled false
	WeaponModuleFamilyType myBaseAffiliation Plasma < tooltip="This value is mainly used by UI and represents the type of weapon module that is effective against this class if enabled" >
	WeaponModuleAffiliationSpecilizationList mySpecializations
}

class NPCResistanceProfile < uid=auto >
{
	string myMaxTagsFromAdrenalineRushFormula 1 < tooltip="when the player use their skill AdrenalineRush, this is the maximum amount of tags that can be used on this NPC. If set to 0, the NPC is an invalid target. " bhv=formulaEditor formulaResolveContextType=Global >
	bool myAdrenalineAllowTagPassengers true < tooltip="if false and the NPC has passengers, these won't be tagged by the adrenaline rush" >
	NPCDamageResistanceList myDamageResistances
	NPCStatusEffctResistanceList myStatusEffectResistanceList
	FactionRelationDamageResistanceList myFactionRelationDamageResistances
	bool myIsReallyStrong false < tooltip="This flag is mainly used for UI purposes, it indicates that an enemy is really strong and the player cannot kill the npc using brute force" >
	NPCWeaponModuleAffiliation myWeaponModuleAffiliation
}