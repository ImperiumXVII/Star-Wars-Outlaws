include "helix/game system data/fruit/ai/aievents.fruit"

class NPCPlayerVehicleSoundEventSettings
{
	float myCooldown 0.0 < min=0 tooltip="Cooldown before event can get emitted again (seconds)" >
	float myVehicleMinSpeed 0.0 < min=0 tooltip="Required speed to trigger a sound detection event. Behavior can act on what it should do with this." >
}

class NPCVehicleNearCollisionEventSettings
{
	float myMinVehicleSpeed 3.0 < min=0 tooltip="Required min vehicle speed to trigger event." >
	float myMaxDistance 5.0 < min=0.5 tooltip="Required max distance between vehicle and npc to trigger event." >
	float myMaxEvadeTime 1.0 < min=0.5 tooltip="Max time before the predicted collision time to trigger the event." >
}

class VehicleMovingSoundEventSettings
{
	float myCooldown 0.1 < min=0 tooltip="Cooldown before event can get emitted again (seconds)" >
	float myVehicleMinSpeed 0.1 < min=0 tooltip="Required speed to trigger a sound detection event. Behavior can act on what it should do with this." >
	float myVelocityOffsetModifier 1.0 < tooltip="This modifier will multiply with velocity and add as a offset of the sound." >
}

class AIEventConfig
{
	AIEvent myEventType NotSet
	bool myRequiresLineOfSight FALSE
	bool myBlockedByConeOfSilenceVolume FALSE < tooltip="If TRUE, the event will fail if the recipient is not in the same cone of silence volume as the event. If neither, the recipient nor the event are in a cone of silence volume, the event will succeed." >
	float myIgnoreLineOfSightRadius 0.0 < tooltip="If the event is closer than this radius we will never do a line of sight check." >
	AIEvent myFallbackEventTypeInCaseOfNoLineOfSight NotSet < tooltip="If set, and the event fails a required line of sight check, we will emit this event instead. We will not do a line of sight check for the fallback event type." >

	bool myMustBeInAlertOrInvestigationVisionCone FALSE < tooltip="If TRUE, the event will fail if it is not inside the Investigation vision cone (Cone in vision profile, peripheral cone non-inclusive)." >
	AIEvent myFallbackEventTypeInCaseOfNotInAlertOrInvestigationVisionCone NotSet < tooltip="If set, and the event fails the in Investigation Vision Cone check, we will emit this event instead. We will not do a in Investigation Vision Cone check for the fallback event type." >
}

list AIEventConfigList
{
	AIEventConfig
}

class NPCAIEventSettings < uid=auto >
{
	NPCPlayerVehicleSoundEventSettings myPlayerVehicleSoundEventSettings
	NPCVehicleNearCollisionEventSettings myVehicleNearCollisionSettings
	VehicleMovingSoundEventSettings myVehicleMovingSoundEventSettings
	AIEventConfigList myAIEventConfigs
}

