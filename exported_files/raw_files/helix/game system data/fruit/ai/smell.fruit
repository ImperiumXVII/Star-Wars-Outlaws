include "helix/game system data/fruit/ai/alertlevel.fruit"

class SmellCylinderList
{
	float mySmellRadius 0.0
	float mySmellHeight 0.0
	float myImmediateSmellRadius 0.0
	float myImmediateSmellHeight 0.0
}

class NPCSmellProfile < uid=auto >
{
	bool myAllowNPCOnVehicle false
	bool myOnlyAllowSpaceship false
	bool myOnlyAllowAgentInTetherVolume false
	NPCAlertLevel myMaxAlertLevel AWARE
	SmellCylinderList myDefaultSmellCylinders
	SmellCylinderList myPlayerStealthSmellCylinders
}
