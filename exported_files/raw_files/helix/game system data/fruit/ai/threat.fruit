include "helix/game system data/fruit/faction/faction.fruit"

class BaseThreatPerFaction
{
	Faction* myFaction
	float myBaseThreat 0.0 < tooltip="Base Threat for the given faction" >
}

list BaseThreatPerFactionList
{
	BaseThreatPerFaction
}

class NPCThreatProfile < uid=auto >
{
	bool myAllowNeutralAndSuspiciousThreat false < tooltip="We will always track Hostile agent and never track Friendly agent as threats.\nFor Neutral and Suspicious agent, use this flag to decide whether to track them" >
	bool myAllowNPCOnVehicleThreat true < tooltip="Some NPCs need to ignore hositle NPCs on vehicle" >
	bool myAllowAgentOutsideTetherVolume true < tooltip="Some agents need to ignore agents outside the tether volume" >

	float myCurrentTargetThreatMultiplier 1.5 < tooltip="If the agent is the current target, multiply its current threat by this value. This prevent the npc from switching target too much" >
	float myUnreachableTargetThreatMultiplier 1.0 < tooltip="If the agent is not reachable, multiply its current threat by this value. This prevent the npc from sticking to an agent that it can't reach" >

	float myMaxBaseThreat 0.0 < tooltip="Max amount of Base Threat a potential target can have" >

	float myHostileRelationBaseThreat 0.0 < tooltip="Threat added if agent is hostile" >
	float myOwnerHostileTargetBaseThreat 0.0 < tooltip="Threat added if agent is hostile to the npc owner" >

	float myPlayerFactionBaseThreat 0.0 < tooltip="Threat added if agent is a player" >
	float myNPCFactionBaseThreat 0.0 < tooltip="Threat added if agent is a npc" >

	BaseThreatPerFactionList myBaseThreatPerFactionList < tooltip="Threat added per faction list" >
	
	float myPlayerPetBaseThreat 0.0 < tooltip="Threat added if agent is the player pet" >
	float myPlayerOnVehicleBaseThreat 0.0 < tooltip="Threat added if agent is a player and is on a vehicle" >
	float myVehicleBaseThreat 0.0 < tooltip="Threat added if agent is a vehicle" >

	float myIsVisibleBaseThreat 0.0 < tooltip="Threat added if agent is visible" >

	float myMeleeRange 0.0 < tooltip="Distance max to be in Melee Range" >
	float myCloseRange 0.0 < tooltip="Distance max to be in Close Range, has to be >= to Melee Range" >
	float myMediumRange 0.0 < tooltip="Distance max to be in Medium Range, has to be >= to Close Range" >
	float myLongRange 0.0 < tooltip="Distance Max to be in Long Range, has to be >= to Medium Range" >
	float myMeleeRangeBaseThreat 0.0 < tooltip="Threat Added if agent is closer than Melee Range" >
	float myCloseRangeBaseThreat 0.0 < tooltip="Threat Added if agent is between Melee and Close Range" >
	float myMediumRangeBaseThreat 0.0 < tooltip="Threat Added if agent is between Close and Medium Range" >
	float myLongRangeBaseThreat 0.0 < tooltip="Threat Added if agent is between Medium and Long Range" >

	float myMaxActionThreat 0.0 < tooltip="Max amount of Action Threat a potential target can have" >

	float myActionThreatDecayDelay 0.0 < tooltip="Time in seconds before the Action Threat value start decreasing, reset when there's something adding value to the Action Threat Score" >
	float myActionThreatDecayRate 0.0 < tooltip="Speed at which the Action Threat value will decrease when the DecayDelay is passed" >
	float myActionThreatNoLOSDecayDelay 0.0 < tooltip="Time in seconds before the Action Threat value start decreasing if the agent is not visible, reset when there's something adding value to the Action Threat Score" >
	float myActionThreatNoLOSDecayRate 0.0 < tooltip="Speed at which the Action Threat value will decrease if the agent is not visible when the DecayDelay is passed" >
	float myBaseThreatPlayerReviveReduction 0.0 
	float myBaseThreatPlayerLowHealthReduction 0.0
	float myBaseThreatOutOfPackCombatRadiusReduction 0.0

	float myProjectileActionThreat 0.0 < tooltip="Value added when a projectile from a threat hit the npc, it's fixed, not linked to the amount of damage done" >

	float myHealthPercentDamageActionThreat 0.0 < tooltip="Value added when the npc lose 1% of health from another agent. eg. a damage removing 15% of health will add 15 times the Threat value" >
	float myHealthAllyPercentDamageActionThreat 0.0 < tooltip="Value added when an ally of the npc lose 1% of health by another agent. eg. a damage removing 15% of health will add 15 times the Threat value" >
	float myAllyKilledActionThreat 0.0 < tooltip="Not implemented" >
	float myAllyActionThreatConsiderationRadius 0.0 < tooltip="Radius around the agent to detect ally damage" >
	
	float myMaxObjectiveThreat 0.0 < tooltip="Max amount of Objective Threat a potential target can have" >
	
	float myObjectiveThreatPlayerNearHeistTarget 0.0 < tooltip="Not implemented" >
	float myObjectiveThreatPlayerCarriesHeistTarget 0.0 < tooltip="Not implemented" >
}
