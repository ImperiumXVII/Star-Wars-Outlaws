enum SmartDriveModelVersion
{
	V0
	V1
}

class GroundVehicleAIMovementProfile < uid=auto >
{
	bool myUseWideLanes TRUE < tooltip="When enabled a wider path is used, i.e it allows more space on the path to move on." >
	
	string myMaxSpeedAtDirectionAngleError < bhv=inputgraph tooltip="PID data - When at a certain direction angle error, this value decides what the maximum speed should be. Higher value means more aggressive driving" >
	string myMaxSpeedAtPredictedDistanceFromPathError < bhv=inputgraph tooltip="PID data - When at a certain predicted distance away from the path, this value decides what the maximum speed should be. Higher value means more aggressive driving" >
	
	string myDesiredTurningAtDirectionAngleError < bhv=inputgraph tooltip="PID data - 90degrees = max turn. When at a certain direction angle error, this value decides how much to turn to align with the path direction. Higher value means more more erratic driving" >
	string myDesiredTurningAtPredictedDistanceFromPathError < bhv=inputgraph tooltip="PID data - 90degrees = max turn. When at a certain predicted distance away from the path, this value decides how much to turn to minimize the distance from the path. Higher value means more erratic driving" >

	string myFinalStopSpeedLimit < bhv=inputgraph tooltip="What the target speed should be, i.e. when to start braking when nearing the end of the path. x = distance left on path, y = speed limit." >

	file mySmartDriveModelPath < tooltip="SmartDrive data" >
	SmartDriveModelVersion mySmartDriveModelVersion V0 < tooltip="Use new SmartDrive model" >
}