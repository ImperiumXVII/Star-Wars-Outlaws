
class NPCTacticalPositionSettings < uid=auto >
{
	float myLowPositionDensity 0.25
	float myHighPositionDensity 4.0

	float myMinLowCoverHeight 0.89
	float myMaxLowCoverHeight 1.21
	float myMinHighCoverHeight 1.8

	float myCoverSlotDistanceFromCoverEdge 0.5
	float myMaxDistanceBetweenCoverSlots 1.5
	float myCoverSlotDistanceFromProp 0.6
	
	float myDefaultSplinePositionInterval 3.0 < tooltip="Interval is defined in meters so a position generated for every x meter on spline" >
	float myLowSplinePositionInterval 6.0 < tooltip="Interval is defined in meters so a position generated for every x meter on spline" >
	float myHighSplinePositionInterval 1.5 < tooltip="Interval is defined in meters so a position generated for every x meter on spline" >

	int myExtraCoverToTest 5 < min=0 tooltip="Number of extra cover tactical positions that can be tested during a cover only search." >
}