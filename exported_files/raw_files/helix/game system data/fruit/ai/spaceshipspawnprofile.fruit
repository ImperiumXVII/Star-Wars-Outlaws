include "helix/game system data/fruit/settings/spaceshipenums.fruit"

class SpaceshipSpawnProfile < uid=auto >
{
	string myHyperjumpEntry "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.15230207 172.86081, }, outTangents = { 0.067695215 -350, 0 -0, }, properties = { 275, 1299, }, values = { 0 1000, 0.40000001 0, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Distance" >
	string myHyperjumpExit "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.075593978 -331.27466, }, outTangents = { 0.1960668 196.50592, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 0.40000001 1000, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Distance" >

	float myHyperjumpExitDelay 0 < tooltip="Delay added before doing the actual hyperjump, used for the 'charging' effect feedback">
	
	float mySpawnRadius 30

	float mySpawnDelayMin 0.1
	float mySpawnDelayMax 0.2

	bool myAllowsInstantAccelerationAfterSpawn true
}
