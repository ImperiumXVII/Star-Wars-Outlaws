include "helix/game system data/fruit/ai/capinteraction.fruit"
include "helix/game system data/fruit/ai/capbiomedata.fruit"

enum CAPSpawnPosNavAreaType
{
    Land
    ShallowWater
    DeepWater
    LandAndShallowWater
    ShallowAndDeepWater
    All
}

enum CAPSpawnPositionType
{
	AroundSelf
	AroundOwner	
}

enum DynamicCAPSpawnDataSetType
{
	Default
	Follow
	PostPetting
	Guard
}

class DynamicCAPSpawnParameter
{
	CAPSpawnPositionType myPositionType AroundSelf
	float myMinDistanceToAgent 0.0 < min=0 >
	float myMaxDistanceToAgent 0.0 < min=0 >
	float myMinSpawnAngle 0.0 < min=0 max=360 >
	float myMaxSpawnAngle 360 < min=0 max=360 >
	float myClearanceRadius 0.0 < min=0 tooltip="CAP will be spawned without other CAPs around this radius." >
	float myMaxSlopeAngle -1.0 < max = 90 tooltip="CAP will be spawned within this slope angle. -1 means no slope limitations." >
	CAPSpawnPosNavAreaType mySpawningPosNavArea Land
	float myMinCooldown 0.0 < min=0 tooltip="Minimum seconds to cool down after selection, <= 0 means no cool down">
	float myMaxCooldown 0.0 < min=0 tooltip="Maximum seconds to cool down after selection, <= 0 means no cool down">
	float myWeight 0.0 < min=0 >
	BiomeCollisionList* myBiomeCollisionList
	bool myIsSyncCAP false
	float myMoveRange 0.0 < min=0 >
	bool myDisableNavMeshValidation false
}

class DynamicCAPSpawnData
{
	CAPInteraction* myCAPInteractionConstantData
	DynamicCAPSpawnParameter mySpawnParameters
}

list DynamicCAPSpawnDataList
{
	DynamicCAPSpawnData
}

class DynamicCAPSpawnDataSet
{
	DynamicCAPSpawnDataList myDynamicCAPSpawnDataList
	DynamicCAPSpawnDataSetType myDynamicCAPSpawnDataSetType
	bool myPreferOnSpotCAPAfterFirstFailure
}

list DynamicCAPSpawnDataSetList
{
	DynamicCAPSpawnDataSet
}

class NPCDynamicCAPInteractionProfile < uid=auto >
{
	DynamicCAPSpawnDataSetList myDynamicCAPSpawnData
}