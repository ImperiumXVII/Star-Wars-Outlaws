class SpaceshipTranslationSettings
{
	float myLateralSpeed 0
	float myVerticalSpeed 0
	float myLateralAcceleration 0
	float myVerticalAcceleration 0
}

class SpaceshipBehaviorParameter
{
	SpaceshipBehaviorParameterType myType None
	float myValue 0
}

list SpaceshipBehaviorParameterList
{
	SpaceshipBehaviorParameter
}

class AiEvasiveManeuverParams
{
	float myEvasiveCooldown 5.0; < tooltip="Cooldown before AI can start another evasive maneuver" >
	float myMaxTimeBetweenProjectileHits 5.0; < tooltip="Maximum time difference between hits" >
	float mySustainedDamageRequiredDuration 5.0; < tooltip="Required time to take damage in order to allow maneuver" >
	float myReturnTrueDuration 2.0;
}

list SpaceshipRestrictionVolumeTypes
{
	SpaceshipRestrictionVolumeType
}

class AISpaceshipControlParameters
{
	SpaceshipAvoidanceProfile* myAvoidanceProfile
	SpaceshipCombatProfile* myCombatProfile
	SpaceshipCombatRoleType myCombatRoleType Default
	
	SpaceshipBehaviorParameterList mySpaceshipBehaviorParameters
	
	float myNavigationPredictionTime 0 < tooltip="Optional, if 0 it will be estimated from the velocities and accelerations, but for slower ships it tends to be underestimated." >

	float myAngularThresholdToTargetMin 0
	float myAngularThresholdToTargetMax 1
	float myLateralAttractorThresholdDistance 10
	float myLateralAttractorInput 0

	float mySplineLookAheadMinimum 100
	float mySplineLookAheadMaximum 200
	float mySplineLookAheadSpeedRatio 1.3
	float mySplineLookAheadDistanceRatio 1.0

	float myStaticCollisionInputInfluenceMin 0.2
	float myDynamicCollisionInfluenceSpeedDeltaLow 10
	float myDynamicCollisionInfluenceSpeedDeltaHigh 30
	float myDynamicCollisionInfluenceBySpeedDeltaMin 0.2

	float myFormationMaxDistance 100.0
	float myFormationDistanceThreshold 20.0
	float myFormationMaxSpeedMultiplier 1.2
	float myFormationMinSpeedMultiplier 0.8

	float myAIHorizonMaxHeight 200 < tooltip="Max altitude relative to the enemy" >
	float myAIHorizonMaxHeightLocal 200 < tooltip="Max height relative to the enemy (in the enemy's space)" >
	
	AiEvasiveManeuverParams myEvasiveManeuverParams
	
	SpaceshipRestrictionVolumeTypes myRestrictionVolumeTypeExceptions
}

class SpaceshipDimensionsParams
{
	float myLength 0
	float myWidth 0
	float myHeight 0
}

class PhysicsParams
{
	float myMinLinearEnginePower 0.1
	float myMaxLinearEnginePower 10.0
	float myLinearEnginePowerRecoverySpeed 3.0
	float myMinAngularEnginePower 1.0
	float myMaxAngularEnginePower 1000.0
	float myAngularEnginePowerRecoverySpeed 600.0
	float myWeakCollisionImpulseThreshold 5.0 < tooltip="Impulse threshold so that an impact event will be triggered for the collided object, but with no effects on the ship other than the physics driven ones" >
	float myCollisionImpulseThreshold 40.0 < tooltip="Impulse threshold from where the spaceship also gets damaged and for the player spaceship camera and rumble effects are triggered" >
	float myCollisionDamageToBreakablesMultiplier 10.0
	float myCollisionDamageMultiplier 1.0
	float myCollisionDamageFromSameEntityCooldown 0.5 < tooltip="Time until we can receive collision damage again from the same entity" >
	float myWeakCollisionCooldown 0.2 < tooltip="Time until we can send a weak collision impact event again(to not spam VFXs from impact realization)" >
}

// Must match enum HC_SpaceshipTumblingType in code/helix/HClient/HC_SpaceshipSettings.h
enum SpaceshipTumblingType
{
	LoseControl
	Plunge
	None
}

class CollisionEffectSettings
{
	float myEngineDisableDuration 0.5 < tooltip="Duration of the stun/disable caused by the bump collision effect" >
	float myMinimumRelativeSpeedForEffect 30.0 < tooltip="The minimum relative speed for applying the archetype-specific collision effect" >
}

class DeathSequenceSettings
{
	file myEndExplosionFilename "" < bhv=asset assettype=particles >
	file myOnExplosionGameScript "" < tooltip="GameScript(KillScript) to run when the spaceship agent explodes and despawns." bhv=asset assettype="Game Script/KillScript" >
	file myOnExplosionWreckGraphObjectPath "" < bhv=asset assettype=object tooltip="Graph Object of the wreck to spawn when the spaceship agent despawns.">
	float myCollisionDamageThreshold 10.0
	float myDeathSequenceDuration 3
	float myAfterDeathSequenceDelay 3
	bool myShouldTumble false < tooltip="Used for activating the death sequence maneuver" >
	float myTumbleProbability 0.5 < min = 0, max = 1 >
	float myTumbleMaxDuration 5
	SpaceshipTumblingType myTumblingType LoseControl < tooltip="Type of tumbling behavior" >
	bool myShouldTargetColliders true < tooltip="Used in the 'LoseControl' behavior. If checked, the spaceship will go towards and hit objects with colliders that it finds in the cone described by the radius and angle below" >
	float myTumbleFindTargetMinimumDistance 0
	float myTumbleFindTargetRadius 1500
	float myTumbleFindTargetAngle 45
	string myTumbleFallingCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -500 0, }, outTangents = { 500 0, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 2000 -2000, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Used for the 'Plunge' behavior. Describes the falling trajectory of the spaceship. Horizontal axis is the distance it goes forward and vertical represents how much it falls" >
	bool myDespawnAttachmentsOnExplosion true < tooltip="If true, attached agents will despawn on the 'Explosion' state of the host spaceship( this is the state where we usually disable the visual of the spaceship to make room for the spawned explosion and debris). Otherwise, they will dispawn along with the host." >
}

class DamagedEnginesModifiers
{
	float mySpeedModifier 0.5 < min = 0, max = 1 >
	float mySteeringModifier 0.5 < min = 0, max = 1 >
}

list EnergyShieldDataList < size=1 >
{
	EnergyShieldData
}

class SpaceshipSpecificFleeSettings
{
	bool myIsTooBigToFlee false
	float myTimeToChargeHyperdrive 10
}

class EngineDischargeSettings
{
	float myDamage 10.0 < tooltip="Damage to be done to ships in the engine discharge area" >
	float myDamageTickTime 1.0 < tooltip="Period of time between two damage ticks" >
}

class SpaceshipSetting < uid=auto >
{
	SpaceshipType mySpaceshipType Default
	SpaceshipUsage mySpaceshipUsage Default
	SpaceshipArchetype mySpaceshipArchetype Default

	ImpactRealization* myPassThroughImpact

	float myMaximumSpeed 65
	float myMinimumSpeed 60
	float myPitchSpeed 90
	float myYawSpeed 90
	float myRollSpeed 360
	float myAcceleration 300
	float myPitchAcceleration 90
	float myYawAcceleration 90
	float myRollAcceleration 360
	float myMaximumPitchUp 90
	float myMaximumPitchDown 90
	float myMass 1
	float myDrag 1

	float mySpawnRadius 10 < tooltip="Used for searching a free volume when spawning" >

	float myMinDistanceToTarget 5

	float myMovementControlRollAngle 45
	float myMovementControlRollMix 5
	float myMovementControlRollStrength 0.3

	float myFormationDistanceScale 10

	float myHuntingRadius 5000.0

	SpaceshipTranslationSettings myTranslationSettings

	AISpaceshipControlParameters myAISpaceshipControlParameters

	SpaceshipRubberbandProfile* myRubberbandProfile
	SpaceshipSpawnProfile* mySpawnProfile
	SpaceshipSpeedProfile* mySpeedProfile

	SpaceshipTrajectoryProfile* myTrajectoryProfile

	IonChargeCollectorData myIonCollectorData
	EnergyShieldDataList myShieldData

	SpaceshipDimensionsParams myDimensions
	PhysicsParams myPhysicsParams

	SpaceshipSpecificFleeSettings mySpaceshipSpecificFleeSettings

	NPCShootPattern* myShootPatternAccurate
	NPCShootPattern* myShootPatternInaccurate

	NPCTicketType myShootTicketAccurate
	NPCTicketType myShootTicketInaccurate
	
	bool myHasInterdictorEffect

	DeathSequenceSettings myDeathSequenceSettings
	
	CollisionEffectSettings myCollisionEffectSettings
	
	DamagedEnginesModifiers myDamagedEnginesModifiers
	
	SpaceshipFormationProfile* mySpaceshipFormationProfile
	
	UISpaceshipParameters myUISpaceshipParameters

	EngineDischargeSettings myEngineDischargeSettings
}

list SpaceshipSettingsList
{
	SpaceshipSetting
}

class SpaceshipSettingsListClass < uid=auto >
{
	SpaceshipSettingsList mySpaceshipSettings
}