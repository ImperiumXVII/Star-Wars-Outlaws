class NPCAimProfile < uid=auto >
{
	float myMinDistanceForBlockingOffset 7.0 < tooltip="If the target is closer than this distance, no penalties will be applied" >

	vec2f myMaxAngleToForward 180.0;180.0 < tooltip="The max deviation angle (x=yaw and y=pitch) from the forward vector, in degrees" >
	
	float myMaxRotationalVelocity 20.0 < tooltip="The max rotation speed in degrees per second" >
	float myRotationalAcceleration 40.0 < tooltip="The max rotational acceleration in degrees per second squared. \nHigh value needed to be sure the aim position follow correctly a too close target" >
	bool myUseRotationalAccelerationDistanceToTargetMultiper FALSE < tooltip="If TRUE the max rotational acceleration will be multiplied by the value get from the curve myRotationalAccelerationDistanceToTargetMultiper." >
	string myRotationalAccelerationDistanceToTargetMultiper "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -1 0, }, outTangents = { 1 0, 0 -0, }, properties = { 2051, 3347, }, values = { 0 1, 5 0, }, }, numKeys = 2, }" < tooltip="Rotational Acceleration mulitplier based on the distance to target. \nUsed only if myUseRotationalAccelerationDistanceToTargetMultiper is set to TRUE." bhv=inputgraph >
	
	float myMinAccuracy 0.0 < tooltip="Min Accuracy Points absolute min 0" >
	float myMaxAccuracy 100.0 < tooltip="Max Accuracy Points absolute max 100" >
	float myAccuracyRadius 1.0 < tooltip="Radius of the aim circle from the target at 0 accuracy" >
	float myAnimAccuracyRadiusMultiplier 0.0 < min=0 max=1 tooltip="Multiplier applied on the aim circle radius from the target at 0 accuracy used for anim aim direction/position" >
	float myLOSAccuracyIncreasePerSecond 4.0 < tooltip="Increases accuracy every second if has the NPC has LOS to target" >
	float myLOSAccuracyIncreaseLimit 100.0 < tooltip="This is the max cap for myLOSAccuracyIncreasePerSecond to reach" >
	float myNoLOSAccuracyDecreasePerSecond 5.0 < tooltip="How many points the npc loses every second if he doesn't have LOS to the target" >
	float myNoLOSAccuracyDecreaseLimit -100.0 < tooltip="This is the max cap for myNoLOSAccuracyDecreasePerSecond to reach" >
	float myRangeAccuracyBonus 30.0 < tooltip="Additional accuracy when inside the RangeAccuracyBonusStartingRange" >
	float myRangeAccuracyBonusStartingRange 40.0 < tooltip="If the target is inside this range the npc gains points" >
	float myTargetEvadingAccuracyPenalty 0.0 < tooltip="(Space) Penalty added when the target is doing evasive maneuvers" >
	float myTargetRollEvadingAccuracyPenalty 0.0 < tooltip="(Space) Penalty added when the target is doing a sideway roll maneuver" >
	float myTargetManeuverAccuracyPenalty 0.0 < tooltip="(Space) Penalty added when the target is doing a 180 or 360 maneuver" >
	float myTargetBoostAccuracyPenalty 0.0 < tooltip="Penalty added when the target is boosting" >
	float myMinDistanceForPenalty 50.0 < tooltip="Minimum distance for adding the MaxDistanceAccuracyPenalty" >
	float myMaxDistanceForPenalty 150.0 < tooltip="Maximum distance for adding the MaxDistanceAccuracyPenalty" >
	float myMaxDistanceAccuracyPenalty 0.0 < tooltip="Maximum value for the distance based penalty" >
	float mySpeedThresholdForAccuracyIncrease 0.0 < tooltip="When the target slows down below this value we start increasing the accuracy" >
	float mySpeedAccuracyIncreasePerSecond 0.0 < tooltip="Accuracy increase per second when target slows down below SpeedThresholdForAccuracyIncrease" >
	float mySpeedAccuracyIncreaseLimit 0.0 < tooltip="Maximum accuracy increase when target slows down below SpeedThresholdForAccuracyIncrease" >
	float myStartShootingPenalty 50.0 < tooltip="Minus points when the NPC starts aiming." >
	float myStartShootingPenaltyDuration 1.5 < tooltip="How long the penalty lasts in seconds(decreases over time). Used only in cover." >
	float myTargetDamagePenalty 20.0 < tooltip="Minus points when the NPC hits its target" >
	float myTargetDamagePenaltyDuration 1.0 < tooltip="How long the penalty lasts in seconds(decreases over time)." >
	
	float myAimPointRotationSpeed 30 < tooltip="The speed of the rotation in degrees per second" >
	float myAimPointAngleLimit 120 < tooltip="How much the aim point deviates left and right from the up direction in degrees" >
	float myAimPointRotationTimeMin 1.0 < tooltip="Random between min and max. When to change rotation direction" >
	float myAimPointRotationTimeMax 7.0 < tooltip="Random between min and max. When to change rotation direction" >
	float myAimingWhilePlayerManeuverTime 1.0 < tooltip = "Time for which the spaceships keeps firing at a dodging player" >
	float myShotMaxAngleLimit 180 < tooltip="How much the shoot direction can deviates from the muzzle direction in degrees before been an aimless shoot" >
	float myShotForbiddenAngleLimit 180 < tooltip="How much the shoot direction can deviates from the muzzle direction in degrees before been forbidden" >

	bool myPredictMovement false < tooltip="The npc will aim abit ahead of the enemy" >
	bool myResetAccuracyOnTargetHit false < tooltip="Reset current accuracy for npc when hitting the target" >
}
