include "helix/game system data/fruit/ai/motion/motionpatternprofile.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"

enum CAPPriorityType
{
	VeryLow
	Low
	Medium
	High
	VeryHigh
}

list RBTagsReferenceListProp
{
    RBTagsTag* < compact_view=1 bhv=rbtags rbtags_filter="~+Prop" >
}

list RBTagsReferenceListAgent
{
    RBTagsTag* < compact_view=1 bhv=rbtags rbtags_filter="~+Agent ~+Group" >
}

list RBTagsRuleAgentGroupList
{
    RBTagsReferenceListAgent < horizontal_view=1 >
}

class CAPInteraction < uid=auto >
{
	file mySequence "" < bhv=asset assettype=sequence >
	file myCAPScript ""  < bhv=asset assettype=script >

	CAPPriorityType myPriority Low
	bool myNeedSnapToCapPosition TRUE < tooltip="Use interaction point position as CAP entry position" >
	bool myNeedOrientTowardCAPDirection TRUE < tooltip="Use interaction point direction as CAP entry direction" >
	bool mySnapToCAPDirection TRUE < tooltip="Will valid if myNeedOrientTowardCAPDirection is TRUE. If true, motion plan will turn the agent to the CAP direction with no animation. If false, system won't turn the agent and user can handle direction by manully." >
	NPCMotionPatternType myMotionPatternType Jog
	float myMaxApproachDuration 0.0 < min=0 tooltip="the max duration to move to the cap. If the value is zero, there will be no time limit." >
	float myMaxOutOfNavMeshNavigationDistance 0.0 < min=0 tooltip="the maximum allowed distance to navmesh to reach and play the cap. If the value is zero, out of navmesh navigation will be disabled" >

	RBTagsTag* myPurposeTag < rbtags_no_negative=1 bhv=rbtags rbtags_filter="~+Purpose" >
	RBTagsTag* myMetricTag < rbtags_no_negative=1 bhv=rbtags rbtags_filter="~+Metric" >
	
	RBTagsReferenceListProp myPropRequirements < bhv=interactionEditor >
    RBTagsRuleAgentGroupList myAgentRequirementsPerSlot < bhv=interactionEditor >

	bool myIgnoreNavMeshValidation FALSE < tooltip="Makes CAP Validation doesn't expect NPC to be on navmesh at all. Used for secondary wildlife, where NPCs are only controlled by sequence, never by locomotion on navmesh" >

	bool myIsExclusive TRUE < tooltip="Exclusive NPC Interactions, when played on Interaction Points from Props, makes all others interactions points from this Prop locked too (the interaction is considered occupying the whole space)" >
	bool myIgnoreCooldown false
	bool myCanUpdateBT	TRUE < tooltip="Keep update BT during CAP interaction" >	
	bool myCanUpdateGroundAligner FALSE
	float myAgentInteractionPointCooldown -1 < tooltip="Cooldown of interaction point only on current agent\n\nUnit in Seconds, -1 to unset\nGiven agent A1, A2, A3, Interaction type T1, T2, T3, Interaction point P1, P2, P3\nIf Agent A1 plays interaction type T1 on interaction point P1\nThe Agent A1 starts cooldown on interaciton point P1\n\nAgent A1 CANNOT play any interaction type on interaction point P1 again during the AgentInteractionPointCooldown\nAgent A1 can still play any interaction type on interaction point P2, P3 since no prior interactions played\n\nAgent A2, A3 can play any interaction type on interaction point P1, P2, P3 since no prior interactions played" >
	float myInteractionPointCooldown -1 < tooltip="Cooldown of interaction point\n\nUnit in Seconds, -1 to unset\nGiven agent A1, A2, A3, Interaction type T1, T2, T3, Interaction point P1, P2, P3\nIf Agent A1 plays interaction type T1 on interaction point P1\nThe interaction point P1 starts cooldown\n\nAgent A1 CANNOT play any interaction type on interaction point P1 again during the InteractionPointCooldown\n\nAgent A2, A3 CANNOT play any interaction type on the interaction point P1 since P1 is in InteractionPointCooldown\n\nAgent A1, A2, A3 can still play any interaction type on interaction point P2, P3 since no prior interactions played" >
	float myNPCInteractionCooldown -1 < tooltip="Cooldown of interaction type\n\nUnit in Seconds -1 to unset\nGiven agent A1, A2, A3, Interaction type T1, T2, T3, Interaction point P1, P2, P3\nIf Agent A1 plays interaction type T1 on interaction point P1\nThe interaction type T1 starts cooldown\n\nAgent A1 CANNOT play interaction type T1 on any interaction point again during the NPCInteractionCooldown\nAgetn A1 can still play interaction type T2, T3 on any interaction point since no prior interactions played\n\nAgent A2, A3 CANNOT play interaction type T1 on any interaction point during the NPCInteractionCooldown\nAgent A2, A3 can still play interaction type T2, T3 on any interaction point since no prior interactions played" >
	float myAgentNPCInteractionCooldown -1 < tooltip="Cooldown of interaction type only on current agent\n\nUnit in Seconds, -1 to unset\nGiven agent A1, A2, A3, Interaction type T1, T2, T3, Interaction point P1, P2, P3\nIf Agent A1 plays interaction type T1 on interaction point P1\nThe Agent A1 starts cooldown on interaction type T1\n\nAgent A1 CANNOT play interaction type T1 on any interaction point again during the AgentNPCInteractionCooldown\nAgent A1 can still play interaction type T2, T3 on any interaction point since no prior interactions played\n\nAgent A2, A3 can still play interaction type T1, T2, T3 on any interaction point since no prior interactions played" >
	float myPreferedDuration -1 < tooltip="Unit in Seconds, -1 to unset" >
}