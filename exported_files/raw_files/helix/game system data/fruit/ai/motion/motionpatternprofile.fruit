include "helix/game system data/fruit/ai/motion/motionpattern.fruit"

//Every new motion pattern type should also be added as a member of the motion pattern profile
enum NPCMotionPatternType
{
	Jog 
	NoFocusJog
	Sprint
	Walk
	NoFocusWalk
	Strafe
	Patrol
	NoFocusPatrol
	Investigate
	NoFocusInvestigate
	Run
	NoFocusRun
	FleeSpeedBoost
	Travel
}

class NPCMotionPatternProfile < uid=auto >
{
	NPCMotionPattern* myDefaultWalkMotionPattern
	NPCMotionPattern* myDefaultInvestigateMotionPattern
	NPCMotionPattern* myDefaultCombatMotionPattern
	
	//these need to match the naming convention my[MotionPatternType]MotionPattern
	NPCMotionPattern* myJogMotionPattern
	NPCMotionPattern* myNoFocusJogMotionPattern
	NPCMotionPattern* mySprintMotionPattern
	NPCMotionPattern* myWalkMotionPattern
	NPCMotionPattern* myNoFocusWalkMotionPattern
	NPCMotionPattern* myStrafeMotionPattern
	NPCMotionPattern* myPatrolMotionPattern
	NPCMotionPattern* myNoFocusPatrolMotionPattern
	NPCMotionPattern* myInvestigateMotionPattern
	NPCMotionPattern* myNoFocusInvestigateMotionPattern
	NPCMotionPattern* myRunMotionPattern
	NPCMotionPattern* myNoFocusRunMotionPattern
	NPCMotionPattern* myFleeSpeedBoostMotionPattern
	NPCMotionPattern* myTravelMotionPattern
}

// NB: In the case of a motion pattern type change, please also update the following definitions:
// NPCFleeLookAtEnabledMotionPatternTypes @ npcfleeprofile.fruit