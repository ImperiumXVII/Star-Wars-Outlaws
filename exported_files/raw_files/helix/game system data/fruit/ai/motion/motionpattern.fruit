include "helix/game system data/fruit/ai/motion/motionenums.fruit"

class NPCMotionPattern < uid=auto >
{
	NPCMovementStyleType myMovementStyle Casual
	float myCruiseSpeed 1.0
	float myMaxCruiseSpeedAdjustment 1.0 < tooltip="Defines how much cruise speed can be increased or decreased (in meters per second) to reach other agents in a formation." >
	float myMaxAcceleration 1.0
	float myTurnRate 360.0

	float myMaxStartDistance 5.0 < tooltip="Defines maximum distance for the start animations, huge distances will have a slight impact on performance." >
	float myMaxStopDistance 5.0 < tooltip="Defines maximum distance for the stop animations, huge distances will have a slight impact on performance." >
	
	float myDesiredTurnRadius 0.6f
	float myTurnSmootherNavMeshExpand -0.5f < tooltip="How far the smoothed arc-turn could go out of navmesh. A negative value will try limiting the arc inside the navmesh. A positive value will allow the arc going out of the navmesh" >
	float myTurnSmootherArcLength 0.5f
	float myTurnSmootherFixed 0.25f
	
	bool myDisableSlowDownUponArrival false < tooltip="Define whether the movement should try to stop directly from the cruise speed(an abrupt stop)" >
	bool myWaitForAnimStateTransitions true < tooltip="Define whether movement can be started during animation state transitions (blend time on animations)" >
	
	float myPathMergeLookAheadDistance 2.0f < tooltip="A point at this distance of agent's current direction will be used to start a new path if the agent is currently moving" >
	float myPathMergeMaxDistanceBasedTurnSpeed 0 < tooltip="When using an arc-turn on path merging, the maximal turning angle per meter(moving distance) allowed. It's actually the curvature of this arc. Any sharper turn than this value will trigger a stop-restart path merge. Set to 0 to use an automatically calculated value. " >
	float myPathMergeStopDistanceToReserve 1.0f < tooltip="On the merged path, the distance to reserve for the stop animation.Ideally this value should be the distance of the shortest none-zero-length stop animation." >
	bool myRespectStartDirectionOnStopAndStart false < tooltip="If true, when playing a stop&start during moving, the agent will first stop at the start direction,and then make a straight forward start. Otherwise there will be a stop at current direction,followed by a turning start" >
	
	bool myCanStrafe false
	bool myPrioritizeFocusOnPath false < tooltip="If true, the npc will prefer to look in the direction of movement instead of the hostile target" >
	float myPathFocusLookAheadTime 1.0f < min=0 tooltip="Look ahead time that will be used to predict the path focus position, in seconds. Specify zero to completely disable the path focus for this motion pattern.">
	bool myCanPerformStaticTurn true
	bool myDisableStopAndStarts false < tooltip="Disable Stop-and-Starts during path merging. Regular Starts and Stops are unaffected by this" >

	uid myOffscreenMotionPatternUID // a motion pattern that will be used instead of this one if the motion plan starts off camera
	
	float myMinTravelAndTalkSpeed 0.0f // the minimum speed an NPC with a Travel And Talk objective is able to move
	float myMaxTravelAndTalkSpeed 10.0f // the maximum speed an NPC with a Travel And Talk objective is able to move

	float myImmobilePlanPathThreshold 0.1f // motion plan shorter than this are considered immobile (have only one stop segment)
}