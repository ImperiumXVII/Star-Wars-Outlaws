class NPCMotionPlanFollowProfile < uid=auto >
{
	float myCurvatureDetectDistance 0.0 < min=0 tooltip="For long body npcs(like quadruped), we might need use an ahead position to calculate the curvature ,so that the npc's move-turn animation could response to the curvature change earlier and match the path curve better. This value defines how far this ahead position could be.">
	float mySlopeAngleSmoothingDistance 2.0 < min=0 tooltip="This defines how long before entering a segment we start lerping the current slope angle into the starting slope angle of the following segment.">
	float myMaxAngleToExtendDropSegment 15.0f < tooltip="When generating drop segment, drop exit point will be extended by animation length, however if the drop angle is too large, this extent won't have a good animation result. If drop angle is larger than this value, no more extension will be applied.">
	float myAdditionalSoftInterruptStopDistance 1.0f < tooltip="When MoveToAction getting soft-interrupted, this additional distance will added before the stop segment" >
	float myMaxStopMoveAnimationDistance 3.0f < tooltip="The max moving distance of all the stop-move animations" >
	bool myAllowPenetrationResolve false < tooltip="This flag defines when moving, if we allow the agents be pushed off its motion plan to avoid penetration with others" >
	float myPenetrationResolveCapsuleRadius 0 < min=0 tooltip="The radius of the capsule used for penetration resolve colliding check. If set to 0, will use the setting of the steering profiler as a fall back" >
	float myPenetrationResolveCapsuleDistA 0.0 <  tooltip="The 1st sphere's distance along the npc's body axis" >
	float myPenetrationResolveCapsuleDistB 0.0 <  tooltip="The 2nd sphere's distance along the npc's body axis" >
	bool myEnablePenetrationResolveSlidingAllowance false < tooltip="When the penetration resolve takes effect, the agent moving will be limited so that it could no longer match the moving animations. We call this as 'sliding'. Enable this flag to constraint the sliding range." >
	float myPenetrationResolveSlidingAllowanceSpeedInBodySize 1.0 < tooltip="How many units of body size the agent could slide per second. Currently the body size is defined as the width of the body" >
	float myPenetrationResolveSlidingAllowanceMaxSpeedRatioAlongMoveDir 2.0 < tooltip="The max speed scale along the moving direction" >
	float myPenetrationResolveSlidingAllowanceMinSpeedRatioAlongMoveDir 0.0 < tooltip="The min speed scale along the moving direction, note it could be a negative value" >

}
