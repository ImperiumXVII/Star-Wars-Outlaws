// The order of these values should not be changed. The animation system depends on the index of these values.
enum NPCMovementStyleType
{
	Casual			// = 0
	Sneak			// = 1
	Investigation	// = 2
	Patrol			// = 3
	Combat			// = 4
}

// The order of these values should not be changed. The animation system depends on the index of these values.
