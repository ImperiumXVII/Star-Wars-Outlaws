include "helix/game system data/fruit/ai/motion/motionenums.fruit"

class MoveTurnCapabilityEntry
{
	bool myEnable true
	float myMinSpeed 0.0 
	float myMaxSpeed 10.0 
	float myMinIdealSpeed -1.0 < min=0.1 tooltip="The minimum movement speed at which the movement animation is allowed to look good enough" >
	float myMaxIdealSpeed -1.0 < min=0.1 tooltip="The maximum movement speed at which the movement animation is allowed to look good enough" >
	float myMaxCurvature 10.0 < tooltip="The reciprocal of the smallest turning radius of the move-turn animations at this speed range." >
}

list MoveTurnCapabilityEntries
{
	MoveTurnCapabilityEntry
}

list MoveTurnCapabilityAnimationStyles
{
	NPCAnimationStyleType
}

class MoveTurnCapabilitiesEntry
{
	MoveTurnCapabilityAnimationStyles myAnimationStyles
	MoveTurnCapabilityEntries myEntries
}

list MoveTurnCapabilitiesEntries
{
	MoveTurnCapabilitiesEntry
}

class NPCMoveTurnCapabilitiesProfile < uid=auto >
{
	MoveTurnCapabilitiesEntries myEntries

}