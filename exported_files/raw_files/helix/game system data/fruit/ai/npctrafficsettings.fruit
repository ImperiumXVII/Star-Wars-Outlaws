include "helix/game system data/fruit/ai/roadsettings.fruit"
include "helix/game system data/fruit/ai/npcpathwaytraversalcapability.fruit"
include "helix/game system data/fruit/ai/npctrafficpassengerloadout.fruit"
include "helix/game system data/fruit/npc/npc.fruit"

class RandomNPC < uid=auto >
{
	NPC* myNPC
	NPCTrafficPassengerLoadoutList myPassengerLoadouts
	int myRandomSelectionChance 100 < tooltip="The chance that this npc will be selected when randomizing between the number of npcs used in RoadSetting." min=1 >
}

list RandomNPCList
{
	RandomNPC
}

class NPCTrafficWantedLevelData
{
	int mySpawnChance 0 < tooltip="Used for randomizing between 0 - 100 to see if traffic system should spawn wanted related traffic instead." min=0 max=100 >
	RandomNPCList myRandomNPCs
}

list NPCTrafficWantedLevelDataList
{
	NPCTrafficWantedLevelData
}

class NPCRoadSetting
{
	NPCPathType myPathType
	color myColor
	float myNPCMaxVehicleSpeed 0.0
	NPCPathTypeList myAllowedPathTypeConnnections < tooltip="Used for traffic in intersections. If connected roads are not of the same npc path type as the current road, then that npc path must exist in this list for traffic to able to continue on it.">
	RandomNPCList myRandomNPCs
	int myMaxAmountOfRandomNPCsPerSpawnWave 1 < tooltip="The max number used for randomizing between how many npcs should spawn together." min=1 max=5 >
	float mySpawnPositionsDistance 50.0 < min=5.0 tooltip="Specifies in meters a distance along the road between possible spawn positions for traffic. Also used to determine how much traffic a road can hold." >
	float myMinRandomSpawnInterval 10.0
	float myMaxRandomSpawnInterval 50.0
	float myShortDistanceFromPlayer 300.0 < tooltip="Min distance to the player from the road to qualify for short distance score bonus." >
	int myShortDistanceFromPlayerScore 100 < tooltip="Score applied to the road if within short distance requirement to the player." >
	float myLongDistanceFromPlayer 500 < tooltip="Min distance to the player from the road to qualify for long distance score bonus." >
	int myLongDistanceFromPlayerScore 50 < tooltip="Score applied to the road if within long distance requirement to the player." >
	int myTrafficAtHalfCapacityPenalty 50 < min=0 tooltip="Score subtracted to roads considered for traffic spawning that are at half of their traffic capacity." >
	int myMaxAllowedStoppedVehiclesOnLane 2 < min=-1 tooltip="Used to determine if traffic will use this road depending on how many vehicles are stopped on the same lane. If -1 traffic won't care how many vehicles are stopped on the road" >
	float myRoadContainsWantedPlayerModifier 2.0 < min=1 tooltip="Modififer multiplied with road score to determine how much influence a road containing wanted player should have for empire traffic." >
	NPCTrafficWantedLevelDataList myNPCTrafficWantedLevels
}

class NPCTrafficVehicleSetting
{
	float myMaxIntersectionCurveAngle 180 < min=0 max=180 tooltip="Max curve angle used for road selection when reaching a intersection. Will not turn onto roads with a higher curve angle" >
	float myMaxIntersectionWithTrafficCurveAngle 95 < min=0 max=180 tooltip="Max curve angle used for road selection when reaching a intersection with traffic. Will not turn onto roads with a higher curve angle" >
	float myPathSuccessDistance 40.0 < tooltip="When npc is within this distance its considered to have reached it's goal and will start looking for next road." >
	float myMinLifetime 30.0 < tooltip="Specifies in seconds a minimum lifetime before it can be marked for removal." >
	float myIntersectionTrafficRadius 30.0 < tooltip="Specifies in meters a radius how far we check for incoming traffic at intersections." >
	float myIntersectionMinRoadAngleForTrafficAvoidance 45.0 < tooltip="If curve angle to road from current is smaller than specified, then we don't consider traffic from that road when attempting to avoid collision by turning right." >
	float myIntersectionTurnScoreModifier 0.5 < min=0 tooltip="Modififer used to control how much influence the turn angle has when scoring which road should be taken at intersections." >
	float myIntersectionRoadTrafficCapacityScoreModifier 1.0 < min=0 tooltip="Modififer used to control how much influence current traffic amount has when scoring which road should be taken at intersections." >
	float myIntersectionRoadTrafficWeightScoreModifier 1.0 < min=0 tooltip="Modififer used to control how much influence traffic presence weight has when scoring which road should be taken at intersections." >
}

list NPCRoadSettingsList
{
	NPCRoadSetting
} 

class NPCTrafficSettings < uid=auto >
{
	NPCRoadSettingsList myNPCRoadsSettings
	NPCTrafficVehicleSetting myTrafficVehicleSetting
	int myMaxAmountOfVehiclesInWorld 100
	float myGlobalSpawnCooldown 2.0
	float myMinDistanceToPlayerForSpawn 10
	float myMaxDistanceToPlayerForSpawn 1000
	float myMinDistanceToPlayerForDespawn 10
}