enum NPCSensoryModifierVolumeType
{
	None
}

class NPCSensoryMultiplier
{
	NPCSensoryModifierVolumeType myType
	float myHearingRangeMultiplier 1.0 < min=0 >
}

list NPCSensoryMultiplierList
{
	NPCSensoryMultiplier
}

class NPCSensoryModifierProfile < uid=auto >
{
	NPCSensoryMultiplierList mySensoryMultipliers
}