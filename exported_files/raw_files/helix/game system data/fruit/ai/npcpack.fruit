include "helix/game system data/fruit/npcmove/movesetting.fruit"
include "helix/game system data/fruit/ai/npcfollowprofile.fruit"

class NPCPackCommonSetting
{
	float myPackDefaultRadius 0.0 < hiddenFromFruitParser="1" >
	float myPackRadiusIncrement 0.0 < hiddenFromFruitParser="1" >
	float myPackLeavingFireteamDuration 60.0
	float myPackLeavingFireteamRadius 40.0
}

class NPCPackTrackingSetting
{
	float myPackDefaultRadiusOverride 0.0 < hiddenFromFruitParser="1" >
	float myPackRadiusIncrementOverride 0.0 < hiddenFromFruitParser="1" >
	float myTrackingSurroundRadius 0.0
	float myMaxDistanceToOwner 0.0 < min=0 tooltip="Distance threshold to abort tracking and return to the owner. Set to zero for UNLIMITED." >
}

class NPCPackSlotSetting
{
	float myMinRadius 0.0
	float myMaxRadius 0.0
}

class NPCPackMemberTacticalMoveSetting
{
	float myLookaheadSpeedThreshold 1.2
	float myLookaheadTime 1.2
	float myLookaheadBleedingCoefficient 0.7
	float myErosionSpeedCoefficient 0.5
	bool myRequireLOSToHostileTarget true
}

class NPCPackCombatSetting
{
	float myPackDefaultRadiusOverride 0.0 < hiddenFromFruitParser="1" >
	float myPackRadiusIncrementOverride 0.0 < hiddenFromFruitParser="1" >
	float myCombatExtendedRadius 0.0 < hiddenFromFruitParser="1" >
	float myMaxMoveCloserDuration 0.0
	int myPreferredPackSize 0
	NPCPackSlotSetting myPackSlotSetting
	NPCPackMemberTacticalMoveSetting myTacticalMoveSetting
}

class NPCPackFleeSetting
{
	float myPackDefaultRadiusOverride 0.0
	float myPackRadiusIncrementOverride 0.0
}

class NPCPackFollowSetting
{
	float myPackFollowMinRadius 0.0
	float myPackFollowMaxRadius 0.0
	FollowDistanceTable myDistanceTable
	FollowMotionPatternTypeTable myFollowMotionPatternTypeTable
}

class NPCPackSyncCAPSetting
{
    float mySyncCAPDistanceFactor 10.0
	float mySyncCAPDirectionFactor 10.0
	float myMinSyncCAPDistance 5.0
	float myMaxSyncCAPDistance 20.0
	float myMaxSyncCAPAngleDiff 30.0
	float myMaxSyncCAPHightDiff 1.0
	float myTicketCoolDownTime 20.0
	float myGuestCoolDownTime 30.0
}

class NPCPackProfile < uid=auto >
{
	NPCPackCommonSetting myPackCommonSetting < hiddenFromFruitParser="1" >
	NPCPackTrackingSetting myPackTrackingSetting < hiddenFromFruitParser="1" >
	NPCPackCombatSetting myPackCombatSetting < hiddenFromFruitParser="1" >
	NPCPackFleeSetting myPackFleeSetting < hiddenFromFruitParser="1" >
	NPCPackFollowSetting myPackFollowSetting < hiddenFromFruitParser="1" >
	NPCPackSyncCAPSetting myPackSyncCAPSetting < hiddenFromFruitParser="1" >
}