include "helix/game system data/fruit/ai/aimaccuracytype.fruit"
include "snowdrop/modules/core/audio/audio.fruit"

class NPCShootPatternBase < uid=auto abstract=1 >
{
} 

class NPCShootBlock
{
	float myStartTime 0.0
	float myEndTime 0.2
	HC_NPCAimAccuracyType myAimAccuracyType Default
	bool myIsCharge FALSE
	float myRTPCValue 0.0 < tooltip="Value of the per-block custom RTPC." > 
}

list NPCShootBlockList
{
	NPCShootBlock
}

class NPCShootPattern : NPCShootPatternBase
{
	AudioRTPC myPatternBlocksRTPC < tooltip="Custom RTPC we want to set to each shooting block. Works only for the player weapons for now." > 
	NPCShootBlockList myShootBlocks
}

class NPCWeightedShootPattern
{
	NPCShootPattern* myShootPattern
	int myWeight < min=1 >
}

list NPCWeightedShootPatternList
{
	NPCWeightedShootPattern
}

class NPCCustomShootPattern : NPCShootPatternBase
{
    NPCWeightedShootPatternList myShootPatterns
}
