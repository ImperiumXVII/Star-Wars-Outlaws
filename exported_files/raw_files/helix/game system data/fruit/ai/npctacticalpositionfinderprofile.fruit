
class NPCTacticalPositionFinderProfile < uid=auto >
{
	float myDistanceFromSearchAgentPenaltyMultiplier 1.0
	float myDistanceFromOptimumRangeToHostileTargetPenaltyMultiplier 30.0
	float myDistanceFromSearchVolumePenaltyMultiplier 1.0
	float myAngleFromPreferredDirectionPenaltyMultiplier 1.0

	float myOutOfInnerNPCObjectiveVolumePenalty 30.0
	float myOutOfInnerNPCObjectiveVolumeDistancePenaltyMultiplier 1.3

	float myOutOfInnerTetherVolumePenalty 30.0
	float myOutOfInnerTetherVolumeDistancePenaltyMultiplier 1.3

	float myOnRoadPenalty 45.0 < tooltip="Vehicle npcs only, adds a penalty for positions located on the latest used road." >
	float myOnRoadDistancePenaltyMultiplier 1.5 < tooltip="Vehicle npcs only. The distance from road center to road edge, subtracted with the distance from road center to position gets multiplied by this value." >

	float myNotCoverPositionButCoverPositionPreferredPenalty 30.0
	float myLowCoverPositionBonus 0.0
	float myHighCoverPositionBonus 0.0

	float myCurrentPositionBonus 0.0
	float myHigherPositionBonus 0.0
	float myLowerPositionBonus 0.0

	float myInFrontOfAgentAngleDegrees 0.0
	float myInFrontOfAgentBonus 0.0
	float myBehindAgentAngleDegrees 0.0
	float myBehindAgentPenalty 0.0

	float myAwayFromTargetAngleDegrees 0.0
	float myAwayFromTargetPenalty 0.0
	float myBehindTargetAngleDegrees 0.0
	float myBehindTargetPenalty 0.0

	float myCloseToFireteamMembersRadius 0.0
	float myCloseToFireteamMembersBonus 0.0
	float myTooCloseToFireteamMembersRadius 0.0
	float myTooCloseToFireteamMembersPenalty 0.0
	float myTooFarFromFireteamMembersRadius 0.0
	float myTooFarFromFireteamMembersPenalty 0.0
	float myPositionRequiresCrossingLineOfFirePenalty 0.0

	float myTooCloseToDeathStainRadius 0.0
	float myTooCloseToDeathStainPenalty 0.0
	
	float myTooCloseToCoopPlayerRadius 0.0
	float myTooCloseToCoopPlayerPenalty 0.0

	float myNavMeshPathCostPenaltyMultiplier 1.3

	float myFrontlineCrossedPenalty 0.0
	float myFrontilneCenterOffset 0.0

	float myCoverMinDistanceToHostile 0.0

	vec3f myNonCoverEyeOffset 0.0;1.5;0.0
	vec3f myLowCoverPeakOverEyeOffset 0.0;1.5;0.0
	vec3f myHighCoverPeakLeftEyeOffset -1.0;1.5;0.0
	vec3f myHighCoverPeakRightEyeOffset 1.0;1.5;0.0
}