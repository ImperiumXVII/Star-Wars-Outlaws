class NPCFootStepSoundEventSetting
{
    string mySpeedToIntervalCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -1.3333334 0, }, outTangents = { 1.3333334 0, 0 0, }, properties = { 3, 1027, }, values = { 0 1, 4 0.1, }, }, numKeys = 2, }," < bhv=inputgraph tooltip="The horizontal axis represent speed while the vertical axis represent sound event interval.\nThe interval should decrease as the speed increases" >
    float mySprintingSpeed 2 < tooltip="If speed is above this value, NPCSprintingFootStep sound event will be emitted instead of NPCFootStep" >
}

class NPCFootStepProfile < uid=auto >
{
    NPCFootStepSoundEventSetting mySoundEventSetting
}
