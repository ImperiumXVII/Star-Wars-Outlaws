class AIVisionCone
{
	vec3f myPivotOffset 0.0;0.0;0.0 				< tooltip="The offset from the pivot point. This is normally the head position of the agent. It can be used to create a cone with a truncated top, increasing the visibility surface at the agent's head position. This offset does not apply to the peripheral cone (use myPeripheralPivotOffset instead)." >
	float myHorizontalAngleDegrees 0.0				< tooltip="The horizontal angle in degrees of the vision cone. Max 360." bhv=degree_angle min=0 max=360 >
	float myVerticalAngleDegrees 0.0				< tooltip="The vertical angle in degrees of the vision cone. Max 180." bhv=degree_angle min=0 max=180 >
	string myRadiusFormula 0.0						< tooltip="The radius of the vision cone." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myMaxRadius 0.0							< tooltip="The maximum radius of the vision cone." >
	float myMaxWidth 1000.0							< tooltip="The maximum width of the vision cone. Setting this smaller will result in a coffin shape instead of an arc." >
	float myMaxHeightUp 2.5							< tooltip="The maximum height upwards of the vision cone. Setting this smaller will result in a coffin shape instead of an arc." >
	float myMaxHeightDown 2.5						< tooltip="The maximum height downwards of the vision cone. Setting this smaller will result in a coffin shape instead of an arc." >
	vec3f myPeripheralPivotOffset 0.0;0.0;0.0 		< tooltip="The offset from the pivot point of a second shallower vision cone to model peripheral vision." >
	float myPeripheralHorizontalAngleDegrees 0.0	< tooltip="The horizontal angle in degrees of a second shallower vision cone to model peripheral vision. Max 360." bhv=degree_angle min=0 max=360 >
	float myPeripheralVerticalAngleDegrees 0.0		< tooltip="The vertical angle in degrees of a second shallower vision cone to model peripheral vision. Max 180." bhv=degree_angle min=0 max=180 >
	string myPeripheralRadiusFormula 0.0			< tooltip="The radius of a second shallower vision cone to model peripheral vision." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myPeripheralMaxRadius 0.0					< tooltip="The maximum radius of a second shallower vision cone to model peripheral vision." >
	float myPeripheralMaxWidth 1000.0				< tooltip="The maximum width of the periperal vision cone." >
	float myPeripheralMaxHeightUp 3.5				< tooltip="The maximum height upwards height of the periperal vision cone." >
	float myPeripheralMaxHeightDown 3.5				< tooltip="The maximum height downwards height of the periperal vision cone." >
}

class AIVisionConeState
{
	AIVisionCone myCone
	AIVisionCone myAlertCone
}

class NPCVisionProfile < uid=auto >
{
	AIVisionConeState myIdleConeState
	AIVisionConeState myAwareConeState
	AIVisionConeState myCombatConeState
	
	bool myUse3DOrientation FALSE < tooltip="If true, it will use the 3D orientation. Otherwise, it will keep it parallel to the ground plane." >
	bool myUseHeadLook TRUE
	bool myUseActiveFocusPointDuringCombat FALSE
	float myHeadLookLerpRatio 1.0	
	float myHeadLookMaxPitchRotationDegrees 70.0
	float myHeadLookMaxHeadingRotationDegrees 60.0

	float myConcealmentVolumeRange 2.0 < tooltip="Determines vision range into concealment volumes when the NPC is out of combat and inside of a concealment volume" >
	float mySmokeBombConcealmentVolumeRange 1.5 < tooltip="Determines vision range into smoke bomb concealment volumes when the NPC is out of combat and inside of a smoke bomb concealment volume" >
	float myConcealmentVolumeRangeInCombat 2.0 < tooltip="Determines vision range into concealment volumes when the NPC is in combat" >
	float mySmokeBombConcealmentVolumeRangeInCombat 1.5 < tooltip="Determines vision range into smoke bomb concealment volumes when the NPC is in combat" >
	float myVisionRangeIntoConcealmentVolumes 0.0 < tooltip="Determines vision range into concealment volumes when the NPC is out of combat and outside of a concealment volume" >
	float myNPCToNPCNonCombatRadiusMultiplier 1.5
	float myNPCToWildlifeRadiusMultiplier 0.66
	float myInvestigationConeExpandDelay 2.0
	float myInvestigationConeExpandTime 4.0

	bool myCanDetectPlayer TRUE
	bool myNeedLOSToDetectPlayer TRUE	
	bool myCanDetectHostile TRUE
	bool myNeedLOSToDetectHostile TRUE		
	bool myCanDetectFriendly TRUE
	bool myNeedLOSToDetectFriendly TRUE		
	bool myCanDetectPrimaryWildlife TRUE
	bool myNeedLOSToDetectPrimaryWildlife TRUE	
	bool myCanDetectSecondaryWildlife FALSE
	bool myNeedLOSToDetectSecondaryWildlife FALSE	
	
	float myMinEMTransmittance 0.2 < min=0 max=1 tooltip="Minimum Electro Magnetic Cloud transmittance">
}
