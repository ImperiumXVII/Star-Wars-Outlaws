include "helix/game system data/fruit/settings/spaceshipenums.fruit"

list SpaceshipSpeedProfileTypeEntries
{
	SpaceshipSpeedProfileType
}

class SpaceshipRubberbandProfile < uid=auto >
{
	string mySpeed "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.33333334 0, }, outTangents = { 0.33333334 0, 0 0, }, properties = { 3, 1027, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Speed Versus Angle To Screen Edge" >

	float myAcceleration 0
	string myAccelerationBlendRatio < bhv=inputgraph tooltip="Acceleration Versus Angle To Screen Edge" >

	SpaceshipSpeedProfileTypeEntries mySpeedProfileExceptions
}
