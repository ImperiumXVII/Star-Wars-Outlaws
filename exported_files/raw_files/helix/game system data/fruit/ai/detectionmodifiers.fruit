include "helix/game system data/fruit/faction/faction.fruit"

// It is okay to insert new values inside the enum or to change the order of the values, but not to change the value strings.
// The enums can be deleted if it's not referenced by a NPCDetectionModifierProfile. This will however leave affected volumes with the "None" enum
enum NPCDetectionModifierVolumeType
{
	None		// Referenced in code
	LimitedVisibility
	SpotlightVisibility
}

class DetectionMultiplierVolumeTypeEntry
{
	NPCDetectionModifierVolumeType myType
	float myMultiplier 1.0 < min=0 tooltip="Applied to the stimulus rate if the player is within this type of volume" >
}

list DetectionMultiplierVolumeTypeList
{
	DetectionMultiplierVolumeTypeEntry
}

class DetectionMultiplierTimeOfDay
{
	float myMultiplier 1.0 < min=0 tooltip="Applied to the stimulus rate if current time is within StartHour and EndHour" >
	float myStartHour < tooltip="Start hour given in float. 18.5 equals to 18:30 in time" >
	float myEndHour < tooltip="End hour given in float. 18.5 equals to 18:30 in time" >
}

list DetectionMultiplierTimeOfDayList
{
	DetectionMultiplierTimeOfDay
}

class DetectionMultiplierFactionRelation
{
	FactionRelation myFactionRelation
	float myMultiplier 1.0 < min=0 tooltip="Applied to the stimulus rate when the NPC sees a target with the defined faction relation" >
}

list DetectionMultiplierFactionRelationList
{
	DetectionMultiplierFactionRelation
}

class NPCDetectionModifierProfile < uid=auto >
{
	// environment
	DetectionMultiplierTimeOfDayList myTimeOfDayMultipliers
	
	// cones
	float myAlertConeStimulusMultiplier 1.5 < tooltip="Stimulus rate will be multiplied by this value when a hostile target is detected within the NPC's Alert Vision Cone" >
	float myPeripheralConeStimulusMultiplier 1.0 < tooltip="Stimulus rate will be multiplied by this value when a hostile target is detected within the peripheral range of the NPC Vision Cone" >
	
	// self
	float myIdleAlertStimulusMultiplier 1.0 < tooltip="Stimulus rate will be multiplied by this value when the NPC is in Idle, but has been alerted by the Player at some point during its lifetime.">
	
	// target
	DetectionMultiplierVolumeTypeList myVolumeTypeMultipliers < tooltip="Applies if an NPC sees the player within this type of NPCDetectionModifier volume modifier. Defaults to 1.0 if not set" >
	DetectionMultiplierFactionRelationList myFactionRelationMultipliers < tooltip="Applies if the NPC sees their target with the defined faction relation" >
	float myTargetPlayerOnSpeederMultiplier 1.0 < min=0 tooltip="Applies if an NPC sees the player on a speeder" >	
	float myTargetNPCOnVehicleMultiplier 1.0 < min=0 tooltip="Applier if an NPC sees another hostile NPC on a vehicle" >
	float myConcealmentVolumeMultiplier 1.0 < min=0 tooltip="Applies if an NPC sees the player within a concealment volume" >
	float myCrouchingVisibilityMultiplier 1.0 < min=0 tooltip="Applies if an NPC sees a crouching player" >
	float myCrouchingPeripheralVisibilityMultiplier 1.0 < min=0 tooltip="Applies if an NPC sees a crouching player within the peripheral range" >
	float myRollingVisibilityMultiplier 1.0 < min=0 tooltip="Applies if an NPC sees a rolling player. Overrides crouch multiplier" >
	float myRollingPeripheralVisibilityMultiplier 1.0 < min=0 tooltip="Applies if an NPC sees a rolling player within the peripheral range. Overrides crouch multiplier" >	
	// wanted
	float myImmediateCombatWantedLevelMultiplier 1.0 < min=0 tooltip="'High' Wanted \nApplies if:\nPlayer is not currently hostile towards the fireteam or faction \nWanted relation towards player \nNPC is not within Security Area Low/High/Faction territory \nImmediate level is defined by wanted settings" >
	float myNonImmediateCombatWantedLevelMultiplier 1.0 < min=0 tooltip="'Low' Wanted \nApplies if:\nPlayer is not currently hostile towards the fireteam or faction \nWanted relation towards player \nNPC is not within Security Area Low/High/Faction territory \nImmediate level is defined by wanted settings" >

	// prohibited actions
	float myProhibitedActionDetectionRateMultiplier 1.0 < min=0 tooltip="Detection score multiplier for prohibited actions. If 0 then no score will be added." >
	
	// projectile
	float myProjectileDetectionRateMultiplier 1.0 < min=0 tooltip="Detection score multiplier for projectile stimulus." >

	string myInPlayerFOVMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -1 0, }, outTangents = { 1 0, 0 -0, }, properties = { 2051, 3347, }, values = { 0 1, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	
	// moving speed
	string myMovingSpeedMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, 0 0, }, outTangents = { 0 0, 0 0, }, properties = { 1299, 2323, }, values = { 0 1, 0 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Maps the moving speed to detection multiplier" >

}

