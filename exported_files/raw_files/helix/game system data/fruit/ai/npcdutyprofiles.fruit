include "helix/game system data/fruit/ai/npcduty.fruit"
include "helix/game system data/fruit/ai/npcmood.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"

list DutyPurposeTagList
{
	RBTagsTag* < compact_view=1 bhv=rbtags rbtags_filter="~+Agent ~+Purpose" >
}

class NPCDutyMoodInfo < uid=auto >
{
	NPCMood myNPCMood None
	DutyPurposeTagList myPurposeTags
}

list DutyMoodList
{
	NPCDutyMoodInfo
}

class NPCDutyInfo < uid=auto >
{
	NPCDuty myNPCDuty None
	DutyMoodList myMoods
}

list NPCDutyInfoList
{
	NPCDutyInfo
}

class NPCDutySettings < uid=auto >
{
	NPCDutyInfoList myNPCDutyInfos
}
