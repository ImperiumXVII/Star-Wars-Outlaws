include "helix/game system data/fruit/ai/npcdetectionsoundevent.fruit"
include "helix/game system data/fruit/ai/aimprofile.fruit"
include "helix/game system data/fruit/ai/npcshootpattern.fruit"
include "helix/game system data/fruit/equipment/weapon/weapon_collector.fruit"
include "helix/game system data/fruit/item/item.fruit"
include "helix/game system data/fruit/projectile/projectile.fruit"
include "helix/game system data/fruit/sound/audioweapon.fruit"
include "helix/game system data/fruit/equipment/equipment_attachment.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"

// These enum values are referenced by string in code.
// It is okay to insert new values inside the enum or to change the order of the values, but not to change the value strings.
enum NPCWeaponGripType
{
	Unarmed // 0
	Melee1H // 1
	Melee2H // 2
	MeleeDual // 3
	PistolGrip1H // 4
	PistolGrip2H // 5
	PistolGripDual // 6
	RifleGrip1H // 7
	RifleGrip2H // 8
	RifleGripDual // 9
	HeavySideGrip2H // 10 
}

enum NPCPickupWeaponType
{
	None
	Ground
	Table
	Rack
	High
}

list RBTagsReferenceListWeapon
{
	RBTagsTag* < compact_view=1 bhv=rbtags rbtags_filter="~+Weapon" >
}

class NPCWeapon < uid=auto >
{
	file myGraphObject "" < bhv=asset assettype=object >
	
	string myIcon < bhv="sprite" >
	
	WeaponTargetCollectorList myTargetCollector
	Projectile* myProjectile
	NPCDetectionSoundEvent* myNPCDetectionSoundEvent
	float myDamage 1
	DamageType myDamageType Unknown
	string myFiringInterval 0.1 < tooltip="Minimum time between shots if trigger is held down" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myAudioThreatValue -1.0 < min=-1.0 max=1.0 tooltip="Optional precomputed threat value for weapon. Range 0 - 1 (-1 to ignore)." >
	float myAudioThreatDistanceMultiplier 1.0 < min=0.0 max=1.0 tooltip="Value multiplied to the distance from NPC to player when calculating Threat Level. Range 0 - 1." >
	int myAudioThreatShootingCooldownTimeMS 1000 < min=0 max=8000 tooltip="Time in milliseconds to wait after an npc stops firing before reducing shooting threat modifier. Range 0-8000." >
	AudioWeapon* myAudioData
	EquipmentAttachment myAttachment
	bool myUseMultipleMuzzles false
	bool myUsePerMuzzleSoundEmitter false
	int myProjectilesFiredPerShot 1
	bool myAllowMultipleValidProjectilesOnSameFrame false
	float myConvergenceAtTarget 1 < tooltip="The factor for how much projectiles( shot from multiple muzzles) trajectories converge at the target position." min=0 max=1 >
	vec3f myAgentEyePositionOverride < tooltip="Moves the Agent's eye position, when it's holding the weapon, to affect the LOS starting point. Zero to not override." >
	RBTagsReferenceListWeapon myWeaponRBTags
	Item* myWeaponDrop
	float myWeaponDropChance 1.0 < min=0.0 max=1.0 bhv="percent" tooltip="Percentage between 0.0 and 1.0 for the weapon to drop" >
	bool myDespawnOnOwnerDeath false
	float myWeaponDropAmmoPercentageMin 0.7 < min=0.0 max=1.0 bhv="percent" tooltip="Minimum percentage of dropped weapon ammo" >
	float myWeaponDropAmmoPercentageMax 1.0 < min=0.0 max=1.0 bhv="percent" tooltip="Maximum percentage of dropped weapon ammo" >
}

class NPCWeaponLoadout < uid=auto >
{
	NPCWeapon* myMainWeapon
	NPCWeapon* mySecondaryWeapon
	NPCWeapon* myTertiaryWeapon
	
	NPCAimProfile* myAimProfile
	NPCAimProfile* myReducedAimProfile
	NPCAimProfile* myNearMissAimProfile
	
	NPCShootPatternBase* myMainWeaponShootPattern
	NPCShootPatternBase* mySecondaryWeaponShootPattern
	NPCShootPatternBase* myTertiaryWeaponShootPattern
	
	RBTagsTag* myRBTag
	int myRandomSelectionPercentage 100 < tooltip="The percentage used for randomizing between the number of npc weapon loadouts used in npc constant data." min=0 max=100 >
	
	bool myHolsterOutOfCombat false
}

list NPCWeaponLoadoutList
{
	NPCWeaponLoadout*
}