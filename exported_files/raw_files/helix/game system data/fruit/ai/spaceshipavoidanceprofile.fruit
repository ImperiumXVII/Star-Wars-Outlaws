include "helix/game system data/fruit/settings/spaceshipenums.fruit"

list SpaceshipAvoidanceCastStep
{
	float
}

list SpaceshipObstacleTypes
{
	SpaceshipObstacleType
}

class SpaceshipAvoidanceProfile < uid=auto >
{
	bool myIsDefault false
	SpaceshipAvoidanceCastStep myCastStepsTimes

	string myCollisionAvoidanceRotationInfluenceBySpeed "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.602639 -0.038683, }, outTangents = { -0.602639 -0.038683, 0 0, }, properties = { 3, 3}, values = { 25 0.5, 100 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Collision Avoidance Rotation Influence By Speed" >
	string myCollisionAvoidanceTranslationInfluenceBySpeed "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.602639 -0.038683, }, outTangents = { -0.602639 -0.038683, 0 0, }, properties = { 3, 3}, values = { 25 0.5, 100 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Collision Avoidance Translation Influence By Speed" >

	string myStaticCollisionInfluenceByTime < bhv=inputgraph tooltip="Static Collision Influence By Time" >
	string myStaticCollisionThrottleInfluenceByTime < bhv=inputgraph tooltip="Static Collision Throttle By Time" >

	string myDynamicCollisionInfluenceByTime < bhv=inputgraph tooltip="Dynamic Collision Influence By Time" >
	string myDynamicCollisionThrottleInfluenceByTime < bhv=inputgraph tooltip="Dynamic Collision Throttle By Time" >

	float myCastRadiusMultiply 1.1
	float myCastRadiusAdd 5

	float myFatigueIncreasePerSecond 0.1
	float myFatigueDecreasePerSecond 0.1

	float myFatigueThresholdMin 0.5
	float myFatigueThresholdMax 1

	float myAddNavgridToPropsInfluence 0

	bool myCornerDetectionAnalyzerEnabled false
	float myCornerDetectionAnalyzerMaxDuration 1
	float myCornerDetectionThresholdDuration 1.33
	float myCornerDetectionReverseDuration 2
	float myCornerDetectionReverseThrottle 0.025
	SpaceshipObstacleTypes myObstacleAvoidanceExceptions
}
