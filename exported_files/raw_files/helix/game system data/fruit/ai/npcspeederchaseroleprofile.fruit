
// These enum values are referenced by string in graphs.
// It is okay to insert new values inside the enum or to change the order of the values, but not to change the value strings.
enum NPCSpeederChaseRole
{
	None
	Intercept
	Behind
	Left
	Right
	AheadLeft
	AheadRight
	BehindLeft
	BehindRight
	BehindFiller1
	BehindFiller2
	BehindFiller3
	BehindFiller4
	BehindFiller5
	BehindFiller6
	BehindFiller7
	BehindFiller8
	BehindFiller9
	BehindFiller10
	BehindFiller11
}

class NPCSpeederChaseRoleProfile < uid=auto >
{
	NPCSpeederChaseRole myRole
	vec3f myTargetOffset 0.0;0.0;0.0 < tooltip="The position offset to the target agent." >
	int myPriority 0
}