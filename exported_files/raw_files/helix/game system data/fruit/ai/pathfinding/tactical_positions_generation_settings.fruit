class CornerDetection
{
	bool  myEnableCornerDetection TRUE			
	float myHeight 0.5							< min=0.0 max=100.0 tooltip="Height (in meters) added to the tactical position for the raycast (to avoid small obstacles)" >
	float myRaycastRange 2.5					< min=0.2 max=100.0 tooltip="In meters" >
	float myCornerCoefficient 40.0				< min=1.0 max=100.0 tooltip="Percentage of consecutive raycast hits to be considered a corner" >	
}

class TacticalPositionsGenerationSettings
{
	CornerDetection myCornerDetection
}