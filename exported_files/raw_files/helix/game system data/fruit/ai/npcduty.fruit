enum NPCDuty
{
	// NPCDuty values are used by name and not index, you can add/Remove/Move
	// Be careful with delete if the value is used in data, you must update it also there!
	None // declared and used in code, must be synced with HC_NPCDuty.h !
	Patrol // declared and used in code, must be synced with HC_NPCDuty.h !
	Guide // declared and used in code, must be synced with HC_NPCDuty.h !	
	MoveAround
	AnyCAP	
	Patrol_AnyCAP
	Patrol_QuestSpecific
	Guard
	Inspect
	Survey
	Threaten
	Relax
	Scavenge
	WorkForRepairShop
	WorkAtTerminal
	WorkForCantina
	Shop
	OnPath_Guard
	OnPath_Inspect
	OnPath_Survey
	OnPath_Threaten
	OnPath_Relax
	OnPath_Scavenge
	OnPath_WorkForRepairShop
	OnPath_WorkAtTerminal
	OnPath_WorkForCantina
	OnPath_Shop
	PlaySpecificCAP
	Bouncer
	TakeShelter
}

