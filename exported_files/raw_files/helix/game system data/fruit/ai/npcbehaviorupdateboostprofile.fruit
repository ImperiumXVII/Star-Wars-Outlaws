include "helix/game system data/fruit/ai/alertlevel.fruit"
include "helix/game system data/fruit/ai/aievents.fruit"

class BehaviorUpdateBoostEvent
{
	AIEvent myEvent
}

list BehaviorUpdateBoostEvents
{
	BehaviorUpdateBoostEvent
}

class BehaviorUpdateBoostAlertLevel
{
	NPCAlertLevel myAlertLevel
}

list BehaviorUpdateBoostAlertLevels
{
	BehaviorUpdateBoostAlertLevel
}

class BehaviorUpdateBoostEntry
{
	BehaviorUpdateBoostEvents myEvents
	BehaviorUpdateBoostAlertLevels myAlertLevels
	int myExtraUpdates 1 < min=1 max=3 >
}

list BehaviorUpdateBoostEntries
{
	BehaviorUpdateBoostEntry
}

class NPCBehaviorUpdateBoostProfile < uid=auto >
{
	BehaviorUpdateBoostEntries myEntries

}