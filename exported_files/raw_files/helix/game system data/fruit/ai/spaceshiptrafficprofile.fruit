include "helix/game system data/fruit/npc/npc.fruit"

list SpaceshipTrafficGroupNPCList
{
	NPC*
}

class SpaceshipTrafficGroup
{
	SpaceshipTrafficGroupNPCList myNPCs
	float myProbability 1
}

list SpaceshipTrafficGroupList
{
	SpaceshipTrafficGroup
}

class SpaceshipTrafficProfile < uid=auto >
{
	SpaceshipTrafficGroupList myGroups
	float myDistanceMin 100
	float myDistanceMax 500
	float myHeight 200
	float myLeftWidth 0
	float myRightWidth 300
	float mySpeed 50
	float mySpawnDelayMin 0.0f
	float mySpawnDelayMax 0.0f
}
