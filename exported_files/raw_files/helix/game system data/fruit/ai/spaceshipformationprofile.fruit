include "helix/game system data/fruit/settings/spaceshipenums.fruit"

class SpaceshipFormationPosition
{
	SpaceshipTypeList myTypes
	SpaceshipArchetypeList myArchetypes
	vec3f myPosition
}

list SpaceshipFormationPositionsList
{
	SpaceshipFormationPosition
}

class SpaceshipFormation
{
	SpaceshipFormationPositionsList myFormationPositions < tooltip="Positions are defined in local space relative to a leader." >
	bool myIsCombatFormation false
	float myRotationSpeedMultiplier 1.0 < min=0 max=1 tooltip="Limit the leader rotation speed so the followers are able to follow">
}

list SpaceshipFormationList
{
	SpaceshipFormation
}

class SpaceshipFormationProfile < uid=auto >
{
	SpaceshipFormationList mySpaceshipFormations
}
