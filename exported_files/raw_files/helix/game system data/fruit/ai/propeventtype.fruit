include "helix/game system data/fruit/ai/npcdetectionsoundevent.fruit"

enum PropEventType
{
	NotSet  					// Referenced In Code
	Footstep 					//
	WeaponTrigger 				//
	Explosion					//
	Distraction					//
	VehicleMoving				//
	ProjectileImpact			//
	NPCVehicleMoving			//
}

enum PropEventPriority
{
	Low
	High
}

class PropEvent_PriorityTypeMapping
{
	PropEventType myPropEventType
	PropEventPriority myPropEventPriority
}

