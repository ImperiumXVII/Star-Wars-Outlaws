include "snowdrop/modules/core/audio/audio.fruit"

class NPCAudioTriggerVolumeProfile < uid=auto >
{
    float myTriggerVolumeRadius 0.3 < tooltip="NPC agent AABB radius for collision checks with vegetation trigger volume" >
    float myTriggerVolumeHeight 1.6 < tooltip="NPC agent AABB height for collision checks with vegetation trigger volume" >
    AudioSwitch myTypeSwitch < tooltip="Used to determine type of agents for audio" >
}