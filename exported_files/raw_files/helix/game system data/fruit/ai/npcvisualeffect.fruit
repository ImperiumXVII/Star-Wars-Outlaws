include "helix/game system data/fruit/effects/effects.fruit"

class NPCVisualEffectFootstep < uid=auto >
{
	EffectsByMaterials myFootstepEffects
	string myLeftFootBoneAliasName
	string myRightFootBoneAliasName
	string myLeftHandBoneAliasName
	string myRightHandBoneAliasName
	float myFootRayCastOffsetUp 0.15f
	float myFootRayCastOffsetDown 0.85f
	bool myReuseFootstepEffect False < tooltip="if true, the system will create only one footstep particle system, and with each footstep trigger, it will generate a new particle at a new location." >
}