include "helix/game system data/fruit/bodypart/bodypart.fruit"
include "helix/game system data/fruit/combat/combat.fruit"
include "helix/game system data/fruit/npc/npctagslists.fruit"

class NPCStaggerBodyPartModifier
{
	BodyPartType myBodyPartType None
	float myValue 1.f
}

class NPCStaggerDamageSourceTypeModifier
{
	DamageSourceType myDamageSourceType Unknown
	float myValue 1.f
}

class NPCStaggerDamageTypeModifier
{
	DamageType myDamageType 
	float myValue 1.f
}

list StaggerDamageTypeList < size=1 >
{
	DamageType
}

list StaggerDamageSourceTypeList < size=1 >
{
	DamageSourceType
}

class NPCStaggerDamageModifier
{
	StaggerDamageTypeList myDamageType
	StaggerDamageSourceTypeList myDamageSourceType
	NPCAgentTagsList myDamageDealerRBTags
	float myValue
	float myExtraImmunityDuration 0 < min=0 tooltip="When stagger is triggered by this matchup, an extra duration of immunity to stagger will be added" >
}

list NPCStaggerBodyPartModifierList
{
	NPCStaggerBodyPartModifier
}

list NPCStaggerDamageModifierList
{
	NPCStaggerDamageModifier
}

list NPCStaggerDamageSourceTypeModifierList
{
	NPCStaggerDamageSourceTypeModifier
}

list NPCStaggerDamageTypeModifierList
{
	NPCStaggerDamageTypeModifier
}

class FaceTargetAfterStaggerForDamage
{
	StaggerDamageTypeList myDamageType
	StaggerDamageSourceTypeList myDamageSourceType
	bool myFaceTargetAfterStagger FALSE
}

list FaceTargetAfterStaggerForDamageList
{
	FaceTargetAfterStaggerForDamage
}

class NPCStaggerConfig < uid=auto >
{
	string myStaggerGaugeMaxValue 0.0 < tooltip="The maximum value of the stagger gauge." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myStaggerGaugeTreshold 0.0 < tooltip="When this value is reach, the stagger is triggered." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myStaggerRecoveryRate 0.f < tooltip="Every second, the stagger gauge value will be reduced by this value." >
	float myStaggerDurationBeforeRecoveryStart 0.f < tooltip="The recovery will start after this time has passed since the last increase of the gauge." >
	float myStaggerImmunityDuration 0.f < tooltip="When the stagger is triggered, the npc will be immune to another stagger during this duration." >

	NPCStaggerBodyPartModifierList myStaggerBodyPartModifiers
	NPCStaggerDamageModifierList myStaggerDamageModifiers < tooltip="If the list is empty, all damage modifiers will be 1 by default." >

	bool myIsStaggerImmune FALSE < tooltip="If this is true, the npc will be immune to stagger." >
	bool myOverrideAnimationDirection TRUE < tooltip="If this is true, the npc's animation direction will be overridden." >
	bool myFaceTargetAfterStagger TRUE < tooltip="If this is true, the npc will be forced to face target." >
	FaceTargetAfterStaggerForDamageList myOverrideFaceTargetAfterStaggerForDamage < tooltip="Override the myFaceTargetAfterStagger if damage type and/or damage source type is used to trigger the stagger." >
	bool myForceInterruptCAP TRUE < tooltip="If this is true, the npc will play stagger animation rather than the custom exit animation in the CAP" >
	bool myStaggerOnEveryMelee TRUE < tooltip="If this is true, the npc will stagger on every melee even if not reach the threshold" >
	bool myIsStaggerAllowedOnVehicle FALSE < tooltip="If this is true and the npc is on a vehicle, the stagger will be allowed" >
	bool myStaggerIgnoreNavmesh FALSE < tooltip="Ignore navmesh for stagger animation, so it could be played even when off navmesh(only the OnSpot ones will be played though)" >

	string myDazedGaugeMaxValue 0.0 < tooltip="The maximum value of the dazed gauge." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myDazedGaugeTreshold 0.0 < tooltip="When this value is reach, the dazed is triggered." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myDazedRecoveryRate 0.0 < tooltip="Every second, the dazed gauge value will be reduced by this value." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myDazedDurationBeforeRecoveryStart 0.0 < tooltip="The recovery will start after this time has passed since the last increase of the gauge." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myDazedDuration 0.0 < tooltip="Duration of the dazed. During this periode, the animation will loop." bhv=formulaEditor formulaResolveContextType=AgentAttributes >

	bool myDazedIgnoreDirection FALSE < tooltip="Ignore hit direction for daze intro animation." >
	bool myCanUseStaggerAsDazedIntro TRUE < tooltip="If true allow Stagger animation to be used as the intro of the dazed animation." >
	bool myDazedIgnoreNavmesh FALSE < tooltip="Ignore navmesh for daze intro animation, so it could be played even when off navmesh" >

	NPCStaggerDamageModifierList myDazedDamageModifiers < tooltip="If the list is empty, all damage modifiers will be 0 by default." >

	bool myIsDazedImmune FALSE < tooltip="If this is true, the npc will be immune to dazed." >
	bool myIsDazedAllowedOnVehicle FALSE < tooltip="If this is true and the npc is on a vehicle, the dazed will be allowed" >
	bool myUseAlternateDazedAnimation FALSE < tooltip="This won't initially do anything it's just for animation to know if they should use a different animation for corresponding NPC." >
}
