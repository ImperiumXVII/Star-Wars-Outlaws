
// This enum needs to be kept in sync with the HC_NPCFocusPointType code enum in HC_NPCFocusPoint.h
// These enum values are referenced by string in graphs.
// It is okay to insert new values inside the enum or to change the order of the values, but not to change the value strings.
enum NPCFocusPointType
{
	NotSet
	Facing 
	HostileTarget // Focus Point pointing out the actual npc target in combat state
	FriendlyNPCEnteringCombat
	FriendlyNPC
	WantedPlayerAction // Focus Point toward the player when the npc is trying to arrest it
	AgentOwner
	PlayerAwarenessTarget // Focus Point generated by the npc NPCPlayerAwareness component when the player is close to it
	PathLookAheadHighPriority // Focus Point toward the direction of the npc path (high priority)
	PathLookAheadLowPriority // Focus Point toward the direction of the npc path (low priority)
	FleeSource
	AlertEventTarget
	CompanionInterestPoint
	Sequence // Global Focus Point pointing out a npc in a sequence
	VO
	TravelAndTalkPlayer // Focus Point toward the player when walking with them during Travel and Talk
	CivilianAmbientNPC // Generic purpose focus point dedicated to Civilain Ambient NPC (e.g. looking around randomly)
	InteractionTarget // Generic purpose focus point dedicated to when you want the NPCs to look at a specific point of interest
}

// This enum needs to be kept in sync with the HC_NPCFocusPointPriority code enum in HC_NPCFocusPoint.h
enum NPCFocusPointPriority
{
	Low
	Medium
	High
	Highest
}

class NPCFocusPointData
{
	NPCFocusPointType myType NotSet
	bool myIsEnabled true < tooltip="If false, this type of focus point will be ignored completely" >
	
	NPCFocusPointPriority myPriority Low
	
	float myLookAtDuration 0.0 < tooltip="For how long keeping the focus on that point before be invalid (in seconds). Zero or less for unlimited time." >
	float myCooldown 0.0 < tooltip="Time (in seconds) to make the focus point, the one the npc was looking at, available again. Zero or less for no cooldown." >
	float myTypeCooldown 0.0 < tooltip="Time (in seconds) to make all the focus points, with the current 'myType', available again. Zero or less for no cooldown." >

	float myMaxDistance 0.0 < tooltip="Max distance to consider the focus point valid. Zero or less for unlimited range." >

	bool myAllowStaticTurn false < tooltip="Whether allow automatically turning to focus target if possible" >
	float myDelayBeforeTurning 0.0 < tooltip="Time to wait before turning" >
	float myMaxAngleBeforeTurning 45.0 < tooltip="Difference in angle to reach before turning" >
	float myMaxLookAtAngle 360.0 < tooltip="Maximum allowed turn angle with the focus point to continue to follow it." >

	float myLookAtSpeed 50.0 < max=50.0 tooltip="Speed to look at the active focus point." >
}

list NPCFocusPointDataList
{
	NPCFocusPointData
}

class NPCFocusProfile < uid=auto >
{
	bool myIsEnabledInSequence false
	NPCFocusPointDataList myFocusPointDataList
}
