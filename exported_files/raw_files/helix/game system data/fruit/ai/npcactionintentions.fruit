// These enums are referenced in data by string.
// It is okay to add enums or change the order or these enums, but changing the text values will break existing uses.
enum NPCActionIntentionType
{
	NotSet
	RunTowardsAlarm
	TriggerAlarm
	ReportWantedAction
	ArrestPlayer
	SelfHeal
	GrenadeLauncher
	GrenadeThrow
	SniperShot	
	SkittererCall
	RancorCharge
	KraytDragonAttack
	InvestigatingCorpse
	InvestigateWhistle
	PickupWeapon
}

class NPCActionIntentionEntry
{
	NPCActionIntentionType myType
	bool myIsImportant false
	string myIcon < bhv=sprite >
}

list NPCActionIntentionList
{
	NPCActionIntentionEntry
}

class NPCActionIntentionSettings < uid=auto >
{
	NPCActionIntentionList myEntries
}