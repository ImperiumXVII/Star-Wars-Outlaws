class ShootingDirectionFlags < uid=auto >
{
	bool Front true
	bool Back true
	bool Left true
	bool Right true
}

class NPConNPCAttachmentSlot < uid=auto >
{
	NPConNPCAttachmentSlotType mySlot None
	
	uid myAttachedAgent < bhv="constantData" constantDataType="npc" >
	
	bool myReleaseable true

	bool myRespawnable false < tooltip="When true an attached ship will be periodically respawned in this slot." >

	float myRespawnDelay 5 < tooltip="Cooldown period for respawning a new ship in the slot." >
	
	int myRespawnCharges 5 < tooltip="How many times can a slot respawn attached agents." > 

	float myCollisionEnableDelay 1 < tooltip="Delay used to allow attachment to get away from the host, without colliding with it in the meantime. Currently used only for the spaceship physics." >
	
	ShootingDirectionFlags myShootingDirections
}

list NPConNPCAttachmentSlotList
{
	NPConNPCAttachmentSlot
}

class NPConNPCAttachmentSet < uid=auto >
{
	file myDetachSequence "" < bhv=asset assettype=sequence >
	NPConNPCAttachmentSlotList myNPCAttachments
}