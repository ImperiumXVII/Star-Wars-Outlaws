include "helix/game system data/fruit/ai/motion/motionpatternprofile.fruit"
include "helix/game system data/fruit/camera/cameralookatpreset.fruit"

enum PetTrailWaitType
{
	None
	Manual
	Reach
	Delay
}

class PetTrailStep < uid=auto >
{
	bool myEnabledCheckPoint false
	uid mySpawnPointEntity

	bool myEnabledStartSequence false
	uid myStartSequence

	bool myEnabledEndSequenceGroup false
	uid myEndSequence

	bool myEnabledStartLookat false
	CameraLookAtPreset* myStartLookatPreset
	float myStartLookatDuration 0.0f
	bool myStartIsTimedLookat

	bool myEnabledEndLookat
	CameraLookAtPreset* myEndLookatPreset
	float myEndLookatDuration 0.0f
	bool myEndLookatIsTimed

	bool myEnabledStartVisibility false
	bool myStartVisibility false

	bool myEnabledEndVisibility false
	bool myEndVisibility false

	bool myEnabledStartVoice false
	string myStartVoice

	bool myEnabledIdleAnimation false

	bool myEnabledMove false
	NPCMotionPatternType myMoveType Walk

	bool myEnabledWait false
	float myWaitTime 0.0f
	PetTrailWaitType myWaitType
}

list PetTrailStepInfoList
{
	PetTrailStep
}

class PetTrail < uid=auto >
{
	PetTrailStepInfoList myPetTrailSteps < tooltip="List of all steps in this pet trail beat" >
	uid myQuest < bhv="constantData" constantDataType="questbeat" >
	uid myReward < bhv="constantdata" constantDataType="reward" tooltip="Reward on completing the pet trail" >
}
