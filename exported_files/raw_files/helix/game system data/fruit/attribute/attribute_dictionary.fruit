include "helix/game system data/fruit/attribute/formulacontexttypes.fruit"

class Specialization
{
	string myCondition < bhv=formulaEditor tooltip="A formula defining the condition" >
	string myFormula < bhv=formulaEditor tooltip="A formula that overrides the default formula if the condition is true" >
}

list SpecializationList
{
	Specialization
}

enum AttributeBonusUnit
{
	Value
	Seconds
	Meters
	HP
	HPPerSecond
}

enum AttributeBonusType
{
	FlatValue
	Modifier
	Percentage	

	None	
}

enum RoundMode
{
	None
	Floor
	NearestHalf
	Ceiling
	Nearest
	NearestTenth
}

class AttributeDefinition < uid=auto >
{
	string myOriginalFormula < bhv=formulaEditor tooltip="Formula using a combination of standard math and other attributes as variables">
	SpecializationList mySpecializations < tooltip="The first specialization with a valid condition will override the default formula">
	AttributeBonusType myBonusType None
	AttributeBonusUnit myUnit Value
	RoundMode myRoundMode None
	
	varmap myUIName < bhv="localization" >
	int myUINumDecimals 0
}

list AttributeDefinitionList
{
	AttributeDefinition
}

list AttributeDefinitionCategory
{
	AttributeDefinitionList
}

class AttributeDictionary
{
	FormulaResolveContextType myFormulaResolveContextType AgentAttributes
    AttributeDefinitionCategory myAttributeDefinitionCategories
}

list AttributeList
{
	uid < bhv=bonusAttributeList >
}