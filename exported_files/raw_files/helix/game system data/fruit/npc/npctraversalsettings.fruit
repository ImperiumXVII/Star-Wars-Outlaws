include "helix/game system data/fruit/ai/pathfinding/user_edge_types.fruit"

list TraversalSettingsList
{
	TraversalSettings
}

class TraversalSettings
{
	UserEdgeType myUserEdgeType
	bool myAllowMultipleEntries false < tooltip="Allow multiple NPCs to use the navlink at the same time" >
	float myCooldownBetweenUsages 0.0 < min=0 tooltip="Cooldown in seconds for two NPCs going in the same direction on the navlink" >
	float myExclusivityCooldown 0.0 < min=0 tooltip="Cooldown in seconds until another NPC can claim the prop after an exclusive claim" >
	float mySwitchDirectionCooldown 0.0 < min=0 tooltip="Cooldown when an NPC finishes using a ladder and another one wanting the use it from the other direction, so that they don't clip through each other" >
	float myStopDistanceBetweenNPC 0.0 < min=0 tooltip="Minimum distance to keep from the next NPC waiting to claim the prop" >  
}
