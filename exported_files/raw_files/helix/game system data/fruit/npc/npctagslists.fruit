{
	RBTagsTag*  < compact_view=1 bhv=rbtags rbtags_filter="~+Gender" >
}

list NPCSpeciesTagsList
{
	RBTagsTag*  < compact_view=1 bhv=rbtags rbtags_filter="~+Species" >
}

list NPCSynergyTagsList
{
	RBTagsTag* < compact_view=1 bhv=rbtags rbtags_filter="~+Synergy" >
}