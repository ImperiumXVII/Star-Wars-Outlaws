// Must match enum HC_PetAttackTargetType in code/helix/HClient/HC_NPCConstantData.h
enum PetAttackTargetType
{
	None
	HumanoidLight
	HumanoidMedium
	HumanoidHeavy
}

// The combat role for a npc. 
// It is okay to insert new values inside the enum or to change the order of the values, but not to change the value strings.
enum NPCCombatRole
{
	None
	Assault
	Beast
	Commander
	Heavy
	Melee  
	Sniper
	Mech
	Elite
	Companion
	Interceptor
	Fighter
	LightFreighter
	Warship
	SpaceTurret
	Worker
	Prey
}

// The behavior state of an NPC.
// We use this enum to declear an animation variable instead of using a bunch of boolean or int variable for better readibility.
enum NPCBehaviorState
{
	None
	Aware
	Stressed
	OnSpotAttack
	JumpAttack
	PounceAttack
	RangeAttack
	GrabPrepare
	GrabAttack
	GrabFail
	Taunt
	DodgeLeft
	DodgeRight
	DodgeBack
	Backoff
	TailRegen
	FleeFinishingToCasual
	CornerRoar
	Beg
	Celebrate
	AwareBark
	PointlessBark
	TargetLostBark
	MasterLostBark
	StalkingHeavyGrowl
	StalkingTaunt
	StalkingGrowl
	StalkingIdle
	StalkingDodgeLeft
	StalkingDodgeRight
	StalkingDodgeBack
	CombatToCasual
	CasualToCombat
	Unreachable
	LongRangeAttack
	HitTarget
	MissTarget
	IdleSit
	IdleHanging
	FleeInTree
	JumpAttackPrepare
	JumpAttackPrepareFailTransition
	TauntWithDisplacement
	CasualMoveToCombatIdleTransition
	Summon
}

enum NPCFacialState
{
	None
	OrderAcknowledged
	FlyerGuide
	FlyerWait
}

enum NPCMusicProfileType
{
	None
	KraytDragon
	Rancor
}

enum NPCRiderType
{
	Civilian
	Military
}

