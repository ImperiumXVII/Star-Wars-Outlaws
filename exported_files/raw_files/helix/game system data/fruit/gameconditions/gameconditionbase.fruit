// Keep in sync with HC_GameCondition::InternalOperator
enum GameConditionOperator
{
	Equal
	NotEqual
	GreaterThan
	GreaterThanOrEqual
	LessThan
	LessThanOrEqual
}

// Keep in sync with HC_GameConditionAgentContextType in HC_GameConditionAgentTypeEnums.h
enum GameConditionAgentContextType
{
	SourceAgent
	TargetAgent
}

class GameCondition < abstract=1 >
{
	GameConditionType myType < hidden=1 >
	
	bool myIsNegated FALSE
}

list GameConditionList
{
	GameCondition
}
