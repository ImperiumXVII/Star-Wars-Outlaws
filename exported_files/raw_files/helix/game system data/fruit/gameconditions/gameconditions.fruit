enum GameConditionGroupOperator
{
	And
	Or
}

// Can be used to create a GameConditionGroup with access to only certain types of game conditions
// Create a class that inherits from this and add a list of GameConditions called myConditions to it.
class GameConditionGroupBase : GameCondition
{
	GameConditionType myType Group < hidden=1 >

	GameConditionGroupOperator myOperator And
	bool myCanBeOverridden false < hidden=1 >
}

class GameConditionOverridableGroupBase : GameConditionGroupBase
{
	bool myCanBeOverridden false
}

class GameConditionGroup : GameConditionGroupBase
{
	GameConditionList myConditions
}

