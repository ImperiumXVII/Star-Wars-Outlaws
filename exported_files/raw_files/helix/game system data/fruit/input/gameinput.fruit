enum GameActionState
{
	IsSprinting
	IsForcedSliding
	IsAiming
	IsAimLockControlType_CameraOffset
	IsAimLockControlType_SimpleRightAndLeft
	CanForceOverHeat
	IsAnyPlayerInteractionNearby
	IsEquipmentOverHeat
	IsRestricted_ChangeWeaponModule
	IsBoundToGrappleOrRappel
	IsHoldingPickableWeapon
	IsUsingAlternatePreset
	IsPickableWeaponInHolster
}

class ConditionalGameActionState : ConditionalGameActionBase
{
	GameActionState myGameActionState
}

class ConditionalGameAction : ConditionalGameActionBase
{
	GameAction myGameAction
}

class HardcodedUIInput
{
	MIN_ButtonName myButtonName
	int myAxisDirection 0 < tooltip = "If an axis was selected, specify which direction to show. Negative, Neutral or Positive." >
}

list InputActionList
{
	ConditionalInputActionBase
	ConditionalGameActionBase
	ConditionalActionGroup
	HardcodedUIInput
}

class TriggerGameAction
{
	InputActionList myConditionalInputActions < tooltip="List of input conditions" >
	GameAction myGameAction < tooltip="The game action to enable if all conditions are met" >
	bool myRequireNewInputOnContextChange TRUE < tooltip="Uncheck this if you want held actions to re-evaluate without a repress after context changes." >
	bool myIsCinematicAction < tooltip="If true, this will only trigger when in Cinematic Mode" >
	bool myIsExclusiveToggle < tooltip="If true, this will disable any other active GameAction that also has this set to true" >
	string myConsoleCommand < tooltip="If set, this console command will be run when the action is triggered" >
	GameActionContexts myActionContexts < tooltip="This action will be triggered in the selected contexts" >
	ExcludeGameActionContexts myExcludeInActionContexts < tooltip="This action will not be triggered in these contexts" >
}
