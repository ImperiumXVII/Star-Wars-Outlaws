include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/audio/stimulus.fruit"

list GameConditionGroupPetProtectiveSkillUnlockConditionsList
{
    GameConditionGroupPetProtectiveSkillUnlock
    GameConditionPlayerHasGearItemEquipped
    GameConditionPlayerHasItem
}

class GameConditionGroupPetProtectiveSkillUnlock : GameConditionGroupBase
{
    GameConditionGroupPetProtectiveSkillUnlockConditionsList myConditions
}

class PetProtectiveSkillSettings < uid=auto >
{
    float myCooldownDuration 15 < tooltip="The skill will wait at least this much time after an activation before triggering again." >
    GameConditionGroupPetProtectiveSkillUnlock myUnlockCondition < tooltip="Unlock condition for the skill. If no condition is provided it will be considered as unlocked by default." >
    float myTriggerDistanceFromPlayer 2 < tooltip="Distance between player and the grenade landing point to trigger the behaviours" >
    bool myShouldTriggerOnPlayerGrenades false < tooltip="If set to true, player's grenades will also trigger the behaviour" >
    bool myUseCustomThrowSpeed true < tooltip="If true, uses throw speed set in data, otherwise it will reuse the one used by the enemy." >
    float myThrowSpeed 20 < tooltip="Throw speed used to throw the grenade back" >
    float myTargetMinDistanceFromPlayer 2 < tooltip="Minimum distance between the player and an enemy for the latter to be considered as a valid target. This is meant to prevent the pet from throwing grenades too close to the player." >
    float myMaxThrowDistance 20 < tooltip="If the pet could not find any enemy in this radius, will just throw the grenade back to the its start position." >
    float myVerticalDisplacementForStartPosition 0.1f < tooltip="Distance from the ground level, applied to the start position of the throw on the vertical direction. This is used to prevent unwanted collision with the ground, since the pet is really close to ground level." >
    StimulusIdentifier* myOnExplosionKayStimulusIdentifier < tooltip="Bark that will be played by Kay when the claimed grenade explodes." >
}