include "helix/game system data/fruit/quest/quest.fruit"

class FirstPartyActivity < uid=auto >
{
	Quest* myQuest
	string myFirstpartyId
    varmap myDisplayName < bhv="localization" >
    varmap myDescription < bhv="localization" >
	bool myIsRequiredForCompletion TRUE < tooltip="Check if the activity is required to be finished to complete the game. Should be true for activities tied to main campaign." >
	bool myIsHiddenByDefault FALSE < tooltip="Check if the activity is supposed to be hidden by default, so players avoid spoilers." >
	bool myIsAvailableByDefault TRUE < tooltip="Check if the activity is available for players from the start of the game." >
}