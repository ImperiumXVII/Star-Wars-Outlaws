class QuadrupedalGroundAlignerParams
{
	string myBankRemapCurve "" < bhv=inputgraph >
	float myForceWorkLodDistance 150.0 < tooltip="Within this LOD distance, GroundAligner will be forced to work, outside the distance according to the NPCLODProfile." >
	float myForwardRefPointOffset 1.0 < tooltip="Control the forward reference point offset. Ideally the offset should match the forelegs' offset." >
	float myBackwardRefPointOffset -1.0 < tooltip="Control the backward reference point offset. Ideally the offset should match the back foots' offset." >
	float myLeftRightRefPointOffset 0.5 < tooltip="Control the left/right reference point offset. Ideally the offset should match the body width." >
	vec2f myCastExtents 1.0;-2.0 < tooltip="Control the ray cast offset andlength. X value represents the offset in Y axis, y value represents the direction and length(for example -2 means cast downward for 2 meters) in y axis." >
	vec2f myYAlignLimits -1.0;0.1 < tooltip="Control the alignment limits only within this limit will animal change its altitude. X value represents the minimal align limit; y value represents the maximum align limits." >
	vec2f myYAlignSnapRange 0.0;-0.2 < tooltip="Control the alignment range, within this range animal will directly snap to the ground. X value represents the minimal align range; y value represents the maximum align range." >
	float myYAlignSpring 6.0 < tooltip="If altitude target is not within snap range, use the spring method to adjust altitude. This control the spring magnitude." >
	float myYAlignDamping 1.0 < tooltip="If altitude target is not within snap range, use the spring method to adjust altitude. This control the spring damping." >
	float myAlignAngleLimit 50.0 < tooltip="If angle between ground and raycast position is larger than this value, raycast position will be ignored." >
}

list AlignerRayCastBoneAliasNames
{
	string
}

class CustomBoneAlignerParams
{
	bool myEnableAligner false
	bool myPerformRagdollAlignCheck false
	AlignerRayCastBoneAliasNames myRayCastBoneAliasNames < tooltip="Skeletal chains that need to be raycast. When movement stops raycast until the elevation of all bones is greater than 0. " >
	vec2f myCastExtents 1.0;-2.0 < tooltip="Control the ray cast offset andlength. X value represents the offset in Y axis, y value represents the direction and length(for example -2 means cast downward for 2 meters) in y axis." >
	float mySoftDistance 0.05 < min=0 tooltip="The soft length of the skeletal chain can be retracted." >
}

class QuadrupedalGroundAlignerConfig < uid=auto >
{
	QuadrupedalGroundAlignerParams myParams
	CustomBoneAlignerParams myTailParams
	CustomBoneAlignerParams myHeadParams
}