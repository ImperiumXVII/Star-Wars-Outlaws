// This file is based on snowdrop/modules/rbtags/rbtags_example.fruit.

// These values will be used for the RBTags_TagContainerHierarchyLevel data enum.
// Each tags container specifies a hierarchy level to ensure container validity.
enum RBTagsTagContainerHierarchyLevel
{
	// The names of these items can not be changed without breaking stuff.
	// The order of these items is not important. 
	// They can and should be specialized for the game.
	
	None             // This tag is required by the RBTags module.

	Agent
	Fireteam
	World

	Metric
	Prop
}

// These values will be used for the RBTags_TagCategory data enum.
// A container hierarchy may not hold more than one tag from any given category.
// Also tags with the same category must be part of the same hierarchy level.
enum RBTagsTagCategory
{
	// The names of these items can not be changed without breaking stuff.
	// The order of these items is not important. 
	// They can and should be specialized for the game.

	None             // This tag is required by the RBTags module.
	Archetype
	Activity
	Agent
	AgentWeather
	BehaviorState
	BarksFamily
	BeastMasterBeasts
	BodyType
	Callsign
	CharacterName
	DemoMode
	Duty
	Ethnicity
	Faction
	FashionMoreniaHasPattern
	FashionMoreniaHasPatternShirt
	FashionMoreniaHasPatternVestJacket
	FashionMoreniaHasPatternBottom
	FashionMoreniaPattern
	FashionMoreniaStandout
	FashionMoreniaShirtStandout
	FashionMoreniaVestJacketStandout
	FashionMoreniaBottomStandout
	FashionMoreniaColor
	FashionRokanaRaider
	GameMode
	Gender
	Group
	HairColor
	HairCut
	Health
	InCombat
	LocationName
	Map
	MapType
	Meta
	Metric
	Mood
	NPCAlertLevel
	Objective
	OnSpeeder
	ProximityAlly
	ProximityEnemy
	PlayerState
	LOSSweep
	Planet
	Portal
	Progress
	Purpose
	Reputation_AshigaClan
	Reputation_CrimsonDawn
	Reputation_GalacticEmpire
	Reputation_HuttClan
	Reputation_PykeSyndicate
	Reputation_ZerekBash
	ShipType
	Skeleton
	Species
	SpeederSpeed
	Time
	Vendor
	VendorReputation
	VendorContractOutOfJobs
	WantedLevel
	Weapon
	Wing
	Wildlife
	WorldTime

	UnittestAgent    // This tag is required by the RBTags unit tests.
	UnittestFireteam // This tag is required by the RBTags unit tests.
	UnittestWorld    // This tag is required by the RBTags unit tests.
}

// These values will be used for the RBTags_DebugSource data enum.
enum RBTagsDebugSource
{
	// The names of these items can not be changed without breaking stuff.
	// The order of these items is not important. 
	// They can and should be specialized for the game.
	None
	ClaimCAPInteraction
	FindCAPInteraction
	PatrolGetWaypointCAPInteraction
	AgentBark
	CharacterBark
	CommsScanner
}


// Below this line changing any of the types will require changes to the RBTags module code.

class RBTagsTag < uid=auto >
{
}

list RBTagsTagList
{
	RBTagsTag*
}

class RBTagsBinaryTags < uid=auto >
{
	RBTagsTag* myTag
	RBTagsTag* myNegativeTag
	RBTagsTag* myParentTag
	bool myDefaultTagIsMyNegativeTag TRUE

	RBTagsTagContainerHierarchyLevel myLevel None
	RBTagsTagCategory myCategory None
	
	float myLifeTimeInSeconds -1 < tooltip="Value <= 0 will be considered as Infinite. \nLifeTime only applies to the non-default tag." >
}