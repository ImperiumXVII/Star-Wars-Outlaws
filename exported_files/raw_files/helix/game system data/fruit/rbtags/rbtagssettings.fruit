include "helix/game system data/fruit/rbtags/rbtags.fruit"

class WeatherPresetRBTags
{
	file myWeatherPresetFile "" < bhv=asset assettype=environment >
	RBTagsTagList myTags
}

list WeatherPresetRBTagsList
{
	WeatherPresetRBTags
}

class SkeletonRBTagPair
{
	string mySkeletonID
	RBTagsTag* myTag
}

class CategoryDefaultPair
{
	RBTagsTagCategory myCategory
	RBTagsTagList myTagsIfEmpty
}

list SkeletonRBTagList
{
	SkeletonRBTagPair
}

list CategoryDefaultList
{
	CategoryDefaultPair
}

class RBTagsSettings < uid=auto >
{
	// player archetype tags
	RBTagsTag* myAgentArchetypePlayerTag

	// agent state tags
	RBTagsTag* myAgentHealthDeadTag
	RBTagsTag* myAgentHealthLowTag
	RBTagsTag* myAgentHealthMediumTag
	RBTagsTag* myAgentHealthHighTag

	RBTagsTag* myAgentInCombatTag
	RBTagsTag* myAgentPlayerStateCombatTag
	RBTagsTag* myAgentPlayerStateStealthTag
	RBTagsTag* myAgentPlayerStateSafeTag
	RBTagsTag* myAgentPlayerStateInCoverTag
	RBTagsTag* myAgentPlayerStateIsConcealedTag
	RBTagsTag* myAgentPlayerStateIsOnSpeederTag
	RBTagsTag* myAgentPlayerStateUnderFireTag
	RBTagsTag* myAgentPlayerSpeederStateIsHighSpeedTag
	RBTagsTag* myAgentPlayerSpeederStateIsLowSpeedTag
	RBTagsTag* myAgentPlayerSpeederStateIsStationaryTag
	RBTagsTag* myAgentPlayerTraversalClimbing
	RBTagsTag* myAgentPlayerTraversalGrapple
	RBTagsTag* myAgentPlayerTraversalRappel

	// npc CAP tags
	RBTagsTag* myAgentIsInCAP

	// npc alert levels
	RBTagsTag* myAgentNPCAlertLevelIdleRelaxedTag
	RBTagsTag* myAgentNPCAlertLevelIdleAlertTag

	RBTagsTag* myAgentGroupIsAloneTag
	RBTagsTag* myAgentGroupHasOneAllyTag
	RBTagsTag* myAgentGroupHasMoreThanOneAllyTag

	RBTagsTag* myAgentProximityAllyNoAlliesNearbyTag
	RBTagsTag* myAgentProximityAllyOneAllyNearbyTag
	RBTagsTag* myAgentProximityAllyManyAlliesNearbyTag

	RBTagsTag* myAgentProximityEnemyNoEnemiesNearbyTag
	RBTagsTag* myAgentProximityEnemyOneEnemyNearbyTag
	RBTagsTag* myAgentProximityEnemyManyEnemiesNearbyTag

	// location tags
	RBTagsTag* myAgentLocationOpenWorldTag
	RBTagsTag* myAgentLocationNonCombatAreaTag
	RBTagsTag* myAgentLocationLowSecurityAreaTag
	RBTagsTag* myAgentLocationHighSecurityAreaTag
	RBTagsTag* myAgentLocationCityGameplayAreaTag
	
	// focused beat tags
	RBTagsTag* myAgentInFocusedBeatTag

	// sabacc tags
	RBTagsTag* myAgentSabaccTag

	// fireteam
	RBTagsTag* myFireteamLeaderHasLeaderTag

	// fireteam activity tags
	RBTagsTag* myFireteamActivityDefendingTag

	// agent weather tags
	RBTagsTag* myAgentWeatherRainTag
	RBTagsTag* myAgentWeatherFogTag
	RBTagsTag* myAgentWeatherThunderTag
	RBTagsTag* myAgentWeatherSunTag
	RBTagsTag* myAgentWeatherCloudTag
	RBTagsTag* myAgentWeatherWindTag
	RBTagsTag* myAgentWeatherSandstormTag
	RBTagsTag* myAgentWeatherSnowTag

	// agent space tags
	RBTagsTag* myAgentSpaceRokanaTag
	RBTagsTag* myAgentInIonNebulaTag

	// world time tags
	RBTagsTag* myWorldTimeDawnTag
	RBTagsTag* myWorldTimeDayTag
	RBTagsTag* myWorldTimeDuskTag
	RBTagsTag* myWorldTimeNightTag
	
	// map type tags
	RBTagsTag* myWorldMapTypePlanetTag
	RBTagsTag* myWorldMapTypeSpaceTag

	// demo mode tags
	RBTagsTag* myWorldDemoModeE32023Tag

	// game mode tags
	RBTagsTag* myWorldGameModeNormalTag
	RBTagsTag* myWorldGameModeCoopTag

	// world wanted tags
	RBTagsTagList myWorldWantedTags
	RBTagsTag* myWorldWantedCooldownTag
	
	// Skeleton ID to Tag map
	SkeletonRBTagList mySkeletonIDTags
	
	//Category defaults when empty
	CategoryDefaultList myDefaultTagsInCategoryIfEmpty

	WeatherPresetRBTagsList myWeatherTags
	
	RBTagsTag* myWorldNixIsPresentTag
	
	RBTagsTag* myEmpireFactionTag

	float myProximityEnemyDistance 10.0
}
