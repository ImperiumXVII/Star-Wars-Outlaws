include "helix/game system data/fruit/talent/talent.fruit"

class GearSetTalentEntry
{
	int myNumberOfItemsRequired
	TalentList myTalents
}

list GearSetTalents
{
	GearSetTalentEntry
}

class GearSet < uid=auto >
{
	string myUIIcon < bhv="sprite" ui_info=1 >
	varmap myUIName < bhv="localization" ui_info=1 ui_info_debug_ui_name=1 >
	varmap myUIDescription < bhv="localization" ui_info=1 >
    GearSetTalents myGearSetTalents
}

list GearSetlist
{
	GearSet*
}