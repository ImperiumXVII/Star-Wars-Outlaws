include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/gamestatistics/gamestatistics.fruit"

list CantinaMinigameUnlockRequirementList < size=1 >
{
	GameConditionFlag
	GameConditionPlayerHasItem
}

class CantinaMinigame < uid=auto abstract=1 >
{
	file myUIGraph < bhv="asset" assettype="GUI" tooltip="UI graph that runs the minigame." >
	GameConditionPlayerHasItem myCost < tooltip="Which item (preferably a currency) should be consumed when playing?" >
	uid myReward < bhv="constantdata" constantDataType="reward" tooltip="Which reward is given when winning the minigame?" >
	string myJackpotCooldownFormula 0 < bhv="formulaEditor" formulaResolveContextType="AgentAttributes" tooltip="In seconds, how long is the minigame on cooldown after winning the jackpot?" >
	CantinaMinigameUnlockRequirementList myUnlockRequirements < tooltip="This condition will define if the minigame is unlocked." >
}

/////////////////////////////////////////////////////////////////

list WanderingSylop_Beat < size=9 >
{
	vec2i < min=1;1 max=3;3 tooltip="1,1 is bottom-left tile. 3,3 is bottom-right tile." >
}

list WanderingSylop_Beats
{
	WanderingSylop_Beat
}

class WanderingSylop_Round
{
	int myBPM 60 < min=1 tooltip="How many beats per minute during shuffle?" >
	float myAnimationDurationFactor 0.5 < min=0.0001 max=1.0 tooltip="How much time of the beat is spent on moving the cards? Factor between 0-1." >
	WanderingSylop_Beat myInitialCardCoords < tooltip="Where do the cards start from (pre-shuffling)?" >
	WanderingSylop_Beats myBeats
}

list WanderingSylop_Rounds
{
	WanderingSylop_Round
}

class WanderingSylopCantinaMinigame : CantinaMinigame
{
	WanderingSylop_Rounds myRounds
}

/////////////////////////////////////////////////////////////////
class ShopliftingMinigame : CantinaMinigame
{
	bool myHasInitialRound true < tooltip="If True, the first round will not have a timer, to prevent having to instantly react when the menu opens up." >
	vec2f myTimeoutTimeRange < min=0;0 tooltip="(Optional) Min and Max ranges for the timeout in seconds. If omitted, no timeout will be used." >
	bool myIsTimeoutTimeChosenPerRound false < tooltip="If True, a new random timeout will be selected each round. If False, the same will be used during the entire shoplift attempt." >
	vec2f myTimingBarPeriodRange 2;2 < tooltip="Min and Max ranges for the timing bar period. Dictates how long it will be until the marker returns to its starting position and direction." >
	bool myIsTimingBarPeriodChosenPerRound false < tooltip="If True, a new random timing bar period will be selected each round. If False, the same will be used during the entire shoplift attempt." >
	bool myStartTimingBarAtRandomPosition true < tooltip="Option to make the timing bar always start at a random position, to make it less predictable." >
	vec2f myOkayCenterRange 0.5;0.5 < min=0;0 max=1;1 tooltip="Range for the okay-region center-position. Between 0(left) and 1(right)." >
	vec2f myOkayWidthRange 0.4;0.6 < min=0;0 max=1;1 tooltip="Range for the okay-region width. Between 0(none) and 1(all)." >
	vec2f myPerfectCenterRange 0.5;0.5 < min=0;0 max=1;1 tooltip="Range for the perfect-region center-position. Between 0(left) and 1(right)." >
	vec2f myPerfectWidthRange 0.02;0.1 < min=0;0 max=1;1 tooltip="Range for the perfect-region width. Between 0(none) and 1(all)." >
	bool myPerfectAlwaysWithinOkay true < tooltip="Makes sure that the Perfect-region is always within the Okay-region." >

	vec2i myRoundsRange 4;8 < tooltip="" >
	vec2i myEmptyRounds 0;2 < tooltip="" >

	GameStatistic* myDomainOfMasteryShopliftingGameStatistic
	GameStatistic* myMissSearchGameStatistic
	GameStatistic* myOkaySearchGameStatistic
	GameStatistic* myPerfectSearchGameStatistic
}

/////////////////////////////////////////////////////////////////