include "helix/game system data/fruit/attribute/attribute_bonus.fruit"

class BaseTalent < uid=auto abstract=1 >
{
	varmap myName < bhv="localization" ui_info=1 ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" ui_info=1 >
	string myIcon < bhv="sprite" ui_info=1 >
	bool myShowAttributesInUI false < ui_info=1 >
	
	BonusList myAttributeBonuses
	file myGameScript "" < bhv=asset assettype="Game Script/Talent" >
	float myDuration 0.0 < hidden=1 min=0.0 >
}

class Talent : BaseTalent 
{
}

class TimedTalent : BaseTalent
{
	float myDuration 1.0 < tooltip="0 means it's not timed. Timed talents won't stack effects, instead the duration will be reset." min=0.0 >
}

list TalentList
{
	Talent*
}

list TalentListUID
{
	uid < bhv="constantData" constantDataType="BaseTalent" >
}

list TimedTalentList
{
	TimedTalent*
}