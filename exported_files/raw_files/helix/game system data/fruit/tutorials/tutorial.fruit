include "helix/game system data/fruit/input/gameinput.fruit"

list GameActionEnumList
{
	GameAction
}

class Tutorial < uid=auto abstract=1 >
{
	varmap myTitle < bhv="localization" >
	varmap myText < bhv="localization" tooltip="Text displayed when the player uses a gamepad or if the keyboard text is empty." >
	GameActionEnumList myGameActions < tooltip="Game Actions displayed when the player uses a gamepad or if keyboard text is empty" >
	varmap myKeyboardText < bhv="localization" tooltip="Text displayed when the player uses a keyboard and a mouse." >
	GameActionEnumList myKeyboardGameActions < tooltip="Game Actions displayed when the player uses a keyboard and a mouse." >
	varmap myTTS < bhv="localization" tooltip="[OPTIONAL] If set, read this instead of the normal text. DOES NOT REQUIRE TRANSLATION - MARK IT AS SUCH" >
	varmap myKeyboardTTS < bhv="localization" tooltip="[OPTIONAL] If set, read this instead of the normal text. DOES NOT REQUIRE TRANSLATION - MARK IT AS SUCH" >
}

class TutorialHint : Tutorial
{
}

class TutorialPrompt : Tutorial
{
	varmap myTitle < hidden=1 >
}
