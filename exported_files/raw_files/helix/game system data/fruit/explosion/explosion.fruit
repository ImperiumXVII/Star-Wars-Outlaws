include "helix/game system data/fruit/combat/combat.fruit"
include "helix/game system data/fruit/effects/effects.fruit"
include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/statuseffect/status_effect.fruit"
include "snowdrop/modules/core/audio/audio.fruit"
include "helix/game system data/fruit/effects/fluffy.fruit"
include "helix/game system data/fruit/rumble/rumble.fruit"
include "helix/game system data/fruit/ai/aievents.fruit"
include "helix/game system data/fruit/dynamicnpcgear/dynamicnpcgearenums.fruit"

list DynamicNPCGearSlotTargets
{
    DynamicNPCGearSlot
}

enum ExplosionBlockerType
{
	None
	StaticOnly
	DynamicAndStatic
	ShieldAndStatic
}

class ExplosionSection  < abstract=1 >
{
	float mySize 1.0 < tooltip = "Size is a percentatge of the explosion radius" >
}

class ExplosionFragmentablesSection : ExplosionSection
{
	float myEnvironmentalDamage 100.0
	float myEnvironmentalDamageVariation 15.0
	float myLocalClothReactionRadius 1.0 < tooltip = "When the explosion hits a cloth, we apply a cloth reaction on that point using this radius to define the area of the cloth will be affected." >
	bool myOnlyTargetDestroyables false < tooltip = "Make the explosion only affect the Fragmentables that also have a Destroyable node" >
}

class ExplosionPhysicsSection : ExplosionSection
{
	float myImpactEnergy 100.0 < tooltip = "This value will be multiplied by the mass of the object to trigger a physic object reaction" >
	string myImpactEnergyMultiplierByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph >
}

class ExplosionStagger
{
	float myStaggerDamage 1.0 < min=0.0 tooltip="Optional override to apply an additional amount of stagger damage (even if actual damage is 0), optionally in a different damage type (set below)" >
	string myStaggerDamageMultiplierByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0.1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Stagger damage multiplier by distance ratio (between 0 and 1)." >
	DamageType myStaggerDamageOverrideDamageType Physical < tooltip="The type of stagger damage to apply. Can be set to Unknown if it should match the damage type of the explosion." >
}

class ExplosionGameplayDamageSection : ExplosionSection
{
	float mySize 1.0 < hidden=1 >
	
	ExplosionBlockerType myBlockerType ShieldAndStatic
	DamageType myDamageType Physical
	DamageTargetType myDamageTargetType All
	
	string myDamageFormula 1.0 < tooltip="Calculating damage for this explosion" bhv=formulaEditor formulaResolveContextType=Explosion >
	float myDefaultDamage 1.0 < tooltip="The default damage used if projectile source is not an agent" >
	string myDamageMultiplierByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0.1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Damage multiplier by distance ratio (between 0 and 1).">
	
	bool myStaggerDamageOverrideEnabled FALSE
	float myStaggerDamageOverride 1.0 < min=0.0 tooltip="Optional override to apply a set amount of stagger damage (even if actual damage is 0)" >
	string myStaggerDamageOverrideMultiplierByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0.1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Stagger damage multiplier by distance ratio (between 0 and 1)." >
	
	bool myAdditionalStaggerDamageEnabled FALSE
	ExplosionStagger myAdditionalStaggerDamage

	bool mySensoryStaggerEnabled FALSE
	ExplosionStagger mySensoryStagger < tooltip="This stagger is applied to NPC only, it takes place if the victim has been discarded as damage victim but the sensory position is reachable. Mainly for get NPCs from cover through stagger" >

	bool myOverriddenStaggerDurationEnabled FALSE
	float myOverriddenStaggerDuration 0.0 < tooltip = "The victim of the imapct will apply this stagger duration instead of the normal one. IMPORTANT: If you change this value remeber to also change OverriddenStaggerDisplacement to keep the speed consistent." >

	bool myOverrideStaggerDisplacementEnabled FALSE
	float myOverrideStaggerDisplacement 0.0 < tooltip = "The victim of the imapct will apply this stagger duration instead of the normal one. IMPORTANT: If you change this value remeber to also change OverriddenStaggerDuration to keep the speed consistent." >

    DynamicNPCGearSlotTargets myTargetedDynamicNPCGearSlots < tooltip = "If the target of the explosion has any DynamicNPCGear with this tag, that gear will be affected by the explosion" >

	bool myDamageSelf true
	bool myFriendlyFireEnabled true
	bool myPlayerSourceFriendlyFireEnabled false < tooltip="If 'myFriendlyFireEnabled' is false, this flag does not have an effect. If 'myFriendlyFireEnabled' is true, this flag can be used to disable friendly fire for when the player is the source agent." >
}

class ExplosionGameplayHealSection : ExplosionSection
{
	float mySize 1.0 < hidden=1 >
	
	ExplosionBlockerType myBlockerType ShieldAndStatic
	
	string myHealFormula 1.0 < tooltip="Calculating heal for this explosion" bhv=formulaEditor formulaResolveContextType=Explosion >
	float myDefaultHeal 1.0 < tooltip="The default healing used if projectile source is not an agent. The heal is instant." >
	string myHealMultiplierByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Healing multiplier by distance ratio (between 0 and 1).">
	
	float myHealOverTime 0.0 < tooltip="This is the amount of healing you would want to be applied over time. Keep in mind that the instant heal set above will lessen what you set here, it is not additive." >
	float myHealOverTimeDamageAmount 0.0 < tooltip="If healing over time getting interrupted from damage is true, then this will be the amount of damage required to interrupt the healing process." >
	float myHealOverTimeDamageTimeWindow 1.0 < tooltip="If healing over time getting interrupted from damage is true, then this will be the time we keep track of how much damage you have taken." >
	bool myDamageInterruptsHealingOverTime false < tooltip="If this is true, taking damage will stop the healing over time" >
	
	bool myHealSelf true
	bool myHealBySegment false
	bool myOnlyHealFriendlies false
}

class ExplosionIonChargeSection : ExplosionSection
{
	string myIonChargeFormula 0.0 < tooltip="Calculating ion charge for this explosion" bhv=formulaEditor formulaResolveContextType=Explosion >
	float myDefaultIonCharge 0.0 < tooltip="The default ion charge used if projectile source is not an agent" >
	string myIonChargeMultiplierByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0.1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Ion charge multiplier by distance ratio (between 0 and 1).">
	
	bool myIonChargeSelf false
	bool myFriendlyFireEnabled true
}

class ExplosionBendShockwaveSection : ExplosionSection
{
	float myBendStrength 1.0 < min=0.0 max=50.0 >
	float myTrampleStrength 1.0 < min=0.0 max=50.0 >
	float myWidth 1.0 < min=0.0 max=50.0 >
}

class ExplosionWaterWaveSection : ExplosionSection
{
	bool mySplashAddSurface true
	float mySplashStrength 0.1f
	bool mySplashAddFoam true
	float mySplashFoamStrength 0.05f
}

class ExplosionCameraShakeSection : ExplosionSection
{
	ShakeCameraModifier* myCreationShake < tooltip="This camera shake is triggered once when the detonation starts if the camera is inside the max radius" >
	string myCreationStrengthByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph >
	ShakeCameraModifier* myLoopShake < tooltip="This camera shake is triggered when the detonation starts if the camera is inside the max radius and keeps alive the effect in a loop while the detonation grows." >
	string myLoopStrengthByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="This strength is a bit special because it is based on the distance to the shockwave" >
	ShakeCameraModifier* myImpactShake < tooltip="This camera shake is triggered once the detonation sphere hits the camera." >
	string myImpactStrengthByDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph >
}

// Hidding the flags as they will be set contextually in code
class ExplosionRumble : Rumble
{
	bool myIsPositional false < hidden=1 >
	bool myIsRotational false < hidden=1 >
	bool myIsLoop false < hidden=1 >
	float myRadius 1.0f < hidden=1 >
}

class ExplosionRumbleSection : ExplosionSection
{
	ExplosionRumble myCreationRumble
	ExplosionRumble myLoopRumble
	ExplosionRumble myImpactRumble
}

class ExplosionImpactEffect
{
	EffectsByMaterials myEffects
	float myCastForImpactGroundDistance 1.0
}

class ExplosionStatusEffectSection : ExplosionSection
{
	ExplosionBlockerType myBlockerType None
	StatusEffectType myStatusEffect NotSet
	float myDuration 1.0
}

list ExplosionStatusEffectSectionList
{
	ExplosionStatusEffectSection
}

class ExplosionFlinchSection : ExplosionSection
{
	
}

class ExplosionAudioSection : ExplosionSection
{
	AudioEvent myDetonationEvent
	AudioEvent myUnderWaterDetonationEvent < tooltip="Event used instead of DetonationEvent if the explosion detonates underwater.">
	AudioEvent myShockwaveLoopStartEvent
	AudioEvent myShockwaveLoopStopEvent
	AudioEvent myShockwavePlayerImpactEvent
	AudioRTPC myDetonationRadiusRTPC
	float myEmitterSphereRadius 1.0 < tooltip="Emitter Sphere Radius property from Emitter Prefeb.">
	float myMinimumUnderWaterDepth 0.1 < min=0.0 tooltip="Minumum water depth of emitter to use UnderWaterDetonationEvent. Anything above this depth will use the DetonationEvent." >
	bool mySetWaterGameSyncs true < tooltip="Set water volume game syncs (Underwater switch, water depth RTPC, etc.).">
	bool mySetWeatherGameSyncs true < tooltip="Set weather mask game syncs (InPuddle switch, wetness, snow, etc.). If checked, events will be posted from weather sampler callback a few frames after detonation.">
}

class ExplosionFluffySection : ExplosionSection
{
	FluffyDeformationRingsConfig myBasicDeformation < tooltip="If no decal been provided, fluffy will use this deformation instead. The radius will be the radius of the section itself." >
	bool myDecalSizeLinkedToSection true < tooltip="If true, the size of the decal provided by data will be overriden by the section size" >
	bool myDecalProgressiveScaleEnabled false < tooltip="If true the decal size will scale with the explosion radius" >
	FluffyDecal myDecal
}

class ExplosionAIEvent
{
	AIEvent myType NotSet
	float mySize 1.0 < tooltip = "Size is a percentatge of the explosion radius" >
	float myLifetime 0.0
	bool ExplosionOwnerAsTarget true
	bool ExplosionOwnerAsSource false
}

list ExplosionAIEventList
{
	ExplosionAIEvent
}

class BaseEffectByConditions
{
	GameConditionImpactGroup myConditions
	file myEffect "" < bhv=asset assettype=particles >
}

list BaseEffectByConditionsList
{
	BaseEffectByConditions
}

class ExplosionDetonation
{
	float myPropagationSpeed 150.0 < min=0.1 tooltip = "This is the time the propagation speed on meters per second." >
	float myStartTime 0.0 < tooltip = "Time it takes all the detonation to start to grow." >
	file myBaseEffect "" < bhv=asset assettype=particles tooltip = "This effect is executed if there is no effect with a valid condition executed" >
	BaseEffectByConditionsList myBaseEffectsByConditions < bhv=asset assettype=particles tooltip = "If an effect has its conditions validated, the effect is executed. " >

	ExplosionImpactEffect myImpactEffect < tooltip = "This effect is executed in addition to the default one if the ground is close enough to the explosion center." >
	
	ExplosionCameraShakeSection myCameraShakeSection < tooltip = "This is an effect focused on the player only." >
	ExplosionRumbleSection myRumbleSection < tooltip = "This is an effect focused on the player only." >
	
	bool myGameplayDamageEnabled true
	ExplosionGameplayDamageSection myGameplayDamageSection
	bool myIonChargeEnabled false
	ExplosionIonChargeSection myIonChargeSection
	bool myGameplayHealEnabled false
	ExplosionGameplayHealSection myGameplayHealSection
	
	ExplosionStatusEffectSectionList myStatusEffectSections
	
	bool myFragmentablesEnabled true
	ExplosionFragmentablesSection myFragmentablesSection < tooltip = "This section setup how the explosion will affect fragmentable graph objects that implement the destruction system" >
	
	bool myPhysicsEnabled true
	ExplosionPhysicsSection myPhysicsSection < tooltip = "This section adds a physical push reaction against physic dynamic objects onside it" >
	
	bool myBendShockwaveEnabled true
	ExplosionBendShockwaveSection myBendShockwaveSection < tooltip = "This section adds a bend shockwave (used primarily to bend the greass)" >
	
	bool myWaterWaveEnabled true
	ExplosionWaterWaveSection myWaterWaveSection
	
	bool myFlinchEnabled true
	ExplosionFlinchSection myFlinchSection < tooltip = "This section is active only during the time the gameplaydamage is no longer active. This way hit reactions are not affected by gestures." >

	bool myFluffySectionEnabled true
	ExplosionFluffySection myFluffySection < tooltip = "This section decides how to affect fluffy/deformable terrain (i.e. sand, snow...) thorugh a fluffy decal or a basic deformation" >

	ExplosionAudioSection myAudioSection
	
	ExplosionAIEventList myAIEvents
}

list ExplosionDetonationList
{
	ExplosionDetonation
}

class Explosion < uid=auto >
{
	float myDefaultRadius 1.0 < tooltip = "If no custom radius is provided on runtime, this radius will be used" >
	
	ExplosionDetonation myDetonation
	ExplosionDetonationList myExtraDetonationList
}
