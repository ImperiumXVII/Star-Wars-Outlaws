
class UbisoftConnectCardStat
{
	varmap myCardStatName < tooltip="Localized name of stat showing up on UC card." bhv="localization" >
}

list UbisoftConnectCardStatList
{
	UbisoftConnectCardStat
}

class UbisoftConnectCardConfig < uid=auto >
{
	UbisoftConnectCardStatList myCardConfig < tooltip="The list of stats that are supposed to show up on UC cards. Only used for localization input/track purpose.">
}