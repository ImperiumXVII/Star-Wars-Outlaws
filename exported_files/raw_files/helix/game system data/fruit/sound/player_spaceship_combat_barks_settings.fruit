include "helix/game system data/fruit/audio/stimulus.fruit"
include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/npc/npc.fruit"
include "helix/game system data/fruit/settings/spaceshipenums.fruit"

enum PlayerSpaceshipCombatBarkOrientation
{
	FacingPlayer
	AwayFromPlayer
	Both
}

class PlayerSpaceshipCombatBark
{
	SpaceshipTypeList mySpaceshipTypes
	Factions mySpaceshipFactions < tooltip="Applicable only for group validation requirement. Bark criterias have to be met by all in-combat faction member ships, before playing the bark." >
	NamedNPC myNamedNPC ND5
	StimulusIdentifier* myStimulus
	float myPredictedTime 2
	float myMinRadius 10
	float myMaxRadius 500

	float myAngle 0
	float myAngleThreshold 45
	float myPredictedAngleAdditionalThreshold 15

	bool myIsGroupValidationRequired false < tooltip="If true, the bark will be evaluated against all spaceships in-combat with the player before playing. Agent playing the bark will be randomly selected from the pool." >

	SpaceshipCombatManeuverTypeList myCombatManeuvers
	PlayerSpaceshipCombatBarkOrientation myEnemyOrientationToPlayer Both

	vec3f myDebugPos
	color myDebugColor 0xFFFFFFFF
}

list PlayerSpaceshipCombatBarkList
{
	PlayerSpaceshipCombatBark
}

class PlayerSpaceshipCombatBarksSettings < uid=auto >
{
	PlayerSpaceshipCombatBarkList myBarks
}
