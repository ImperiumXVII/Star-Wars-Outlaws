include "helix/game system data/fruit/bodypart/bodypart.fruit"
include "helix/game system data/fruit/equipment/equipment_slot_types.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "snowdrop/modules/core/audio/audio.fruit"
include "snowdrop/modules/core/audio/billboardsettings.fruit"

// Keep this in sync with Core_FootstepEvent::Event
enum FootstepEventType
{
	Type_LeftFoot
	Type_RightFoot
	Type_LeftHand
	Type_RightHand
}

class FootstepEmitterLabelPair
{
	FootstepEventType myFootstepEventType
	EmitterLabel* myEmitterLabel
}

list FootstepEmitterLabelList
{
	FootstepEmitterLabelPair
}

class EmitterEquipmentAttachmentSlotInfo
{
	EquipmentSlotGroupType myGroupType
	EquipmentSlotTag myTag
}

list EmitterEquipmentAttachmentSlotInfoList
{
	EmitterEquipmentAttachmentSlotInfo
}

class AgentEmitter
{
	EmitterLabel* myEmitterLabel
	varmap myEmitterPrefab "emitterLayerName = \"misc\", enableDoppler = false, enablePropagation = true, sphereRadius = 1, stopOnDestroy = true" < bhv=audioemitter disable=stopondestroy tooltip="Defines the properties for the agent emitter" >
	string myBoneName
	bool myIsBoneNameAlias false
	bool myEnableBillboarding false
	BillboardingCategory* myBillboardingCategory
	bool mySetMovementSpeedRTPC false
	bool myAttachToAnyEquipmentSlots false
	EmitterEquipmentAttachmentSlotInfoList myEquipmentAttachmentSlotOverrides
}

list AgentEmitterList
{
	AgentEmitter
}

list AudioAgentTagsList
{
	RBTagsTag*  < compact_view=1 bhv=rbtags rbtags_filter="~+Agent" >
}

class AudioSwitchByTags
{
	AudioAgentTagsList myTagsList
	AudioSwitch mySwitch
}

list AudioSwitchByTagsList
{
	AudioSwitchByTags
}

class BodyPartImpactSound
{
	BodyPartType myBodyPart
    AudioEvent myImpactAudioEvent
}

list BodyPartImpactSoundList
{
	BodyPartImpactSound
}

class AudioParameters
{
	string myEmitterName "Unnamed agent" < tooltip="Name of agent. Used when setting up the game object name for visibility in the wwise profiling tool." >
	bool myPropagated true < tooltip="A flag for if this agent's bone emitters should be registered propagation system. Leave true if unsure." >
	bool myDoppler false < tooltip="A flag for if this agent's bone emitter should be registered to the doppler system. Leave false if unsure." >
	AudioSwitchList mySwitches < tooltip="List of switches to be applied to this agent's emitters." >
	AgentEmitterList myEmitters < tooltip="List of emitters to be created for the agent and their properties." >
	AudioSwitchByTagsList myAudioSwitchByTags < tooltip="List of switches to be applied to this agent's emitters. Only matching RBTags switches will be applied." >
	BodyPartImpactSoundList myBodyPartImpactSounds < tooltip="List of body part impact sound to be applied to this agent." >
	EmitterLabel* myFootstepMarkerEventEmitterLabel < tooltip="The emitter label agent-level override for footstep animation callbacks. Make sure an emitter is setup with this label." >
	EmitterLabel* myDialogueMarkerEventEmitterLabel < tooltip="The emitter label agent-level override for dialogue animation callbacks (also as the agent-level bark emitter override). Make sure an emitter is setup with this label." >
	FootstepEmitterLabelList myFootstepEmitterLabels < tooltip="Specify the mapping between a FootstepEventType and an EmitterLabel. The footstep animation marker event would then use the mapped labelled emitter to post the audio event." >
}
