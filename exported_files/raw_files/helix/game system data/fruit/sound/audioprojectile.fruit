include "snowdrop/modules/core/audio/audio.fruit"

class AudioProjectile < uid=auto >
{
	varmap myEmitterPrefab "emitterLayerName = \"misc\", enableDoppler = false, enablePropagation = true, sphereRadius = 1, stopOnDestroy = true" < bhv=audioemitter tooltip="Defines the properties for the emitters created for this projectile type." >
	AudioEvent myImpact < tooltip="The audio event that will be used for when the projectile collides with a hard/normal surface.">
	AudioEvent myWaterImpact < tooltip="The audio event that will play when the projectile breaks the surface of water.">
	AudioEvent myLoopStart < tooltip="Looping event that will play while the projectile is active.">
	AudioEvent myLoopStop < tooltip="Optional event for stopping the looping event started with myLoopStart. If blank, loop event will be stopped manually in code.">
	AudioEvent myRollLoopStart < tooltip="Looping event that plays when the projectile is rolling.">
	AudioEvent myRollLoopStop < tooltip="Optional Stop event for Roll Loop.">
	AudioRTPC mySpeedRTPC < tooltip="Speed of the projectile.">
	bool mySetWaterGameSyncs true < tooltip="Set water volume game syncs (Underwater switch, water depth RTPC, etc.).">
	bool mySetWeatherGameSyncs true < tooltip="Set weather mask game syncs (InPuddle switch, wetness, snow, etc.). If checked, events will be posted from weather sampler callback a few frames after projectile impact.">
}