include "snowdrop/modules/core/audio/audio.fruit"
include "snowdrop/modules/core/physics/collisionmaterials.fruit"
include "helix/game system data/fruit/impact/impact.fruit"

class AudioTriggerVolume < uid=auto >
{
    AudioSwitch myMaterialSwitch < tooltip="Used to determine the material like leaves / grass / stem / branch" >
    AudioSwitch mySizeSwitch < tooltip="Used to determine short / medium / tall objects" >
    CollisionMaterial* myImpactMaterial < tooltip="Used in impact realization when this volume is hit with a speeder" >
    ImpactRealization* myImpactRealization < tooltip="Used when the speeder gets into contact with this volume (on enter)" >
}