include "snowdrop/modules/core/audio/audio.fruit"

class WeatherPortalEnvironmentEvent
{
	string myEnvironmentName
	AudioEvent myClosedPortalEvent
	AudioEvent myOpenPortalEvent
	AudioEvent myWallEvent
}

list WeatherPortalEnvironmentEvents
{
	WeatherPortalEnvironmentEvent
}

class WeatherPortalEmittersSettings
{
	float myPortalSearchRadius
	int myMaxNumberOfPortalEmitters
	float myPortalRayLength
	AudioRTPC myNearestWallRTPC
	AudioRTPC myFloorAreaRTPC
	AudioEvent my2dBedEvent
	WeatherPortalEnvironmentEvents myEvents
}
