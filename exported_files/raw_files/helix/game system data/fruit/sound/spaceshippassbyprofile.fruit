include "snowdrop/modules/core/audio/audio.fruit"
include "helix/game system data/fruit/ai/alertlevel.fruit"
include "helix/game system data/fruit/audio/stimulus.fruit"
include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/input/rumble.fruit"

// Keep updated with HC_SpaceshipPassbyMode in "HC_SpaceshipPassbyProfileConstantData.h"
enum SpaceshipPassbyMode
{
	Loopable
	Apex
	EntityPassingPlayer
	PlayerPassingEntity
}

class SpaceshipPassbyEffectBase
{
	SpaceshipPassbyMode myMode Apex
	NPCAlertLevel myAlertLevel UNKNOWN < tooltip="If different than UNKNOWN, the effect will play only if the entity is an agent and the alert level is the same as the set one" >

	float myTime 1

	float myMinRadius 10.0 < tooltip="Used to compute the amplitude of the effect. If the distance is lower than MinRadius, the amplitude is clamped to maximum" >
	float myMaxRadius 100.0 < tooltip="If the distance between the player spacveship and the entity exceends MaxRadius, the effect will not play" >
	float myBoundary 10.0 < tooltip="For looping effects: start when the player distance is less than MaxRadius - Boundary; stop when distance is greater than MaxRadius + Boundary" >
	float myMinSpeed 10 < tooltip="The combined speed between the player spaceship and the entity. If the meeting speed is lower than MinSpeed, the effect will not play" >
	float myMaxSpeed 100 < tooltip="The combined speed between the player spaceship and the entity. Used only to modulate the amplitude of the effect, not to decide whether to start the effect or not" >
	float myMinPlayerSpeed 0 < tooltip="If the player speed is lower than MinPlayerSpeed, the effect will not play" >
}

class SpaceshipBypassAudioEffect : SpaceshipPassbyEffectBase
{
	StimulusIdentifier* myStimulus

	AudioEvent myAudioEvent
	AudioRTPC myPassbyVolumeRTPC

	float myFadeOutTime 2.0 < tooltip="For looping sounds" >
	float myCooldown 2.0 < tooltip="Will not yield for another effect of this type for this duration" >
}

list SpaceshipBypassAudioEffectList
{
	SpaceshipBypassAudioEffect
}

class SpaceshipPassbyRumblePreset
{
	uid myRumble < bhv="constantData" constantDataType="rumble" >
	float myIntensity 1
}

list SpaceshipPassbyRumblePresetList
{
	SpaceshipPassbyRumblePreset
}

class SpaceshipBypassRumbleffect : SpaceshipPassbyEffectBase
{
	SpaceshipPassbyRumblePresetList myPresets
}

class SpaceshipBypassCameraShakeffect : SpaceshipPassbyEffectBase
{
	ShakeCameraModifier* myCameraShake
}

class SpaceshipPassbyProfile < uid=auto >
{
	float myActiveDistance 500

	SpaceshipBypassAudioEffectList myAudioEffects
	AudioRTPC myRelativeSpeedRTPC
	bool myEnableDoppler true

	SpaceshipBypassRumbleffect myRumbleEffect
	SpaceshipBypassCameraShakeffect myCameraShakeEffect
}
