include "helix/game system data/fruit/item/item.fruit"
include "helix/game system data/fruit/gamevalues/gamevalues.fruit"
include "helix/game system data/fruit/intel/intel.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/gamestatistics/gamestatistics.fruit"
include "helix/game system data/fruit/quest/quest.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "helix/game system data/fruit/domainsofmastery/domainofmasterytypes.fruit"
include "helix/game system data/fruit/audio/stimulus.fruit"

class DomainAbilityRequirementUIInfo < ui_info=1 >
{
	varmap myUnlockHint < bhv="localization" >
}

class DomainAbilityUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" >
	varmap myLoreDescription < bhv="localization" >
	varmap myLongDescription < bhv="localization" >
	varmap myLongDescriptionKeyboard < bhv="localization" >
	varmap myUnlockHint < bhv="localization" tooltip="DEPRECATED: use the unlock hint in the ability unlock requirement settings instead" >
	string myIcon < bhv="sprite" >
	file myVideo < bhv="asset" assettype="webm" >
	bool myIsSpecialAbility FALSE < tooltip="If enabled, the ability will be represented with a elongated shape instead of a circle." >
	bool myIsNotAvailableForCurrentVersion FALSE < tooltip="If enabled, the ability will be restricted on UI and not shown." >
}

class DomainExpertSetUIInfo < ui_info=1 >
{
	varmap myTitle < bhv="localization" >
	varmap myDescription < bhv="localization" >
	string myIcon < bhv="sprite" referenced_by_code=1 >
	file myExpertImage < bhv="asset" assettype="texture" >
	file myUnknownExpertImage < bhv="asset" assettype="texture" >
	file myHiddenExpertImage < bhv="asset" assettype="texture" >
	bool myIsNotAvailableForCurrentVersion FALSE < tooltip="If enabled, the ability will be restricted on UI and not shown." >
}

list AbilityDependenciesList
{
	uid < bhv="constantData" constantDataType="domainofmasteryability" >
}

list PlayerInventoryTypeList
{
	PlayerInventoryType
}

class DomainOfMasteryAbility < uid=auto abstract=1 >
{
	DomainAbilityUIInfo myUIInfo
	
	Item* myAbilityItem
	PlayerInventoryTypeList myAdditionalInventoriesToReceiveItem
	
	DomainOfMasteryAbilityGameValue myState < hidden=1 init_set=1 >

	bool myRequiresManualUnlock TRUE < tooltip="If set to false, the ability will be unlocked automatically when it becomes Ready To Unlock." >

	DomainOfMasteryAbilityState myDefaultState

	AbilityDependenciesList myAbilityDependencies < tooltip="These abilities must be unlocked first, before this one can start being progressed" >

	RBTagsTag* myAbilityUnlockedTag

	bool myHealPlayerOnUnlock FALSE < tooltip="Set to true if you want the player to be fully healed when unlocking that ability." >
}

class AbilityUnlockRequirementSettings
{
	bool myShouldAlwaysShowProgressNotifications TRUE < tooltip="If true, progress made toward this unlock requirement will display a UI notification even when the ability is not being tracked" >
	bool myShouldShowProgressNotificationWhenProgressingToZero TRUE < tooltip="If false, when this requirement's value is change to 0 (by a reset or by a decrement) the UI notification will be silenced" >
	StimulusIdentifier* myOnCompletionPetReactionBarkIdentifier < tooltip="Optional pet bark to play when this requirement is completed" >
	bool myPlayPetReactionOnAnyProgress FALSE < tooltip="If true, the above bark will play whenever the progress of this requirement is updated, rather than only when it's completed." >
	DomainAbilityRequirementUIInfo myUIInfo
	Intel* myIntel < tooltip="this associated intel will be used for linking this requirement to the map or journal for giving more contexual info" >
}

class AbilitySkillUnlockRequirement : GameConditionGameStatistic
{
	GameConditionType myType DomainOfMasteryAbilitySkillUnlockRequirement < hidden=1 >

	GameConditionOperator myOperator GreaterThanOrEqual < hidden=1 >

	AbilityUnlockRequirementSettings mySettings
	bool myIsStreak FALSE < tooltip="Unlock requirements which are a streak will reset at the end of a session. For example, 'kill N enemies in a row' would likely be a streak. Upon death or loading a of save, the statistic will reset back to 0, unless it has reached it's target value, in which case this will persist" >
}

list AbilitySkillUnlockRequirementList < size=3 >
{
	AbilitySkillUnlockRequirement
}

class DomainOfMasteryAbilitySkill : DomainOfMasteryAbility
{
	AbilitySkillUnlockRequirementList myUnlockRequirements
}

class AbilityItemUnlockRequirement : GameConditionPlayerHasItem
{
	GameConditionType myType DomainOfMasteryAbilityItemUnlockRequirement < hidden=1 >

	AbilityUnlockRequirementSettings mySettings
}

list AbilityItemUnlockRequirementList < size=3 >
{
	AbilityItemUnlockRequirement
}

class DomainOfMasteryAbilityItem : DomainOfMasteryAbility
{
	AbilityItemUnlockRequirementList myUnlockRequirements
}

list DomainOfMasteryAbilityList
{
	DomainOfMasteryAbilitySkill
	DomainOfMasteryAbilityItem
}

list DomainOfMasteryExpertDiscoveryRequirementList < size=3 >
{
	GameConditionPlayerHasIntel
}

class DomainOfMasteryExpertName < uid=auto >
{
	varmap myName < bhv="localization" ui_info_debug_ui_name=1 >
	Intel* myIntel
}

list DomainOfMasteryExpertNameList < tooltip="Expert names are ordered by priority. The first name (from top to bottom) that fulfills the intel requirement will be the one used. No intel means it can be used by default." >
{
	DomainOfMasteryExpertName
}

class DomainOfMasteryExpertSet < uid=auto >
{
	DomainExpertSetUIInfo myUIInfo

	DomainOfMasteryExpertNameList myNames
	
	DomainOfMasteryAbilityList myAbilities

	DomainOfMasteryExpertSetStateGameValue myState < hidden=1 init_set=1 >

	Intel* myStartingIntel
	Quest* myAdventure
	MapRef* myMapRef
	uid myLevelInfo < bhv="constantData" constantDataType="levelinfo" tooltip="The level that the expert is on." >

	DomainOfMasteryExpertSetState myDefaultState
	
	DomainOfMasteryExpertDiscoveryRequirementList myDiscoveryRequirements
}
