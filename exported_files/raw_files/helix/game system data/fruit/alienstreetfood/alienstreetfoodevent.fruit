include "helix/game system data/fruit/alienstreetfood/alienstreetfoodvoice.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "snowdrop/modules/core/audio/audio.fruit"

enum AlienStreetFoodEventType < process_using_strings = 1 >
{
    JumpEvent
    AudioEvent
    VoiceEvent
    DialogueEvent
}

class AlienStretFoodInputChallengeEvent < uid=auto abstract=1 >
{
    AlienStreetFoodEventType myType < hidden = 1 >
    GameConditionGroup myTriggerConditions
    bool myShouldEvaluateOnFirstFrame false
}

class AlienStreetFoodJumpEvent : AlienStretFoodInputChallengeEvent
{
    AlienStreetFoodEventType myType JumpEvent < hidden = 1 >
    string myJumpMarker
}

class AlienStreetFoodAudioEvent : AlienStretFoodInputChallengeEvent
{
    AlienStreetFoodEventType myType AudioEvent < hidden = 1 >
    AudioEvent myAudioEvent
    bool myIsOneShot
}

class AlienStreetFoodVoiceEvent : AlienStretFoodInputChallengeEvent
{
    AlienStreetFoodEventType myType VoiceEvent < hidden = 1 >
    AlienStreetFoodVoices myVoices
    bool myIsOneShot false
}

class AlienStreetFoodDialogueEvent : AlienStretFoodInputChallengeEvent
{
    AlienStreetFoodEventType myType DialogueEvent < hidden = 1 >
    AlienStreetFoodDialogues myDialogues
    bool myIsOneShot false
}

list ChallengeEvents
{
    AlienStretFoodInputChallengeEvent
}