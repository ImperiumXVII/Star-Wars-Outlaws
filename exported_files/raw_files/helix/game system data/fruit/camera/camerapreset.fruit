	ShoulderAim
	Default
	Combat
	Scope
	LockAim
	HipAim
	PetModeActive
	ThrowableAim
	UnarmedAim
	Crouch
	CrouchHipAim
	CrouchShoulderAim
	HeavyWeaponHipAim
	CrouchHeavyWeaponHipAim
	
	ShoulderAimMirror
	DefaultMirror
	CombatMirror
	ScopeMirror
	LockAimMirror
	HipAimMirror
	PetModeActiveMirror
	ThrowableAimMirror
	UnarmedAimMirror
	CrouchMirror
	CrouchHipAimMirror
	CrouchShoulderAimMirror
	HeavyWeaponHipAimMirror
	CrouchHeavyWeaponHipAimMirror
	
	SpaceshipIndoor
	SpeederIndoor
	TrickShotIndoor
