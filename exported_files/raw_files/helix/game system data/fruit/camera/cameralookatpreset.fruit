include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/camera/camerasoftedgedata.fruit"
include "helix/game system data/fruit/camera/camerablendtransitions.fruit"

class RestrictionData
{
   SensitivityCameraModifier* myCameraSensitivityModifier < tooltip="While the lookat is active, this sensitivity will be multiplied to final camera input" >
   CameraSoftEdgeData myPitchSoftEdgeData
   CameraSoftEdgeData myYawSoftEdgeData
   vec2f myAllowedMovementDegrees 0.0;0.0 < tooltip="This is how much in degrees the camera is allowed to look away in the x-axis and y-axis. 0.0 means the camera is not allowed to rotate" >
   float mySpringConstant 1.0f < min=0.f tooltip="The larger this value is, the faster the camera will return to where it was looking if you rotate it away. If it's set to 0, it will not rotate back at all." >
   float myDampingRatio 1.0f < min=0.1f tooltip="This controls if the rotation will overshoot when camera rotation is returning after you rotate it away" >
   float myBreakTime 0.0f < min=0.0f tooltip="If the player tries rotate the camera in this amount of time, then the lookat will break. 0 means it will never break" >
   bool myIsActive true
}

class ZoomData
{
   CameraModifierInOutTransitions myTransitions
   float myFOVChange
}

class PivotOffsetData
{
   CameraModifierInOutTransitions myTransitions
   vec3f myPivotOffset 0.0;0.0;0.0 < tooltip="Will offset the camera by this amount" >
}

class ShoulderSwitchData
{
    CameraTransition* myTransitionIn < tooltip="When you queue a mirrored camera, you can control the blending with this. If this is empty the blend will be calculated automatically." >
	CameraTransition* myTransitionOut < tooltip="When the mirrored camera is removed, you can control the blending with this. If this is empty the blend will be calculated automatically." >
	bool myCanSwitchShoulder false < tooltip="If this is true, once the LookAt starts, if the lookat point is to a different side of the camera, then switch shoulder" >
}

class AdditionalLookAtSettings
{
   float myLazyRetentionSpringConstant 50.f < min=0.1f tooltip="The larger this value is, the stronger the camera will try to keep looking a point" >
   float myLazyRetentionDampingRatio 1.0f < min=0.1f tooltip="If this is 1, the camera will stop once it reaches its target, other values will result in overshooting when making the camera look toward the point" >
   bool myUsePolarRotation false < tooltip="If this is true, the camera will rotate based on the difference in azimuth and zenith instead of using quaternions. Works well if there's a big Yaw difference" >
   bool myUseLazyRetention false < tooltip="Once the LookAt has finished, if you want it to try and keep looking without being so strict, you should set this bool to true, as it will make it follow lazily" >
   bool myGetHeadPositionOnAgents true < tooltip="If the target entity is an agent- we will make it automatically target their head" >
}

class CameraLookAtPreset < uid=auto >
{
   RestrictionData myRestrictionData
   ZoomData myZoomData
   PivotOffsetData myPivotOffsetData
   ShoulderSwitchData myShoulderSwitchData
   AdditionalLookAtSettings myAdditionalLookAtSettings
   CameraModifierTransition myBaseTransition < tooltip="The transition time and curve to make the camera look at the target position" >
   CameraModifierTransition myOutTransition < tooltip="The transition time and curve for exiting the look at" >
   float myMaxAngleDifferenceDegrees 180.0f < tooltip="If the angle toward the target and where the camera is looking ends up being larger than this value, then the LookAt will not trigger" >
   float myStayTime 3.0f < tooltip="Once the camera is looking at the target, wait this time (in seconds) before finishing automatically. 0 means never finish." >
   PlayerRestriction* myPlayerRestrictions < tooltip="The actions prevented while the LookAt is active" >
   ShakeCameraModifier* myCameraShake
   bool myIgnoreLookAtOrientationForInput false
}
