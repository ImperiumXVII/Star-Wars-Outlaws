include "helix/game system data/fruit/camera/aimassistdata.fruit"
include "helix/game system data/fruit/camera/camerashakes.fruit"
include "helix/game system data/fruit/input/gameinput.fruit"

class CameraModifierInOutTransitions
{
	float myInDuration 0 < tooltip="When blending in, transition time" >
	string myInCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.2 0.001, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	float myOutDuration 0 < tooltip="When blending out, transition time" >
	string myOutCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.5 0, }, outTangents = { 0.2 0, 0 0, }, properties = { 275, 1299, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph >
    bool myAllowReverseTransition false < tooltip="Decides if the transition can go in reverse mid-transition" >
}

class CameraModifierTransition
{
    float myDuration 1 < tooltip="transition time" >
	string myCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.2 0.001, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
}

class CameraModifier < uid=auto abstract=1 >
{
	CameraModifierInOutTransitions myTransitions
}

class SwayCameraModifier : CameraModifier
{
	float myMovementSpeed 1.2 < tooltip="Speed of the sway movement in point per second" >
	float myMinHorizontalMove 0.001 < tooltip="minimum sway horizontal movement from the base aiming point" >
	float myMaxHorizontalMove 0.004 < tooltip="maximum sway horizontal movement from the base aiming point" >
	float myMinVerticalMove 0.001 < tooltip="minimum sway vertical movement from the base aiming point" >
	float myMaxVerticalMove 0.002 < tooltip="maximum sway vertical movement from the base aiming point" >
	float myStartTime 0.f < min=0.f tooltip="time after initialization before the sway actually starts (note, this will delay the modifier transition if set)" >
}

class FOVCameraModifier : CameraModifier
{
	float myExtraFOV -10.0 < tooltip="Extra camera FOV applied to the cam FOV" >
}

class AimAssistCameraModifier : CameraModifier
{
	AimAssistValuesList myAimAssistValues
	AimAssistFade myFade
}

class TargetPanCameraModifier : CameraModifier
{
	float myBlendTimeIn 1
	float myBlendTimeOut 1
	string myBlendInCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -2.6666667 0, }, outTangents = { 2.6666667 0.10133334, 0 0, }, properties = { 3275, 8195, }, values = { 0 0, 1 1.0, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myBlendOutCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -2.6666667 0, }, outTangents = { 2.6666667 0.10133334, 0 0, }, properties = { 3275, 8195, }, values = { 0 0, 1 1.0, }, }, numKeys = 2, }" < bhv=inputgraph >
	bool myShouldBlendFOV true < tooltip="If true the camera will match the target camera FOV" >
	bool myUseStickValueForBlend false < tooltip="Use the stick value as a target camera blend" >
	bool myUseSpringBlend true < tooltip="If true the blend will follow a damped spring motion. This take precedence over the other blend options if set to true." >
	float mySpringConstant 15 < min=0 tooltip="The strength of the 'spring' used for blending (if using the spring blend). Larger values will blend faster." >
	bool myBlendBetweenAllCameras true < tooltip="If set to false it will only choose one camera to blend to. If set to true it will blend between two in the direction" >
	GameAction myUpInput LookUp
	GameAction myDownInput LookDown
	GameAction myLeftInput LookLeft
	GameAction myRightInput LookRight
}

class ShakeCameraModifier : CameraModifier
{
	string myShakeIntensityCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.25 0, }, outTangents = { 0.25 0, 0 -0, }, properties = { 3347, 8467, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	CameraShakeBlockList myBlocks
	bool myShouldHandleCollision false < tooltip="If this is true, the CamShake will be restricted by camera collision, use sparingly" >
}

class RecoilCameraModifier : CameraModifier
{
	string myVerticalRecoilCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -2.6666667 0, }, outTangents = { 2.6666667 0.10133334, 0 0, }, properties = { 3275, 8195, }, values = { 0 0, 8 9.0, }, }, numKeys = 2, }" < bhv=inputgraph >
		
	float myRecoilMax 15.0 < tooltip="Maximum recoil angle / bullet" >
	float myRecoilMin 0.0 < tooltip="Minimum recoil angle / bullet" >
	float myVerticalRecoilStrengthAtBorder 0.01 < min=0 tooltip="Vertical recoil kick strength once vertical recoil border has been reached." >
	float myVerticalRecoilBorder 5.0 < tooltip="The angle from the firing start point for which the vertical recoil SHALL NOT PASS!" >
	float myVerticalRecoilBorderThreshold 2.5 < tooltip="The angle that defines threshold for how far from the border the vertical recoil can go." >
	
	float myVerticalBorderRecalculateThreshold 0.5 < min=0 max=1 tooltip="The threshold after the player moves the right stick upwards the vertical border is recalculated to the current aiming point. (0-1)" >
	float myRecoilRecoveryPerSecond 0.0 < tooltip="While the player stops firing the recoil angle will decrease with this angle value / second" >
	float myRecoilClimbTime 0.1 < tooltip="How the recoil should climb after a bullet is fired." >
	float myRecoilResetTime 1.0 < tooltip="After the player stops firing the time it takes to reset back to the base recoil kick value" >
	
	float myVerticalRecoilRecoveryTime 0.5 < tooltip="The time after the vertical recoil recovery kicks in after the player stops firing" >
	float myVerticalRecoveryPerSecond 5.0 < tooltip="How fast the vertical recovery adjusts back to the initial position (Angle / second)" >
	float myVerticalRecoveryPercent 1.0 < min=0.0 max =1.0 tooltip="How much the vertical recovery adjusts back to the initial position (percentage)" >
	float myStopVerticalRecoveryThreshold 0.5 < min=0 max=1 tooltip="The required right stick upwards movement required before vertical recoil recovery is cancelled. (0 to 1)" >
	
	float myHorizontalRecoilRecoveryTime 0.1 < tooltip="The time after the horizontal recoil recovery kicks in after the player stops firing" >
	float myHorizontalRecoveryPerSecond 5.0 < tooltip="How fast the horizontal recovery adjusts back to the initial position (Angle / second)" >
	float myHorizontalRecoveryPercent 1.0 < min=0.0 max =1.0 tooltip="How much the horizontal recovery adjusts back to the initial position (percentage)" >
	float myStopHorizontalRecoveryThreshold 0.5 < min=0 max=1 tooltip="The required right stick horizontal movement required before horizontal recoil recovery is cancelled. (0 to 1)" >
	
	float myHorizontalRecoilLeft 20 < tooltip="Horizontal recoil strength maximum left value" >
	float myHorizontalRecoilRight 20 < tooltip="Horizontal recoil strength maximum right value" >
	float myHorizontalRecoilBorderLeft 10.0 < min=0 max=90 tooltip="Horizontal recoil left border angle. (Recoil will not jump to the left of this angle, starting from the aiming point when firing started)" >
	float myHorizontalRecoilBorderRight 10.0 < min=0 max=90 tooltip="Horizontal recoil right border angle. (Recoil will not jump to the right of this angle, starting from the aiming point when firing started)" >
	float myHorizontalBorderRecalculateThreshold 0.5 < min=0 max=1 tooltip="The threshold after the player moves the right stick left/right the horizontal borders are recalculated to the current aiming point. (0-1)" >
	float myHorizontalRecoilTime 0.1 < tooltip="How long the recoil should jump horizontally after a bullet is fired." >
	
	float myHorizontalSmoothRecoilModifier 200.0 < min=1 tooltip="Defines how smoothened out the horizontal recoil is" >
	float myVerticalSmoothRecoilModifier 200.0 < min=1 tooltip="Defines how smoothened out the vertical recoil is" >
	
	float myFovRecoilAmount 0.0 < tooltip="Amount of recoil that is added on the camera fov when aiming and shooting." >
	float myFovRecoilCeiling 20 < min=0 tooltip="Ceiling to clamp the amount of recoil added to the camera fov. Also adds a floor of -FovRecoilCeiling in case of negative fov recoils." >
	float myFovRecoilRecoveryRate 30 < min=0 tooltip="Recovery rate of the camera fov per second." >
}

class CurveRailCameraModifier : CameraModifier
{
	string myCatchUpSpeedBasedOnDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -2.6666667 0, }, outTangents = { 2.6666667 0.10133334, 0 0, }, properties = { 3275, 8195, }, values = { 0 0, 8 9.0, }, }, numKeys = 2, }" < bhv=inputgraph >
	vec2f myCameraOffset 0;0
	vec2f myCameraTargetOffset 0;0
	vec2f myTargetLookAtOffsetBasedOnStick 0;0
	vec2f myCameraOffsetBasedOnStick 0;0
	float myBlendTranslationMultiplier 1.0
	float myBlendRotationMultiplier 1.0
}

class MagnetismCameraModifier : CameraModifier
{
    float myInputWaitTime 0.1f < tooltip="If there is input moving away from the point, this is the time it will wait before activating magnetism again" >
	float myStartTime 0.2f < tooltip="During this time, there will be no input from the camera, it's set in code based on context" >
	
	float myAcceleration 3.f < tooltip="how fast in percentage every second it accelerates (1 means it will reach full potential in 1 second)" >
	float myDeceleration 0.5f < tooltip="how fast in percentage every second it decelerates" >
	float myMaxAmountPerSecond 60.f < tooltip="Angle in degrees how fast at maximum the camera will rotate toward magnetic point" >
	
	float myAngleForMaxMagnetism 1.f < tooltip="If the angle(degrees) between where you're looking, and the target is smaller than this, then acceleration will have maximum effect" >
	float myAngleForMinMagnetism 10.f < tooltip="If the angle(degrees) between where you're looking, and the target is larger than this, then there will be no acceleration" >
	
	bool myIsMagnetic false < tooltip="If it's magnetic, the smaller the angle to your target, the stronger the acceleration" >
	bool myIsReverseMagnetic false < tooltip="If it's reverse magnetic, you will get an effect of further away being stronger (similar to a spring)" >
}

class SensitivityCameraModifier : CameraModifier
{
    string mySensitivityMultiplierFormula 1.f < tooltip="Will be applied to final sensitivity on camera input." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
}

class LazinessCameraModifier : CameraModifier
{
    float mySpringStrength 100.f < min=1.f tooltip="The strength of the spring trying to catch up" >
	float myDampingRatio 1.f < min=1.f tooltip="The damping ratio on the spring" >
}

class TargetTransformOverrideModifier : CameraModifier
{
	float myDuration 0.0f < min=0.0f >
}

class RestrictedRotationCameraModifier : CameraModifier
{
	bool myShouldReturnToCenterOnRelease true < tooltip="If true, the camera return to the center position when the stick is released." >
	float myMaxUpAngle 45 < min=0 max=360 tooltip="Maxium vertical angle when trying to look up." >
	float myMaxDownAngle 45 < min=0 max=360 tooltip="Maxium vertical angle when trying to look down." >
	float myMaxLeftAngle 45 < min=0 max=360 tooltip="Maxium horizontal angle when trying to look left." >
	float myMaxRightAngle 45 < min=0 max=360 tooltip="Maxium horizontal angle when trying to look right." >
	float myTimeToMaxInSpeed 1 < min=0 tooltip="Time to reach max speed when the player starts moving the stick." >
	string myInMoveSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.1 0.1, }, outTangents = { 0.1 -0.1, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv = inputgraph >
	float myTimeToMaxOutSpeed 1 < min=0 tooltip="Time to reach max speed when the player releases the stick." >
	string myOutMoveSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.1 0.1, }, outTangents = { 0.1 -0.1, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv = inputgraph >
	GameAction myUpInput LookUp
	GameAction myDownInput LookDown
	GameAction myLeftInput LookLeft
	GameAction myRightInput LookRight
}

list FOVList
{
	float
}

class FOVListCameraModifier : CameraModifier
{
	FOVList myFOVList < tooltip="The list of fov set to the camera everytime the inputs are pressed." >
	bool myAddCurrentCameraFOV true < tooltip="If true, the fov the camera has when this modifier is started will be inserted at the beginning of the fov list." >
	bool myCircleThroughList true < tooltip="If true, pressing an input while at the extremity of the array will move to the other extremity." >
	GameAction myNextFOVInput
	GameAction myPreviousFOVInput
	float myTimeToChangeFOV < tooltip="Time to move from an FOV to another when one of the button is pressed. Set to 0 to instantly change FOV." >
	string myFOVChangingCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.33333334 -0.33333334, }, outTangents = { 0.33333334 0.33333334, 0 0, }, properties = { 203, 1227, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv = inputgraph tooltip="If the time to change FOV is over 0, the intermediate FOV will follow this curve." >
}