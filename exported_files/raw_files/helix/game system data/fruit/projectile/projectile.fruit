include "helix/game system data/fruit/impact/impact_conditions.fruit"
include "helix/game system data/fruit/projectile/projectile_actions.fruit"
include "helix/game system data/fruit/projectile/projectile_object.fruit"
include "helix/game system data/fruit/projectile/projectile_realization.fruit"
include "helix/game system data/fruit/projectile/npcsensoryprojectiletype.fruit"
include "helix/game system data/fruit/ai/npcdetectionsoundevent.fruit"

enum ProjectileAccelerationMode
{
	Constant
	Curve
}

class Projectile < uid=auto abstract=1 >
{
	// Object
	ProjectileObject myObject
	
	ProjectileRealization* myRealization
	
	// Material
	ProjectileActionList myActions
	
	// NPC Reaction Data
	NPCSensoryProjectileType myNPCSensoryProjectileType < tooltip="Defines the type of projectile for NPC sensory and if the NPC can notice this hitting their projectile detection collision. NPCs define themselves in their sensory profile if they should react to this type of projectile" >
	NPCDetectionSoundEvent* myNPCImpactSoundEvent < tooltip="Defines the type of detection event the NPCs can react to on projectile impact." >

	bool myCanBeDisabledByAuxiliaryDevice false < tooltip="If set, NPCs can't shoot this projectile while countermeasure is active" >
	bool myRemoveAgentsAfterHit false < tooltip="Will remove any hit agent from the collision candidates after first hit." >
}

// Keep in sync with HC_ProjectileBehaviorBallisticSeekerConstantData.h
enum HC_ProjectileBallisticTargetMissAction
{
	KeepPursuing
	AbandonTarget
	Expire
}

class BounceRestitutionDataByMaterial
{
	CollisionMaterial* myMaterial
	float myBounceSpeedRestitution 1.0 < tooltip="Speed multipler applied when the projectile bounces on the given material." >
	float myBounceGroundSpeedRestitution 1.0 < tooltip="Speed multipler applied when the projectile bounces against the ground on the given material." >
	float myBounceWallSpeedRestitution 1.0 < tooltip="Speed multipler applied when the projectile bounces against a wall on the given material." >
}

list BounceRestitutionDataByMaterialList
{
	BounceRestitutionDataByMaterial
}

class BallisticProjectile : Projectile
{
	float myInitialSpeed 50.0
	float myInitialSpeedVariation 0.0 < min=0.0 tooltip="Adds random speed variation (ranges from zero(0) to +Variation) to the intial speed " >

	// Acceleration
	ProjectileAccelerationMode myAccelerationType Constant
	float myAccelerationConstant 0.0
	string myAccelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	
	// Bounce
	bool myBounceEnabled false
	bool myBounceVsDynamicEnabled false
	bool myBounceFriendlyFireEnabled true < tooltip="If enabled the projectile will be able to self damage the shooter and allies when bouncing." >
	bool myForceBounceOnSteepSurface false < tooltip="If enabled, will make the projectile bounce no matter what the max bounces value says. First bounce will use speed multipliers, subsequent will ignore those until the surface is flat enough again." >
	float myForceBounceOnSteepSurfaceMinAngle 45.0 < min=0 max=90 tooltip="Will force bounces if the surface angle is above this value." >
	bool myForceBounceOnAgents false < tooltip="If enabled, will make the projectile bounce no matter what the max bounces value says if the projectile hits an agent. First bounce will use speed multipliers, subsequent will ignore those until the surface is flat enough again." >
	bool mySeekForCloseEnemies false < tooltip="If enabled the projectile will try to pick some random enemy nearby to bounce on." >
	float mySeekForCloseEnemiesDistance 50.f < min=0 tooltip="The max distance to look for nearby enemies when bouncing." >
	float mySeekForCloseEnemiesProbability 1.f < min=0 max=1 tooltip="The probability that the projectile tries to target a nearby enemy when bouncing." >
	float mySeekForCloseEnemiesMaxAngle 90.f < min=0 max=180 tooltip="The maximum angle delta bewteen the realistic bounce direction and the direction to an enemy for it to be considered as a potential target." >
	bool myAvoidPlayerWhenBouncing false < tooltip="If enabled the bouncing projectiles will always try to avoid the player." >
	float myAvoidPlayerCheckRange 50.f < tooltip="The length (in m) of the raycast used to find and avoid the player when bouncing. If the player stands more than this value away from the bounce position there's no guarantee that the projectile will avoid it." >
	GameConditionImpactGroup myCanBounceConditions < tooltip="Bounce will only be enabled if those conditions are valid or empty." >
	float myBounceSpeedRestitution 1.0 < tooltip="Default speed multipler applied when the projectile bounces." >
	float myBounceGroundSpeedRestitution 1.0 < tooltip="Default speed multipler applied when the projectile bounces against the ground" >
	string myGroundBounceRestitutionMultiplierByAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -30 0, }, outTangents = { 30 0, 0 0, }, properties = { 3, 1027, }, values = { 0 1, 90 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Horizontal axis ranges from 0 to 90 degrees, vertical axis is the multiplier applied to ground speed restitution value.">
	float myBounceWallSpeedRestitution 1.0 < tooltip="Default speed multipler applied when the projectile bounces against a wall" >
	BounceRestitutionDataByMaterialList myBounceRestitutionDataByMaterials < tooltip="Custom bounce speed restitutions per material." >
	int myBounceMaxBounces -1
	
	// Seeker
	bool mySeekerEnabled false
	float mySeekerTurnRate 1.0
	string mySeekerActivationDelayFormula 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Homing activation delay (in seconds)" >
	string mySeekerTurnRateModifierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 1, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph  tooltip = "The values of the turn rate after the homing activation delay has expired. Takes values between 0 and 1 representing the percentage of the turn rate. Ox = time, Oy = % of turn rate.">
	bool mySeekerHasMaxDistanceFromTarget false
	float mySeekerMaxDistanceFromTarget 20.0
	bool mySeekerMissActionEnabled false 
	float mySeekerDelayConsiderMissTimerDuration 2.0
	float mySeekerMaxDistanceToConsiderMiss 10.0 
	HC_ProjectileBallisticTargetMissAction mySeekerTargetMissAction KeepPursuing
}

class StaticBallisticProjectile : Projectile
{
	float myInitialSpeed 50.0
	float myInitialSpeedVariation 0.0 < min=0.0 tooltip="Adds random speed variation (ranges from zero(0) to +Variation) to the intial speed " >

	// Acceleration - only constant allowed
	ProjectileAccelerationMode myAccelerationType Constant < hidden=1 tooltip="Do not modify" >
	float myAccelerationConstant 0.0
	string myAccelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < hidden=1 tooltip="Do not modify" bhv=inputgraph >
	
	// Bounce
	bool myBounceEnabled false
	bool myBounceVsDynamicEnabled false < hidden=1 tooltip="Do not modify" >
	float myBounceSpeedRestitution 1.0 < tooltip="Speed multipler applied when the projectile bounces." >
	float myBounceGroundSpeedRestitution 1.0 < tooltip="Speed multipler applied when the projectile bounces against the ground" >
	float myBounceWallSpeedRestitution 1.0 < tooltip="Speed multipler applied when the projectile bounces against a wall" >
	int myBounceMaxBounces -1
	
	// Seeker "HIDDEN - not allowed"
	bool mySeekerEnabled false < hidden=1 tooltip="Do not modify" >
	float mySeekerTurnRate 1.0 < hidden=1 tooltip="Do not modify" >
}

class ScanProjectile : Projectile
{
	float myMaxDistance 100.0
}

class RicochetProjectile : Projectile
{
	// Acceleration - only constant allowed
	ProjectileAccelerationMode myAccelerationType Constant < hidden=1 tooltip="Do not modify" >
	float myAccelerationConstant 0.0
	string myAccelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < hidden=1 tooltip="Do not modify" bhv=inputgraph >
	
	float myInitialSpeed 50.0
	float myInitialSpeedVariation 0.0 < min=0.0 tooltip="Adds random speed variation (ranges from zero(0) to +Variation) to the intial speed " >
	float myMaxBounceDistance 50.0 < tooltip="Max distance a projectile can travel after do a bounce" >
}

enum ProjectileSwirlMode
{
	Random
	Clokwise
	CounterClockwise
}

class SwirlProjectile : BallisticProjectile
{
	string mySwirlAmplitudeCurveX "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 0.047019325 0, }, properties = { 3, }, values = { 0.0 0.15, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="Horisontal amplitude of displacement over projectile lifetime"> 
	string mySwirlAmplitudeCurveY "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 0.047019325 0, }, properties = { 3, }, values = { 0.0 0.15, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="Vertical amplitude of displacement over projectile lifetime">
	string mySwirlRateCurveX "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 0.02099077 0, }, properties = { 3, }, values = { 0.33375314 360, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="Horisontal rate of displacement in degrees per second over projectile lifetime">
	string mySwirlRateCurveY "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 0.02099077 0, }, properties = { 3, }, values = { 0.33375314 360, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="Vertical rate of displacement in degrees per second over projectile lifetime">
	float mySwirlPhaseShiftRange 1.0 < min=0.0 max=1.0 tooltip="Swirl cos/sin generation signal will randomly by shift between 0 and this pecentatge multiplied by 360 degrees" >
	ProjectileSwirlMode mySwirlMode Random
}

class GhostProjectile : Projectile
{
}
