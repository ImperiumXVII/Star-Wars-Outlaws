
enum ProjectileMaterialType
{
	Energy
	Electric
	Kinetic
	Sonic
}

enum ProjectileShapeType
{
	Point
	Sphere
	Cylinder
}

enum ProjectileCastType
{
	VsAll
	VsDynamic
	VsStatic
	VsPierceDynamicPhysics
}

enum ProjectileStickType
{
	Full
	OnlyTranslation
}

enum ProjectileStickAnchorType
{
	Collider
	GraphObject
}

class ProjectileShape
{
	ProjectileShapeType myShapeType Point
	bool myDynamicShapeEnabled false < tooltip="If true the final shape will be defined by the available curves in runtime instead of flat constant values" >
	float myShapeRadius 0.1 < tooltip="Only used for Sphere,Cylinder shape type" >
	string myDynamicShapeRadius "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 1 0, }, properties = { 2250, }, values = { 0 0.1, }, }, maxValueBounds = 10, minValueBounds = -10, numKeys = 1, }" < bhv=inputgraph tooltip="X=Travel distance Y=Radius" >
	float myShapeHeight 0.1 < tooltip="Only used for Cylinder shape type" >
}

class ProjectileExtraShape : ProjectileShape
{
	bool myUseForVisuals false < tooltip="If true the projectile graph object will use this size instead of the Main Shape" >
	bool myUseCustomCastType false < tooltip="If true we can use a custom cast type" >
	ProjectileCastType myCustomCastType VsAll < tooltip="Custom cast type that repalce the one used by the logic" >
}

list ProjectileShapeExtraList
{
	ProjectileExtraShape
}

class ProjectileMaxTravelDistance
{
	string myFormula 100 < bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myDefault 100.0 < tooltip="The default max travel distance value used if the projectile source is not an agent" >
	float myVariation 0.0  < tooltip="The added random distance (ranges from -Variation to +Variation) to the final distance" >
}

class ProjectileObject
{
	ProjectileMaterialType myMaterialType Energy
	float myMass 0.0
	float myFriction 0.0 < tooltip="TODO" >
	float myTravelLifeTime 5.0 < tooltip="Projectile max travel lifetime" >
	bool myMaxTravelDistanceEnabled false
	ProjectileMaxTravelDistance myMaxTravelDistance
	float myAfterFinalImpactLifeTime 0.0 < tooltip="Projectile max lifetime after the final impact on a surface" >
	bool myStickToHitSurfaceEnabled true < tooltip="If true it will create a dynamic attachment between the projectile and the final imapct surface/entity" >
	ProjectileStickType myStickType Full
	ProjectileStickAnchorType myStickAnchorType Collider
	bool myAlignToHitSurfaceEnabled false < tooltip="If true the projectile will be aligned to hit surface so that its up vector matches the surface normal." >
	bool myIgnoreProjectileCollisionFromOwner false < tooltip="If true it will not collide with other projectiles from the same owner" >
	bool myRollingEnabled false < tooltip="Will make the projectile roll at the end of the simulation, enabling this will disable StickToHitSurface." >
	float myRollingFriction 0.0 < min=0.0 tooltip="The speed in m/s lost every second while the projectile is rolling. Initial speed is determined by the projectile velocity at the end of the simulation." >
	float myMaxRollingSpeed 0.0 < min=0.0 tooltip="Maximum rolling speed, leave 0 for unlimited." >
	bool myDissolveInWater false < tooltip="If ture, projectile will despawn after entering water." >
	ProjectileShape myMainShape
	ProjectileShapeExtraList myExtraShapes
}
