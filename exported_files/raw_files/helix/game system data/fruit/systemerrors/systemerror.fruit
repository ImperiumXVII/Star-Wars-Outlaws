enum FacilityId
{
	System
	OnlineInternal
	OnlineExternal
	Gameplay
	UbisoftConnect
	Ubiservices
	Microsoft
	Sony
	Sentinel
	VoiceChat
}

class Facility < uid=auto >
{
	FacilityId myId
	string myFriendlyName
}

class ErrorMessage < uid=auto >
{
	varmap myMessage < bhv="localization" >
}

class SystemError < uid=auto >
{
	string myHexId
	Facility* myFacility
	ErrorMessage* myFriendlyMessage
}