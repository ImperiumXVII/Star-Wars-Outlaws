	NPCMoveType myMoveType WildlifeMoveAway < hidden=1 >
	float myMinDistanceFromSearchPositionLOSRequired 0.0
	float myMaxDistanceFromSearchPositionLOSRequired 20.0
	float myMinDistanceFromSearchAgentLOSRequired 8.0
	float myMaxDistanceFromSearchAgentLOSRequired 20.0
	float myMinDistanceFromTargetLOSRequired 5.0
	float myMaxDistanceFromTargetLOSRequired 10.0
	float myOptimalDistanceFromTargetLOSRequired 0.0
	float myMinDistanceFromSearchPosition 0.0
	float myMaxDistanceFromSearchPosition 20.0
	float myMinDistanceFromSearchAgent 8.0
	float myMaxDistanceFromSearchAgent 20.0
	float myMinDistanceFromTarget 5.0
	float myMaxDistanceFromTarget 10.0
	float myOptimalDistanceFromTarget 0.0
	NPCMotionPatternType myMotionPatternType Jog
}

