// NPCMoveSettingReaction
class NPCMoveSettingReaction < abstract=1 > : NPCMoveSetting
{
	bool myEnabled true
	float myCooldown 5.0
}

list NPCMoveSettingWildlifeReactionList
{
	NPCMoveSettingReaction
}

class NPCMoveSettingReactToDistraction : NPCMoveSettingReaction
{
	NPCMoveType myMoveType WildlifeReactToDistraction < hidden=1 >
	bool myRequireLOS false < tooltip="Indicate if this reaction need LOS to trigger." >
	
	float myWaitingTimeDuringCooldown 2.0
	
	bool myEnableTooCloseBehavior true
	float myTooCloseBehaviorTriggerDistance 5.0 < tooltip="Wildlife will perform too close behavior and distance to distraction agent is within this range." >
	float myWaitingTimeAfterTooCloseBehavior 2.0 < tooltip="Waiting time before exit distraction reaction once too close behavior finished. During this watiing time wildlife is likely to focus on target." >
	
	bool myEnableInvestigation true
	float myInvestigationTriggerDistance 15.0 < tooltip="Wildlife will perform investigation behavior and distance to distraction position is within this range." >
	float myInvestigationTimeout 10.0 < tooltip="Maximum investigation time." >
	NPCMotionPatternType myInvestigationMotionPatternType Investigate
	
	bool myEnableOnSpotBehavior true
	bool myTurnToTargetPositionBeforeOnSpotBehavior true
	float myOnSpotBehaviorTriggerDistance 30.0 < tooltip="Wildlife will perform on spot behavior and distance to distraction position is within this range." >
	float myMinWaitingTimeAfterOnSpotAnimation 1.0 < tooltip="Min waiting time before exit distraction reaction once on spot behavior finished." >
	float myMaxWaitingTimeAfterOnSpotAnimation 3.0 < tooltip="Max waiting time before exit distraction reaction once on spot behavior finished." >
	
}