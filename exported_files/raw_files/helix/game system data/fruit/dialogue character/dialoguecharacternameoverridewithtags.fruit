include "helix/game system data/fruit/rbtags/rbtags.fruit"

list NameOverrideTags
{
	RBTagsTag*  < compact_view=1 bhv=rbtags rbtags_filter="~+Agent" >
}

class DialogueCharacterNameOverrideWithTags
{
	NameOverrideTags myTagsList
	uid myDialogueNameOverride < bhv="constantData" constantDataType="dialoguenameoverride" >
}

list DialogueCharacterNameOverrideWithTagsList
{
	DialogueCharacterNameOverrideWithTags
}