include "helix/game system data/fruit/contract/contracttypegroups.fruit"
include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/galaxy/galaxylocation.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/gamevalues/gamevalues.fruit"
include "helix/game system data/fruit/quest/quest.fruit"
include "helix/game system data/fruit/reward/reward.fruit"

list ContractRequirementsList
{
	ContractRequirementConditionGroup
	GameConditionContextPlayerHasReputation
	GameConditionLivingWorldContent_HasBeenCompleted
	GameConditionFormula
	GameConditionPlayerHasIntel
	GameConditionPlayerHasLegendRank
	GameConditionPlayerHasReputation
	GameConditionQuestState
	GameConditionIsLandingZoneAvailable
}

class ContractRequirementConditionGroup : GameConditionGroupBase
{
	ContractRequirementsList myConditions
}

class ContractPart < uid=auto >
{
	uid myLevelInfo < bhv="constantData" constantDataType="levelinfo" tooltip="The level contract part is played on." >
	bool myShouldBlockFastTravel
	ContractPartPersistentActionGameValue myHasCompletedPersistentActionGameValue < init_set=1 >
}

list ContractParts
{
	ContractPart
}

list BlockerQuestsRequirementsList
{
	GameConditionQuestIsCompleted
}

class Contract < uid=auto >
{
	uid myGalaxyLocation < bhv="constantData" constantDataType="galaxylocation" >
	uid myInitialFaction < bhv="constantData" constantDataType="faction" >
	Factions myPossibleFactions
	varmap myUIName < bhv="localization" >
	varmap myUIDescription < bhv="localization" >
	varmap myNarrativeDescription < bhv="localization" >
	int myDifficulty 1 < min=1 max=3 >
	float myCooldown 0.0 < min = 0 tooltip = "Contract cooldown time before it activates again (seconds)" >
	Reward* myReward
	Reward* myFailReward
	Reward* myBetrayReward
	ContractParts myParts
	ContractType myType
	ContractRequirementsList myRequirements
	ContractRequirementsList myUnlockRequirements
	BlockerQuestsRequirementsList myBlockerQuestsRequirements < tooltip = "Quests that, if not completed, revoke the contract (can't be quests that start while you might be in the contract area)." >
	bool myIsHighRiskContract false < tooltip = "Will fail upon dying in the contract, leaving the area etc." >
}

class ContractHotCargo : Contract
{
	ContractType myType Hot_Cargo < readonly=0 >
	uid myAmbushFaction < bhv="constantData" constantDataType="faction" >
}

class ContractContraband : Contract
{
	ContractType myType Contraband < readonly=1 >
	
	uid myDeliveryLandingZoneUID < bhv="constantData" constantDataType="landingzone" >
}

list ContractReferenceList
{
	Contract*
}

// Keep in sync with GameConditionContextContractIsInStateValidState in HC_GameConditionContextContractIsInState.cpp
enum GameConditionContextContractIsInStateValidState
{
	Started
	Failed
	Completed
}

class GameConditionContractIsInStateBase : GameCondition < abstract=1 >
{
	GameConditionContextContractIsInStateValidState myStateToCheck Completed < tooltip="State to check against" >
	ContractTypeList myRestrictedToTypes < tooltip="If set, only contracts with a type from this list will be considered valid" >
}

class GameConditionContextContractIsInState : GameConditionContractIsInStateBase
{
	GameConditionType myType ContextContractIsInState < hidden=1 >
}

class GameConditionContextContractHasGalaxyLocationType : GameCondition
{
	GameConditionType myType ContextContractHasGalaxyLocationType < hidden=1 >

	GalaxyLocationTypeList myValidLocationTypes
}

class GameConditionContextContractPlayerWasDetected : GameCondition
{
	GameConditionType myType ContextContractPlayerWasDetected < hidden=1 >
	bool myIsNegated FALSE < hidden = 1 >

	bool myPlayerWasDetected < tooltip="Whether or not the player was detected while this contract was in progress (while they were within the related volume)" >
}

class GameConditionAnyContractIsInState : GameConditionContractIsInStateBase
{
	GameConditionType myType AnyContractIsInState < hidden=1 >
}
