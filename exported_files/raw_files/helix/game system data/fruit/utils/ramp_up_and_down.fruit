include "helix/game system data/fruit/input/rumble.fruit"

class RampUpAndDownRumble
{
	uid myRampUpRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played in a loop when ramping up. Intensity is set by curve" >
	string myRampUpRumbleIntensityCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	uid myRampDownRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played in a loop when ramping down. Intensity is set by curve" >
	string myRampDownRumbleIntensityCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.75 0.0, 0 0, }, properties = { -749, -749, }, values = { 0 1, 1 0, }, }, numKeys = 2, }" < bhv=inputgraph >
}

class RampUpAndDown
{
	float myRampUpTime 0
	float myRampDownTime 0
	RampUpAndDownRumble myRumble
}
	
