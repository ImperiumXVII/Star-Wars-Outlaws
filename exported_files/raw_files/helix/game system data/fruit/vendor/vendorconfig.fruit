include "helix/game system data/fruit/mapref/mapref.fruit"
include "helix/game system data/fruit/item/item.fruit"
include "helix/game system data/fruit/reputation/reputation.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/gamevalues/gamevalues.fruit"
include "helix/game system data/fruit/intel/intel.fruit"
include "helix/game system data/fruit/vendor/vendorreplenishingbracket.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "helix/game system data/fruit/vendor/vendorservicetype.fruit"
include "helix/game system data/fruit/vendor/vendorcategorytype.fruit"
include "helix/game system data/fruit/equipmentupgrade/equipmentupgradeenums.fruit"
include "helix/game system data/fruit/domainsofmastery/domainofmastery.fruit"

enum VendorPriceModifierType
{
	Faction
	TrustedCustomer
	Suspicious
	OwesFavor
	JawaHaggling
	Narrative
	MiyukiPrivilegedCustomer
}

class VendorPriceModifierUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" >
	string myIcon < bhv="sprite" >
}

class VendorPriceModifier
{
	VendorPriceModifierUIInfo myUIInfo
	VendorPriceModifierType myType
	float myModifier 0 < bhv="percent" min=-1 max=5 >
	RBTagsTag* myRBTag < compact_view=1 bhv=rbtags rbtags_filter="~+Agent" >
}

class VendorPriceModifierReputation : VendorPriceModifier
{
	GameConditionContextPlayerHasReputation myCondition
	VendorPriceModifierType myType Faction
}

class VendorPriceModifierConditionList : VendorPriceModifier
{
	GameConditionGroup myCondition
}

class VendorPriceModifierSuspicious : VendorPriceModifier
{
	GameConditionContextVendorWasCaughtShoplifting myCondition
	VendorPriceModifierType myType Suspicious
}

list VendorPriceModifiers
{
	VendorPriceModifier
}

class VendorItem < uid=auto >
{
	Item* myItem
	int myQuantity -1 < tooltip="Available quantity of an item. -1 for infinite." min=-1 >
	ItemStackList myRequiredItems < hidden = 1 >
	vec2i myShopliftableQuantityRange 0;0 < tooltip="Specifies how many items are able to be shopliftable in a single shoplifting attempt, if they are in stock." >
}

class PersonalRequestVendorItem : VendorItem
{
	int myQuantity 1 < tooltip="Available quantity of an item. Full quantity is sold for the required items." min=1 >
	ItemStackList myRequiredItems < hidden = 0 >
	GameConditionContextVendorPersonalRequestRequirement myPersonalRequestUnlockRequirement
}

list VendorItemList
{
	VendorItem
}

class VendorItemStock < uid=auto always_override=1 >
{
	VendorItemList myVendorItemList
}

class SpecialVendorItemStock : VendorItemStock
{
	ReputationTier myRequiredReputationTier Good
}

class ConditionalVendorItemStock < uid=auto >
{
	VendorItemStock myConditionalGeneralStock
	SpecialVendorItemStock myConditionalSpecialStock
	GameConditionGroup myConditionGroup
}

list ConditionalStockList
{
	ConditionalVendorItemStock
}

class VendorUIInfo < ui_info=1 >
{
	varmap myUIShopName < bhv="localization" referenced_by_code=1 >
	varmap myUIShopTypeDescription < bhv="localization" >
	string myIcon < bhv="sprite" >
}

// Keep VendorServiceType in vendor/vendorservicetype.fruit in sync
// Format as "myHas[VendorServiceType]Service"
class VendorServices
{
	bool myHasItemShopBuyService true
	bool myHasItemShopSellService true
	bool myHasSpeederComponentsService false
	bool myHasSpeederAppearanceService false
	bool myHasShipComponentsService false
	bool myHasShipAppearanceService false
	bool myHasPersonalRequestService false
	bool myHasGiveDataService false
	bool myHasShipCargoUpgradeService false
}

list UpgradeCategoriesList
{
	UpgradeCategory
}

class VendorConfig < uid=auto >
{
	VendorUIInfo myUIInfo
	bool myEnabledAtSpawn TRUE
	MapRef* myMapRef
	Intel* myIntel < tooltip="Intel that must be resolved for this vendor's map ref to be discovered." >
	VendorItemStock myGeneralVendorItemStock
	SpecialVendorItemStock mySpecialVendorItemStock
	ConditionalStockList myConditionalVendorItemStocks
	VendorPriceModifiers myBuyPriceModifiersOverride
	VendorPriceModifiers mySellPriceModifiersOverride
	CurrencyItem* myCurrencyOverride
	GameConditionContextVendorPersonalRequestsDone myRequiredPersonalRequestGameCondition
	VendorServices myServices
	UpgradeCategoriesList myUpgradeCategories < tooltip="Used in UI to determine what categories of upgrades a vendor can sell." >
	VendorCategoryType myCategory
	uid myLandingZoneRef < bhv="constantData" constantDataType="landingzone" >
	uid mySpeederTransformEntity < bhv="entitypicker" tooltip="If set, the entity's transform will be used for teleporting the speeder upon interacting with the vendor." >
	uid myUICameraEntity < bhv="entitypicker" entitytype="Camera" >
}
