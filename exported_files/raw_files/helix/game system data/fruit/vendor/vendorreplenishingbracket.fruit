include "helix/game system data/fruit/item/item.fruit"

class VendorReplenishingBracket 
{
	float myPercentageOfMaxToReplenish < bhv="percent" min=0 max=1 tooltip="Will replenish a percentage of the max amount of each item. At least one item will be replenished">
}

list VendorReplenishingBracketList
{
	VendorReplenishingBracket
}

class VendorStockReplenishingBracket
{
	VendorReplenishingBracketList myVendorReplenishingBracketList
	ItemCategory myItemCategory
}

list VendorStockReplenishingBracketList
{
	VendorStockReplenishingBracket
}
