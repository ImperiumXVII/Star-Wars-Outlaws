// This enum needs to be kept in sync with the HC_SabaccMessageType enum in code/helix/HClient/HC_SabaccGameTypes.h
enum MessageType
{
	Info
	Success
	Warning
	Instruction
}

class SabaccMessages < uid=auto >
{
	MessageType myType
	string mySprite < bhv="sprite" >
	float myDisplayDuration 8.0
	varmap myMessage < bhv="localization" >
}