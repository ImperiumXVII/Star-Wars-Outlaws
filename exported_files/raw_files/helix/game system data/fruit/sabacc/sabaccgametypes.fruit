class SabaccGameCard
{
	int myValue < min=-8 max=8 >
	int myCount < min=0 >
}

list SabaccGameCards
{
	SabaccGameCard
}

class SabaccGameHand
{
	int myFirstCardValue < min=0 max=8 >
	int mySecondCardValue < min=-8 max=0 >
}

list SabaccGameHands
{
	SabaccGameHand
}

class SabaccGameHandRank
{
	SabaccGameHands myHands
	int myRank
}

list SabaccGameHandRanks
{
	SabaccGameHandRank
}

// This enum needs to be kept in sync with the HC_SabaccGameCollectionType enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccGameCollectionType
{
	PositiveDeck
	NegativeDeck
	PositiveDiscard
	NegativeDiscard
	PlayerHand
}

// This enum needs to be kept in sync with the HC_SabaccTaxGamePlayerChoice enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccTaxGamePlayerChoice
{
	None
	DrawCard
	Stand
	Shift
}

// must be consistent with HC_SabaccCheatDiceGaugeEntryType from HC_SabaccGameTypes.h
enum SabaccCheatDiceGaugeEntryType
{
	None
	HardFailed
	SoftFailed
	Succeed
}

// must be consistent with HC_SabaccSuspicionLevel from HC_SabaccGameTypes.h
enum SabaccSuspicionLevel
{
	None
	Low
	Middle
	High
	Caught
}

// must be consistent with HC_SabaccCheatResult from HC_SabaccGameTypes.h
enum SabaccCheatResult
{
	None
	HardFailed
	SoftFailed
	Success
}

// This enum needs to be kept in sync with the HC_SabaccTaxGamePhase enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccTaxGamePhase
{
	None
	ActionIntro
	ActionStakes
	ActionGameStart

	ActionAnte
	ActionInitializeDecks

	ActionRoundStart
	ActionPlayerTurnStart
	
	ChoicePlayer
	ActionPlayerChoice

	ActionRevealHand

	ActionReactReveal

	ActionPlayShiftCard
	ChoiceShiftTarget
	ActionChoiceShiftTarget
	ActionSpecialShiftEffect

	ActionCheat
	ActionSuspicionFeedback
	ChoiceBlabbermouthOpportunity
	ActionBlabbermouthEnded

	ActionPutChipsOnPot
	ActionTakeChipsFromPot

	ChoiceDrawDeck
	ActionDrawCard
	ChoiceDiscardCard
	ActionDiscardCard

	ActionRollsDice
	ChoiceDice
	ActionPutAwayDice

	ActionCinematic

	ActionPlayerTurnEnd
	ActionRoundEnd
	ActionGameEnd
	ActionOutro
}

// must be consistent with HC_SabaccGameInterruptionTime from HC_SabaccGameTypes.h
enum SabaccGameInterruptionTime
{
	Before
	After
}

class SabaccGameInterruption
{
	SabaccTaxGamePhase myPhaseToInterrupt
	SabaccGameInterruptionTime myInterruptionTime
}

// must be consistent with HC_SabaccCheatID from HC_SabaccGameTypes.h
enum SabaccCheatID
{
	None
	ResponsiveDice
	DoubleDraw
	SneakPeek
	NixScam
	CounterCheat
}

// This enum needs to be kept in sync with the HC_SabaccTableTier enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccTableTier
{
	Casual
	Serious
	Nemesis
}