class SabaccAIAnalyseProfile < uid=auto abstract=1 >
{
}

list SabaccAIAnalyseProfiles
{
	SabaccAIAnalyseProfile*
}

list StandSabaccRankThresholds
{
	int < min=0 tooltip="Will Stand if the sabacc rank is STRICTLY below the given value"> 
}

class SabaccAIAnalyseProfileCartesian : SabaccAIAnalyseProfile
{
	StandSabaccRankThresholds myStandPureSabaccRankThresholdsPerRound
	StandSabaccRankThresholds myStandSylopSabaccRankThresholdsPerRound
	int myCommanderPotentialSabaccRankThreshold < min=0 >
	bool myLikesDoubleCommanders
}

list TurnProbabilities
{
	float < min=0.0 max=1.0 >
}

class SabaccAIAnalyseProfileDoubleDrawer : SabaccAIAnalyseProfileCartesian
{
	TurnProbabilities myProbabilitiesToReplaceCardBySylop
	TurnProbabilities myProbabilitiesToReplaceCardBySylopWhenHasAlreadyASylop
}

class SabaccAIAnalyseProfileSuperstitious : SabaccAIAnalyseProfileCartesian
{
	bool myLikesDoubleCommanders False < readonly=1 >
}

class SabaccAIAnalyseProfileRiskTaker : SabaccAIAnalyseProfileCartesian
{
	bool myLikesDiscardDecks 
}