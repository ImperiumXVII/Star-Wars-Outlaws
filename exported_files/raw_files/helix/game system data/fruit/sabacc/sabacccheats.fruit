include "helix\game system data\fruit\sabacc\sabaccgametypes.fruit"
include "helix/game system data/fruit/item/item.fruit"

class SabaccCheatSettings < abstract=1 uid=auto >
{
	bool myIsActive true < tooltip="If false, the cheat will be disabled. Otherwise, the cheat will be enabled." >
	varmap myIsNotActiveWarning < bhv="localization" >
	SabaccGameInterruption myPhaseInterruptionWhenSuspicionIncreased < tooltip="If the suspicion has increased at the end of the cheat, we will block the flow at this phase">
	float myAutoSuccessGameplayDuration < min=0 tooltip="If the player has deactivated input challenges or if he is in story mode, he will automatically succeed the cheat. The gameplay will have this duration. (0 = no gameplay)">
}

/////////////////////////////////////////////////////////////////

class SabaccCheatDoubleDrawSettingsByDifficulty
{
	uid myInputChallenge < bhv="constantData" constantDataType="inputchallenge" >
}
list SabaccCheatDoubleDrawSettingsByDifficultyList
{
	SabaccCheatDoubleDrawSettingsByDifficulty
}
class SabaccCheatDoubleDrawSettings : SabaccCheatSettings
{
	Item* myRequiredItem < tooltip="Required item to unlock the cheat" >

	SabaccCheatDoubleDrawSettingsByDifficulty myDefaultSettings < tooltip="We take this settings if SettingsByDifficulty is empty" > 
	SabaccCheatDoubleDrawSettingsByDifficultyList mySettingsByDifficulty < tooltip="Settings ordered from easiest to most difficult" > 
}

/////////////////////////////////////////////////////////////////

class SabaccCheatDiceSettingsByDifficulty
{
	uid myInputChallenge < bhv="constantData" constantDataType="inputchallenge" >
}
list SabaccCheatDiceSettingsByDifficultyList
{
	SabaccCheatDiceSettingsByDifficulty
}
class SabaccCheatDiceSettingsBySuspicionLevel
{
	uid myInputChallenge < bhv="constantData" constantDataType="inputchallenge" >
}

list DieRankList
{
	int
}

class SabaccCheatDicePrimeSettings
{
	DieRankList myDieRanksWhenTwoImpostorsOnSucceed < tooltip="We will randomly pick the rank from this list for the die if we have two impostors in our hand and we succeed the cheat" >
	int myDieRankWhenImpostorAndSylopOnSucceed < tooltip="We will set this rank if we have a sylop and an impostor in our hand and if we succeed the cheat" >
	DieRankList myDieRanksWhenImpostorAndSylopOnFail < tooltip="The list size must be greater or equal than 2 (one at least for each dice). We will randomly pick the rank from this list if we have a sylop and an impostor in our hand and if we fail the cheat" >
}

class SabaccCheatDiceRevealSettings
{
	int myDieRankWhenImpostorOrSylopOnSucceed < tooltip="We will pick this rank if we succeed the cheat and if the second card is an impostor or a sylop" >
	DieRankList myDieExcludedRanksWhenImpostorOrSylopOnFail < tooltip="We will randomly take the die value between MinDieValue and MaxDieValue but we will exclude the value with the ranks in this list if we fail the cheat and if the second card is an impostor or a sylop." >
}

class SabaccCheatDiceSettings : SabaccCheatSettings
{
	Item* myRequiredItem < tooltip="Required item to unlock the cheat" >
	
	int myMinDieValue 1 < min=0 tooltip="Min value of the die" >
	int myMaxDieValue 6 < min=0 tooltip="Max value of the die" >
	SabaccCheatDicePrimeSettings myPrimeSettings < tooltip="Settings of the dice cheat when we use the prime shift card. We use the values of the associated ranks but we skip the ranks with only impostors and sylops" >
	SabaccCheatDiceRevealSettings myRevealSettings < tooltip="Settings of the dice cheat when revealing impostors. We use the values of the associated ranks but we skip the ranks with only impostors and sylops" >
		
	SabaccCheatDiceSettingsByDifficulty myDefaultSettings < tooltip="We take this settings if SettingsByDifficulty is empty" > 
	SabaccCheatDiceSettingsByDifficultyList mySettingsByDifficulty < tooltip="Settings ordered from easiest to most difficult" > 
}

