/////////////////////////////////////////////////////////////////
list SabaccSuspicionSettingsList
{
	SabaccSuspicionSettings
}

class SabaccSuspicionSettings
{
	SabaccSuspicionLevel mySuspicionLevel < tooltip="Blabbermouth parameters for this suspicion level" >
	string myRequiredSuspicionValue 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Required suspicion value to reach this suspicion level" >
	string myCheatDifficultyIndex 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Minimum difficulty index of every cheats if the player reaches this suspicion level. The difficulty index refers the index of the list SettingsByDifficilty for each cheat." >
	string myNumberOfAutoSuccessToIncreaseSuspicion 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="If the player has activated the no input challenges or if he is in story mode, he will automatically succeed the cheat. But the suspicion will increase every x cheat." >
	string myBlabbermouthPercentageChanceToTrigger 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Percentage chance to trigger blabbermouth each time suspicion is raised (between 0 and 1)" >
	string myBlabbermouthOpportunityDuration 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Duration of blabbermouth opportunity based on suspicion level" >
}

class SabaccCheats < uid=auto >
{
	SabaccSuspicionSettingsList mySuspicionsSettings
	int myBlabbermouthMaxOpportunities < min = 0 tooltip="Max blabbermouth opportunities per game" >
	Item* myRequiredItemToUnlockBlabbermouth < tooltip="Required item to unlock the blabbermouth" >
	string myBanDuration 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Duration in seconds of the ban. We cannot interact with table if we are banned from the table and we are caught cheating" >
	varmap myAllCheatsNotActiveWarning < bhv="localization" >
	int myRemainingAIPlayerCountToWatchCheatingAI 2 < min=0 max=5 tooltip="Can watch a cheating AI if remaining AI player count is equal or below this value" >

	SabaccCheatDoubleDrawSettings myDoubleDrawCheatSettings
	SabaccCheatDiceSettings myDiceCheatSettings
	SabaccCheatSneakPeekSettings mySneakPeekCheatSettings
	SabaccCheatNixScamSettings myNixScamCheatSettings
	SabaccCheatCounterCheatSettings myCounterCheatCheatSettings
}