include "helix/game system data/fruit/dialogue character/dialogue_character.fruit"
include "helix/game system data/fruit/character/charactervisuals.fruit"

class SabaccPlayerAVData < uid=auto >
{
	varmap myName < bhv="localization" >
	file myPortrait < bhv="asset" assettype="texture" >
	file myGameplaySequence < bhv=asset assettype=sequence >
	file myActionCard1Sequence < bhv=asset assettype=sequence >
	file myActionCard2Sequence < bhv=asset assettype=sequence >
	file myActionCard3Sequence < bhv=asset assettype=sequence >
	file myNixSneakPeakSequence < bhv=asset assettype=sequence >
	DialogueCharacterHelix* myVoiceData
	CharacterVisuals* myVisualData
}