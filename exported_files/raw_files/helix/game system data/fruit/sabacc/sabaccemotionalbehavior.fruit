include "helix\game system data\fruit\sabacc\sabaccshiftcards.fruit"

enum SabaccBeliefUpdate
{
	Fixed
	Updated
}

class SabaccBelief < abstract=1 >
{
	SabaccBeliefUpdate myUpdate
	bool myEmotionUpdate true 
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

enum SabaccTaxRiskBeliefState
{
	NeutralTax
	RiskyTax
	DeadlyTax
	AngryTax
}

class SabaccTaxRiskBelief : SabaccBelief
{
	SabaccTaxRiskBeliefState myStartingState
	int myChipsThreshold < min=0 >
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

enum SabaccPaybackRewardBeliefState
{
	NeutralPayBack
	RewardingPayBack
	ExcitingPayBack
}

class SabaccPaybackRewardBelief : SabaccBelief
{
	SabaccPaybackRewardBeliefState myStartingState
	int myChipsThreshold < min=0 >
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

enum SabaccChoiceBeliefState
{
	Bad
	Neutral
	Good
}

class SabaccStandBelief : SabaccBelief
{
	SabaccChoiceBeliefState myStartingState
}

class SabaccDrawBelief : SabaccBelief
{
	SabaccChoiceBeliefState myStartingState
	int myDiscardCardValueThreshold 5
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

enum SabaccStrongOpponentBeliefState
{
	Lower
	Equal
	Stronger	
}

class SabaccStrongOpponentBelief : SabaccBelief
{
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

enum SabaccAntagonistBeliefMode
{
	StrongestOpponent
	Susceptible
	ChipsRichest
	ChipsPoorest
}

list SabaccShiftCardSettings
{
	SabaccShiftCardSetting*
}

class SabaccAntagonistBelief : SabaccBelief
{
	SabaccAntagonistBeliefMode myMode
	int myStartingAntagonistIndex -1 < min=-1 tooltip="Starting antagonist player index, -1 means no starting antagonist" >
	SabaccShiftCardSettings  mySusceptibleShiftsAffectingMe < hidden=1 >
	SabaccShiftCardSetting*  mySusceptibleCheapSylopShift < hidden=1 >
	SabaccShiftCardSetting*  mySusceptibleBadBatchShift < hidden=1 >
	SabaccShiftCardSetting*  mySusceptiblePrimeShift < hidden=1 >
	SabaccShiftCardSetting*  mySusceptibleFirstAtLastShift < hidden=1 >
	SabaccShiftCardSetting*  mySusceptibleSwitcharooShift < hidden=1 >
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

// Differ from HC_SabaccWinBeliefState on purpose
enum SabaccWinBeliefState
{
	MightWin
	MightNotWin
}

enum SabaccGameWinBeliefMode
{
	HandBased
	StrongOpponentsAnalysis
}

class SabaccGameWinBelief : SabaccBelief
{
	SabaccWinBeliefState myStartingState
	SabaccGameWinBeliefMode myMode
	int mySabaccRankThreshold < min=0 tooltip="In HandBased mode the sabaccc rank of the player must be < to this threshold to set the belief to MightWin">
	int myFirstRevealerSabaccRankThreshold < min=0 tooltip="At reveal phase, the first revealer must have a sabacc rank < to this threshold to set the belief to IsWin">
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

class SabaccFullWinBelief : SabaccBelief
{
	SabaccWinBeliefState myStartingState
}

// ------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------

// This enum needs to be kept in sync with the HC_SabaccPlayerEmotionBaseline enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccPlayerEmotionBaseline
{
	Hope
	Fear
}

// This enum needs to be kept in sync with the HC_SabaccPlayerEmotionTemper enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccPlayerEmotionTemper
{
	Cold
	Hot
}

// This enum needs to be kept in sync with the HC_SabaccPlayerEmotionTemper enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccPlayerEmotion
{
	None
	Puzzled
	Gratification
	GratificationHigh
	Relief
	ReliefHigh
	Remorse
	RemorseHigh
	Disappointment
	DisappointmentHigh
	Angry
	AngryHigh
}

class SabaccEmotionalBehavior < uid=auto >
{
	SabaccPlayerEmotionBaseline myEmotionBaseline
	SabaccPlayerEmotionTemper myEmotionTemper
	SabaccPlayerEmotion myEmotion

	SabaccTaxRiskBelief myTaxRiskBelief
	SabaccPaybackRewardBelief myPaybackRewardBelief
	SabaccStandBelief myStandBelief
	SabaccDrawBelief myDrawBelief
	SabaccStrongOpponentBelief myStrongOpponentBelief < tooltip="The Strong Opponent Belief order the opponents in the order of who is more susceptible to win.\nAt the start of the game, no order is done, if the AntagonistBelief ask for the rank, the stronger player will be random" >
	SabaccAntagonistBelief myAntagonistBelief
	SabaccGameWinBelief myGameWinBelief
	SabaccFullWinBelief myFullWinBelief
}