include "helix\game system data\fruit\sabacc\sabaccgametypes.fruit"

// This enum needs to be kept in sync with the HC_SabaccGameShiftCardTarget enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccGameShiftCardTarget
{
	CurrentPlayer
	OneOpponent
	AllOpponents
	AllPlayers
	OneStandingOpponent
	AllStandingOpponents
}

// This enum needs to be kept in sync with the HC_SabaccGameShiftCardDuration enum in code/helix/HClient/HC_SabaccGameTypes.h
enum SabaccGameShiftCardDuration
{
	Instant
	Turn
	FullTurn
	NextTurn
	Round
}

enum SabaccGameShiftType
{
	Offense
	Defense
}

// This enum needs to be kept in sync with the HC_SabaccShiftCardEffect enum in code/helix/HClient/HC_SabaccShiftCardsConstantData.h
enum SabaccGameShiftCardEffect
{
	TakeChips
	DrawCostModifier
	ChoiceCountModifier
	ChoiceModifier
	DrawCardsCountModifier
	DrawDeckModifier
	TaxedChipsModifier
	SwitchCards
	ExtraTax
	CardValueModifier
	SabaccRanksModifier
	SpecialActionEffect
	Shield
}

// This enum needs to be kept in sync with the HC_SabaccShiftCardEffect enum in code/helix/HClient/HC_SabaccGameTypes.h
enum PlayerChoice
{
	None
	DrawCard
	Stand
	Shift
}

// This enum needs to be kept in sync with the HC_SabaccGameCardValueModifierType enum in code/helix/HClient/HC_SabaccGameTypes.h
enum CardModifierType
{
	CommanderToNormalCard
	SylopToNormalCard
	ChangeNormalCardValue
	NormalCardToSylop
	NormalCardToCommander
	SylopToCommander
	CommanderToSylop
}

enum RanksModifierType
{
	ReverseSabaccRank
	SetNewPrimeSabacc
	SetNewPrimeSabaccBetterThanSylop
}

enum SpecialActionType
{
	InsiderTrading
	Switcharoo
	TrueShift
}

enum ShieldOption
{
	ChoiceModifierShield
}

list ShieldOptions
{
	ShieldOption
}

list PlayerChoices
{
	PlayerChoice
}

class SabaccShiftCardSetting < uid=auto abstract=1 >
{
	int myIndex < min=0 >
	SabaccGameShiftCardEffect myEffect
	SabaccGameShiftCardTarget myTarget
	SabaccGameShiftCardDuration myDuration
	varmap myName < bhv="localization" >
	varmap myDescription < bhv="localization" >
	varmap mySubdescription < bhv="localization" >
	string myCardSymbolSprite < bhv="sprite" >
	string myCardBasicSymbolSprite < bhv="sprite" >
	file myCardRenderTexture < bhv="asset" assettype="texture" >
	file myCardBasicSymbolTexture < bhv="asset" assettype="texture" >
	vec2f myTextureOffset 0.0;0.0
	SabaccGameShiftType myType
	SabaccTaxGamePlayerChoice myChoiceAfterAIPlaying
	bool myCanShiftBePlayedJustBeforeReveal TRUE < tooltip="Uncheck this if it's not relevant to play the shift if the Reveal starts with the next player." >
}

class SabaccShiftCardTakeChips : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect TakeChips < readonly=1 >
	int myTakeChipsCount < min=0 >
}

class SabaccShiftCardDrawCostModifier : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect DrawCostModifier < readonly=1 >
	int myDrawCost < min=0 >
}

class SabaccShiftCardChoiceModifier : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect ChoiceModifier < readonly=1 >
	PlayerChoices myBlockedChoices
}

class SabaccShiftCardExtraTax : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect ExtraTax < readonly=1 >
	int myTaxedChipsCount < min=0 >
}

class SabaccShiftCardDrawCardsCountModifier : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect DrawCardsCountModifier < readonly=1 >
	int myDrawCardsCount < min=0 >
}

class SabaccShiftCardValueModifier : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect CardValueModifier < readonly=1 >
	SabaccGameShiftCardTarget myTarget AllPlayers < readonly=1 >
	SabaccGameShiftCardDuration myDuration Round < readonly=1 >
	CardModifierType myCardModifierType
	int myNewValue < min=-6, max=6 >
	int myOriginalValue < min=-6, max=6 >
}

class SabaccShiftRanksModifier : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect SabaccRanksModifier < readonly=1 >
	SabaccGameShiftCardTarget myTarget AllPlayers < readonly=1 >
	SabaccGameShiftCardDuration myDuration Round < readonly=1 >
	RanksModifierType myRanksModifierType
}	

class SabaccShiftInsiderTrading : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect SpecialActionEffect < readonly=1 >
	SpecialActionType mySpecialActionType InsiderTrading < readonly=1 >
	int myChipsInPotTax 1 < min=1 tooltip="Amount of chips in pot to be taxed.">
}

class SabaccShiftSwitcharoo : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect SpecialActionEffect < readonly=1 >
	SpecialActionType mySpecialActionType Switcharoo < readonly=1 >
}

class SabaccShiftTrueShift : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect SpecialActionEffect < readonly=1 >
	SpecialActionType mySpecialActionType TrueShift < readonly=1 >
}

class SabaccShiftShield : SabaccShiftCardSetting
{
	SabaccGameShiftCardEffect myEffect Shield < readonly=1 >
	SabaccGameShiftCardTarget myTarget CurrentPlayer < readonly=1 >
	SabaccGameShiftCardDuration myDuration Round < readonly=1 >
	ShieldOptions myShieldOptions
}
