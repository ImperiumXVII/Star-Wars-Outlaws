enum ChallengeStatOperation 
{
	GT
	GTE
	LT
	LTE
	EQ
}

class UbisoftCoreChallenge < uid=auto >
{
	varmap myDisplayName < tooltip="The challenge display name." bhv="localization" >
	varmap myDisplayDescription < tooltip="The challenge display description." bhv="localization" >
	string myVisibilityStartsAt < tooltip="When the challenge starts being visible. UTC time. Format: \"YYYY-MM-DD HH:mm:ss\"" >
	string myApplicabilityStartsAt < tooltip="When the challenge computation starts. UTC time. Format: \"YYYY-MM-DD HH:mm:ss\"" >
	file myIcon "" < tooltip="Relative path to a challenge icon. PNG 160 x 160 px, should not be black or white." >
	int myOrder < tooltip="Defines the sorting order of the retrieved challenges from the Public, Delegation and S2S APIs." >
	string myComment < tooltip="Comment from the administrator. Can't be null nor empty." >
	int myXp < tooltip="Xp quantity granted when the challenge is completed. Is greater or equal to 1." >
	string myStatName < tooltip="Stat on which the challenge is based. Can't be null nor empty." >
	ChallengeStatOperation myStatOperation < tooltip="How the threshold value is compared to the current player stat value." >
	string myStatTargetValue < tooltip="Threshold to reach for completing the challenge. Can't be null nor empty." >
}