
class FluffyDeformationRingsConfig
{
	// Inner ring: Random(InnerMin,InnerMax) -> center
	float myInnerMinRadius 0.7f < min=0.0 max=1.0 tooltip="This defines the min size of the inner ring: center -> inner radius. The value is a percentatge 0-1." >
	float myInnerMaxRadius 0.9f < min=0.0 max=1.0 tooltip="This defines the max size of the inner ring: center -> inner radius. The value is a percentatge 0-1." >
	float myInnerMinDepth 0.4f < min=0.0 max=1.0 tooltip="Min value of depth deformation on the inner ring . The value is a percentatge 0-1." >
	float myInnerMaxDepth 0.8f < min=0.0 max=1.0 tooltip="Max value of depth deformation. The value is a percentatge 0-1." >
	
	// Outer ring: Radius -> Random(InnerMin,InnerMax)
	float myOuterMinDepth 0.7f < min=0.0 max=1.0 tooltip="Min value of depth deformation: inner radius -> radius. The value is a percentatge 0-1." >
	float myOuterMaxDepth 0.9f < min=0.0 max=1.0 tooltip="Max value of depth deformation: inner radius -> radius. The value is a percentatge 0-1." >
}

class FluffyDeformation
{
	float myRadius 0.15f
	float myRadiusVariation 0.05f < tooltip="+/- Variation over the radius" >
	float myExpansionTime 0.f < tooltip="Time it takes the deformation to reach its maz size" >
}

class FluffyAdvancedDeformation : FluffyDeformation
{
	float myRadius 0.15f
	float myRadiusVariation 0.05f < tooltip="+/- Variation over the radius" >
	float myExpansionTime 0.f < hidden=1 > // Expand the deformation with rings doesn't look good and is not supported
	
	FluffyDeformationRingsConfig myRingsConfig
}

class FluffyDecal
{
	file myHeightTexture "" < bhv=asset assettype=texture >
	file myNormalTexture "" < bhv=asset assettype=texture >
	file myDiffuseTexture "" < bhv=asset assettype=texture >
	vec2f myTiling 1.0;1.0 < min=0.01 >
	float myHeightScale 1.0
	float myHeightOffset 0.0
	float mySize 1.0 < min=0.01 >
	float mySizeVariation 0.1 < tooltip="+/- Variation over the size" >	
	bool myReplaceWithDeformation false < tooltip="Once the decal is removed, a deformation of similar size will be added on the same place" >
	float myReplaceWithDeformationRadiusMultiplier 0.5 < tooltip="Decal size divided by 2 and then multiplied by this value will give us the deformation radius" >
	FluffyDeformationRingsConfig myDeformationReplacementRingsConfig

	// TODO /asm
	// float myExpansionTime 0.f < tooltip="Time it takes the decal to reach its max size" >
}
