include "helix/game system data/fruit/impact/impact_conditions.fruit"
include "snowdrop/modules/core/physics/collisionmaterials.fruit"

class VisualEffectByConditions
{
	GameConditionImpactGroup myConditions
	file myEffect "" < bhv=asset assettype=particles >
	file myDecal "" < bhv=asset assettype=object/gameplayobject >
}

list VisualEffectsByConditionsList
{
	VisualEffectByConditions
}

class EffectOnMaterial
{
	CollisionMaterial* myMaterial
	file myEffect "" < bhv=asset assettype=particles >
	file myDecal "" < bhv=asset assettype=object/gameplayobject >
}

list EffectOnMaterialList
{
	EffectOnMaterial
}

class EffectsByMaterials
{
	file myDefaultDecal "" < bhv=asset assettype=object/gameplayobject >
	file myDefaultEffect "" < bhv=asset assettype=particles >
	EffectOnMaterialList myList
	VisualEffectsByConditionsList myEffectsByConditions
}
