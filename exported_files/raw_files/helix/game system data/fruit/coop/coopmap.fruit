include "helix/game system data/fruit/coop/coopmapzone.fruit"
include "helix/game system data/fruit/coop/coopreinforcementteam.fruit"
include "helix/game system data/fruit/quest/quest.fruit"

list CoopMapZoneList
{
	CoopMapZone*
}

class CoopMapRoute
{
	CoopMapZoneList myZones		// the zone that the route is made of, in the proper order
	uid mySpawnPointUID			// the starting position of the route
	uid myRouteMutexUID			// used for creating the current route, like blocking doors to areas not part of the route
	uid myMainQuestMutexUID		// the main quest script is placed on this layer
	Quest* myMainQuest			// reference to the quest juice used on this route (in order to randomly pick one)
	int myWeight 1				// the weight of this route being chosen over another (from this map)
	varmap myRouteName < bhv="localization" >
}

list CoopMapRouteList
{
	CoopMapRoute
}

list ReinforcementList
{
	uid < bhv="constantData" constantDataType="coopreinforcementteam" >
}

class CoopMap < uid = auto >
{
	varmap myMapName < bhv="localization" >
	uid myLevelUID < bhv="constantData" constantDataType="levelinfo" >
	CoopMapRouteList myRoutesList
	int myWeight 1 
	ReinforcementList myReinforcementsTeamsPerAlarmLevelUIDs < tooltip="List of reinforcements that are selected by alarm level, first entry is for level 0, second for level 1 and so on. Defaults to the one below if none are used" >
	uid myReinforcementsTeamUID < bhv="constantData" constantDataType="coopreinforcementteam" >
}