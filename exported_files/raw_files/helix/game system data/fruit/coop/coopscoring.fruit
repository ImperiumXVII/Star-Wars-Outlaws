class ScorePerLivesLeft < uid=auto >
{
	int myLivesLost
	int myScore
}

list TeamLivesScoringSettings
{
	ScorePerLivesLeft
}

class TimeScoringSettings < uid=auto >
{
	int myMinimumPoints 0
	int myMaximumPoints 100000
	int myTimeForMaximumPoints 0
	int myTimeForMinimumPoints 1200
}

class RankThresholdSettings <uid=auto >
{
	int myUpperThreshold 80000 < tooltip="If the score is higher than this, the player will receive Gold rank." >
	int myLowerThreshold 40000 < tooltip="If the score is lower than this, the player will receive Bronze rank." >
}

class CoopScoringSettings < uid=auto >
{
	TimeScoringSettings myTimeScoringSettings
	TeamLivesScoringSettings myTeamLivesScoringSettings
	RankThresholdSettings myRankThresholdSettings < tooltip="score > upper threshold -> gold, score < lower threshold -> bronze, in between -> silver" >
}