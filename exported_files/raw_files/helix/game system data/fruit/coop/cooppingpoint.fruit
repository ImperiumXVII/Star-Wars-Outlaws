include "helix/game system data/fruit/audio/stimulus.fruit"

class CoopPingInputSettings
{
  string myIcon < bhv="sprite" ui_info=1 referenced_by_code=1 >
  StimulusIdentifier* myBarkStimulus
  AudioEvent myAudioEvent < tooltip="Audio event to be played when a ping is done.">
}

class CoopPingPoint < uid=auto >
{
  bool myUseBillboard true
  string myScalingCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph >
  CoopPingInputSettings myInfoPingSettings
  CoopPingInputSettings myActionPingSettings
  CoopPingInputSettings myAgreeResponseSettings
  CoopPingInputSettings myDisagreeResponseSettings
}