include "helix/game system data/fruit/equipment/equipment.fruit"
include "helix/game system data/fruit/talent/talent.fruit"
include "helix/game system data/fruit/character/charactervisuals.fruit"
include "helix/game system data/fruit/interactionpoints/interactionpoints.fruit"

list SpecializedInteractionsList
{
	InteractionPoint*
}

class MinigameDifficultyOverride
{
	InteractionPointMinigameType myType None
	InteractionPointMinigameDifficulty myDifficulty Easy
}

list MinigameDifficultyOverrideList
{
	MinigameDifficultyOverride
}

class CoopClass < uid = auto >
{
	TalentList myClassTalents
	SpecializedInteractionsList mySpecializedInteractions
	ItemStackList myStartingItems
	float mySpecializedInteractionDurationModifier 1.0f < min=0 tooltip="The duration value on the interaction gets multiplied with this if the specialization matches. Ex: 0.5 if we want 2x interact speed" >
	MinigameDifficultyOverrideList myMinigameDifficultyOverrides
}