include "helix/game system data/fruit/coop/coopclass.fruit"
include "helix/game system data/fruit/character/playablecharacterconfig.fruit"

class CoopCharacter < uid=auto >
{
	varmap myName < bhv="localization" ui_info=1 ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" ui_info=1 >
	string myIcon < bhv="sprite" ui_info=1 >

	CoopClass* myCoopClass
	PlayableCharacterConfig* myPlayableCharacterConfig
	TalentList myCharacterTalents
	uid myHUDGadgetCharges < tooltip="Where to get the charges data from to display in the HUD." bhv="constantData" constantDataType="item">
}
