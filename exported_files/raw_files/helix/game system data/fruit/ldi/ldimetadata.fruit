include "helix/game system data/fruit/accessibility/highcontrastenum.fruit"
include "helix/game system data/fruit/equipment/weapon/weapon_module.fruit"

class LDIMetadataUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" >
}

class LDIMetadataVisibilityUIInfo < ui_info=1 >
{
	varmap myStateName < bhv="localization" ui_info_debug_ui_name=1 >
	uid myColor < bhv=presetcolor >
	bool myWeaponModuleAffiliationEnabled false < referenced_by_code=1 >
	WeaponModuleFamilyType myWeaponModuleAffiliation Plasma < referenced_by_code=1 tooltip="This value is mainly used by UI and represents the type of weapon module that is effective against this class if enabled" >
}

class LDIMetadataVisibilityDataBase
{
	uid myState < bhv="constantData" constantDataType="ldimetadatastate" >

	LDIMetadataVisibilityUIInfo myUIInfo

	bool myIsVisibleInBinoculars TRUE
	bool myIsVisibleOnPetPulse TRUE
	bool myPlaysAudioEventWhenAlarmTriggers FALSE
	bool myIsVisibleOnScanner FALSE
	HighContrastModeCategory myHighContrastModeCategory None
}

class LDIMetadataVisibilityDataDefault : LDIMetadataVisibilityDataBase
{
	uid myState < hidden=1 >

	bool myIsVisibleInBinoculars TRUE
	bool myIsVisibleOnPetPulse TRUE
}

class LDIMetadataVisibilityDataOverride : LDIMetadataVisibilityDataBase
{
	bool myIsVisibleInBinoculars FALSE
	bool myIsVisibleOnPetPulse FALSE
}

list LDIMetadataVisibilityDataOverrides
{
	LDIMetadataVisibilityDataOverride
}

class LDIMetadata < uid=auto >
{
	LDIMetadataUIInfo myUIInfo

	LDIMetadataVisibilityDataDefault myDefaultVisibilityData
	LDIMetadataVisibilityDataOverrides myVisibilityDataOverrides
}