include "helix/game system data/fruit/interactionpoints/interactionpoints.fruit"
include "helix/game system data/fruit/player/movement.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/camera/camerablendtransitions.fruit"
include "helix/game system data/fruit/camera/cameralookatpreset.fruit"
include "helix/game system data/fruit/camera/cameramodifier.fruit"

class ArrestCameraParameters
{
	CameraLookAtPreset* myLookAtPreset
	vec3f myLookAtOffset 0.0;0.0;0.0
}

class ArrestOrbitCameraParameters
{
	CameraLookAtPreset* myLookAtPreset
	vec3f myLookAtOffset 0.0;0.0;0.0
	CameraModifierTransition myOrbitTransition < tooltip="The transition for the camera rotation around the orbit center." >
	float myOrbitRotationAngle -90.0
	float myMinAllowedOrbitRadius 6.0
	float myMaxAllowedOrbitRadius 9.0
	vec3f myOrbitCenterOffset 0.0;0.0;0.0
}

class MomentOfOpportunity < uid=auto >
{
	InteractionPoint* myBlabbermouthInteractionPoint
	PlayerMovementConfig* myBlabbermouthMovementConfig
	PlayerRestriction* myBlabbermouthRestrictions
	PlayerRestriction* myBlabbermouthInteractionRestrictions
	CameraTransition* myBlabbermouthCameraTransitionIn
	string myBlabbermouthSlowdownCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.2 0.001, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	float myBlabbermouthSlowdownTransitiontime 0.4f
	string myBlabbermouthPromptLifetime 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myPreBlabbermouthPromptMaxWaitingTime 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myBlabbermouthCameraRestrictionX 1.0
	float myBlabbermouthCameraRestrictionY 1.0
	float myBlabbermouthSlowmotionTime 0.5
	float myBlabbermouthRadius 40.0
	float myNearbyBlabbermouthInnerRadius 1.0 < tooltip="When we enter the inner radius we enter the NearbyBlabbermouth state">
	float myNearbyBlabbermouthOuterRadius 2.0 < tooltip="When we exit the outer radius we exit the NearbyBlabbermouth state">
	float myPetAttackDistanceToInterruptBlabbermouth 3.0 < tooltip="Distance between the pet and the target NPC within which we interrupt the blabbermouth during a pet attack">
	float myBlabbermouthLifetime 1.0
	float myBlabbermouthCooldownTime 3
	float myBlabbermouthNPCFocusPointLifetime 10.0
	float myPostBlabbermouthAssistTime 3 < tooltip="The time after blabbermouth ends during which actions can be attributed to being assisted by blabbermouth." >
	float myArrestLockControlsDistance 3.0
	float myScoutObjectiveDuration 5.0
	float myOrbitCameraStartTime 1.0
	ArrestCameraParameters myArrestCameraParameters
	ArrestOrbitCameraParameters myArrestOrbitCameraParameters
	uid myBlabbermouthReadyLoopRumble < bhv="constantData" constantDataType="rumble" tooltip="The rumble that is played in a loop once Blabbermouth is ready to be used">
	uid myBlabbermouthActivatedRumble < bhv="constantData" constantDataType="rumble" tooltip="The rumble that is played once when activating Blabbermouth">
	uid myArrestInProgressLoopRumble < bhv="constantData" constantDataType="rumble" tooltip="The rumble that is played in a loop once the player is being arrested, till it concludes">
	uid myArrestedRumble < bhv="constantData" constantDataType="rumble" tooltip="The rumble that is played once when the player is arrested">
}