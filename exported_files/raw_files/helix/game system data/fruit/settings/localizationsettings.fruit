list CardinalDirectionsList
{
	varmap < bhv=localization >
}

class LocalizationSettings < uid=auto >
{
	// Numbers 
	varmap myDecimal < bhv=localization >
	varmap myThousandSeparator < bhv=localization >
	varmap myThousandUnit < bhv=localization >
	varmap myMillionUnit < bhv=localization >

	// Distances
	float myMetersToKilometersThreshold 200.0 < tooltip="At which point should we display kilometers instead of meter for distances?" >
	float myFeetToMilesThreshold 2640.0 < tooltip="At which point should we display miles instead of feet for distance?" >
	float myRoundedDistThreshold 0.0 < tooltip="At which point should we display dist instead of rounded dist for distance?" >
	varmap myMetersUnit < bhv=localization tooltip="Short for meters" >
	varmap myKilometersUnit < bhv=localization tooltip="Short for kilometers" >
	varmap myFeetUnit < bhv=localization tooltip="Short for feet" >
	varmap myMilesUnit < bhv=localization tooltip="Short for miles" >
	varmap myDistUnit < bhv=localization tooltip="Short for distance" >

	// Cardinal directions
	CardinalDirectionsList myCardinalDirections < tooltip="Must match order and number of UICardinalDirections (uienums.fruit)" >
	CardinalDirectionsList myAbbreviatedCardinalDirections < tooltip="Must match order and number of UICardinalDirections (uienums.fruit)" >

	// Subtitles
	varmap mySubtitleNameFormat < bhv=localization tooltip="The format for a subtitle speakername. {0} contains the name." >

	// Subtitle language tags
	varmap mySubtitleLanguageTag_Binary < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Binary." >
	varmap mySubtitleLanguageTag_Gamorrean < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Gamorrean." >
	varmap mySubtitleLanguageTag_Huttese < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Huttese." >
	varmap mySubtitleLanguageTag_Jawaese < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Jawaese." >
	varmap mySubtitleLanguageTag_Melitto < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Melitto." >
	varmap mySubtitleLanguageTag_Toshari < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Toshari." >
	varmap mySubtitleLanguageTag_Tusken < bhv=localization tooltip="A short tag shown before the subtitles indicating the speaker is talking in Tusken." >
}