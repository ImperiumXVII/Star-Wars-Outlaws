include "helix/game system data/fruit/ai/npcobjectives.fruit"

enum NPCObjectiveMutexGroup
{
	NotSet
	Wanted
	Guide
}

list NPCObjectiveTypeList
{
	NPCObjectiveType
}

class NPCObjectiveMapping
{
	NPCObjectiveTypeList myObjectives
}

class NPCObjectivePriorityMapping : NPCObjectiveMapping
{
	int myPriority < min="1" tooltip="Higher value = higher priority" >
}

class NPCObjectiveMutexMapping : NPCObjectiveMapping
{
	NPCObjectiveMutexGroup myMutexGroup
}

list NPCObjectivePriorityMappingList
{
	NPCObjectivePriorityMapping
}

list NPCObjectiveMutexMappingList
{
	NPCObjectiveMutexMapping
}

class NPCObjectiveSettings
{
	NPCObjectivePriorityMappingList myPriorityMapping	
	NPCObjectiveMutexMappingList myMutexMapping
}

class NPCObjectiveSettingsRoot < uid=auto >
{
	NPCObjectiveSettings myObjectiveSettings
}