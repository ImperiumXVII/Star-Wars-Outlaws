include "helix/game system data/fruit/equipment/equipment_slot_types.fruit"

enum CustomCommandType
{
	Item
	Quest
}

class CustomCommand < abstract=1 >
{
	CustomCommandType myType
	uid myUID
	bool myIsBlocking false < tooltip="If true, the next commands will wait for this to finish first before executing" >
}

class CustomItemCommand : CustomCommand
{
	CustomCommandType myType Item < hidden=1 >
	uid myUID < bhv="constantData" constantDataType="item" >

	int myQuantity 1
	bool myForceEquip false
	EquipmentSlotGroupType myGroup
	EquipmentSlotTag myTag
}

class CustomQuestCommand : CustomCommand
{
	CustomCommandType myType Quest < hidden=1 >
	uid myUID < bhv = "constantData" constantDataType = "questbeat" >

	bool myTeleportToLocation false
	bool myUsePreset false
	bool myForceCompleteQuest false
}

list CustomCommandList
{
	CustomCommand
}

class CustomCommandGroup
{
	string myCommandNickname "Default" < tooltip="Name used to execute the command by calling CustomCommand nickname" >
	CustomCommandList myCustomCommands
}

list CustomCommandGroupList
{
	CustomCommandGroup
}

class DebugCustomCommandsSettings < uid=auto >
{
	CustomCommandGroupList myCustomCommandGroups
}