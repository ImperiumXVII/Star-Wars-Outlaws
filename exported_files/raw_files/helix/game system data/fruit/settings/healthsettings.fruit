include "helix/game system data/fruit/settings/safetybelt.fruit"
include "helix/game system data/fruit/combat/combat.fruit"

class DifficultyDamageAttributeModifier
{
	DamageType myDamageType
	DamageSourceType myDamageSourceType
	uid myDifficultyDamageAttribute < tooltip="This attribute applies a modifier to the taken damages" bhv=attribute >
}

list DifficultyDamageAttributeModifierList
{
	DifficultyDamageAttributeModifier
}

class HealthAttributes
{
	uid myHealthRegenModeAttribute < tooltip="Used in talents to allow different regeneration modes ( 0 = None, 1 = current segment, 2 =  custom segment number, 3 = full health)" bhv=attribute >
	uid myHealthSegmentsToRegenerateAttribute < tooltip="This attribute will dictate the number of health segments which are going to regenerate OUT of combat" bhv=attribute >
	uid myHealthSegmentsToRegenerateDuringCombatAttribute < tooltip="This attribute will dictate the number of health segments which are going to regenerate DURING combat" bhv=attribute >
	uid myReviveAttribute < tooltip="This attribute will dictate if the Agent can be revived or not" bhv=attribute >
	DifficultyDamageAttributeModifierList myDifficultyDamageAttributes < tooltip="list of attribute modifiers for the taken damage. They are defined by damage source and type" >
}

class DamageReduction
{
	DamageSourceType myDamageSourceType < tooltip="The damage source type for which the damage reduction is applied" >
	string myDamageReductionCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph >
	float myMaxTimeBetweenShots 0.5f < tooltip="The maximum time between shots, used to determine a new series of damage received" >
	float myDamageHistotyLifeTime 1.0f < tooltip="The duration for which the damage history sould be kept" >
}

list DamageReductionList
{
	DamageReduction
}

class HealthSettings
{
	float myHealthBarOffset 1.3f < tooltip="" >
	string myMaxHealthFormula 1 < bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myHealthPerSegment 1.f < tooltip="This amount is used to handle health in segments. The amount of segments will be given by MaxHealth/HealthPerSegment. If you do not want to use segments, this amount should be equal to MaxHealth." >
	int mySubSegments 4 < tooltip="number of health sub segments" >
	string myHealingRateFormula 0.34 < bhv=formulaEditor tooltip="Amount of health recovered in one second when health is recovered by medkits" formulaResolveContextType=AgentAttributes >
	float mySegmentPercentageToHealNext 0.8 < min=0.0 max=1.0 tooltip="When healing by means of a medkit, if the current segment has the specified percentage or more, the following segment will be healed as well" >
	bool myCanRegenerate false < tooltip="If true, the entity will be able to automatically regenerate health" >
	string myRegenerationRateFormula 0.34 < bhv=formulaEditor tooltip="Amount of health recovered in one second when health is recovered automatically (NOT by medkits)" formulaResolveContextType=AgentAttributes >
	string myRegenerationRateDuringCombatFormula 0.34 < bhv=formulaEditor tooltip="Amount of health recovered in one second when health is recovered automatically during combat (NOT by medkits)" formulaResolveContextType=AgentAttributes >
	string myHealthRegenCooldown 3.0f < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Time in seconds between the last time the entity received damage and when the regeneration should start" >
	float myReviveCooldown 150.0f < tooltip="Time in seconds from last revive to re-enable being revived" >
    bool myUseSafetyBelt false < tooltip="If true, the entity will use the following SafetyBelt settings" >
    SafetyBelt mySafetyBelt
    bool myUseDamageReduction false < tooltip="If true, the entity will use the following DamageReduction settings" >
	DamageReductionList myDamageReductionSettings < tooltip="Damage reduction applied when too much damage is taken in a short amount of time" >
	HealthAttributes myHealthAttributes
}