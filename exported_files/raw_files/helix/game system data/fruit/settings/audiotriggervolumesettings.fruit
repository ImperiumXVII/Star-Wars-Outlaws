include "snowdrop/modules/core/audio/audio.fruit"

class AudioTriggerVolumeSettings < uid=auto >
{
    AudioEvent myPlayerVegetationEnterAudioEvent < tooltip="Audio event to be played when an agent enters an audio vegetation trigger volume" >
    AudioEvent myPlayerVegetationExitAudioEvent < tooltip="Audio event to be played when an agent exits an audio vegetation trigger volume" >

    float myPetTriggerVolumeRadius 0.3 < tooltip="Pet agent AABB radius for collision checks with vegetation trigger volume" >
    float myPetTriggerVolumeHeight 0.5 < tooltip="Pet agent AABB height for collision checks with vegetation trigger volume" >
    AudioEvent myPetVegetationEnterAudioEvent < tooltip="Audio event to be played when an agent enters an audio vegetation trigger volume" >
    AudioEvent myPetVegetationExitAudioEvent < tooltip="Audio event to be played when an agent exits an audio vegetation trigger volume" >

    float myNPCSearchRadius 10.0 < tooltip="Radius used to generate audio events only for NPCs in that range of player agent. If set to less than 1, it will disable all NPC audio trigger events." >
    AudioEvent myNPCVegetationEnterAudioEvent < tooltip="Audio event to be played when a NPC agent enters an audio vegetation trigger volume" >
    AudioEvent myNPCVegetationExitAudioEvent < tooltip="Audio event to be played when a NPC agent exits an audio vegetation trigger volume" >
}
