include "helix/game system data/fruit/player/prohibitedaction.fruit"
include "helix/game system data/fruit/equipment/equipment.fruit"

class ProhibitedActionDetectionData < uid=auto >
{
	float myIdleDetectionRate 0.0
	float myAlertDetectionRate 0.0
	float myDetectionDelay 0 < tooltip = "Detection of action will not be processed until after the current time of detected action + delay.">
	bool myRequireVisibilityToOffender FALSE < tooltip = "**ONLY SUPPORTED FOR DELAYED ACTIONS** - Flags if the action requires the offender to be visible to the NPC in order to report." >
}

class ProhibitedActionSetting < uid=auto >
{
	ProhibitedActionType myActionType
	ProhibitedActionDetectionData myWantedProhibitedActionDetectionData
	ProhibitedActionDetectionData myReputationProhibitedActionDetectionData
}

list ProhibitedActionSettingList
{
	ProhibitedActionSetting
}

list ProhibitedHoldItems
{
	EquipmentItem*
}

class ProhibitedActionSettings < uid=auto >
{
	ProhibitedActionSettingList myProhibitedActionSettings
	ProhibitedHoldItems myProhibitedHoldItems < tooltip="Prohibited holding items which generates AI events for NPCs. Throwable items will also generate a specific prohibited throwing AI event." >
	float myNoticePlayerStandingTooCloseDelay 0.0
	float myPlayerShotNearNPCActionLifetime 1.0 < tooltip="How long NPCs are able to see on the player that they've recently shot near another NPC" >
	float myPlayerVehicleNPCCollisionActionLifetime 1.0 < tooltip="How long NPCs are able to see on the player that they've recently collided with another NPC whilst in a speeder or spaceship" >
	float myPlayerAssaultedNPCActionOutOfCombatTimeout 1.0 < tooltip="Timeout for how long the action can be active when out of combat" >
	float myPlayerShotAtNPCActionOutOfCombatTimeout 1.0 < tooltip="Timeout for how long the action can be active when out of combat" >
	float myPlayerEliminatedNPCMaxDistance 30.0 < tooltip="How far a NPC will notice and report player if the player kills another npc within that range. This value is used for when player is in combat and does not require any vision to player or other npc" >
	float myPlayerEliminatedNPCSpaceMaxDistance 4000.0 < tooltip="How far a NPC will notice and report player if the player kills another npc within that range. This value is used for when player is in combat and does not require any vision to player or other npc" >
}
