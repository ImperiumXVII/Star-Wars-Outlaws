include "helix/game system data/fruit/contract/contracttypegroups.fruit"
include "helix/game system data/fruit/gamevalues/gamevalues.fruit"
include "helix/game system data/fruit/equipmentupgrade/equipmentupgradeenums.fruit"

class ContrabandCargoTierData
{
	varmap myUIName < bhv="localization" ui_info=1 ui_info_debug_ui_name=1 >
	varmap myUIDescription < bhv="localization" ui_info=1 ui_info_debug_ui_name=1 >
	string myIcon < bhv="sprite" ui_info=1 >

	ContractContrabandCargoTier myTier
	TalentListUID myTalentList
	uid myReward < bhv="constantData" constantDataType="reward" >
	uid myPreferredCargoReward < bhv="constantData" constantDataType="reward" >
}

list ContrabandCargoTierDataList < size=3 >
{
	ContrabandCargoTierData
}

class ContrabandCargoTypeData
{
	varmap myUIName < bhv="localization" ui_info=1 >
	varmap myUITypeName < bhv="localization" ui_info=1 >
	varmap myUIDescription < bhv="localization" ui_info=1 ui_info_debug_ui_name=1 >
	varmap myUIPreferredCargoName < bhv="localization" ui_info=1 >
	varmap myUIPreferredCargoDescription < bhv="localization" ui_info=1 >
	varmap myUIPreferredFactionDescription < bhv="localization" ui_info=1 >
	string myIcon < bhv="sprite" ui_info=1 >
	string myIconHUD < bhv="sprite" ui_info=1 >
	string myIconContainer < bhv="sprite" ui_info=1 >
	file myCargoTextureOn < bhv="asset" assettype="texture" ui_info=1 >
	file myCargoTextureOff < bhv="asset" assettype="texture" ui_info=1 >
	uid myRequiredItem < bhv="constantData" constantDataType="item">
	uid myPreferredFaction < bhv="constantData" constantDataType="faction"> 

	ContractContrabandCargoType myCargoType
	ContrabandCargoTierDataList myTalentData

	UpgradeCategory myRequiredUpgradeCategory
}

list ContrabandCargoTypeDataList < size=4 >
{
	ContrabandCargoTypeData
}

class FactionRestrictionGroup
{
	uid myFaction < bhv = "constantData" constantDataType = "faction" >
	uid myGalaxyLocation < bhv = "constantData" constantDataType = "galaxylocation" >
}

class ContractReputationReward
{
	uid myFaction < bhv = "constantData" constantDataType = "faction" >
	uid myContractReward < bhv="constantData" constantDataType="reward" >
	uid myFactionReward < bhv="constantData" constantDataType="reward" >
}

class ContrabandCargoBoxParameters
{
	file myContrabandCargoContainerGraphObject < bhv=asset assettype=object >
	vec3f myPositionOffset 0.0;0.0;0.0 < tooltip="The offset from the Trailblazers position." >
	float myScale 1.0 < tooltip="The scale of the spawned object, if a specialized asset is used, leave at 1." >
	float myDespawnDistance 2000.0 < tooltip="Will despawn when far enough away from the ship." >
}

list FactionRestrictionGroupList
{
	FactionRestrictionGroup
}

list ContractReputationRewardList
{
	ContractReputationReward
}

list ContractGalaxyLocationSafeguardUID
{
	uid < bhv="constantData" constantDataType="galaxylocation" >
}

class ContractSettings < uid=auto >
{
	ProgressionGraphGameValue myContractsSystemIsAvailableGameValue < init_set=1 >
	int myMaxActiveContracts 1
	int myMaxActiveContrabandContracts 1
	int myMaxContractDifficulty 3
	int myReshuffleRequestValue 0 < tooltip = "Increment when a full contract reshuffle is required" >
	uid myMapRefConstantData < bhv="constantData" constantDataType="mapref" >
	ContractTypes myNewContractTypes
	ContractTypes myIgnoreHighRiskVolumeBehaviourContractTypes < tooltip = "Types that ignore contract volume high risk behaviour" >
	uid myHotCargoItem < bhv="constantData" constantDataType="item" >
	FactionRestrictionGroupList myFactionRestrictionGroups
	ContractReputationRewardList myContractReputationRewards
	uid myNeutralFaction < bhv = "constantData" constantDataType = "faction" tooltip="The neutral buyer faction used for betrayals" >
	uid myContrabandFaction < bhv = "constantData" constantDataType = "faction" tooltip = "The faction of the contraband brokers" >
	ContrabandCargoTypeDataList myContrabandCargoSettings
	uid myDefaultContrabandReward < bhv="constantData" constantDataType="reward" >
	ContractGalaxyLocationSafeguardUID myContractGalaxyLocationSafeguardUIDs < tooltip = "If the data is setup correctly for contracts, but you still get the message saying a contract part doesn't exist, try adding the galaxy location to this list." >
	ContrabandCargoBoxParameters myCargoObjectParameters < tooltip = "If left empty or setup incorrectly, no box will spawn when dumping contraband cargo." >
}