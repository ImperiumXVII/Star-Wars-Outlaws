include "helix/game system data/fruit/animation/animvariableforwardingconfig.fruit"
include "helix/game system data/fruit/equipment/equipment_set.fruit"
include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/gamestatistics/gamestatistics.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"

list FactionList
{
	Faction*
}

list PetPulseVisibilityGameConditions
{
	PetPulseVisibilityGameConditionGroup
	GameConditionPlayerHasItem
	GameConditionDomainOfMasteryAbilityState
}

class PetPulseVisibilityGameConditionGroup : GameConditionGroupBase
{
	PetPulseVisibilityGameConditions myConditions
}

class PetPulseVisibilityCondition
{
	uid myLDIMetadata < bhv="constantData" constantDataType="ldimetadata" >
	PetPulseVisibilityGameConditionGroup myGameConditionGroup
}

list PetPulseVisibilityConditions
{
	PetPulseVisibilityCondition
}

class PetSettings < uid=auto >
{
	EquipmentSet* myEquipmentSet 
	
	float myMaxDistanceFromPlayerBeforeTeleportNeutralStance 50.0f
	float myMaxDistanceFromPlayerBeforeTeleportStealthStance 50.0f
	float myMaxDistanceFromPlayerBeforeTeleportCombatStance 50.0f

	float myMaxDistanceFromPlayerOutsideNavmesh 5.0f < tooltip="The max distance that the pet will wait in navmesh while the player is outside the navmesh" >
	float myPlayerSpeederMountAnticipationDistance 10.0f < tooltip="When the distance between the player and speeder is less than this, the pet will mount the speeder" >
	float myPlayerSpeederDismountDistance 15.0f < tooltip="If the player moves away from the speeder before mounting (above this distance), the pet will dismount" >
	float myPetMomentOfOpportunityAwarenessRadius 15.0f

	string myDefautPlayerVelocityResponseCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myResponsivePlayerVelocityResponseCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string mySlowPlayerVelocityResponseCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >

	GameConditionPlayerHasItem myPetCacheDetectionRequirement
	GameConditionPlayerHasItem myPetDoubleDistractRequirement
	string myMaxMultiDistractTargets 2 < tooltip="Number of multi attack targets." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myDistractTargetHeightDifferenceDistancePenalty "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >

	GameStatistic* myPetGotPetGameStatistic

	PlayerRestriction* myPetModePlayerRestrictions < tooltip="The actions prevented while in pet mode" >
	PlayerRestriction* myPetModePreparationPlayerRestrictions < tooltip="The actions prevented while pet mode is about to be enabled (quick tap actions)" >
	
	FactionList myPetSenseFactionFilter < tooltip="The Factions to allow in pet sense" >
	
	AnimVariableForwardingConfig* myPlayerAnimVariableForwardingConfig
	AnimVariableForwardingConfig* mySpeederAnimVariableForwardingConfig
	
	file myDefaultStolenLootGraphObject "" < bhv=asset assettype=object tooltip="Default graph object used for when the pet is bringing an item that does not have a custom loot graph." >

	PetPulseVisibilityConditions myPetPulseVisibilityConditions

	uid myNewInteractionSelectionRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played while on pet mode, when selecting (hovering) a new interaction" >
	uid myPetPulseRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played when the pet pulses" >
	uid myActionConfirmationRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played when confirming an action" >
	uid myActionCancellationRumble < bhv="constantData" constantDataType="rumble" tooltip="This rumble is played when cancelling an action" >

	float myPetModeInputComboTimerDuration 0.12 < tooltip="Input Time window for the Pet Game Action to allow to do a quick Pet Mode combo vs a Quick Pet Command. For best results, keep close to the Enter Pet Mode game action timings" >
	float myPetCommandCooldownDuration 0.5 < tooltip="Cooldown between pet orders (Does not affect cancelling) to avoid spam issues" >

	float myDynamicNavLinkEntryOffset 0.3 < tooltip="Entry offset for jump animation over dynamicly created navlink" >
	float myDynamicNavLinkExitOffset 0.3 < tooltip="Exit offset for jump animation over dynamicly created navlink" >	
}
