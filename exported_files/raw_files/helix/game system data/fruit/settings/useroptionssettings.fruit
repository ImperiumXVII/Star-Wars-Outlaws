//=========================================================
// * User Option Controls
//=========================================================
class UserOptionControl < abstract=1 >
{
	OptionEnum myUserOption
	varmap myUserOptionName < bhv = "localization" >
	varmap myDescription < bhv = "localization" >
	string myAbbreviation < tooltip = "A 4 letter abbreviation used for storing on cloud" >
	bool myNeedsConfirmApply false
	PlatformList myExclusiveToPlatforms
	bool myExcludeOnLockhart false < tooltip = "If true, don't display this on Xbox Series S (Lockhart)" >
}

class BoolControl : UserOptionControl
{
	bool myDefaultValue false
}

class IntegerControl : UserOptionControl
{
	int myStepNumber 1
	vec2i myMinMax 0;10
	int myDefaultValue 5
}

list StringList
{
	varmap < bhv = "localization" >
}

class StringControl : UserOptionControl
{
	StringList myStrings
	int myDefaultIndex 0
	bool myShouldWrap true
	bool myIsLastOptionMaxOnly false < tooltip = "If true, the last setting value will only be available if game is launched with -unlockmaxsettings." >
}

list HexColorList
{
	color
}

list PresetColorList
{
	uid < bhv = "color" >
}

class ColorControl : UserOptionControl
{
	uid myColor < bhv = "color" tooltip = "The preset color that should be overridable" >
	bool myAllowOpacityChange < tooltip = "Allow user to change the opacity of the preset color" >
	HexColorList myPredefinedHexColors < tooltip = "List of pre-defined colors to select from, keep empty to enable full color picker" >
	PresetColorList myPredefinedPresetColors < tooltip = "List of pre-defined colors to select from, keep empty to enable full color picker" >
}

class UserOptionsColorPresetConfig
{
	uid myUID
	uid myHighContrastUID
	varmap myUIName < bhv = "localization" >
}

//=========================================================
// * User Options Lists
//=========================================================
list BoolSettingsList
{
	BoolControl
}

list IntegerSettingsList
{
	IntegerControl
}

list StringSettingsList
{
	StringControl
}

list ColorSettingsList
{
	ColorControl
}

list UserOptionsColorPresetConfigList
{
	UserOptionsColorPresetConfig
}

//=========================================================
// * User Options Menu Category Configurations
//=========================================================
class CategoryEntry < abstract=1 >
{
	PlatformList myExclusiveToPlatforms
	bool myExcludeOnLockhart false < tooltip = "If true, don't display this on Xbox Series S (Lockhart)" >
	bool myIsIndented
}

class CategoryEntryButton : CategoryEntry
{
	string myButtonIdentifier < tooltip = "Name of the button to check for in the UI Graph." >
	varmap myButtonName < bhv = "localization" >
}

class CategoryEntryHeader : CategoryEntry
{
	varmap myHeaderTitle < bhv = "localization" >
}

class CategoryEntryOption : CategoryEntry
{
	OptionEnum myOption
}

class CategoryEntryPresetSelector : CategoryEntry
{
	PresetSelectorEnum myPresetSelector
}

class CategoryEntrySeparator : CategoryEntry
{

}

class CategoryEntrySubpage : CategoryEntry
{
	string myCategoryDestination
}

list CategoryEntries
{
	CategoryEntryButton
	CategoryEntryHeader
	CategoryEntryOption
	CategoryEntrySeparator
	CategoryEntrySubpage
	CategoryEntryPresetSelector
}

class OptionCategory
{
	varmap myCategoryName < bhv = "localization" >
	bool myIsGrid false
	string myIcon < bhv=sprite >
	CategoryEntries myCategoryEntries
}

list OptionCategoryList
{
	OptionCategory
}

//=========================================================
// * User Options Menu Preset Selector
//=========================================================

list UserOptionPresetSelectorEntries
{
	CategoryEntryOption
	CategoryEntryHeader
	CategoryEntrySeparator
	CategoryEntryPresetSelector
}

class PresetValue < abstract = 1 >
{
	OptionEnum myOption
}

class PresetValueBoolean : PresetValue
{
	bool myValue
}

class PresetValueInteger : PresetValue
{
	int myValue
}

class PresetValueColor : PresetValue
{
	color myValue
}

class PresetValuePreset
{
	PresetSelectorEnum myPreset
	int myPresetLevelIndex
}

list PresetLevelValues
{
	PresetValueBoolean
	PresetValueInteger
	PresetValueColor
	PresetValuePreset
}

class PresetLevel
{
	varmap myName < bhv = "localization" >
	PresetLevelValues myValues
}

list PresetLevels
{
	PresetLevel
}

class UserOptionPresetSelector
{
	PresetSelectorEnum myPresetSelector
	varmap myName < bhv = "localization" >
	varmap myDescription < bhv = "localization" >

	UserOptionPresetSelectorEntries myLayout
	PresetLevels myLevels
}

list UserOptionPresetSelectors
{
	UserOptionPresetSelector
}

//=========================================================
// * User Options Menu Examples
//=========================================================
class UserOptionExample < abstract=1 >
{
	OptionEnumList myOptions
}

class UserOptionExampleGraph : UserOptionExample
{
	file myGraph < bhv=asset assettype="GUI" >
}

list UserOptionExampleHeaderList
{
	varmap < bhv = "localization" >
}

list UserOptionExampleTextureList
{
	file < bhv=asset assettype="texture" >
}

class UserOptionExampleTextures : UserOptionExample
{
	UserOptionExampleTextureList myTextures
	UserOptionExampleHeaderList myHeaders
}

list UserOptionExampleVideoList
{
	file < bhv=asset assettype="bink" >
}

class UserOptionExampleVideos : UserOptionExample
{
	UserOptionExampleVideoList myVideos
	UserOptionExampleHeaderList myHeaders
}

list UserOptionExamples
{
	UserOptionExampleGraph
	UserOptionExampleTextures
	UserOptionExampleVideos
}

class UserOptionsGraphicsPreset
{
	string myPresetName
	varmap myUserFacingName < bhv = "localization" >

	bool my40hzMonitorDependent false < tooltip = "If true, signals this preset is only available on 40hz monitors. " >
	bool myNeedsRestartFromEarlier false < tooltip = "If true, signals that any change from a preset earlier(higher up) in the list will require a restart to apply fully." >
	bool myNeedsRestartFromLater false < tooltip = "If true, signals that any change from a preset later(lower down) in the list will require a restart to apply fully." >
	bool myIsMaxPreset false < tooltip = "If true, preset will only be available if the process runs with -unlockmaxsettings." >
}

list UserOptionsGraphicsPresets
{
	UserOptionsGraphicsPreset
}

class UserOptionsGraphicsPresetsPerPlatform
{
	UserOptionsGraphicsPresets myPCPresets
	UserOptionsGraphicsPresets myXBXPresets
	UserOptionsGraphicsPresets myXBSPresets
	UserOptionsGraphicsPresets myPS5Presets
	UserOptionsGraphicsPresets myPS5ProPresets
}

//=========================================================
// * User Options Menu Hardcoded Strings
//=========================================================
class UserOptionsMenuHardcodedStrings
{
	varmap myDisplayNameFormat < bhv = "localization" >
	varmap myDisplayNameFormatPrimary < bhv = "localization" >

	varmap myCustomGraphicsPreset < bhv = "localization" >

	varmap myWindowModeWindowed < bhv = "localization" >
	varmap myWindowModeBorderless < bhv = "localization" >
	varmap myWindowModeFullscreen < bhv = "localization" >

	varmap myUpscalerTAAName < bhv = "localization" >
	varmap myUpscalerFSR3Name < bhv = "localization" >
	varmap myUpscalerXeSSName < bhv = "localization" >
	varmap myUpscalerDLSSName < bhv = "localization" >
	varmap myUpscalerPSSRName < bhv = "localization" >

	varmap myMonitorNameFormat < bhv = "localization" >
	varmap myMonitorNameFormatPrimary < bhv = "localization" >
}

//=========================================================
// * User Options Root Types
//=========================================================
class UserOptionsMenuConfig
{
	OptionCategoryList myCategories
	UserOptionExamples myExamples
	UserOptionsColorPresetConfigList myColorPresets
	UserOptionsMenuHardcodedStrings myHardcodedStrings
}

class UserOptionsSettings < uid=auto >
{
	BoolSettingsList myBoolOptions
	IntegerSettingsList myIntegerOptions
	StringSettingsList myStringOptions
	ColorSettingsList myColorOptions

	UserOptionPresetSelectors myPresets

	UserOptionsGraphicsPresetsPerPlatform myGraphicsPresetsPerPlatform

	UserOptionsMenuConfig myOptionsMenuConfig

	uid myNavigationColor < bhv="color" tooltip="Default preset color for in-world navigation hints." >
	uid myPuristNavigationColor < bhv="color" tooltip="Preset color for overriding the in-world navigation hints in Purist Mode." >
}
