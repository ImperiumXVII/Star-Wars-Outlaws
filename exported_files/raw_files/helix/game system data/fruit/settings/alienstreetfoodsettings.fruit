list EvaluationMarkers
{
    string
}

class AlienStreetFoodSettings < uid=auto >
{
    EvaluationMarkers myEvaluationMarkerTags < tooltip="Any marker having one of these tags will perform any scheduled jump. Used to smoothly transition from one animation to another." >
    EvaluationMarkers myLeavingMarkerTags < tooltip="Any marker having one of these tags will signal the runtime that the gameplay is about to end and to switch to the leaving state." >
    EvaluationMarkers myResumeChallengeMarkerTags < tooltip="Any marker having one of these tags will resume the currently running challenge if paused." >
    EvaluationMarkers myStopDroidIdleMarkerTags < tooltip="Any marker having one of these tags will signal that the droid needs to stop its idle loop to be attached to the gameplay sequence.">
    EvaluationMarkers myIgnoreMarkerTags < tooltip="Any marker having one of these tags will be ignored by the alien street food activity." >
    float myDefaultChallengeStartDelay 0 < min=0 tooltip = "Default minumum time before the start of a challenge." >
    float myDefaultSuccessJumpDelay 2.0 < min=0 tooltip = "Default minumum time before a jump is executed after a success." >
    float myDefaultFailureJumpDelay 2.0 < min=0 tooltip = "Default minumum time before a jump is executed after a failue." >
    file myMasterGraph < bhv="asset" assettype="GUI" tooltip="Alien street food ui master graph." >
}