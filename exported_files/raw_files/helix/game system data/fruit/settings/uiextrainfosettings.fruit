class ItemUIExtraInfo < ui_info=1 >
{
	string myIcon < bhv="sprite" >
	varmap myTitle < bhv="localization" >
	varmap myDescription < bhv="localization" >
}

list ItemUIExtraInfoList
{
	ItemUIExtraInfo
}

class ItemUIInfo
{
	uid myRelatedItem < bhv="constantdata" constantDataType="item" >
	ItemUIExtraInfoList myExtraInfos
}

list ItemUIInfoList
{
	ItemUIInfo
}

class UIExtraInfoSettings < uid = auto >
{
	ItemUIInfoList myItemsUIInfo
}