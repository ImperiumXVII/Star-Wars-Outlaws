include "snowdrop/modules/core/physics/collisionmaterials.fruit"
include "snowdrop/modules/core/audio/audio.fruit"

list CollisionMaterialsGroup
{
	CollisionMaterial
}

class CollisionEffect < uid=auto >
{
	float myMinTriggerVelocity 0.0
	float myMaxTriggerVelocity 0.0
	file myParticleEffect < bhv=asset assettype=particles >
	file myContinuousEffect < bhv=asset assettype=object >
	AudioEvent myOneHitAudioEvent
	AudioEvent myContinuousAudioEvent
	AudioEvent myContinuousEndAudioEvent
	
	CollisionMaterialsGroup myGroup1
	CollisionMaterialsGroup myGroup2
}

list CollisionEffectList
{
	CollisionEffect
}

class CollisionSettingsClass < uid=auto >
{
	CollisionEffectList myCollisionEffects
}
