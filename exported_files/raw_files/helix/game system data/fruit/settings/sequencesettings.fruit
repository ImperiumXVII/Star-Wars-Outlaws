include "helix/game system data/fruit/restriction/playerrestriction.fruit"

enum SequenceResourceType
{
	Agent
	Prop
	Emitter
}

list ExternalResourceNames
{
	string
}

class SequenceResourceArchetype
{
	SequenceResourceType myResourceType
	ExternalResourceNames myExternalResourceNames
}

class SequenceResourceArchetypes
{
	SequenceResourceArchetype myPlayerArchetype
	SequenceResourceArchetype myPlayerPetArchetype
}

class TransitionToSequenceCameraData
{
   float myMaxAngleToTriggerTransition 110.f < min=0.f max=180.f tooltip="Value is in degrees. When initiating a transition to sequence, if the angle between current camera direction and the direction of the initial sequence camera is larger than this, then skip camera transition" >
   bool myShouldSkipTransitionOnCameraFail false < tooltip="If this is set to true, skip the entire transition to sequence with a fade if the camera angle is too large, otherwise cut the camera specifically" >
}

class SequenceSettings < uid=auto >
{
	SequenceResourceArchetypes myResourceArchetypes
	PlayerRestriction* myPlayerTransitionToSequenceRestrictions < tooltip="List of restrictions during transition to sequences" >
	TransitionToSequenceCameraData myPlayerTransitionToSequenceCameraData < tooltip="Settings for camera behavior during transition to sequences" >
	float myPlayerTransitionToSequenceFailFadeDuration 1.0 < tooltip="In/out duration, 1 means 1 second in and one second out" >
	float myPlayerTransitionToSequenceMinOptimalDistance 1.5
	float myPlayerTransitionToSequenceMaxOptimalDistance 2.0
}