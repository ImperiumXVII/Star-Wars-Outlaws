include "helix/game system data/fruit/playerpresets/playerpresets.fruit"

// keep in sync with HC_DemoModeEnum in code\helix\HClient\HC_DemoMode.h
enum DemoModeType
{
	None
	FWD_2024
	FWD_2024_Marketing
	Preview
}

list FileList
{
	file
}

class DemoModeParameters
{
	DemoModeType myDemoModeType < tooltip="Which mode do the settings belong to?" >
	string myDeliveryArgument < tooltip="When mode is enabled, the value is appended to -delivery in the command line arguments. When a new game is started, you'll get the corresponding progression state." >
	file myUserOptionsFile < types=*.useroptions tooltip="When mode is enabled, this user options file is loaded to override specified settings." >
	FileList myEnableConsoleScripts < tooltip="When mode is enabled, each console script in the list is executed." >
	FileList myDisableConsoleScripts < tooltip="When mode is disabled, each console script in the list is executed." >
	PlayerPresets* myPlayerPreset < tooltip="A Preset for player Gear and Abilities to be applied when the mode is enabled. Can be empty." >
}

list DemoModeParametersList
{
	DemoModeParameters
}

class DemoQuest
{
	string myName
	string myDescription
	file myImage < bhv=asset assettype=texture >
	file mySaveGamePC
	file mySaveGameXSX
}

list DemoQuestList
{
	DemoQuest
}

class DemoModeSettings < uid=auto >
{
	DemoModeType myDefaultMode < tooltip="Default mode to use if no mode parameter is used for -demo or -helixdemo start argument." >
	DemoModeParametersList myParameters
	DemoQuestList myQuests
}