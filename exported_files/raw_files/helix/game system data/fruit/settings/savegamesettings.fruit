class SaveGameSettings < uid=auto >
{
	float myAutoSaveGameIntervalSeconds 0.0
	float myAutoSaveGameSlotSwitchIntervalSeconds 0.0
	float myPlayerInactivityTimer 0.0
	int myMaxNumberOfAutoSaveGames 0
	int myMaxNumberOfManualSaveGames 10
	float myBackupSaveMinDistanceToFocusedBeat 3 < tooltip = "Minimum distance below which a backup save won't be performed." >

	varmap myNoQuestSavegameTitle < bhv = "localization" tooltip = "The title to display on save-games when no quest has been detected to display." >
	varmap myPlatformSavegameTitle < bhv = "localization" tooltip = "The title to display on save-games for platforms." >
	varmap myPlatformSavegameSubTitle < bhv = "localization" tooltip = "The sub title to display on save-games for platforms." >
	varmap myPlatformSavegameDetail < bhv = "localization" tooltip = "The detail to display on save-games for platforms." >
}