
enum BoneAliasID < useCategories=1 >
{
	Undefined

	< startCategory="HUD" >
	UIHat
	< endCategory="" >

	< startCategory="Pet Commands" >
	PetAttackPose
	PetStealPose
	PetHeadAttackBone
	PetTorsoAttackBone
	< endCategory="" >
	
	< startCategory="Wildlife" >
	WildlifeRangeAttackPose
	< endCategory="" >

	< startCategory="Humanoid" >
	RightHand
	LeftHand
	< endCategory="" >

	< startCategory="Weakpoint" >
	WeakpointTorsoBone
	WeakpointHipBone
	< endCategory="" >
}

class BoneAlias
{
	BoneAliasID myBoneAliasID
	string myBoneAliasName
}

list BoneAliasList
{
	BoneAlias
}

class BoneAliasSettings < uid=auto >
{
	BoneAliasList myBoneAliases
}