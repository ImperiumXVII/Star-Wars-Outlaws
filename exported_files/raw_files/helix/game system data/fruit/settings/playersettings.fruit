class ForcedSlideParameters
{
	string myForcedSlideAccelerationOverTime "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 1, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.2 0, }, outTangents = { 0 0, }, properties = { 1299, }, values = { 0 8, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the time (in seconds) passed sliding, the y axis represents the acceleration" >
	float myForcedSlideMaxSpeed 25.0f
	float myMinDistanceToStartForcedSlideDeceleration 0.0f < tooltip="If you are entering a ForcedSlide Volume in a direction that is opposite with the ForcedSlide direction, the ForcedSlide deceleration will start after you will have walked this minimum amount, in the ForcedSlide direction" > 
	float myMinSpeedToStartForcedSlide 0.1f < tooltip="If you are in a ForcedSlide Volume, you passed the myMinDistanceToStartForcedSlideDeceleration and your current is less than or equal this value, the forced slide will immediately start" >
	float myTimeToStartForcedSlideFromOppositeDirection 0.0f < min=0.0 tooltip="Minimum time that should pass in a ForcedSlide volume or slope before starting the PreForcedSlide deceleration if we are walking on it following a direction that is opposite of the ForcedSlide one (defined by the parameter IsOppositeDirectionAngleThreshold)">
	float myTimeToStartForcedSlideFromSameDirection < min=0.0 tooltip="Minimum time that should pass in a ForcedSlide volume or slope before starting to slide if we are walking on it following a direction that is similar to the ForcedSlide one (defined by the parameter IsOppositeDirectionAngleThreshold). No decelerations will happen in this case">
	float myMinExitSpeedToEndForcedSlide 0.0f < tooltip="If you exited the ForcedSlide Volume and you are still sliding with a speed that is lower than or equal this value, the forced slide will immediately stop" >
	string myPreForcedSlideSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, }, outTangents = { 0.641985 0, }, properties = { 275, }, values = { 0 -100, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the time (in seconds) passed in the ForcedSlide volume before the ForcedSlide start; the y axis the speed modifier (as additional increment)" >
	string myDecelerationOverMovementAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.2 0, }, outTangents = { 0 0, }, properties = { 1299, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the angle between the movement direction and the forced slide direction; the y axis the deceleration (it will be a multiplication value applied to myPreForcedSlideSpeedCurve)" >
	float myTerminationTimeOffset 0.0f < tooltip="After exiting from the ForcedSlide Volume, the ForcedSlide will last after this time (in seconds)" >
	string myOnExitSpeedCurve < bhv=inputgraph tooltip="The x axis represents the time (in seconds) passed after exiting the ForcedSlide volume; the y axis the speed modifier" >
	string myPreForcedSlideSpeedMultiplierOverSlopeAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 1, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.2 0, }, outTangents = { 0 0, }, properties = { 1299, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the current slope angle; the y axis the speed multiplier that is applied during the deceleration that comes before the sliding start" >
	string myForcedSlideSpeedMultiplierOverSlopeAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 1, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.2 0, }, outTangents = { 0 0, }, properties = { 1299, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the current slope angle; the y axis the speed multiplier that is applied when the character is sliding" >
	string myPostForcedSlideSpeedMultiplierOverSlopeAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 1, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.2 0, }, outTangents = { 0 0, }, properties = { 1299, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the current slope angle; the y axis the speed multiplier that is applied when the character is stop sliding while exiting the volume or slope" >
	PlayerRestriction* myForceSlideRestrictions < tooltip="The actions prevented while force sliding" >
	float myMaxTurnAngle 0.0f < bhv=angle min=0.0f max=1.570796326794896619f tooltip="Max turn angle during the ForcedSlide." >
	float myMovementTurnDurationBeforeSliding 0.3 < min=0.0f tooltip="Movement turn duration while the character is rotating at the beginning of the ForcedSlide" >
	float myFacingTurnDurationBeforeSliding 0.3 < min=0.0f tooltip="Facing turn duration while the character is rotating at the beginning of the ForcedSlide" >
	float myMovementTurnDurationWhileSliding 0.3 < min=0.0f tooltip="Movement turn duration while the character is tilting left or right during the ForcedSlide" >
	float myFacingTurnDurationWhileSliding 0.3 < min=0.0f tooltip="Facing turn duration while the character is tilting left or right during the ForcedSlide" >
	bool myKeepMovementOnForcedSlideEnd false < tooltip="If false, at the end of ForcedSlide the character will re-start the movement acceleration even if the stick was kept tilted" >
	bool myResetSpeedStartingOnLanding false < tooltip="If false, if the ForcedSlide is triggered landing on a slope from a jump or fall, the initial velocity during ForcedSlide will be reset" >
	float myRetainedVerticalLandingSpeedPercentageFromSameDirection 0.0 < bhv=percent min=0.0 max=1.0 tooltip="If ResetSpeedStartingOnLanding is true and we are landing on a ForcedSlide volume or slope in an opposite direction, we will keep this percentage as initial vertical speed">
	float myRetainedVerticalLandingSpeedPercentageFromOppositeDirection 0.0 < bhv=percent min=0.0 max=1.0 tooltip="If ResetSpeedStartingOnLanding is true and we are landing on a ForcedSlide volume or slope in the same ForcedSlide direction, we will keep this percentage as initial vertical speed">
	string myRetainedVerticalLandingSpeedMultiplierOverSlopeAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -30 -0.33333334, }, outTangents = { 30 0.33333334, 0 0, }, properties = { 203, 1227, }, values = { 0 0, 90 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The x axis represents the slope angle in degrees (0 = flat, 90 = vertical); the y axis represents a multiplier of the retained vertical speed on landing" >
	float myRetainedInDirectionLandingSpeedPercentage 0.0 < bhv=percent min=0.0 max=1.0 tooltip="If ResetSpeedStartingOnLanding is true and we are landing on a ForcedSlide volume or slope, we will keep this percentage of speed in the projection of the ForcedSlide direction as initial vertical speed">
	string myRetainedSpeedMultiplierOnDownhillOverSlopeToMovementAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The x axis represents the angle between ForcedSlide direction and movement direction; the y axis represents a multiplier of the retained speed at the beginning of the ForcedSlide (NB it only applies while going downhill)" >
	bool myResumeSprintSlidingFromOppositeDirection false < tooltip="At the end of a ForcedSlide triggered sprinting on a ForcedSlide volume or slope following a direction that is opposite of the ForcedSlide one (defined by the parameter IsOppositeDirectionAngleThreshold), we will resume the sprint if and only if this bool is true" >
	bool myResumeSprintSlidingFromSameDirection false < tooltip="At the end of a ForcedSlide triggered sprinting on a ForcedSlide volume or slope following a direction that is the same of the ForcedSlide one (defined by the parameter IsOppositeDirectionAngleThreshold), we will resume the sprint if and only if this bool is true" >
	float myOverriddenCoyoteJumpTimeWindow -1.0 < min=-1, tooltip="If this value is >= 0, at the end of this ForcedSlide, if the character falls, the CoyoteJumpTimeWindow will be overridden with this amount of time (in seconds)." >
	float myOverrideJumpCooldownStartingFromOppositeDirection -1.0 < min=-1, tooltip="If this value is >= 0, if we start a ForcedSlide from opposite direction, the jumping cooldown will be restarted and overridden with this amount of time (in seconds)." >
	float myOverrideJumpCooldownStartingFromSameDirection -1.0 < min=-1, tooltip="If this value is >= 0, if we start a ForcedSlide from the same direction of the ForcedSlide, the jumping cooldown will be restarted and overridden with this amount of time (in seconds)." >
	float myOverrideJumpCooldownAtEnd -1.0 < min=-1, tooltip="If this value is >= 0, at the end of this ForcedSlide, the jumping cooldown will be restarted and overridden with this amount of time (in seconds)" >
	bool myStopForcedSlideOnBlockedMovement false < tooltip="If true, if the ForcedSlide movement is considered blocked, the ForcedSlide will be interrupted" >
	float mySpeedDifferenceToBeBlockedThreshold 0.0 < tooltip="If StopForcedSlideOnBlockedMovement is true and difference between the actual velocity and the desired velocity is greater this amount, the ForcedSlide will be interrupted" >
	float myRestartFromBlockedTimer 0.0 < min=0.0 tooltip="If StopForcedSlideOnBlockedMovement is true and the ForcedSlide is interrupted due to the blocked movement, this is the time in which you will be able to move without forced sliding." >
	ForcedSlideStates myStatesWithNixOnShoulder < tooltip="Nix will jump on shoulder only during these ForcedSlide states" >
	ForcedSlideFallStrategy myForcedSlideFallStrategy
	float myCastLengthToFall  0.0 < min=0.0 tooltip="If ForcedSlideFallStrategy is FallInVolumeWithRaycastCheck and we are in a falling situation inside a ForcedSlide volume, we will transit to the Fall Context if a Raycast with this length, starting from the player's feet, doesn't hit anything.">
	bool myCanSlideBackward false < tooltip="If true, the ForcedSlide will be triggered backward if the conditions inside myForcedSlideSlopeLengthDataToSlideBackward are met" >
	ForcedSlideBackwardDesiredFacing myForcedSlideBackwardDesiredFacing
	float myBackwardFacingTurnDuration 0.0 < min=0.0 tooltip="Facing turn duration while the player ForcedSlides backward." >
	float myBackwardMovementTurnDuration -1.0 < min=-1.0 tooltip="Input dependent turn duration while the player ForcedSlides backward. If -1 it means it will not turn if the stick is tilted, and the sliding will be in the slope direction" >
	float myMinDistanceToVolumeEndForOutroToFall 4.0 < min=0.0 tooltip="If the distance to a ForcedSlide Volume edge is less than this value and after that there would be a Fall, we will try to perform an anticipation animation" >
	float myForwardRaycastOffsetForOutroToFall 1.0 < min=0.0 tooltip="If we are near the end of a ForcedSlide volume, we will perform a Raycast with this forward offset from the end of the volume to detect if there is not a ground" >
	float myVerticalRaycastOffsetForOutroToFall 0.5 < min=0.0 tooltip="If we are near the end of a ForcedSlide volume, we will perform a Raycast with this vertical offset from the end of the volume to detect if there is not a ground" >
	float myRaycastLengthForOutroToFall 1.0 < min=0.0 tooltip="If we are near the end of a ForcedSlide volume, we will perform a Raycast with this length to detect if there is not a ground" >
	ForcedSlideAnimationType myForcedSlideAnimationType OnTheBack < tooltip="Animation that will be displayed during the following ForcedSlide. NOTE: the entry None is not expected to be used here" >
	ShakeCameraModifier* myForcedSlideCameraModifier
	JumpSettings myJumpSettings
}

