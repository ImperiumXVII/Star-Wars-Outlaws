	float myPowerslideMinTime 0.3f < tooltip="Minimum time you can slide, even if button is not held" min 0.1f max 10.0f >
	float myPowerslideMaxTime 0.7f < tooltip="Max time you can slide, even if button is held" min 0.1f max 10.0f >
	float myPowerslideMaxFallingTime 1.0f < tooltip="Max time (in seconds) you can stay in powerslide while falling" min 0.0f max 10.0f >
