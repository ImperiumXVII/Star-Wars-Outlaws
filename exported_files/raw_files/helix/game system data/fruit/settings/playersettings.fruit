	string myAmountFromSneakingNearHostileNPCPatrol 3 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="How much adrenaline is gained by sneaking near patrolling hostile NPCs. Interval and valid range is defined by AdrenalineRushNPCParemeters" >
