	string myAfterDodgeAngleAccelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, 0 3.5889091, -0 0.61575818, -100 0, }, outTangents = { 150 0, -0 -0.79753536, 0 -2.1551538, 0 0, }, properties = { 15635, 17683, 18707, 16659, }, values = { 0 12, 90 7.5, 110 -7.5, 180 -10, }, }, numKeys = 4, }" < bhv=inputgraph tooltip="Acceleration (m/s^2) depending on the inclination of the input stick (0 <= x <= 180, where 0 means forward)" >
	string myDodgeInputAngleMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0 0.43071273, -30 0, }, outTangents = { 150 0, 0 -0.08614254, 0 0, }, properties = { 6419, 10515, 7443, }, values = { 0 1, 150 0.5, 180 0, }, }, numKeys = 3, }" < bhv=inputgraph tooltip="Speed multiplier (0 <= x <= 180, where 0 means forward, 0 <= y <= 1) based on the angle between the current character direction and input stick direction" >
	string myEndDodgeManeuverTurnSpeedLerpCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.080831707 -0.12468469, -0.50285172 -0.063343167, }, outTangents = { 0.235614 0.036105275, 0.21200509 0.32702252, 0 0, }, properties = { 6419, 8467, 7443, }, values = { 0 0, 0.27602988 0.62835741, 1 1, }, }, numKeys = 3, }" < bhv=inputgraph tooltip="Lerp progress from 0 to 1, used for turning rate change from dodge value to regular ground value" >
