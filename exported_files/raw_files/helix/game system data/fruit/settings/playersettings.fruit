	float myFallProtectionHeightThreshold 5.f < tooltip="Height threshold for the edge to be considered fall protected" >
	float myFallProtectionReposDuration 0.1f < tooltip="Duration of the resposition when fall protected" >
	float myPressingAgainstEdgeTurnDuration 0.15f < tooltip="Turn duration for player movement when pressing against the edge" >
	float myMaxConsideredWalkableAngle 46.f < tooltip="Max slope angle to be considered Walkable by the analyzer" >
	string myEdgeHesitationStepOffDistance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -4 0, }, outTangents = { 4 0, 0 0, }, properties = { 71, 1095, }, values = { 0 1, 12 0, }, }, numKeys = 2, }" < bhv=inputgraph >
	float myMaxStepOffLeapDistance 2.f < tooltip="Max distance Kay is allowed to leap when performing a StepOff" >
	int myProbeCount 4 < tooltip="Amount of probes to analyze edge height/shape" >
	bool myIsFallProtectionWalkOffEnabled FALSE < tooltip="TRUE allows you to trigger a step off after certain amount in fall protection" >
	float myWalkOffTimeThreshold 0.1f < tooltip="Time threshold for the fall protection walk off">
	float myStepOffGravityBoost 1.0f < tooltip="Gravity boost during step off">
