	string myPowerslideInputAngleMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0 0.43071273, -30 0, }, outTangents = { 150 0, 0 -0.08614254, 0 0, }, properties = { 6419, 10515, 7443, }, values = { 0 1, 150 0.5, 180 0, }, }, numKeys = 3, }" < bhv=inputgraph tooltip="Speed multiplier (0 <= x <= 180, where 0 means forward, 0 <= y <= 1) based on the angle between the current character direction and input stick direction" >
	string myPowerslideInputStrengthMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.0035118442 -0.22569723, -0.1 0, -2 0, }, outTangents = { 0.1 0, 0.0084559917 0.54344493, 0.30000001 0, 0 0, }, properties = { 4371, 3347, 5395, 2323, }, values = { 0 0, 0.058688045 0.38673812, 0.2 1, 1 1, }, }, numKeys = 4, }" < bhv=inputgraph tooltip="Speed multiplier [0, 1] based on the strength of the input stick" >
	string myPowerslideInputStrengthMultiplierVariationSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.33333334 0, }, outTangents = { 0.33333334 0, 0 0, }, properties = { 6147, 8195, }, values = { 0 1.5, 1 2, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Multiplier variation speed (1/s) (e.g. 1 means that the global input multiplier can go from 1 to 0 in 1 second)" >
