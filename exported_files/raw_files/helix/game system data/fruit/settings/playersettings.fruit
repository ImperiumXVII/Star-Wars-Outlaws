class HeightSmoothingParameters
{
    float myDampingRatio 1.0f < tooltip="Damping ratio for adjusting deviation expectation spring- but should be 1 unless you want back and forth movement" >
	float myDampingRatioOffset 1.0f < tooltip="Damping ratio for springing toward no offset from expectation deviation. Should be 1 unless you want back and forth movement" >
	float mySpringConstant 150.0f < tooltip="Spring constant related to how fast the expectation deviation adjusts to current change in height velocity" >
	float mySpringConstantOffset 150.0f < tooltip="Spring constant for how fast the offset from expectation deviation moves to 0, thus leading to no offset" >
	float myMaxDistance 0.15f < tooltip="The max amount of deviation in height from the expectation deviation" >
}

class CameraSmoothingParameters
{
    float myNoInputDirectionTime 3.0f < tooltip="The amount of time where no orientation input is allowed for the camera to start looking where you are going" >
	float mySpringConstantDirection 11.0f < tooltip="The spring constant for making the camera look where you're going" >
	float myDampingRatioDirection 1.0f < tooltip="The damping ratio for making the camera look where you're going, you want it at 1 if you don't want back and forth movement" >
	float myMinDotValueDirection -0.1f < tooltip="The minimum dot value from the direction that the player is going compared to where the camera is looking for the orientation change to take effect" >
	bool myUseDeviation true < tooltip="Decides if you should have expectation deviation, thus making the camera more stable in bumpy terrain" >
	bool myUseCameraDirection true < tooltip="Decides if you should make the camera rotate toward the location you're moving toward" >
	bool myUseSmoothLookAt false < tooltip="Decides if the laziness makes the camera look independently in the direction the character is moving" >
}

class AvoidanceSettings
{
	AvoidanceParameters myObjectsAvoidanceParameters < tooltip="Set of parameters used to compute the player avoidance when a generic object is detected along the player movement intention" >
	AvoidanceParameters myNPCsAvoidanceParameters < tooltip="Set of parameters used to compute the player avoidance when an NPC is detected along the player movement intention" >
	AvoidanceTiltReductionParameters myAvoidanceTiltReductionParameters < tooltip="Set the parameters to reduce player tilts due to the avoidance redirection" >
	AvoidancePlayerMovementConfingList myMovementConfigBlackList < tooltip="Set the list of player movement configs for which the avoidance is turned off" >
	AvoidanceCollisionMaterialList myHandPlacementMaterialBlackList < tooltip="Set the list of materials for which the hand placement is turned off" >
	PlayerIntentDirectionConsistencyParameters myPlayerIntentDirectionConsistencyParameters < tooltip="Set the threshold in order to consider an ongoing avoidance information in the previous frame for the current frame calculation" >
	float myReactionTime 0.35f < min=0.01 >
	float myMinSpeedToStartAvoidance 0.0 < min=0.0 tooltip="The avoidance anticipation will be computed if the speed is higher than this value" >
	vec3f myStartDetectionOffset 0.0;0.0;0.0 < tooltip="The avoidance anticipation will start with this offset (in local coordinates) from character position" >
	bool myAvoidInteractableNPCs false < tooltip="If true, the avoidance will be triggered even when detected NPCs have interaction points (like Takedown)" >
	int myMaxTrackableObjects 1 < min=0 tooltip="Set the max amount of entities that can be tracked at the same time" >
	float myMaxObstacleTrackingTimeInterval 2.f < min=0.0 tooltip="Set the maximum time interval for which an obstacle is tracked. When a new obstacle is spotted and the list of tracked obstacles is full, the older obstacle is discarded in favor of the newer" >
	bool myEnablePhysicsCollisionObstaclesDetection false < tooltip="If true, the entities colliding with the player's collider are also considered to compute the avoidance desired direction" >
	bool myAdjustSideSphereCastsToMainCollisionHeight false < tooltip="If true, the rotated side casts start position will be adjusted according to the main collision hit Y. The main collision hit is the collision with the hit normal which is more opposed to the player intent dierction " >
}

class JumpParameters
{
	PlayerRestriction* myJumpRestrictions < tooltip="The actions prevented when you are jumping" >
	float myHorizontalDampeningFactorJumping 0.f < tooltip="Dampening applied when Jumping. 0 = no drag, 1 = max drag" >
	float myFowardInputAngleThreshold 120.f < tooltip="Max angle difference between Directional Input and Initial Jump Direction, to be considered a Forward Jump Input" >
	float myGroundJumpPrepareTime 0.f < tooltip="Jump prepare time while on ground" >
	float myJumpPrepareDeceleration 0.f < tooltip="Deceleration factor while jump preparing and moving" >
	string myMaxAngularSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -1.5 0, }, outTangents = { 2 0, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 2 180, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Max angular speed in air depending on the XZ speed" >
}

class JumpSettings
{
	float myMaxRange 1.0f
	float mySpeedThreshold 5.0f
	float myMaxHeight 1.0f
	float myStompBoost 1.0f
	float myDescentMultAfterApex 1.0f
	ShakeCameraModifier* myCameraShake
	ShakeCameraModifier* myPrepareCameraShake
	float myDistanceFromGroundProbeOffsetUp 1.0f < min=0.0 max=10.0 >
	float myDistanceFromGroundProbeOffsetDown 10.0f < min=0.0 max=10.0 >
}

list GameActions
{
	GameAction
}

list JumpSettingsList
{
	JumpSettings
}

class WallClimbPointEligibilityRequirements
{
	PlayerMovementStateType myPlayerMovementState
	float myOverrideHorziontalDistanceThreshold 3.0f < min=0.0f tooltip="It's the horizontal distance threshold to satisfy between the player and a candidate wall climb point during the wall climb points analysis" >
	float myHorizontalCameraAngleThreshold 3.1416f < bhv=angle min=0.0f max=3.1416f tooltip="It's the horizontal angle threshold to satisfy between the camera and a candidate wall climb point during the wall climb points analysis" >
}

list WallClimbPointEligibilityRequirementsList
{
	WallClimbPointEligibilityRequirements
}

class FallToLadderTransitionParameters
{
	float mySmoothEntryMaxVetricalSpeed -5.0f < tooltip="It's the maximum vertical speed threshold to have a smooth entry to the ladder, which trigger" >
	bool mySmoothEntryTriggerCameraShake true < tooltip="If ture, the camera shake is triggered when the enter to the ladder is smooth" > 
	float myPlayerPositionVerticalOffset 0.3f < min=0.0 tooltip="Set a vertical offset for the player position that compensates the fact that the player position during falling is considered at the player's feet, meanwhile when the player is on a ladder its position it's considered near the character pelvis. The result position is used to search the ladder point with the closest related player position" >
}

class LadderBottomExitParameters
{
	float myDirectionFreezeTimeInterval 0.2f < min=0.0 tooltip="It's the time interval to wait after the ladder exit from bottom before freezing the player movement direction to witch the root motion must be wrapped" >
	float myPlayerExitHeight 0.9 < min=0.0 tooltip="It's the maximum player height from the ground for which the player exit movement is root motion based" >
	float myPlayerPositionHorizontalOffset 0.5 < tooltip="It's the horizontal offset from the player position to the exit position on the ground. The offset is applied starting from the player position, along the direction from the ladder to the player" >
	float mySprintDownAutoDetachHeight 1.8 < tootlip="It's the player height from the ground at which the player is automatically deteached from the ladder while sprinting downward. The ladder detach is not root motion based" >
}

class LadderParameters
{
	float myUpwardSprintRungSearchDistanceMultiplier 1.0f < min=1.0 tooltip="It's the multiplier applied to the ladders' rungs distance to calculate the distance to search the next rung to reach while the player is sprinting upward the ladder" >
	float myUpwardSprintTargetRungRefreshDistance 0.1f < min=0.1 tooltip="Set the distance threshold between the player position and the target rung's player position for which the target rung must be updated with the next one" >
	float myDownwardSprintRungSearchDistanceMultiplier 2.0f < min=1.0 tooltip="t's the multiplier applied to the ladders' rungs distance to calculate the distance to search the next rung to reach while the player is sprinting downward the ladder" >
	float myDownwardSprintTargetRungRefreshDistance 0.34f < min=0.1 tooltip="Set the distance threshold between the player position and the target rung's player position for which the target rung must be updated with the next one" >
	float myDownwardSprintEndRungLerpSpeed 2.f < min=0.1f tooltip="Set the lerps speed to consider when snapping the player to the next ladder's rung when exiting a downward sprint" >
	bool myDisableCancellingMovement false < tooltip="If true, when a movement to the next rung starts, no movement cancellation is done at input release even if the player position is very close to the previous rung" >
	bool mySnapPlayerToLadderRungs false < tooltip="If true, the player position is snapped to the current rung's player position when the traversal hanging state switches to 'Hanging'" >
	float myTransferDirectionCooldownAfterEntry 0.0f < tooltip="The time (in seconds) you need to wait before transferring to the next rung after entering the ladder" >
	float myLadderPointsScoreProbeVerticalOffset 1.9f < tooltip="It's the vertical offset from the player position used to compute the reference probe for the ladder's rungs score calculation while the player isn't on the ladder. The best rung is the one closer to the probe" >
	LadderBottomExitParameters myBottomExitParameters
	float myTopExitLedgeAccessPointOffset 1.1f < tooltip="Set the offset from the ladder top ledge acccess point with which compute the top exit position to reach" >
	FallToLadderTransitionParameters myFallToLadderTransitionParameters
	float myDetachAtEntryDistanceThreshold 0.35f < tooltip="It's the distance threshold between the player position and the entry rung's player position for which the detach is allowed during the ladder entry action." >
	WallClimbPointEligibilityRequirementsList myWallClimbPointEligibilityRequirements
	AnimatedCameraData* myEntryFromVentAnimatedCameraData < tooltip="Set the animated camera data to use when entering a ladder from a vent" >
	float myEntryFromVentHidePlayerTimeInterval 0.35f < min=0.0f tooltip="Set the time interval to keep the player hidden when entering a ladder from a vent. This will avoid the camera to go through the player model during the animation camera blend">
	float myLedgePlayerOffset 0.4f < min=0.0f tootlip="It's the player position offset along the ladder's Z axis from the ladder ledge. This parameter is used to compute the player position when the player reaches the ladder's ledge (a.k.a. top rung) and must be set coherently to the player positions computed in the wall climb volume points" >
	float myCanUseLadderCooldownTimeInterval 0.35f < min=0.0f tooltip="It's the time to wait before allowing the player to use a ladder again" >
}

class JumpToWallClimbTransitionParameters
{
	float myMinGroundDistanceToSearchHigherWallClimbPoint 0.2f < min=0.0 tooltip="Set the minimum player distance from the ground required to search an higher wall climb point than the best point provided by the traversal component" >
	float myPlayerPositionWallClimbVerticalOffset 0.5f < min=0.0 tooltip="Set a vertical offset for the player position that compensates the fact that the player position during jumping is considered at the player's feet, meanwhile when the player is on a wall its position it's considered near the character pelvis. The result position is used to search the wall climb point with the closest related player position" >
	float myMinGroundDistanceToSearchHigherLadderPoint 0.2f < min=0.0 tooltip="Set the minimum player distance from the ground required to search an higher ladder point than the best point provided by the traversal component" >
	float myPlayerPositionLadderVerticalOffset 0.6f < min=0.0 tooltip="Set a vertical offset for the player position that compensates the fact that the player position during jumping is considered at the player's feet, meanwhile when the player is on a ladder its position it's considered near the character pelvis. The result position is used to search the ladder point with the closest related player position" >
}

class WallClimbParameters
{
	float mySpeed 2.5f < tooltip="Speed when climbing a wall" >
	float myAutoTransferMaxDistance 0.7f < tooltip="Max distance before you have to press to transfer" >
	float myTransferDirectionCooldown 0.2f < tooltip="The time (in seconds) you need to wait before transferring wall climbs to another direction." >
	float myDistanceScoringWeight 0.1f < tooltip="Weight multiplied with the distance/max allowed distance for which wall climb she wants to transfer to." >
	float myInputScoringWeight 0.3f < tooltip="Weight multiplied with the angle difference between the point and input for which wall climb she wants to transfer to." >
	float myGroundLevelScoringWeight 3.0f < tooltip="Weight multiplied with the distance if the point is lower than her hanging height, for deciding which wall climb she wants to transfer to." >
	float myMaxInputAngleDifference 65.f < tooltip="Max angle between hand position to next point and input" >
	float myMinInputYToMoveUp 0.2f < tooltip="Min value of the y component of the normalized 2d input vector that allows us to climb up" >
	float myMinInputYToMoveDown 0.2f < tooltip="Min value of the y component of the normalized 2d input vector that allows us to climb down" >
	string myEnterFromGroundSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.30289078 -0.38653803, }, outTangents = { 0.59589279 0.02256757, 0 0, }, properties = { 275, 1299, }, values = { 0 0.40000001, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myEnterFromAboveSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.30289078 -0.38653803, }, outTangents = { 0.59589279 0.02256757, 0 0, }, properties = { 275, 1299, }, values = { 0 0.40000001, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myStartMoveSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.30289078 -0.38653803, }, outTangents = { 0.59589279 0.02256757, 0 0, }, properties = { 275, 1299, }, values = { 0 0.40000001, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myExitSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.25397027 -0.4784776, }, outTangents = { 0.1743421 0.001168251, 0 0, }, properties = { 275, 1299, }, values = { 0 0.5, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	bool myLimitCameraWhileClimbing true < tooltip="While climbing, restrict camera so that you can't rotate front of agent" >
	PlayerRestriction* myRestrictions < tooltip="The actions prevented when you are climbing" >
	PlayerRestriction* myLadderRestrictions < tooltip="The actions prevented when you are climbing on a ladder" >
	LadderParameters myLadderParameters < tooltip="Set specific parameters involved when climbing ladders" >
	JumpToWallClimbTransitionParameters myJumpToWallClimbTransitionParameters
	WallClimbPointEligibilityRequirementsList myWallClimbPointEligibilityRequirements
}

class LedgeParameters
{
	string myStartToHangSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.2 0, }, outTangents = { 0.641985 0, 0 0, }, properties = { 275, 1299, }, values = { 0 5, 0.5 2, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myHangToEdgeSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.2 0, }, outTangents = { 0.641985 0, 0 0, }, properties = { 275, 1299, }, values = { 0 5, 0.5 3, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myNonHangSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.2 0, }, outTangents = { 0.641985 0, 0 0, }, properties = { 275, 1299, }, values = { 0 5, 0.5 5, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myTransferStartSpeedCurveUp "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.2 0, }, outTangents = { 0.098845556 -0.014859319, 0 0, }, properties = { 275, 1299, }, values = { 0 1, 0.30000001 5, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myTransferStartSpeedCurveDown "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.2 0, }, outTangents = { 0.098845556 -0.014859319, 0 0, }, properties = { 275, 1299, }, values = { 0 1, 0.30000001 5, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myTransferStartSpeedCurveSideWays "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.2 0, }, outTangents = { 0.098845556 -0.014859319, 0 0, }, properties = { 275, 1299, }, values = { 0 1, 0.30000001 5, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myTransferStartSpeedCurveOpposite "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.2 0, }, outTangents = { 0.098845556 -0.014859319, 0 0, }, properties = { 275, 1299, }, values = { 0 1, 0.30000001 5, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myDistanceBeforeStepupStartEnterCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.41326642 -0.082827121, -0.66666669 0, }, outTangents = { 0.68639803 0.55525839, 0.27551094 0.055218082, 0 0, }, properties = { 275, 2323, 3075, }, values = { 0 0.41999999, 3 1, 5 1.2, }, }, numKeys = 3, }" < bhv=inputgraph tooltip="The min distance you need to be from the vault before she starts to jump up from ground for autostepover. x-axis is the entry speed, y-axis is distance." >
	string myDistanceBeforeStepupStartEnterCurveCrouched "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.41326642 -0.082827121, -0.66666669 0, }, outTangents = { 0.68639803 0.55525839, 0.27551094 0.055218082, 0 0, }, properties = { 275, 2323, 3075, }, values = { 0 0.41999999, 3 1, 5 1.2, }, }, numKeys = 3, }" < bhv=inputgraph tooltip="The min distance you need to be from the vault before she starts to jump up from ground for autostepover. x-axis is the entry speed, y-axis is distance." >
	PlayerRestriction* myRestrictions < tooltip="Prevented actions" >
	PlayerRestriction* myAutostepRestrictions < tooltip="Prevented actions during automatic stepups and vaults" >
	PlayerRestriction* myClimbUpRestrictions < tooltip="Prevented actions during ledges where you don't go into hanging" >
	PlayerRestriction* myClimbUpFromClimbRestrictions < tooltip="Prevented actions during ledges where you don't go into hanging and you were climbing initially" >
	float myMaxHeightFromGround 3.2f < tooltip="Max height from ground she can grab a placed ledge" >
	float myMaxHeightTransfer 2.5f < tooltip="Max height she can transfer between placed ledges" >
	float myMaxDiagonalDistance 2.5f < tooltip="Max distance diagonally that she can transfer on a placed ledge, not counting height" >
	float myMaxTransferAngleDifference 40.f  < tooltip="Max angle that she can grab an edge sideways" >
	float myMaxTransferCameraAngle 45.f  < tooltip="Max angle that the camera can look away from the edge" >
	float myMaxTransferCameraAngleVsPoint 80.f  < tooltip="Max angle that the input and camera can differ" >
	float myClimbDownMoveToEdgeSpeed 1.2f  < tooltip="Speed when doing a climb-down start to the edge" >
	float myClimbDownEdgeToHanging 0.7f  < tooltip="Speed when doing a climb-down and from the edge to hang position" >
	string myMaxAngleDifference "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.11901759 2.7155123, -0.1042192 1.6702564, -0.461272 1.0560341, }, outTangents = { 0.12594455 -2.8017273, 0.12119108 -2.7651026, 0.31265759 -5.0107689, 0 0, }, properties = { 275, 3347, 2323, 1299, }, values = { 0 80, 0.5 65, 1 40, 2.5 25, }, }, numKeys = 4, }" < bhv=inputgraph >
	string myMaxAngleDifferenceInAir "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.052738003 2.6677203, -0.92188692 0, }, outTangents = { 0.032790065 -5.4848175, 0.31261072 -15.813227, 0 -0, }, properties = { 275, 4371, 1299, }, values = { 0 80, 0.23540348 29.531345, 2.5 10, }, }, numKeys = 3, }" < bhv=inputgraph >
	float myBackwardsTransferAngle 120.0f  < tooltip="Min angle (degrees) between player facing and next point for it to be considered backwards" >
	float myHangFreeMaxTransferAngle 75.0f  < tooltip="Max angle (degrees) between direction to ledge and up that we start to allow no-feet-supported transfers" >
	float myMaxBackwardDistanceInAir 0.3f  < tooltip="Max backward distance from the ledge while in air" >
	LazinessCameraModifier* myClimbupCameraModifier
}

class TraversalParameters
{
	float myEdgeShimmyStepDistance 0.9f < tooltip="The max distance each shimmy step can take" >
	float myRegrabTime 0.2f < tooltip="Time in seconds after exiting an edge before an input registers a re-grab." >
	float myCanGrabWallClimbInFallTime 1.2f < tooltip="Time in seconds after exiting an edge and how long after that you can grab the wall climb." >
	float myKneeHeight 0.3f < tooltip="Used for certain checks in traversal like if you can auto-stepup." >
	float myLowerAutostepHeight 0.4f < tooltip="Used for lower autostep volume." >
	float myHangHeight 1.7f < tooltip="The distance she can hang from." >
	float myHangStopTimer 0.2f < tooltip="The time (in seconds) where you are forced in hang." >
	float myTransferCooldownTimer 0.3f < tooltip="The time (in seconds) you need to wait before transferring ledges." >
	float myClimbUpSpeedMultiplier 1.0f < tooltip="Speed multiplier for rootmotion animation when climbing a wall upwards" >
	float myClimbDownSpeedMultiplier 1.0f < tooltip="Speed multiplier for rootmotion animation when climbing a wall downwards" >
	float myClimbDiagonalUpSpeedMultiplier 1.0f < tooltip="Speed multiplier for rootmotion animation when climbing a wall diagonally upwards" >
	float myClimbDiagonalDownSpeedMultiplier 1.0f < tooltip="Speed multiplier for rootmotion animation when climbing a wall diagonally downwards" >
	float myClimbSidewaysSpeedMultiplier 1.0f < tooltip="Speed multiplier for rootmotion animation when climbing right or left" >
	float myInputDownAngle 25.0f < tooltip="The max angle from down for input to still count as down" >
	float myInputRightLeftAngle 25.0f < tooltip="The max angle from right/left for input to still count as such" >
	float myInputUpAngle 30.0f < tooltip="The max angle from up for input to still count as up" >
	float myInputBackwardsAngle 50.0f < tooltip="The max angle for camera facing from player facing before we stop moving" >
	float myInputMinInputThreshold 0.5f < tooltip="Min percentage threshold for how much you need to hold the stick before it counts as a move action (drop and shimmy) " >
	string myDropFromClimbRotationTurnRate "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.43000001 0, }, outTangents = { 0.24975866 0, 0 0, }, properties = { 275, 1299, }, values = { 0 0.80000001, 1 0.07, }, }, numKeys = 2, }" < bhv=inputgraph >
	float myDropFromClimbStartRotationDistance 0.8f < tooltip="The min distance before you can start to rotate when dropping from a climb" >
	float myDropFromClimbMaxRotationDistance 2.6f < tooltip="The max distance you can rotate when dropping from a climb" >
	float myAutoDropFromClimbMaxHeight 2.f < tooltip="The max distance you can press down to autodrop from walls" >
	float myMaxAngleDiffFacingVsToPointForAutoTraversal 120.f < tooltip="The max allowed angle between facing and direction to edge that an autostep triggers" >
	float myMinAngleDiffFacingVsToPointForAutoTraversalRotation 90.f < tooltip="The max allowed angle between facing and direction to edge that we rotate by code" >
	float myMaxLeaningAngleAllowedToMoveOnLedgesWithFeetSupport 40.f < tooltip="Max leaning angle allowed to move along edges with feet support" >
	ShakeCameraModifier* myAttachCameraShake
	ShakeCameraModifier* myAttachFromAirCameraShake
	ShakeCameraModifier* myBigAttachCameraShake
	uid myLedgeTransferAvailableRumble < bhv="constantData" constantDataType="rumble" >
