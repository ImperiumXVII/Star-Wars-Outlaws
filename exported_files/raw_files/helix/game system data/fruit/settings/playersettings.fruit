	string myAmountFromFastCooling 0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="During a reload, if you succeed in cooling it but not perfectly this amount will be gained" ui_info=0 >
	string myAmountFromPerfectCooling 10 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="During a reload, if you cool it perfectly this amount will be gained" ui_info=0 >
	string myAmountFromNearMiss 1 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="These are gained when shots are nearly hitting the player" ui_info=0 >
	string myAmountFromLostHealthSegment 20 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 >
    string myAmountFromDamagingTaggedEnemy 2 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="When a target gets damaged and they're tagged with binoculars, add this amount every instance of damage" >
    string myAmountFromMedkit 10 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="When the player uses the medkit add this amount" >
	string myAmountFromMeleeFinisher 40 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="Per successful finishing melee move" >
	string myAmountPerDamageFromExplosion 5 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="Per explosion damage" >
	AdrenalineRushGainVictimMultiplierList myMultipliersPerDamageFromExplosion
	string myAmountFromEscapeExplosion 15 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="When the player is inside the max gaemplay damage radius of an explosion but when the explosion ends player has not received a hit" >
	string myAmountPerDamageFromHeadshot 5 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="The damage output from the blaster will be multiplied with this to give adrenaline points if it has been a headshot with damage multiplier" >
	string myAmountPerDamageNearOverheat 3 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="Dealing damage with a shot executed while the weapon has >80% heat" >
	string myAmountPerDamageMissEnemyWithBlaster 2 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="A player projectile that near miss an enemy based on the projectile damage" >
	string myAmountPerDamageMissEnemyWithPickable 1 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="A player projectile that near miss an enemy based on the projectile damage" >
	string myAmountFromIonizing 20 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="When the player ionize a target (in code is equal to be in dazed state in the npc satgger component)" >
    string myAmountFromGrenadePrimingNear 10 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="The amount added if the player is in range of a grenade explosion at any time before it triggers." >
    string myAmountFromHittingEnemyWithGrenade 10 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="The amount added if the player hits an ennemy when throwing a grenade." >
	string myAmountFromHostileNPCEnteringAware 5 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="When a hostile NPC enters Aware within a valid distance to the player, defined by AdrenalineRushNPCParameters" >
	string myAmountFromHostileNPCEnteringCombat 5 < bhv=formulaEditor formulaResolveContextType=AgentAttributes ui_info=0 tooltip="When a hostile NPC enter combat within a valid distance to the player, defined by AdrenalineRushNPCParameters" >
