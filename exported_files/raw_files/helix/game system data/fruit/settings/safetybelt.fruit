class SafetyBelt
{
	float myAccumulatedDamageTakenToActivate 0.3f < tooltip="Flat value. Minimum amout of damage to receive to activate the safetybelt" >	
	float myDamageReductionPerSecond 0.1f < tooltip="Damage drained per second from accumulated damage buffer, to avoid activating the belt when damage is received far apart in time" >	
	float myHealthRemainingAfterSafetyBelt 0.2f < tooltip="Flat value. It is the health the player will be left with" >
	float myHealthRemainingAfterSafetyBeltRandomModifier 0.1f < tooltip="Health random modifer that will be added to the remaining health after use. It is computed in the interval [-modifier, modifier]" >
	float myImmunityDuration 3.f < tooltip="Seconds, once the safety belt is activated, player will be invulnerable for this amount" >
	float myMinIntervalBetweenResets 5.f < tooltip="Seconds, will be checked against how much time has passed since the last time the SafetyBelt was reactivated by refilling the first health segment" >
	float myTimeToResetWhenNoDamage 30.f < tooltip="Seconds, will be checked against how much time has passed since the last time Player took damage" >
}
