list FastTravelRestrictions
{
	varmap < bhv="localization" tooltip="Instance name must match an enum entry in code/helix/HClient/HC_FastTravelRestrictions.h">
}

class FastTravelLandingZoneSetting
{
	uid myLevel < bhv="constantData" constantDataType="levelinfo" tooltip="The level the landing zones are in" >
	uid myFirstLandingZone < bhv="constantData" constantDataType="landingzone" tooltip="The default landing zone to put the spaceship to when players fast travel to the planet." >
	uid mySecondaryLandingZone < bhv="constantData" constantDataType="landingzone" tooltip="The default landing zone to put the spaceship to when players fast travel to the planet but the first landing zone is not unlocked." >
}

list FastTravelLandingZoneSettings
{
	FastTravelLandingZoneSetting
}

class FastTravelSettings < uid=auto >
{
	int myWantedLevelThreshold 2 < tooltip="All wanted levels above [x] restrict fast travel." >
	float myMinFastTravelDistance 30.0 < tooltip="If the player is closer than [x] meters, the fast travel will be restricted." >
	string myRestrictedIcon < bhv=sprite >
	FastTravelRestrictions myFastTravelRestrictions

	FastTravelLandingZoneSettings myFastTravelLandingZoneSettings
}