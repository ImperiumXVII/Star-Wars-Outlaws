include "helix/game system data/fruit/input/gameinput.fruit"

list GameActions
{
    GameAction
}

class InputChallengeAnchor < uid=auto >
{
    vec3f myAnchorPosition
}

list InputChallengeAnchors
{
    InputChallengeAnchor*
}

class InputChallengeStick < uid=auto >
{
    GameAction myStickIdentifier
    GameAction myUpDirection
    GameAction myDownDirection
    GameAction myRightDirection
    GameAction myLeftDirection
    float myDeadZone < min=0, max=1 > 
}

list InputChallengeSticks
{
    InputChallengeStick*
}

class InputChallengeSettings < uid=auto >
{
    GameActions myPressGameActions < tooltip = "List of all possible press game actions for input challenges">
    GameActions myHoldGameActions < tooltip = "List of all possible hold game actions for input challenges">
    float myUIFadeoutTime 1 < min=0 tooltip="Time it takes the UI Graph for an input challenge to fadeout">
    float myUIFadeinTime 0.5 < min=0 tooltip="Time it takes the UI Graph for an input challenge to fadein">
    bool myShouldUseFailCounter true < tooltip="When set to true, an input challenge will automatically suceed when failed a fixed number of times in a row. The amount of failures is set in Max Consecutive Fail" >
    int myMaxConsecutiveFail 5 < tooltip="Number of consecutive fails before triggering an automatic success" >
    InputChallengeAnchors myAnchors < tooltip="List of all anchors used by input challenges" >
    InputChallengeSticks mySticks < tooltip="List of stick available for input challenges" >
}