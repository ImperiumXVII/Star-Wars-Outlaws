include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/livingworld/livingworldtag.fruit"

class ScannerFactionInfo
{
	Faction* myFaction
	varmap myName < bhv="localization" >
	string myIcon < bhv="sprite" >
}

class ScannerSpecialInfo
{
	varmap myName < bhv="localization" >
	string myIcon < bhv="sprite" >
	float myMinScanRadius
	float myMaxScanRadius
	uid myDependency
}

class ScannerSpecialLootInfo : ScannerSpecialInfo
{
	float myMinScanRadius 300.f
	float myMaxScanRadius 1500.f

	uid myDependency < bhv="constantData" constantDataType="ldimetadata" >
}

class ScannerSpecialEventInfo : ScannerSpecialInfo
{
	varmap myName < hidden=1 >
	string myIcon < hidden=1 >
	float myMinScanRadius 1000.f
	float myMaxScanRadius 3000.f

	uid myDependency < bhv="constantData" constantDataType="livingworldtag" >
}

list ScannerSpecialInfoList
{
	ScannerSpecialInfo
}

list ScannerFactionInfoList
{
	ScannerFactionInfo
}

class ScannerSettings < uid=auto >
{
	Factions myFactionsToIgnore
	ScannerFactionInfoList myAgentsInfoByFactions
	ScannerSpecialInfoList mySpecialInfos

	varmap myLootsName < bhv="localization" >
	string myLootsIcon < bhv="sprite" >

	varmap mySmallLootsName < bhv="localization" >
	string mySmallLootsIcon < bhv="sprite" >

	string myEventsIcon < bhv="sprite" >

	string mySpaceStationsIcon < bhv="sprite" >

	string myGameIslandsIcon < bhv="sprite" >

	varmap myBeaconsName < bhv="localization" >
	string myBeaconsIcon < bhv="sprite" >

	float myMinAgentsScanRadius 3000.f
	float myMaxAgentsScanRadius 6000.f

	float myMinLootsScanRadius 3000.f
	float myMaxLootsScanRadius 6000.f

	float myMinEventsScanRadius 3000.f
	float myMaxEventsScanRadius 6000.f

	float myMinSpaceStationsScanRadius 3000.f
	float myMaxSpaceStationsScanRadius 6000.f

	float myMinGameIslandsScanRadius 3000.f
	float myMaxGameIslandsScanRadius 10000.f

	float myMinBeaconsScanRadius 3000.f
	float myMaxBeaconsScanRadius 10000.f

	string myPlayerDistanceToAgentsGroupingDistanceCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -2000 0, }, outTangents = { 0 0, 0 0, }, properties = { 275, 1027, }, values = { 0 0, 6000 3000, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myPlayerDistanceToLootsGroupingDistanceCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -2000 0, }, outTangents = { 0 0, 0 0, }, properties = { 275, 1027, }, values = { 0 0, 6000 3000, }, }, numKeys = 2, }" < bhv=inputgraph >

	float myMinHighlightDistance 50.f

	uid myLDIBeaconMetadata < bhv="constantData" constantDataType="ldimetadata" >
}