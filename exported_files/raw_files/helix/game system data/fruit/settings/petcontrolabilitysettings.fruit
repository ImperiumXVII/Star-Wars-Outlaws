include "helix/game system data/fruit/ai/npcweapon.fruit"

list DestroyableProps
{
    uid < bhv="constantData" constantDataType="destroyableprop" >
}

list NPCWeaponList
{
    NPCWeapon*
}

class ProjectileSettings
{
    string myProjectileCountWeightedChance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0 -0, }, outTangents = { 0 0, 0 0, }, properties = { 275, 1299, }, values = { 1 1, 10 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Weighted chance curve specifying how many projectiles in total this weapon can shoot, the x-axis being the number of shots and the y-axis being its weighted chance. Only define this curve for x-values which should be allowed (if the weapon should always shoot at least 5 shots, don't define it for x values less than 5.)" >
    string myProjectileHitPercentageWeightedChance "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0 -0, }, outTangents = { 0 0, 0 0, }, properties = { 275, 1299, }, values = { 0 1, 100 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Weighted chance curve specifying the maximum percentage of shots which will actually hit a target (it's only a maximum since there is no guarentee of how many actual targets there are around the controlled NPC)." >
    float myMinTargetRange 0.5 < tooltip="The closest distance to the controlled NPC that this weapon can target things" >
	float myMaxTargetRange 40 < tooltip="The farthest distance from the controlled NPC that this weapon can target things" >
    float myMaxTargetPitch 0.872665 < bhv=angle tooltip="The max angular incline or decline that the NPC can aim (to avoid having them shoot something directly above them)" >
}

class WeaponSpecificSettings
{
    NPCWeaponList myAssociatedWeapons < tooltip="The weapons which these settings apply to" >
    ProjectileSettings mySettings
}

list WeaponSettingsList
{
    WeaponSpecificSettings
}

class PetControlAbilitySettings < uid=auto >
{
    DestroyableProps myValidTargets < tooltip="List of destoyable props, by their constant data, which the control ability's projectiles can target (in addition to enemy NPCs)" >
    WeaponSettingsList myWeaponSettings < tooltip="List of settings that are dependent on the weapon the controlled NPC has." >
    string myBonusHitPercentageFormula < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="The additional percentage added to the rolled hit percentage. So if the weapon settings hit percentage curve results in a hit percentage of 70 percent, and this bonus is 5, then the final hit percentage will be 75 percent" >
    float myRotationSpeed 1.5708 < bhv=angle tooltip="Degrees per second that the NPC rotates while being controlled. (Must be the max rotation speed of the animation)" >
    bool myIsRotatingClockwise false < tooltip="The direction the NPC spins while controlled. (Must match the animation)" >
    float myAimAngleRange 0.139626 < bhv=angle tooltip="Once the controlled NPC is within this angle of the target, the forced shot will be aimed and fired. If this is too small, the shot may be missed (skipped), but the smaller it is the more realistic it will look. The fast the animation spins, the larger this will need to be or else the angular difference from one frame to the next could entirely skip a hit location." >
    float myAimAngleSkipThreshold 0.174533 < bhv=angle tooltip="If the gun is pointing past the desired target angle by more than this amount, we consider the shot as having missed its chance and we skip it." >
    float myShotIntervalEpsilon 0.0 < bhv=angle tooltip="Besides the calculated angular 'size' of a shot based on the firing interval and rotation speed, this epsilon is added to account for any possible inaccuracies and imperfections that might force shots to have to be further apart than theorectically calculated." >
    int myMaxLineOfSightRaycastsPerFrame 4 < min=0 tooltip="Raycasts are expensive, so we only allow so many each frame. If we run out of time doing these checks once the animation starts, then we just assume the remaining targets are within sight. (Worst case the NPC shoots at a wall where a target is behind it and it looks like a miss that was supposed to be a hit.)" >
}