include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/item/item_includes.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"


class WallPathData
{
	float myRappelDistanceToWall 0.6f < tooltip="Horizontal distance from the wall where the player will be positioned while climbing" >
	float myRappelMaxWallHeight 26.f < tooltip="Max length of the wall path (and consequently the rope)" >
	float myRappelMaxWallInclination 3.5f
	float myRappelMaxWallConcaveDistance 1.f
	float myRappelMaxWallIrregularSurfaceAngle 30.f
	float myRappelMaxXZWallPathPointsDistance 0.15f < tooltip="Max horizontal delta between points along the wall path" >
}

class InteractionValidationData
{
	float myMaxHorizontalDistanceFromRappelPoint 6.0f
	float myMaxVerticalDistanceFromRappelPoint 15.0f
	float myRappelMaxPathToLength 20.f
}

class AttachDetachData
{
	float myRappelMinPrepTime 0.2f < min=0 tooltip="Minimum time for rappel attach preparation" >
	float myRappelTurnToAttachmentTime 0.0 < min=0 tooltip="Turn time in seconds to turn towards the attachment point during attachment. If 0 it'll be set to the time remaining during preparation from when she stops pathing" >
	float myRappelDeltaHeightToPerformTopEntry 0.5f < tooltip="Max delta height to perform a top entry" >
	float myRappelTopDistanceFromAttachmentToStartAttaching 0.7f < tooltip="Horizontal distance from the edge of the wall where the player should be positioned to start attaching from the top" >
	float myRappelBotDistanceFromAttachmentToStartAttaching 1.4f < tooltip="Horizontal distance from the edge of the wall where the player should be positioned to start attaching from the bottom" >
	float myRappelTopVerticalEnterAndExitDistance 1.7f < tooltip="Vertical position along the wall path where the player should be positioned to start detaching from the top. Also used to define the enter position when attaching." >
	float myRappelBotVerticalEnterAndExitDistance 0.5f < tooltip="Vertical position along the wall path where the player should be positioned to start detaching from the bottom. Also used to define the enter position when attaching." >
	float myRappelTopVerticalEnterAndExitDistanceOnWall 1.03f < tooltip="Vertical position along the wall path where the player should be positioned to start detaching from the top when wall supported. Also used to define the enter position when attaching." >
	float myRappelBotVerticalEnterAndExitDistanceOnWall 0.5f < tooltip="Vertical position along the wall path where the player should be positioned to start detaching from the bottom when wall supported. Also used to define the enter position when attaching." >
	float myRappelPathSpeed 0.f < tooltip="Rappel path speed, if < 0 the speed will be the same of the movement max path speed" >
	bool myBotPreparationEndsAfterPath false < tooltip="When attaching from bottom, skip the prepare state during the attachment" >
	bool myTopPreparationEndsAfterPath false < tooltip="When attaching from top, skip the prepare state during the attachment" >
}

class OffsetsData
{
	vec3f myEndRopePositionLS 0.0;1.0;0.0 < tooltip="Rope end position offset from the player position" >
	float myLowHandOffset 1.f < tooltip="Lower hand offset from the rope end position" >
	float myHighHandOffset 1.f < tooltip="Higher hand offset from the rope end position" >
	vec3f myEndRopePositionOnWallLS 0.0;1.0;0.0 < tooltip="Rope end position offset from the player position when the player is on a wall" >
	float myLowHandOffsetOnWall 1.f < tooltip="Lower hand offset from the rope end position when the player is on a wall" >
	float myHighHandOffsetOnWall 1.f < tooltip="Higher hand offset from the rope end position when the player is on a wall" >
	vec3f myLeftFootPositionLS 0.0;1.0;0.0 < tooltip="Offset from the End Rope Position to start raycasting to find left foot IK" >
	vec3f myRightFootPositionLS 0.0;1.0;0.0 < tooltip="Offset from the End Rope Position to start raycasting to find right foot IK" >
	vec3f myPreviousLeftFootPositionLS 0.0;1.0;0.0 < tooltip="Offset from the End Rope Position to start raycasting to find the previous left foot IK" >
	vec3f myPreviousRightFootPositionLS 0.0;1.0;0.0 < tooltip="Offset from the End Rope Position to start raycasting to find the previous right foot IK" >
    float myFeetIKRaycastLength 0.6f < tooltip="Higher hand offset from the rope end position when the player is on a wall" >
}

class RappelSettings < uid=auto >
{
	PlayerRestriction* myRappelRestrictions < tooltip="The actions prevented when you are Rappelling" >
	InteractionValidationData myInteractionValidationData
	WallPathData myWallPathData
	AttachDetachData myAttachDetachData
	OffsetsData myOffsetsData
	ShakeCameraModifier* myTopThrowCameraShake
	ShakeCameraModifier* myBotThrowCameraShake
	ShakeCameraModifier* myTopExitCameraShake
	ShakeCameraModifier* myBotExitCameraShake
	ShakeCameraModifier* myCancelExitCameraShake
	uid myTopThrowRumble < bhv="constantData" constantDataType="rumble" >
	uid myBotThrowRumble < bhv="constantData" constantDataType="rumble" >
	uid myTopExitRumble < bhv="constantData" constantDataType="rumble" >
	uid myBotExitRumble < bhv="constantData" constantDataType="rumble" >
	uid myCancelExitRumble < bhv="constantData" constantDataType="rumble" >
	string myRappelSpeedMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.2 0.001, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="reel velocity multiplier. X axis refers to the input pression strength" >
	float myRappelSpeedEasingTime < tooltip="Time to reach full speed in any circumstance by following the speed multiplier curve" >
	float myRappelUpSpeed 1.0f < tooltip="Speed applied when Rappeling Up while Free Hanging" >
	float myRappelDownSpeed 1.0f < tooltip="Speed applied when Rappeling Down while Free Hanging" >
	float myRappelUpSpeedOnWall 1.0f < tooltip="Speed applied when Rappeling Up while Wall Suported" >
	float myRappelDownSpeedOnWall 1.0f < tooltip="Speed applied when Rappeling Down while Wall Suported" >
	float myRappelWallAlignTurnRate 0.2f
	float myRappelMoveDirectionDeadZone 0.5f
}