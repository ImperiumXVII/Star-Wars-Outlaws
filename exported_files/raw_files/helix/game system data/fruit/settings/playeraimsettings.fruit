include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/equipment/aiming.fruit"
include "helix/game system data/fruit/equipment/aimassist_target_config.fruit"
include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/camera/camerablendtransitions.fruit"

class AimAssistParameters
{
	AimAssistTargetConfig* myDefaultAimAssistTargetConfig
	float myDistanceScoreContribution 0.15
	float myHDistanceToCrosshairContribution 0.65
	float myVDistanceToCrosshairContribution 0.15
	float myTypeScoreContribution 0.05
	float myMagnetismExitModeMultiplier 0.25 < min=0.0 tooltip="If exit mode is active (input stick suddenly pressed on the opposite direction to the target) this multiplier is applied to the magnetism strength" >
}

class AimSmoothDistanceToTargetParameters
{
	bool myNearToFarEnabled true
	float myNearToFarLerpSpeed 3.5f
	bool myFarToNearEnabled true
	float myFarToNearLerpSpeed 10.f
}

class AimParameters
{
	PlayerRestriction* myADSRestrictions < tooltip="Prevented actions while ADS" >
	PlayerRestriction* myHipFireRestrictions < tooltip="Prevented actions while Hipfiring" >
	PlayerRestriction* myScopeRestrictions < tooltip="Prevented actions while Scoping (binocular)" >
	float myAimSourceHeight 1.4f < tooltip="Height from the agent position to define a point independent from animation as an aproximate aim source position" >
	float myAimSourceHeightWhileCrouching 0.8f < tooltip="Height from the agent position to define a point independent from animation as an aproximate aim source position while in the crouch state" >
	AimAssistParameters myAimAssistParameters
	AimSmoothDistanceToTargetParameters mySmoothDistanceToTargetParameters
	AimConfig* myDefaultAimConfig < tooltip="If the player doesn't held am equipment and there is no main weapon slotted, we will use this as a default configuration." >
	bool myCoverDynamicStealthEnabled false < tooltip="If true Kay will try to not hit dynamic objects while in low cover and stealth mode pushing backwards the weapon." >
	float myCoverDynamicCastRadius 0.5f < tooltip="Radius of the sphere cast to detect dynamic obstacles while in cover." >
	float myCoverDynamicBlockerDepth 0.05f < tooltip="In case of dynamic objects in low cover how much depth the blocker aim poistion should have." >
	Factions myFactionCombatDenyList
	float myCombatDenyDistance 20.f < tooltip="The target distance from camera has to be less than this value in order to activate the aim combat denied state" >
	PlayerRestriction* myAimCombatDeniedRestrictions
	CameraTransition* mySwapShoulderCameraTransition < tooltip="When shoulder swapping, this transition will be selected." >
}
