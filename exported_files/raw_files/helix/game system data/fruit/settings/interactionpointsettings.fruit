include "helix/game system data/fruit/interactionpoints/interactionpoints.fruit"
include "helix/game system data/fruit/item/item.fruit"
include "snowdrop/modules/core/audio/audio.fruit"

enum LockpickingSettingsDifficultyType
{
	Easy
	Normal
	Hard
}

class MinigameAbilitySettingsBase < abstract=1 >
{
	Item* myAbilityItem < tooltip="Required Item to consider this ability to be unlocked." >
}

class MinigameAbilitySettings_Lockpicking_CompleteInstantly : MinigameAbilitySettingsBase
{

}

class MinigameAbilitySettings_Lockpicking_PauseATM : MinigameAbilitySettingsBase
{
	string myDuration 3 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="How many seconds the ATM will be paused" >
}

class LayerSectionSoundEvents
{
	AudioEvent myGapSectionSound
	AudioEvent myBlockSectionSound
	AudioEvent myFailSectionSound
	AudioEvent myPunishSectionSound
}

class LockpickingSettingsDifficultyTypeBase
{
	float myEarlyGraceRange 0.12 < min=0.01 tooltip="The time in seconds we want to allow the player to hit a slot earlier than it is actualy valid." >
	float myLateGraceRange 0.12 < min=0.01 tooltip="The time in seconds we want to allow the player to hit a slot later than it is actualy valid." >
	float myPerfectHitRangeRatio 0.5 < min=0 max=1 tooltip="The range ratio that a player can hit a slot and consider it as a perfect timing. This is a value between 0 and 1." >
	float myMinTempo 0.1 < min=0.01 tooltip="This is the minimum value we want to cap the lockpicking puzzle tempo to.">
}

list LockpickingSettingsPerDifficultyTypeList
{
	LockpickingSettingsDifficultyTypeBase
}

class LockpickingMinigameSettings < uid=auto >
{
	file myUILooseGraph < bhv="asset" assettype="GUI" tooltip="UI loose to spawn for the lockpicking." >
	LockpickingSettingsPerDifficultyTypeList myLockpickingSettingsPerDifficulty
	float mySignalTime 0.05 < min=0.01 max=0.1 tooltip="The time we need our signals to go back to false. This has to be lower than the Pattern Tempo." >

	MinigameAbilitySettings_Lockpicking_CompleteInstantly myCompleteInstantlyAbility
	MinigameAbilitySettings_Lockpicking_PauseATM myPauseATMAbility

	LayerSectionSoundEvents myLayerSectionSounds < tooltip="Sounds used to indicate what section type is currently in front of the cursor" >

	float mySectionAudioEventOffset 0.f < tooltip="Offset from the center of the lockpick to use to trigger audio events" >
}

class MinigameAbilityData_Slicing_Upgrade : MinigameAbilitySettingsBase
{

}

class SlicingUpgrade
{
	MinigameAbilityData_Slicing_Upgrade myUpgradeAbility
	int myEnergyAmountToAdd 0 < min=0 tooltip="Number of energy to add to the total energy amount at the beginning of the slicing." >
}

list SlicingUpgradeList
{
	SlicingUpgrade
}

enum SlicingJokerType
{
	GlyphGroups
	MaximumAttemptBeforeWarningAdjustment
	PlaceFoundGlyphsAtCorrectPositionInLastAttempt
	MarkGlyphsNotInSolution
}

class SlicingJokerBase < abstract = 1 >
{
	SlicingJokerType myJokerType < hidden = 1 >
	int myEnergyCost 1 < min=0 tooltip="Number of energy needed to activate the joker." >
	bool myIsPassive false < tooltip="Defines if this joker will be automaticaly activated upon start or not." >	
}

list SlicingJokerList
{
	SlicingJokerBase
}

class SlicingJokerGlyphGroups : SlicingJokerBase
{
	SlicingJokerType myJokerType GlyphGroups < hidden = 1 >
}

class SlicingJokerMaximumAttemptBeforeWarningAdjustment : SlicingJokerBase
{
	SlicingJokerType myJokerType MaximumAttemptBeforeWarningAdjustment < hidden = 1 >
	int myMaximumAttemptBeforeWarningToAdd 1
}

class SlicingJokerPlaceFoundGlyphsAtCorrectPositionInLastAttempt : SlicingJokerBase
{
	SlicingJokerType myJokerType PlaceFoundGlyphsAtCorrectPositionInLastAttempt < hidden = 1 >
}

class SlicingJokerMarkGlyphsNotInSolution : SlicingJokerBase
{
	SlicingJokerType myJokerType MarkGlyphsNotInSolution < hidden = 1 >
	float myNotInSolutionGlyphRatioToMark 0.25 < min=0.0 max=1.0 tooltip="When computing the glyph count to mark with this ratio, the result will be ceiled not floored." >
}

class SlicingMinigameSettings < uid=auto >
{
	file myUILooseGraph < bhv="asset" assettype="GUI" tooltip="UI loose to spawn for the slicing." >
	
	int myMaximumAttemptBeforeWarningLimit 6 < min=1 tooltip="No matter which settings, user options or jokers the player use, the maximum attempt count before warning will never be higher than this limit." >
	int myMaximumAttemptBeforeWarningUserOptionStep 1 < min=1 tooltip="Defines how many attempts before warning are added by a choice in the user options." >
	SlicingUpgradeList myUpgrades
	SlicingJokerList myJokers
}

class AdminPanelSettings < uid=auto >
{
	file myUILooseGraph < bhv="asset" assettype="GUI" tooltip="UI loose to spawn for the admin panel." >
}

list MidAirJumpGrappleGameActionConflicts
{
	GameAction
}

class InteractionPointSettings < uid=auto >
{
	LockpickingMinigameSettings myLockpickingMinigameSettings
	SlicingMinigameSettings mySlicingMinigameSettings
	AdminPanelSettings myAdminPanelSettings

	InteractionPoint* myLedgeClimbPoint
	InteractionPoint* myLedgeClimbSecondaryPoint
	InteractionPoint* myDropDown
	InteractionPoint* myRevivePoint
	InteractionPoint* myTakeOffPoint
	InteractionPoint* myWorkbenchPoint

	string myInteractionPointSequencePerformMarkerName < tooltip="The name of the marker in the sequence where we perform the interaction" >
	string myInteractionPointSequenceExtResPlayerName < tooltip="The name of the player agent resouce being bound to the sequence" >
	string myInteractionPointSequenceExtResShipName < tooltip="The name of the spaceship agent resouce being bound to the sequence" >
	string myInteractionPointSequenceExtResPetName < tooltip="The name of the pet agent resouce being bound to the sequence" >
	string myInteractionPointSequenceExtResSpeederName < tooltip="The name of the speeder agent resouce being bound to the sequence" >
	string myInteractionPointSequenceExtResEntityName < tooltip="The name of the entity that has the interaction point." >

	GameAction myAdrenalineRushConflictingGameAction Interact < tooltip="If we can go into Adrenaline Rush, we delay a possible interaction of this type by 50ms to resolve input conflicts." >

	MidAirJumpGrappleGameActionConflicts myMidAirJumpGrappleGameActionConflicts < tooltip="Game Actions that would result in a conflict with the Mid Air Grapple Jump. It will prevent the mid air grapple jump if any interaction has a game action from this list." >
}