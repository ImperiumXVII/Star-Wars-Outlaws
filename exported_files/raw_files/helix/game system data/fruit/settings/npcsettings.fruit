include "helix/game system data/fruit/npc/npc.fruit"
include "helix/game system data/fruit/npc/npctraversalsettings.fruit"

class NPCBumpSettings
{
	float myCooldown 0.0 < min=0 tooltip="Cooldown before NPCs can get bumped again (seconds)" >
	float myLightBumpVelocity 0.0 < min=0 tooltip="Required velocity to trigger a light bump AI event. Behavior can act on what it should do with this." >
	float myHeavyBumpVelocity 0.0 < min=0 tooltip="Required velocity to trigger a heavy bump AI event. Behavior can act on what it should do with this." >
	float myLightSlideBumpVelocity 0.0 < min=0 tooltip="Required velocity during slide to trigger a light bump AI event. Behavior can act on what it should do with this." >
	float myHeavySlideBumpVelocity 0.0 < min=0 tooltip="Required velocity during slide to trigger a heavy bump AI event. Behavior can act on what it should do with this." >
	
	float myVehicleLightHitCooldown 0.0 < min=0 tooltip="Time between light hits before the NPC forgets about the other ones." >
	int myRequiredLightVehicleHits 0 < min=0 tooltip="Required hits to trigger an ai event." >
	float myLightVehicleBumpVelocity 0.0 < min=0 tooltip="Required velocity to trigger a light bump Vehicle AI event. Behavior can act on what it should do with this." >
	float myHeavyVehicleBumpVelocity 0.0 < min=0 tooltip="Required velocity to trigger a heavy bump Vehicle AI event. Behavior can act on what it should do with this." >
}

class NPCDeadNPCLimiterSettings
{
	int myMaxNumberDeadNPCs 24 < min=0 tooltip="If the number of dead NPCs exceeds this number we will start despawning dead NPCs if possible." >
	float myMinTimeSinceDeathBeforeDespawningSeconds 20 < min=0 tooltip="If we are despawning dead NPCs because we exceed the maximum number we will only consider NPCs that have been dead for longer than this" >
	float myTimeSinceDeathScoringWeight 0.5 < min=0 tooltip="When scoring dead NPCs to decide which to despawn, this is the weight to apply to the age of the NPC." >
	float myDistanceToPlayerScoringWeight 1.0 < min=0 tooltip="When scoring dead NPCs to decide which to despawn, this is the weight to apply to the distance from the player." >
	float myNotVisibleScoringPenalty 50.0 < min=0 tooltip="When scoring dead NPCs to decide which to despawn, this is the penalty score to apply to an NPC that is not visible." >
}

class NPCSettings < uid=auto >
{
	file myDefaultPlayerAwarenessBehavior "" < bhv=asset assettype=behavior >
	file myDefaultFireteamBehavior "" < bhv=asset assettype=npcfireteambehavior >
	file myDebugMoveOrderBehavior "" < bhv=asset assettype=behavior >
	NPCBumpSettings myNPCBumpSettings
	TraversalSettingsList myTraversalSettings
	NPCDifficultyOverrideGameValue myDifficultyOverrideGameValue < init_set=1 >
	float myLastKnownPositionMaxSampleTime 0.1 < min=0 tooltip="Total time in seconds after losing sight of target that we sample hostile target LKP" >
	NPCDeadNPCLimiterSettings myDeadNPCLimiterSettings
}