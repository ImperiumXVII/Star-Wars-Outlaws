	file < bhv=asset assettype="webm" >
}

class FrontendOptions
{
	WebMList myLogoTrain
	file myTitleBackground < bhv=asset assettype="webm" >
	file myMenuBackground < bhv=asset assettype="webm" >
	WebMList myPCPartners
	WebMList myDemoAssets
}

