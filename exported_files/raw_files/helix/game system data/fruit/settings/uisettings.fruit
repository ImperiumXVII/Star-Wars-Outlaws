	HUDElementVisibility
}

//////////////////////////////////////////////////////////////////////////

class LandingZoneSettings
{
	string myDefaultIcon < bhv=sprite >
	string myCurrentIcon < bhv=sprite tooltip="Icon to use for the landing zone the Trailblazer is currently stationed at." >
	string myLockedIcon < bhv=sprite >
	float myInteractionPointCheckRadius 30.0 < tooltip="How many meters in radius should we check for the relevant take off interaction point to attach map refs to?" >
}

//////////////////////////////////////////////////////////////////////////

class GameActionOffsets
{
	string myFont "ProximaNova"
	float myReferenceHeight 32
	float myMaxWidth 64
	float myHoldLineThickness 2.5
	float myHoldLineDistance 1
	float myHoldMoveDistance 4
	float myReferenceFontSize 18
	float myMinimumFontScale 0.77
	float myTextMargin 3
	float myVerticalAlignment 0.4
}

list GameActionOffsetsList
{
	GameActionOffsets
}

//////////////////////////////////////////////////////////////////////////

class MetroidvaniaGateSettings
{
	uid myAdvancedSlicingKitItem < bhv=constantdata constantDataType=item >
	uid myFusionCutterItem < bhv=constantdata constantDataType=item >
	uid myPowerBlasterModuleItem < bhv=constantdata constantDataType=item >
}

//////////////////////////////////////////////////////////////////////////

class UISettings < uid=auto >
{
	UILoadList myDefaultLoadList
	FrontendOptions myFrontendOptions
	MapWaypointOptions myMapWaypointOptions
	MapAnnotationOptions myMapAnnotationOptions
	UIMovablePieces myMovablePieces
	UIGlowSettings myGlowSettings
	UIAnalogSettings myAnalogSettings
	SoundVisualsSettings mySoundVisualsSettings
	StencilSettings myStencilSettings
	MenuNarrationSettings myMenuNarrationSettings
	SubtitleTextFormattingSettings mySubtitleTextFormattingSettings
	string myDyslexiaFont
	MenuTabGameValueList myMenuTabGameValues
	HUDElementVisibilityList myHUDVisibilityRules
	LandingZoneSettings myLandingZoneSettings < bhv=sprite >
	GameActionOffsetsList myGameActionOffsets
	MetroidvaniaGateSettings myMetroidvaniaGateSettings
}