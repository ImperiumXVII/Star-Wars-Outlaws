	AudioEvent myAudioEvent
	AudioRTPC myAudioRTPC
	MenuNarrationVoiceNames myVoiceUserOptionLocStrings
}

//////////////////////////////////////////////////////////////////////////

class SubtitleTextFormattingSettings
{
	bool myBoldenName false

	uid myClosedCaptionColor < bhv=presetcolor >
	uid myEssentialTextColor < bhv=presetcolor >
	uid myEssentialNameColor < bhv=presetcolor >
	uid myOverheardTextColor < bhv=presetcolor >
	uid myOverheardNameColor < bhv=presetcolor >
}

//////////////////////////////////////////////////////////////////////////

class MenuTabGameValue
{
	UIGameMenuTab myMenuTab
	uid myGameValue < bhv=constantdata constantDataType=gamevalue >
}

list MenuTabGameValueList
{
	MenuTabGameValue
}

//////////////////////////////////////////////////////////////////////////

class HUDVisibilityRule_GameValue
{
	uid myGameValue < bhv=constantdata constantDataType=gamevalue >
}

class HUDVisibilityRule_UserOption
{
	OptionEnum myOption
	int myRequiredValue
}

list HUDVisibilityRuleList
{
	HUDVisibilityRule_GameValue
	HUDVisibilityRule_UserOption
}

class HUDElementVisibility
{
	UIHUDElement myElement
	HUDVisibilityRuleList myRules
}

list HUDElementVisibilityList
