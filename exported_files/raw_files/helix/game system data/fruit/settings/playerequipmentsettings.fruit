include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/talent/talent.fruit"

class EquipmentConfigParameters
{
	PlayerRestriction* myOverHeatRestrictions < tooltip="Prevented actions while the equipment is in overheat" >
	PlayerRestriction* myOverHeatFailureRestrictions < tooltip="Prevented actions while the equipment is in overheat and the player has failed the minigame" >
	PlayerRestriction* myOverHeatSuccessRestrictions < tooltip="Prevented actions while the equipment is in overheat and the player has succeed the minigame" >
	TalentListUID myAmmoRegenTalents < tooltip="Ammo regeneration talents that will block automatic throw away actions on pickup weapons when out of ammo" >
}
