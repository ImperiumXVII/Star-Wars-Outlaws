class DomainOfMasterySettings < uid=auto >
{
    float myUITrackerPopupCooldownTime 0.0f
	int myNonTrackedPopupInterval 5 < tooltip="The interval of which non tracked items will be shown on the tracker regardless of when the last popup was shown (Default value: 5)" >
	bool myShowUINotificationOnItemRemoval TRUE
	bool myOnlyShowUINotificationOnItemRemovalWhenConditionChangesCompletionState TRUE < tooltip="If true, then a notification is only shown if the requirement was true before the item(s) were removed, and is now false. For example, if it requires 4 items and there were 5 and now there are only 3, a notification will show. But if there were 3 and now there are 2, no notification would be shown since the requirement was not met both before and after the item removal." >
}
