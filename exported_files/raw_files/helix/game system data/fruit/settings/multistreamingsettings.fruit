class BucketStreamingDistances 
{
	float mySmallBucketStreamingDistance 80.f < min=0 tooltip="small buckets streaming distance" >
	float myMediumBucketStreamingDistance 400.f < min=0 tooltip="medium buckets streaming distance" >
}

class SecondarySphereRaycastsSettings
{
	vec2f myScreenPosition < tooltip="screen position percentage to cast the raycast" >
	float myWeight < min=0.f tooltip="weight of the position, part of the values to choose the best position for the secondary sphere" >
}

list SecondarySphereRaycastsSettingsList
{
	SecondarySphereRaycastsSettings
}

class MultiStreamingSettings < uid=auto >
{
	BucketStreamingDistances myBucketStreamingDistances < tooltip="bucket streaming distances used to reduce the number of streaming requests. Values copied from the corresponding config file" >
	float myRaycastMaxDistance 4000 < min=0 tooltip="raycast distance for the multi streaming position calculation" >
	float myMaxFallbackAngle 40 < min=1 tooltip="max angle used for the vertical and horizontal fallback raycasts" >
	bool myUseFallbackRaycasts true < tooltip="activate the fallback if the first camera raycast does not hit" >
	int myFallbackRaycastIncrements 1 < tooltip="angle increase of the fallback raycasts" >
	int myFallbackFocalPlaneMaxDistance 7000 < tooltip="max distance of the focal plane to trigger the fallback" >
	bool myUseSecondSphere true < tooltip="enables the second streaming sphere nearer to the player and tangent to the main one" >
	float myMinSecondStreamingDistance 100 < min=0 tooltip="minimum distance from the player to create the second sphere" >
	SecondarySphereRaycastsSettingsList mySecondarySphereRaycastsSettings
	float mySecondarySphereDepthRangePercentage 0.f
	float myDepthWeight 0.f
	float myNeighboursDepthWeight 0.f
	string mySecondarySphereWeightCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.5 -0.001, }, outTangents = { 0.2 0.001, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	float myDistancePercentageThresholdToUpdate 0.2 < min=0 max=1 tooltip="distance percentage of the last bucket distance after which we request a new streaming position" >
	float myStreamingScreenAreaXPerc 0.7 < min=0 max=1 tooltip="visible X screen percentage where the streaming sphere will be inserted" >
	float myStreamingScreenAreaYPerc 0.7 < min=0 max=1 tooltip="visible Y screen percentage where the streaming sphere will be inserted" >

	float myLargeSpherePercentage 1 < min=0.0 max = 1.0 tooltip="percentage used to reduce the sphere radius of the biggest possible in that configuration" >
	float myLargeSphereMinBucketDistance 600 < min=0.0 tooltip="minimum large sphere bucket distance" >
	float myLargeSphereMaxBucketDistance 1500 < min=0.0 tooltip="maximum large sphere bucket distance" >

	int myMaxBlurTimeMS 0 < min=0 tooltip="maximum blur timer in ms" >
	int myBlendInBlurTimeMS 200 < min=0 tooltip="Blur blend in timer in ms" >
	int myBlendOutBlurTimeMS 200 < min=0 tooltip="Blur blend out timer in ms" >
	float myBlurAperture 1.4 < min=0.0 tooltip="lens aperture value on Blur. Minimum and maximum values depend on the lens settings" > 
	float myBlurFocalPlane 2 < min=0.0 tooltip="lens focal plane value on Blur" > 
	bool myActivateBlurOnChangeOfView true < tootlip="True: the blur is triggered also while moving the camera around. False: the blur is active only when the binocular is equipped" >
}
