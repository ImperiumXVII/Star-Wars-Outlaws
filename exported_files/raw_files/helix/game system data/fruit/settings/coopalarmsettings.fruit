class CoopAlarmSettings < uid=auto >
{
  float myAlertedAlarmTimerDuration 60.f < tooltip="Time until alarm goes into lockdown phase" >
  int myMaximumNumberOfClues 10	< tooltip="Maximum number of clues players left over and npcs investigated" >
  int myMaximumNumberOfStealthKills 3 < tooltip="Maximum number of stealth killes per session" >
  float myMaxTimeInCombatInSeconds 10.0	< tooltip="Maximum time (in seconds) players are in combat" >
}