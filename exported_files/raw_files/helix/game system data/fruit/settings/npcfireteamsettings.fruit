include "helix/game system data/fruit/level/levelinfoenums.fruit"

class NPCFireteamSetting < uid=auto >
{
	LevelInfoType myLevelType
	float myMetaFireteamDistanceAdd 0.0 < tooltip="Distance (meters) in which NPCs will be added to the Meta Fireteam" >
	float myMetaFireteamDistanceRemove 0.0 < tooltip="Distance (meters) in which NPCs will be removed from the Meta Fireteam" >
}

list NPCFireteamSettingList
{
	NPCFireteamSetting
}

class NPCFireteamSettings < uid=auto >
{
	NPCFireteamSettingList myFireteamSettings
}