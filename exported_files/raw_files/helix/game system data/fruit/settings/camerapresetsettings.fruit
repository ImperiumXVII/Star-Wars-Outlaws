include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/camera/camerapreset.fruit"
include "helix/game system data/fruit/camera/camerablendtransitions.fruit"

list TransitionDataList
{
    TransitionData
}

list CameraBlendList
{
    CameraPreset*
}

class TransitionData
{
    CameraBlendList myCameraBlendList
	CameraTransition myBlend
}

class BlendTransitions
{
	CameraTransition myDefaultBlend < tooltip="When blending into this camera preset, this blend will be the default one used" >
    TransitionDataList myTransitionDataList < tooltip="If the previous preset was anyone in this list, then the blend will be the one defined below" >
}

list PresetConditions < size=1 >
{
    GameCondition
}

list PresetDataList
{
    PresetData
}

class PresetData
{
    PresetConditions myGameCondition
	CameraPreset* myCameraPreset
	PresetDataList myChildPresets
	BlendTransitions myBlendTransitions
}

class CameraPresetSettings < uid=auto >
{
    PresetDataList myCameraPresetList
}