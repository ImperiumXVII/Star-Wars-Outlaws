include "helix/game system data/fruit/animation/gesturetypes.fruit"

class LootSettings < uid=auto >
{
	file myDefaultSpawnedLootGraphObject "" < bhv=asset assettype=object tooltip="Default graph object used for spawned loot." > 
	file mySpaceOverrideDefaultSpawnedLootGraphObject "" < bhv=asset assettype=object tooltip="If set, overrides default graph object used for spawned loot in space levels." > 
	string mySpawnedLootPillarVisibilityRadius 50 < bhv=formulaEditor formulaResolveContextType=Global tooltip="Visibility radius in meters for the loot pile pillars" >
	GestureType myLootFromPetGestureAnimationType None < tooltip="Gesture animation type to be played when the Pet gives loot to the player." >
	uid myDisableWeaponPickupCharm < bhv="constantData" constantDataType="item">
}
