include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"

// Keep in sync with enum in HC_ContextualControlsSettingsConstantData.h
enum ContextualControls_ContextEnum
{
	Default_Ground
	Default_Space

	Climbing_DynamicLedge
	Climbing_PlacedLedge
	Climbing_Wall
	Climbing_Ladder
	Climbing_Rappel

	GrapplingHook_Swinging

	Speeder
	RidingTroopTransport
	HoloReaderProjection

	ThrowableHeld
	
	AimingScope_ZoomingStep
	AimingScope_ZoomingProgressive
}

list ContextualControls_Control_Conditions
{
	GameCondition
}

class ContextualControls_Control
{
	GameAction myGameAction
	varmap myUserOptionName < bhv = "localization" >
	ContextualControls_Control_Conditions myShowContextualControlConditions
}

list ContextualControls_ControlList
{
	ContextualControls_Control
}

class ContextualControls_ControlContext
{
	ContextualControls_ContextEnum myContextEnum
	ContextualControls_ControlList myControls
}

list ContextualControls_ControlContexts
{
	ContextualControls_ControlContext
}

class ContextualControlsRoot < uid=auto >
{
	ContextualControls_ControlContexts myContexts
}
