include "helix/game system data/fruit/quest/questenums.fruit"

class FailureSettings < uid=auto >
{
    varmap myDeathDuringTimeLimitFailureText < bhv="localization" >
    varmap myOutsideActiveQuestBeatFailureText < bhv="localization" >
    varmap myOutOfTimeFailureText < bhv="localization" >
    varmap myTooCloseToFollowFailureText < bhv="localization" >
    varmap myTooFarFromEscortFailureText < bhv="localization" >
    varmap myTooFarFromFollowFailureText < bhv="localization" >
    varmap myTriggeredAlarmFailureText < bhv="localization" >
	varmap myFailedToDefendFailureText < bhv="localization" >
}

// Keep in sync with HC_FailureType.h
enum FailureType
{
	DeathDuringTimeLimit
	OutsideActiveQuestBeat
	OutOfTime
	TooCloseToFollow
	TooFarFromEscort
	TooFarFromFollow
	TriggeredAlarm
	FailedToDefend
}