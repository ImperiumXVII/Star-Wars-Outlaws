class EnvironmentSettings < uid=auto >
{
	float myDawnStart 5.0f
	float myDayStart 7.0f
	float myDuskStart 18.0f
	float myNightStart 19.0f
	
	float myIndoorTemperature 10.0f
	float myHeatSourceTemperature 40.0f
	float myOverrideTemperature 10.0f
	float myCrossEnvironmentBlendTimeInSeconds 0.0f

	int myDayNightCycleInMinutes 10
	
	float mySnowIncreaseSpeed 0.1f < tooltip="Defines how quick snow accumulates on characters" >
	float mySnowDecreaseSpeed 0.05f < tooltip="Defines how quick snow disapears from characters when sheltered" >
	float myRainIncreaseSpeed 0.1f < tooltip="Defines how quick characters get wet when in rain" >
	float myRainDecreaseSpeed 0.05f < tooltip="Defines how quick characters dry up when sheltered" >
	float myDustIncreaseSpeed 0.1f < tooltip="Defines how quick dust accumulates on characters while outdoor" >
	float myDustDecreaseSpeed 0.05f < tooltip="Defines how quick dust disapears when indoor" >
	
	string myRealTimeToGameTimeCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { 0 0, -0.1 -0.1, }, outTangents = { 0.1 0.1, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
}
