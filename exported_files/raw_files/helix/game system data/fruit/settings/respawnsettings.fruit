include "helix/game system data/fruit/loottable/loottable.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"

class OutOfBoundsParameters
{
	float myDurationUntilTeleportSpace 10.f < tooltip="Duration in seconds until the player is teleported after entering an Out of Bounds Warning volume in space" >
	float myDurationUntilTeleportPlanet 10.f < tooltip="Duration in seconds until the player is teleported after entering an Out of Bounds Warning volume on a planet" >
	float myDurationUntilTeleportWhileFalling 1.f < tooltip="Duration in seconds until the player is teleported after entering an Out of Bounds volume while falling" >
	float myDurationUntilTeleportWhileInWindTunnel 2.f < tooltip="Duration in seconds until the player is teleported after entering an Out of Bounds Wind Tunnel volume" >
	float myCameraModifierTransitionDuration 0.5f < tooltip="Duration in seconds of the camera modifier transition" >
	float myMaxDepthSpace 200.f < tooltip="The maximum distance the ship can go until the engine limitations start" >
	float myMaxDepthPlanet 200.f < tooltip="The maximum distance the speeder can go until the engine limitations start" >
	int myTeleportsForSpawnPointTeleport 5 < min=1 tooltip="How many teleports caused by being out of bounds should trigger spawning the player to the closest spawn point." >
	float myTimeForSpawnPointTeleport 60.f < tooltip="Timeframe in which the teleports above should be done to trigger spawning to the closest spawn point." >
}

class RespawnSettings < uid=auto >
{
    LootTable* myOnRespawnLootTable
	OutOfBoundsParameters myOutOfBoundsParameters
	float myMaxAngleForSafePlayerPosition 12.f < min=0.f max=90.f tooltip="Maximum angle in degrees from the ground compared to the player character or speeder for a safe position to be considered" >
	PlayerRestriction* myPlayerRestrictionsWhileTeleporting
	PlayerRestriction* myPlayerRestrictionsWhileDead
	PlayerRestriction* myPlayerRestrictionsWhileLevelTransition
	float myWaitingForRespawnUIDuration 4.f < min=0.f tooltip="Duration to wait and display the respawn UI before respawning." >
	float myWaitingForRespawnUIDurationWithDeathCamera 0.f < min=0.f tooltip="Duration to wait and display the respawn UI before respawning with death camera on." >
}
