class IonNebulaSettings
{
	uid myIonNebulaTalent < bhv="constantData" constantDataType="BaseTalent" tooltip="The talent applied when the player is in the ion nebula" >

	bool myUseTransmittance true
	float myTransmittanceDistance 150.0

	float myDeactivationThreshold 0.2
	float myActivationThreshold 0.4
	bool mySkipDeactivationHysteresisWhenIonized false

	float myWarningEvaluationRadius 100.0 < tooltip="The distance around the player that a warning is given is an ion nebula is found" >
	
	bool mySmoothOutFinalResult true < tooltip="Use probes around the player to modify the result, and smooth the result with a linear interpolation, which introduces lag" >
	float myProximityEvaluationRadius 50.0 < tooltip="The distance around the player to place additional evaluators" >
	float myProximityEvaluatorsWeight 0.5 < tooltip="Proximity evaluators weight over the center value" >
	float myDensitySmoothTime 2.0 < tooltip="Density Smooth Time" >
}

