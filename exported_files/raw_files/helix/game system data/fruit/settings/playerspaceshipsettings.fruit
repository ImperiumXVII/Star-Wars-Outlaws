	PlayerSpaceshipVisualProgressionSequenceOverrideGameValue myPlayerSpaceshipVisualProgressionSequenceOverrideGameValue < init_set=1 tooltip="The toggle for visual progresion state for the player ship, should only be used in sequences. True for hiding gameplay interior, false for unhiding." >
