class CameraOffsetSettings
{
	string mySpeedToCameraTranslationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string mySpeedToCameraTranslationSmoothTimeCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >

	float myTargetTranslation 0.f < tooltip="The maximum offset of the camera's look at target depending on the input" >
	float myTargetTranslationSmoothTime 0.f < tooltip="The translation smooth time of the camera's look at target" >
}

class NearFarPlaneSettings
{
	bool myIsNearPlaneEnabled false < tooltip="Has the near plane field been enabled" >
	float myNearPlane 0.1f < tooltip="meters" >
	bool myIsFarPlaneEnabled false < tooltip="Has the far plane field been enabled" >
	float myFarPlane 25000.0f < tooltip="meters" >
}

class SpaceshipCameraShakeSettings < uid=auto >
{
	ShakeCameraModifier* myIncreaseSpeedLevelCameraShake < tooltip="Camera Shake when the speed level is increased" >
	ShakeCameraModifier* myDecreaseSpeedLevelCameraShake < tooltip="Camera Shake when the speed level is decreased" >
	ShakeCameraModifier* myYawPitchMaxSpeedCameraShake < tooltip="Camera Shake when the maximum angular yaw speed to the left is reached" >
	ShakeCameraModifier* myHullLittleDamageCameraShake < tooltip="Camera Shake when the ship hull takes a little amount of damage" >
	ShakeCameraModifier* myHullLargeDamageCameraShake < tooltip="Camera Shake when the ship hull takes large amount of damage" >
	ShakeCameraModifier* myShieldLittleDamageCameraShake < tooltip="Camera Shake when the ship shield takes a little amount of damage" >
	ShakeCameraModifier* myShieldLargeDamageCameraShake < tooltip="Camera Shake when the ship shield takes large amount of damage" >
	ShakeCameraModifier* myEngineDischargeDamageCameraShake < tooltip="Camera Shake when the ship receives damage from the exhaust of another ship" >
	ShakeCameraModifier* myCollisionCameraShake < tooltip="Camera Shake when the ship receives Impact damage from damage source types different than ContactCollision" >
	ShakeCameraModifier* myIonDamageCameraShake < tooltip = "Camera Shake when the ship receives damage from Ion Nebula or Ion Cloud LDI" >
	ShakeCameraModifier* myFlightModeTransitionCameraShake < tooltip = "Camera Shake when the ship switches between Recon and Assault flight modes" >
}

class FreeLookCameraSettings
{
	vec3f myFreeLookCameraPivot 0.0;0.0;0.0 < tooltip="The pivot point of the camera in free look camera mode" >
	vec3f myFreeLookCameraSpeeds 100.0;100.0;50.0 < tooltip="The camera angular speeds on every axis during free look camera mode" >
	vec3f myFreeLookCameraAccelerations 1.0;1.0;1.0 < tooltip="The camera angular accelerations on every axis during free look camera mode" >
	vec3f myFreeLookTransitionAccelerations 0.0;10.0;50.0 < tooltip="Accelerations for the transition between modes" >
	float myFreeLookTransitionSmoothTime 0.3 < tooltip="Smooth time for the transition between modes" >
	string myFreeLookReturnSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -60 -0.033333343, }, outTangents = { 60 0.033333343, 0 0, }, properties = { 203, 1227, }, values = { 0 1, 180 1.1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The slerp speed with which the camera returns to the original direction, based on the angle difference" >
	string myFreeLookReturnMovementCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.5 0, }, outTangents = { 0.5 0, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	bool myCanActivateInCombat < tooltip="Should you have the possibility of changing to free camera in combat " >
	float myCameraOrientationAcceleration 5.0 < tooltip="Acceleration that alters orientation speed" >
	float myCameraOrientationDeceleration 5.0 < tooltip="Deceleration that alters orientation speed" >
}

class CameraCollisionSettings
{
	vec3f myConstrainAnchor 0.0;10.0;0.0
	float myCollisionOutSpringStrength 5.f
	float myCollisionFanMaxRotationSpeed 6.28f
	float myCollisionFanMinScale 1.0f
	float myCollisionFanMaxScale 1.0f
	float myCollisionOffset 1.0f
	vec3f myInsideSpaceshipBox 22.0;5.0;42.0 < tooltip="Sizes for the box where the camera is considered inside the spaceship" >
	float myInsideSpaceshipBoxHysteresis 0.5f < tooltip="Extra size added to the box when the camera is inside it. Its a buffer so the inside status isn't spammed on/off quickly when at the edges" >
}

class SpaceshipCameraSettings
{
	string mySpeedToCameraYawSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 41.666668 3.3333335, }, properties = { 203, }, values = { 0 35, }, }, numKeys = 1, }" < bhv=inputgraph >
	string mySpeedToCameraPitchSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, }, outTangents = { 0 0, }, properties = { 275, }, values = { 0 45, }, }, numKeys = 1, }" < bhv=inputgraph >
	string mySpeedToCameraRollSpeedCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, }, outTangents = { 0 0, }, properties = { 275, }, values = { 0 100, }, }, numKeys = 1, }" < bhv=inputgraph >

	vec3f myCameraAccelerations 1.0;1.0;1.0 < tooltip="The camera angular accelerations on every axis" >
	vec3f myCameraTransitionAccelerations 0.0;0.0;0.0 < tooltip="Accelerations for the transition between different camera distances/pivot changes" >

	string myCameraOrientationAcceleration "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 3, }, values = { 0 1.5, }, }, numKeys = 1, }" < bhv=inputgraph >
	string myCameraOrientationDeceleration "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 3, }, values = { 0 3.5, }, }, numKeys = 1, }" < bhv=inputgraph >

	float myCameraLookAheadDistance 100.0f < tooltip="Distance from the spaceship to the camera look at point. Increasing this will make the camera look further into the distance" >
	float myCameraLookAheadDistanceEvasiveManeuver 100.0f < tooltip="Distance from the spaceship to the camera look at point. Increasing this will make the camera look further into the distance" >
	float myCameraLookAheadDistanceSpeedBoost 100.0f < tooltip="Distance from the spaceship to the camera look at point. Increasing this will make the camera look further into the distance" >
	float myMaximumFovChangeSpeed 1.0f < bhv=angle tooltip="Increasing it will make FOV change faster during fast acceleration." >

	int myCameraFOVBlendInTime 500 < tooltip="Transition duration from another camera in miliseconds" >
	int myCameraFOVBlendOutTime 500 < tooltip="Transition duration to another camera in miliseconds" >

	string mySpeedToCameraDistanceCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string mySpeedToExtraFOVCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.79832089 -2.7807119, -17.526897 -24.96526, -36.536285 -2.0069637, -14.314453 8.9807281, }, outTangents = { 1.984055 10.16193, 28.232582 98.339752, 19.52533 27.811821, 41.277721 2.2674141, 0 0, }, properties = { 275, 1299, 6419, 3347, 5395, }, values = { 0.0049052238 0.50632489, 3.2695312 11.287262, 49.124702 125.74115, 160.48059 378.96603, 257.46368 358.83649, }, }, numKeys = , }" < bhv=inputgraph >
	string myStickyTargetingAngleToPowerCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The sticky targeting power depending on the angle from the target">

	string myInputToOffsetModifierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.506338 -0.00039744377, }, outTangents = { 0.55704224 0.081478536, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="Camera offset modifier based on Input Strength">
	CameraOffsetSettings myHorizontalCameraOffsets < tooltip="The camera offsets active during turning" >
	CameraOffsetSettings myUpCameraOffsets < tooltip="The camera offsets active during pitching up" >
	CameraOffsetSettings myDownCameraOffsets < tooltip="The camera offsets active during pitching down" >

	NearFarPlaneSettings myCameraClippingSettings < tooltip="Adjusting the near and far plane values for the camera" >
	FreeLookCameraSettings myFreeLookCameraSettings < tooltip="Tunable fields for the Free Look Camera Mode" >
	CameraCollisionSettings myCameraCollisionSettings

	CameraPreset* myCameraPreset < tooltip="This camera preset will be active for spaceship" >
}

