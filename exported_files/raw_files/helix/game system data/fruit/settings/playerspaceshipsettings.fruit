	LandingSequenceSettings myShipMechanicLandingSequenceSettings < tooltip="Settings for the landing sequence that's played when the player interacts with a ship mechanic" >
	TaggingBehaviorSetup myTaggingBehaviorSetup < tooltip="Setup for the priority of the target tagging" >
	PursuitModeSettings myPursuitModeSettings < tooltip="All the fields regarding the Pursuit Mode" >
	PursuitModeSettings myPursuitModeSettingsAssault < tooltip="All the fields regarding the Pursuit Mode" >
	TractorBeamSettings myTractorBeamSettings < tooltip="Tunable fields for the Tractor Beam Functionality" >
	SpaceshipHealthSettings mySpaceshipHealthSettings
	ManeuverInvulnerabilityDataList myManeuverInvulnerabilityDataList
	SpaceshipDodgeDataList myDodgeDataList
	SpaceshipDodgeDataList myDodgeDataListAssault
	SpaceshipManeuverData my180ManeuverData
	SpaceshipManeuverData my180ManeuverAssaultData
	SpaceshipManeuverData my360ManeuverData
	SpaceshipManeuverData my360ManeuverAssaultData
	BarkData myBarkData
	NPConNPCAttachmentSet* myAttachedNPCsSet
	HuntingSettings myHuntingSettings
	EMInterferenceSettings myEMInterferenceSettings
	ProgressionAttributes myProgressionAttributes < tooltip="Attribute UIDs linked to the progression of the player spaceship" >
	SpaceshipCollisionSettings myCollisionSettings
	SpaceshipDeathSequenceSettings myDeathSequenceSettings
	float myCombatTimeOut 5.0f
	float myMaxCombatDistance 2000.0f < tooltip="Max distance from player for considering enemies for the InCombat player state" >
	string myDodgeSeekingMissilesDistance 1000.0 < tooltip="Range for missile lock deactivation on dodge" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	Factions myImmuneToDamageFactions < tooltip="Factions added here cannot be tagged by player and are immune to damage from player" >
	SpaceshipRestrictions mySpaceshipRestrictions < tooltip="List of restrictions that can be applied" >
	SpaceshipMoveToSettings mySpaceshipMoveToSettings
	SpaceshipAssaultModeSettings mySpaceshipAssaultModeSettings
	IonNebulaSettings myIonNebulaSettings
	PlayerSpaceshipWeaponSettings myPlayerSpaceshipWeaponSettings
