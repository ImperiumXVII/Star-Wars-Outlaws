	uid myHullLargeDamageRumble < bhv="constantData" constantDataType="rumble" >
	uid myEngineDischargeDamageRumble < bhv="constantData" constantDataType="rumble" >
	uid myIonReenablingRumble < bhv="constantData" constantDataType="rumble" >
	uid myIonReenabledRumble < bhv="constantData" constantDataType="rumble" >
	uid myIncreaseSpeedLevelRumble < bhv="constantData" constantDataType="rumble" >
	uid myDecreaseSpeedLevelRumble < bhv="constantData" constantDataType="rumble" >
	uid myYawPitchMaxSpeedRumble < bhv="constantData" constantDataType="rumble" >
	uid myDeathRumble < bhv="constantData" constantDataType="rumble" >
	uid myTurretRumble < bhv="constantData" constantDataType="rumble" >
	uid myCollisionRumble < bhv="constantData" constantDataType="rumble" >
	uid myPreparingHyperDriveRumble < bhv="constantData" constantDataType="rumble" >
