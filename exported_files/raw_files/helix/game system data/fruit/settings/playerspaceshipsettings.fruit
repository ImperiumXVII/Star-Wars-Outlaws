	SpaceshipCameraSettings myCameraSettingsAssault
	SpaceshipInputSettings myInputSettings
	SpaceshipInputSettings myInputSettingsAssault
	SpeedBoostSettingsList mySpeedBoostSettings
	SpeedBoostSettingsList mySpeedBoostSettingsAssault
