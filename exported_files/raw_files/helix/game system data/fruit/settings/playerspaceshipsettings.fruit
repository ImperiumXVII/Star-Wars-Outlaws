class SpaceshipSpeedLevelSettings
{
	float mySpeedValue 0.f
	SpaceshipCameraShakeSettings myCameraShakeSettings
	SpaceshipRumbleSettings myRumbleSettings
}

list SpaceshipSpeedLevelsList
{
	SpaceshipSpeedLevelSettings
}

class SpaceshipFullThrottleSettings
{
	ShakeCameraModifier* myFullThrottleIncreaseSpeedLevelCameraShake < tooltip="Camera Shake when the speed level is increased" >
	ShakeCameraModifier* myFullThrottleDecreaseSpeedLevelCameraShake < tooltip="Camera Shake when the speed level is decreased" >
	uid myFullThrottleIncreaseSpeedLevelRumble < bhv="constantData" constantDataType="rumble" >
	uid myFullThrottleDecreaseSpeedLevelRumble < bhv="constantData" constantDataType="rumble" >
	string myFullThrottleSpeedToAccelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myFullThrottleSpeedToBrakingPowerCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="This curve modifies the braking power based on the ship speed">
}

class SpaceshipSustainedMaxInputModifierSettings
{
	float myCameraOffsetsModifier 1.f
	float myCameraOffsetsModifierIncreaseRate 0.f < tooltip="The speed used to reach the camera offsets modifier value" >
	float myAutoRollModifier 1.f
	float myAutoRollModifierIncreaseRate 0.f < tooltip="The speed used to reach the auto roll modifier value" >
	float myCameraAngularSpeedModifier 1.f
	float myCameraAngularSpeedModifierIncreaseRate 0.f < tooltip="The speed used to reach the camera angular speed modifier value" > 
}

class SpaceshipMouseControlSettings
{
	float myDeadZoneRadiusPercentage 0.2f < bhv="percent" min=0 max=1 tooltip="The percentage of screen height that will make up the diameter of the dead zone for mouse control" >
	float myMaxZoneRadiusPercentage 0.5f < bhv="percent" min=0 max=1 tooltip="The percentage of screen height that will make up the diameter of the max zone for mouse control" >
	float mySensitivityModifier 0.5f < tooltip="Modifier value for the spaceship mouse control." >
	float myFreeLookSensitivityModifier 0.5f < tooltip="Modifier value for the spaceship mouse control during free look." >
}

class SpaceshipInputSettings
{
	SpaceshipSpeedLevelsList mySpeedLevelsList

	float myShipResponsiveness 2.5f < tooltip="Value determining how snappy the ship model is" >
	float myRollInputThreshold 0.7f < tooltip="The value that the roll input needs to exceed to be taken into account when the throttle input exceeds the same value" >
	float myRollInputDeadzone 0.3f < tooltip="The value that the roll input needs to exceed to be taken into account (roll deadzone)" >
	float myShakeAndRumbleYawThreshold 1.51f < tooltip="The value that the yaw speed needs to exceed to trigger rumble and camera shake effect" >
	float myShakeAndRumblePitchThreshold 1.29f < tooltip="The value that the pitch speed needs to exceed to trigger rumble and camera shake effect" >
	float myMaxRollAngle 85.0f < tooltip="Degrees, clamps the vehicle's AutoRoll. 0 to disable" >
	float myAdditionalRollAngle 12.0f < tooltip="Degrees, adds an additional roll movement to the ship while intentionally rolling. 0 to disable" >
	float myAdditionalRollAcceleration 0.5f < tooltip="The acceleration used for the additional roll movement" >

	string myInputCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="This curve modifies the input strength based on the input value">
	string mySpeedToAccelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string mySpeedToBrakingPowerCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="This curve modifies the braking power based on the ship speed">
	string mySpeedToBrakingPowerIonDisable "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="This curve reduces the Trailblazer's speed when is Ion Disabled">

	SpaceshipFullThrottleSettings myFullThrottleSettings < tooltip="Configuration for full throttle (greater acceleration/braking)" >
	
	string myAutoRollYawToRollCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -16.666668 -0.16666667, }, outTangents = { 16.666668 0.16666667, 0 0, }, properties = { 203, 1227, }, values = { 0 0.5, 50 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The AutoRoll strenght based on the current Yaw Angular Velocity">
	string mySpeedToAutoRollModifierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, }, outTangents = { 16.666668 0, }, properties = { 203, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The AutoRoll strenght based on the current Yaw Angular Velocity">
	float myAutoRollSpringConstant 25.f < tooltip="The autoroll spring strength" >
	float myAutoRollSpringDampingRatio 0.5.f < tooltip="The autoroll spring damping" >

	SpaceshipSustainedMaxInputModifierSettings mySustainedMaxInputModifierSettings
	SpaceshipMouseControlSettings myMouseControlSettings

	float myUnlockAccelerationInputThreshold 0.1f < tooltip="When acceleration is locked, the acceleration input needs to go below this threshold for it to unlock" >

	int myControllerNeutralSensitivity 2 < tooltip="Neutral value for the controller sensitivity (right-stick). Should be the same as the value set in useroptionssettings" >
}

class SpaceshipProjectileAvoidanceData
{
	bool myShouldAvoidProjectiles true < tooltip = "Toggles the projectile avoidance functionality">
	float myProjectileAvoidanceDuration 0.f < tooltip = "The duration that the projectiles are getting deactivated if they already are inside or enter the avoidance distance. Set to 0 to happen only once. Can not be longer than the associated maneuver duration" >
}

class SpaceshipDodgeData
{
	string myDodgeTimeToCameraOffset "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The camera offset determined by the progress of the dodge maneuver (from 0 to 100%). Keeping this to 0 Y value will make the camera follow the ship">
	string myDodgeTimeToCameraVerticalOffset "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 0, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The camera offset determined by the progress of the dodge maneuver (from 0 to 100%). Keeping this to 0 Y value will make the camera follow the ship">
	string myDodgeTimeToHorizontalMovement "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The distance from the original horizontal position determined by the progress of the dodge maneuver (from 0 to 100%)">
	string myDodgeTimeToVerticalMovement "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 0, }, }, numKeys = 1, }" < bhv=inputgraph tooltip="The distance from the original horizontal position determined by the progress of the dodge maneuver (from 0 to 100%)">
	string myDodgeTimeToRollAngle "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The ship roll angle determined by the progress of the dodge maneuver (from 0 to 100%)">
	float myDodgeDuration 1 < tooltip="The duration of the dodge maneuver" >
	float myDodgeMovementDuration 0 < tooltip="The duration of the dodge maneuver after which a new dodge can be initiated; 0 means the DodgeDuration setting is used instead" >
	float myDodgeMinimumSpeedModifier 0.15 < tooltip="The minimum value of the speed modifier for the dodge maneuver" >
	float myDodgeMaximumSpeedModifier 1 < tooltip="The maximum value of the speed modifier for the dodge maneuver" >
	ShakeCameraModifier* myDodgeLeftCameraShake < tooltip="Camera Shake when dodging left" >
	ShakeCameraModifier* myDodgeRightCameraShake < tooltip="Camera Shake when dodging right" >
	uid myDodgeLeftRumble < bhv="constantData" constantDataType="rumble" >
	uid myDodgeRightRumble < bhv="constantData" constantDataType="rumble" >
	SpaceshipProjectileAvoidanceData myProjectileAvoidanceData
}

list SpaceshipDodgeDataList
{
	SpaceshipDodgeData
}

class SpaceshipManeuverData
{
	string myPitchInput "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The pitch rotation (from 0 to 100% of the maneuver progress)">
	string myRollInput "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The roll rotation (from 0 to 100% of the maneuver progress)">
	string myForwardInput "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The forward movement (from 0 to 100% of the maneuver progress)">
	string myVerticalInput "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The Up movement (from 0 to 100% of the maneuver progress)">
	string myCameraTargetRightOffset "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys = { inTangents = { -0 -0, -0.602639 -0.038683, }, outTangents = { 0.307335 0.942354, 0 0, }, properties = { -749, -749, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph tooltip="The X Axis offset of the camera \"Look At\" target (from 0 to 100% of the maneuver progress)">
