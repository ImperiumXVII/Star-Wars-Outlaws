	string mySpeedToDamageMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 1, }, }, numKeys = 1, }" < bhv=inputgraph >
	string myDamageToSpeedReductionCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0.001 0, }, outTangents = { 0.001 0, }, properties = { 2051, }, values = { 0 0, }, }, numKeys = 1, }" < bhv=inputgraph >
}

class SpaceshipDeathSequenceSettings
{
	float mySpeedWhileDead 10.f
	float mySpeedTransitionDuration 2.f
	float myInputHandlingModifier 0.5f < bhv=percent >
	float myRollAngle 0.087266f < bhv=angle >
	float myPitchAngle 0.087266f < bhv=angle >
