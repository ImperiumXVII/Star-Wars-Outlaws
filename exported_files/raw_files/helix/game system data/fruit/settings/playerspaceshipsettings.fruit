	PlayerRestriction* myOutOfBoundsRestrictions < tooltip="The actions prevented while the player is OOB" >
	PlayerRestriction* mySpeedBoostRestrictions < tooltip="The actions prevented while the speed boost is active" >
	PlayerRestriction* myOverHeatRestrictions < tooltip="The actions prevented while a spaceship weapon is in overheat" >
	PlayerRestriction* myEMIRestrictions < tooltip="The actions prevented while a spaceship weapon is in EM Interference" >
