include "helix/game system data/fruit/faction/faction.fruit"

class SpaceshipFactionCombatSettings
{
	Faction* myFaction

	int myFleeingThreshold 3
	float myMinTimeBeforeFleeing 30
	float myChanceToFlee 50

	float myChanceToSwarmAttack 100

	float myChanceOfReformingFormationLeaderLoss 100
	float myChanceOfReformingFormationMemberLoss 100

	float myMinTimeBeforeTryingToReform 10
	float myMaxTimeBeforeTryingToReform 20
	float myChanceToReform 100

	int myReinforcementsThreshold 5
	float myReinforcementsCooldown 30
	float myReinforcementsChanceOfCall 30
}

list SpaceshipFactionCombatSettingsList
{
	SpaceshipFactionCombatSettings
}

class SpaceshipFactionCombatSettingsConstantData < uid=auto >
{
	SpaceshipFactionCombatSettingsList mySettingsList
}
