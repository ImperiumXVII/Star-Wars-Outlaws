include "helix/game system data/fruit/combat/combat.fruit"
include "helix/game system data/fruit/player/playeragentstate.fruit"

enum DeathAnimationMode
{
    None
    RagdollOnly
    PlayAnimation
}

enum DeathAnimationModePriority
{
    Lowest
    VeryLow
    Low
    Medium
    High
    VeryHigh
    Highest
}

class DeathContextTransitionData
{
    DeathAnimationMode myAnimationMode < default=PlayAnimation tooltip="It defines the death animation mode. This mode can be get in the animation graph in order to properly handle death animation state flow" >
    PlayerAgentState myAgentState < default=SlidingForced tooltip="It's the agent state for which the death animation mode must be considered" >
    DeathAnimationModePriority myPriority < default=Lowest tooltip="It defines the priority of the transition data. If transition data are concurrent, the last entry in the DeathAnimationMode is considered." >
}

list DeathContextTransitionDataList
{
    DeathContextTransitionData
}
