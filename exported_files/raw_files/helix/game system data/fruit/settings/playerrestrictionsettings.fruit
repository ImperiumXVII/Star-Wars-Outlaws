include "helix/game system data/fruit/restriction/playerrestriction.fruit"

class RestrictionReasonLocLine
{
	PlayerActionRestrictReason myReason
	varmap myLine < bhv="localization" >
}

list RestrictionReasonLocLines
{
	RestrictionReasonLocLine
}

class RestrictionTypeLocLine
{
	PlayerRestrictionTypes myType
	varmap myDefaultLine < bhv="localization" tooltip="If no line with the specific reason is found, this is used" >
	RestrictionReasonLocLines myReasonLocLines < tooltip="Order of this determines which one is used if multiple reasons are restricting the action" >
}

list RestrictionTypeLocLines
{
	RestrictionTypeLocLine
}

class PlayerRestrictionSettings < uid=auto >
{
	RestrictionTypeLocLines myRestrictionTypeLocLines
}
