include "helix/game system data/fruit/animation/gesturetypes.fruit"
include "helix/game system data/fruit/barks/barkscooldown.fruit"
include "helix/game system data/fruit/dialogue/dialogue_ui.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "snowdrop/modules/core/audio/audio.fruit"
include "snowdrop/modules/core/audio/vosettings.fruit"

list TagList
{
	RBTagsTag*
}

list CooldownList
{
	BarksCooldown*
} 

// These enum values are used to select which agent should reply to a bark line.
// This enum needs to be kept in sync with the HC_BarkAgentScope code enum in HC_StimulusConstantData.h
// It is okay to insert new values inside the enum, to change the order of the values (as long as the code and data enums are kept in sync), or to delete values. It is not okay to change the value strings.
enum BarkAgentScope
{
	None
	Self
	Kay
	Nix
	ND5
	Named_Ank
	Named_Asara
	Named_Gedeek
	Named_Riko
	Named_Waka
	Named_DLC2Hondo
	CommsScanner
	HostileTarget
	ClosestAlly
	ClosestHostile
	ClosestPlayer
	QuietestAlly
	QuietestHostile
	QuietestPlayer
	Within10m
	Ally
	Enemy
	FireteamLeader
	FirstInConversation
	LastInConversation
	LastInteracted
	LastPinged
	SortCloser
	SortQuieter
	SortFurther
	NPCHijacked
	Empire
	DifferentFireteam
}

// These enum values are used to select when to trigger a bark's gesture
// This enum needs to be kept in sync with the HC_BarkGestureTriggerType enum in HC_StimulusConstantData.h
// It is okay to insert new values inside the enum, to change the order of the values (as long as the code and data enums are kept in sync), or to delete values. It is not okay to change the value strings.

enum BarkGestureTriggerType
{
	None
	OnStart
	WhileActive
	OnEnd
}

list BarkAgentScopeList
{
	BarkAgentScope
} 

class StimulusIdentifier < uid=auto >
{
}

class StimulusElement
{
	AudioStimulusElement myElement < tooltip="Actual stimulus element asset to be associated with the information set up in this file.\n1/3 parameters that decides the uniqueness of this element.\nTwo stimulus elements with the same element identifier and response is not allowed." >
	CooldownList myCooldowns < tooltip="Cooldowns that this element sets when triggered." >
	AudioEvent myTemplateOverride < tooltip="2/3 parameters that decides the uniqueness of this element.\nTwo stimulus elements with the same element identifier and response is not allowed." >
	GestureType myAnimationGestureType < tooltip="An animation that should play when this bark line is played." >
	BarkGestureTriggerType myAnimationGestureTrigger < tooltip="The moment when the animation should play on the bark" >
	int myWeighting 50 < min=0 max=100 >
	float myDelay 0.3 < tooltip="Delay in seconds between a bark being requested and the event being posted to the emitter." >
	float myPendingTime 0.0 < min=0 max=100 tooltip="The max time in seconds that a bark vocal instance can be pending after being posted on the vocal stack. 0 indicates that there is no pending time." >
	bool myPlayAfterPendingTimeout TRUE
	bool myIgnorePriorityAfterPendingTimeout FALSE
	float myMinDelayAfterQueuing 0.25 < min=0 max=100 tooltip="The min time in seconds that a bark vocal instance can be delayed after being activated from the pending queue of the vocal stack." >
	float myMaxDelayAfterQueuing 0.35 < min=0 max=100 tooltip="The max time in seconds that a bark vocal instance can be delayed after being activated from the pending queue of the vocal stack." >
	float myMinDelayAfterInterruption 0.1 < min=0 max=100 tooltip="The min time in seconds that a bark vocal instance can be delayed to play after interrupting the active vocal instance." >
	float myMaxDelayAfterInterruption 0.2 < min=0 max=100 tooltip="The max time in seconds that a bark vocal instance can be delayed to play after interrupting the active vocal instance." >
	bool myDisable FALSE
	float myResponseDelay 0.3 < tooltip="Delay in seconds between the end of the call bark and the response bark being posted. The value is allowed to be negative." >
	StimulusIdentifier* myResponse < tooltip="3/3 parameters that decides the uniqueness of this element.\nTwo stimulus elements with the same element identifier and response is not allowed." >
}

list StimulusElementList
{
    StimulusElement
}

class StimulusElementContainerAgentRequirements
{
	BarkAgentScopeList myAgentScopes
	TagList myAgentTags
}

class StimulusLookAtRequirements : StimulusElementContainerAgentRequirements
{
	bool myUseFocusPoint false < tooltip="Create a focus point as well (player only)" >
}

list StimulusElementContainerAgentRequirementsList
{
	StimulusElementContainerAgentRequirements
}

class StimulusElementContainer < uid=auto >
{
	StimulusIdentifier* myIdentifier
	CooldownList myCooldowns < tooltip="Cooldowns that this stimulus listenes for." >
	int myTagScoreModifier 0 < min=0 >
	int myProbability 100 < min=0 max=100 >
	float myMaxDistance 80.0 < tooltip="If the agent is further away than this distance, the rule will be skipped. Setting to 0 will skip the distance check." >
	bool myUseDialogueCharacter FALSE < tooltip="If true, this will ignore the agent and will play directly on the dialogue character that is set on agent.">
	DialogueUIElementType myUIElementType 
	VOType* myVOType
	VOPrioritySource myVOPrioritySource Override
	int myVOPriorityOverride 10
	varmap mySubtitlePurpose < bhv = "subtitlepurpose" tooltip="Defines subtitle behaviour for Stimulus Element" >
	TagList myTags
	StimulusElementContainerAgentRequirements myResponseAgentRequirements
	StimulusLookAtRequirements myLookAtAgentRequirements
	StimulusElementContainerAgentRequirementsList myOtherAgentRequirements
	StimulusElementList myElements
}