//Need to match enum in code: HC_BodyPartTypeDefines.h
enum BodyPartType
{
	None
	Head
	Body
	Arms
	Legs
	LOSPosition
	SecondaryLOSPosition
	Shield
	EyePosition
	Tail
	Abdomen
	Weakpoint
}

list BodyPartTypeList
{
	BodyPartType
}

class BodyPart < uid=auto >
{
	string myUIName "Not set"
	color myDebugColor 0x4488ff88
	BodyPartType myBodyPartType None
	float myDamageModifier 1.0
}

list BodyPartList
{
	BodyPart*
}

