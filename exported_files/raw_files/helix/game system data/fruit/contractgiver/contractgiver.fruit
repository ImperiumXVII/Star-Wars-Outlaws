include "helix/game system data/fruit/contract/contract.fruit"
include "helix/game system data/fruit/mapref/mapref.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "helix/game system data/fruit/reputation/reputation.fruit"

class ContractGiverUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" >
}

class ContractGiverSlot
{
	Contract* myInitialContract
	ReputationTier myMinReputationTierForGeneration Terrible
	ReputationTier myMaxReputationTierForGeneration Excellent
	float mySlotCooldown 0.0 < min = 0 tooltip = "Contract Slot cooldown time before it activates again (seconds)" >
}

list ContractGiverSlots
{
	ContractGiverSlot
}

class ContractGiver < uid=auto >
{
	uid myGalaxyLocation < bhv="constantData" constantDataType="galaxylocation" >
	ContractGiverUIInfo myUIInfo
	Factions myAffiliatedFactions
	bool myIsContrabandContractGiver < tooltip="Set to true if you want this npc only to give contraband contract and also special rules to be applied when forming pool of possible contracts" >
	MapRef* myMapRef
	ContractGiverSlots mySlots
	RBTagsTag* myGiverOutOfJobsTag < tooltip="Set RBTag for giver to indicate that it doesn't have jobs right now" >
	int myFamiliarContractCount 5 < tooltip="Number of contracts Completed/Failed in order for the contract giver to become familiar" >
	RBTagsTag* myFamiliarTag < tooltip="This RBTag will be triggered when the contract giver becomes familiar" >
	RBTagsTag* myRecentlyBetrayedTag < tooltip="This RBTag will be triggered when the contract giver was recently betrayed during a choice moment" >
	ReputationTier myLowReputationTier Terrible
	RBTagsTag* myLowReputationTag < tooltip="This RBTag will be triggered when you have reputation equal or lower than LowReputationTier with the giver's faction" >
}