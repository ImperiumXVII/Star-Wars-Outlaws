
enum ShieldType
{
	Mono
	FrontBack
}

class EnergyShieldData
{
	string myMaxValue 100 < tooltip="The full Shield Value" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myRegenerationCooldown 10 < tooltip="How long(seconds) it take for the shield to start regenerating since last taking damage" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myRegenerationRate 1 < tooltip="How much the shield regenerates every second" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myModeSwitchRegenerationCooldown 1 < tooltip="Regeneration cooldown after doing a mode switch" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myModeSwitchRegenerationDuration 1 < tooltip="Duration for applying a special regeneration rate(myModeSwitchRegenerationRate), after doing a mode switch" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myModeSwitchRegenerationRate 1 < tooltip="Special rate applied right after switching the mode to recon, for a custom duration(myModeSwitchRegenerationDuration)" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	string myShieldPerSegmentFormula 10.0 < tooltip="This amount is used to handle Shield in segments. The amount of segments will be given by MaxHealth/ShieldPerSegment. If you do not want to use segments, this amount should be equal to MaxShield." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myEMInterferenceRegenerationModifier 1.f < tooltip="Modifier on the regeneration rate for when the spaceship is inside a nebula volume" >
	ShieldType myShieldType Mono  < tooltip="The shield type. Mono is your basic shield" >
	bool myCanRegenerateWhenDepleted false < tooltip="Whether the shield can regenerted or not. It can't regenerate after it hits 0." >
	string myShieldInvulnerabilityDuration 2 < tooltip="How long(seconds) is the shield invulnerable after regenerating" bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	bool myIsRegeneratingInAssaultMode true < tooltip="If this is set to false, the spaceship(Rokana) won't recharge during assault mode, unless it is inside an ion nebula" >
	bool myIsRegeneratedByIonNebulas false < tooltip="If enabled, the shield will always regenerate while inside the ion nebula" >
	float myIonNebulaRegenerationCooldownBonus 0.0 < tooltip="Flat value added to the regeneration cooldown computed in the formula above" >
	float myIonNebulaRegenerationRateBonus 0.0 < tooltip="Flat value added to the regeneration rate computed in the formula above" >
}