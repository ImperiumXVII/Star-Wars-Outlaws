class CameraLensPreset < uid=auto >
{
	float myDefaultAperture 16.0  < min=1.4 max=22.0 tooltip="Lens aperture. Physical property impacting the amount of light that is allowed to enter the lens. Impacts DoF, vignette, the size (and shape) of the lens flares." >
	float myDefaultFocalLength 35.0 < min=17.0 max=600.0 tooltip="Physical property of the lens impacting the view angle (FoV) as well as the distortion level. Smaller value is MORE FoV and more distortion, Larger value is LESS FoV and less distortion. The value should fall within the focal length limits of the loaded lens and should be unique for a prime (non-zoom) lens. Between 17.0 and 600.0" >
	float myDefaultFocusDistance 5.0 < min=0.2 tooltip="Camera focus position. The distance to an imaginary point in the direction of the camera, inside the frame, where the lens is focusing." >
	
	file myCameraLensObject "" < bhv=asset assettype="Camera Lens" >
}