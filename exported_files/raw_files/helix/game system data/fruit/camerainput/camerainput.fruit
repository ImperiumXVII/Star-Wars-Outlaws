include "snowdrop/modules/core/input/input.fruit"

class GyroAimSettings
{
	bool myIsEnabled false
	string myHorizontalInputRemapCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.019503921 -0.0063766981, -0.053516336 -0.10635515, -0.48672092 -0.010217309, }, outTangents = { 0.0099999998 0.0066666668, 0.17138323 0.056032792, 0.14340396 0.28499243, 0 0, }, properties = { 3275, 4371, 5395, 1299, }, values = { 0 0, 0.029999999 0.02, 0.29361349 0.40838698, 1 1, }, }, numKeys = 4, }"  < bhv=inputgraph tooltip="Remaps the gyro aim's horizontal input. The range of the x-axis and y-axis are 0 to 1. Values near 0 means gyro movements with small delta, values near 1 gyro movements with big delta." >
	string myVerticalInputRemapCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 0, -0.019503921 -0.0063766981, -0.053516336 -0.10635515, -0.48672092 -0.010217309, }, outTangents = { 0.0099999998 0.0066666668, 0.17138323 0.056032792, 0.14340396 0.28499243, 0 0, }, properties = { 3275, 4371, 5395, 1299, }, values = { 0 0, 0.029999999 0.02, 0.29361349 0.40838698, 1 1, }, }, numKeys = 4, }"  < bhv=inputgraph tooltip="Remaps the gyro aim's vertical input. The range of the x-axis and y-axis are 0 to 1. Values near 0 means gyro movements with small delta, values near 1 gyro movements with big delta." >
	float myDeveloperSensitivity 2.5 < min=1 tooltip="Tweaking this value will change the sensitivity of the gyro aim. It will be the base sensitivity, then on top of that the player will apply their own sensitivity in the settings menu." >
	string myPlayerSensitivityMultiplierCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, 0 -2.8710003, }, outTangents = { 1.0843303 1.6359609, 0 0, }, properties = { 6419, 7443, }, values = { 0 0.1, 1 10, }, }, numKeys = 2, }"  < bhv=inputgraph tooltip="The multiplier curve that will be applied to the gyro aim's sensitivity by the slider in the player settings." >
	vec2f myPlayerSmoothingMultiplierRange 0.0;1.0 < tooltip="The min and max multiplier that will be applied to the gyro aim's smoothing by the slider in the player settings." >
	vec2f myPlayerHorizontalBoostRange 1.0;3.0 < tooltip="The min and max multiplier that will be applied to the gyro aim's horizontal boost by the gyro aim's horizontal boost slider in the player settings. Do not change if you don't understand the save game implications." >
	float myMaxSpeed 7.0 < min=0 tooltip="The speed we consider to be the max gyro speed the player is likely to input. Values above this speed will be clamped before we run the input through the remap curves." >
}

class CameraInput < uid=auto >
{
	float myMaxYawAcceleration 0.07f
	float myMaxYawVelocity 0.1f
	
	float myMaxPitchAcceleration 0.03f
	float myMaxPitchVelocity 0.05f
	
	float myDecelerationTime 0.25f
	string myDecelerationCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.420993 0.814721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
			
	InputAxisSensitivity mySensitivityX
	InputAxisSensitivity mySensitivityY
	
	bool myUseSynchedInputAxes FALSE
	string myAxisSynchedInputScaleCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.279596 -0.80000001, }, outTangents = { 0.60000002 0, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
	string myAxisSynchedInputRemapCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -30 -30, -5 0, }, outTangents = { 15 0, 30 30, 0 -0, }, properties = { 275, 2323, 1299, }, values = { 0 0, 45 45, 90 90, }, }, numKeys = 3, }" < bhv=inputgraph >
	string myAxisSynchedAccelerationCurve "{ numKeys = 2, interpolator = 0, defaultValue = 0, defaultLeftSlope = 0, keys = { properties = { -749, -749, }, values = { 0 0, 1 1, }, inTangents = { -0 -0, -0.279596 -0.1, }, outTangents = { 0.5 0.0, 0 0, }, }, defaultRightSlope = 0, }" < bhv=inputgraph >
	float myAxisSynchedAccelerationTime 1.0f < min=0.01f >
	float myAxisSynchedMaxSpeed 0.0f

    float myMouseSensitivityMultiplier 1.0f

    float myTurnSpeedCapX 0.0f
    float myTurnSpeedCapY 0.0f

	GyroAimSettings myGyroAimSettings
}