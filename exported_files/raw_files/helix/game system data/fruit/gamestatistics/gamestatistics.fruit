include "helix/game system data/fruit/gamevalues/gamevalues.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"

// Keep in sync with HC_GameTriggerType
enum GameTriggerType
{
	Manual // jmlp: Keep first
	AgentDamagedByAgent
	AgentKilledByAgent
	ContractStateChanged
	GameStatisticChanged
	InteractionPerformed
	LegendPointsChanged
	ReputationChanged
	WantedStateChanged
	PlayerSpeederSpeedChanged
	PlayerSpeederLanded
	PlayerSpeederLandedWithType
	PlayerSpeederExecutedPowerslideDrift
	DialogueChoice
	PlayerGearSetChanged
	PlayerHealthChanged
	PlayerEnteredCombat
	PlayerExitedCombat
	PlayerGrappleSwingSpeedChanged
	PlayerGrappleEnded
	PlayerDodgedSeekingMissile
	InteractionRequiredMinigameResult
	RewardReceived
	PetPromptCompleted
	ItemAdded
	VendorFirstTimeInteraction
	VendorTransactionCompleted
	PlayerSpentCurrencyAtVendor
	SabaccGameCompleted
	AlienStreetFoodCompleted
	QuestCompleted
	PlayerProjectileHitStreakChanged
	FathierRaceCompleted
	ArcadeGameCompleted
	SpaceshipGearChangedSpace
	IntelCompleted
	AdrenalineRushCrackShotStarted
	AdrenalineRushFinished
	UpgradeTierTalentApplied
	GalaxyLocationDiscovered
	PlayerSpentCurrencyAtVendorBuyBack
	PlayerEquippedGearChanged
}

// Keep in sync with HC_GameStatisticOperation
enum GameStatisticOperation
{
	IncrementOnce
	DecrementOnce
	Increment
	Decrement
	SetIfGreater
	Reset
	CountConditionsTrue
}

list GameStatisticConditionList
{
	GameCondition
}

class GameStatisticEventBlock
{
	GameTriggerType myGameTriggerType Manual
	GameStatisticOperation myGameStatisticOperation Increment < Tooltip="The operation performed on the statistic if the conditions are true" >
	GameStatisticConditionList myConditions
}

list GameStatisticEventBlockList
{
	GameStatisticEventBlock
}

class GameStatistic < uid=auto >
{
	bool myIsDefaultEnabled TRUE < hidden=1 >
	
	bool myIncrementOncePerTrigger FALSE < tooltip="If true, the statistic will increment only once every time the game trigger happens, instead of using the value associated with it." >

	GameStatisticGameValue myGameValue < init_set=1 hidden=1 >
	GameStatisticEventBlockList myEventBlocks
	
	varmap myUIDescription < bhv="localization" tooltip="Description of the statistic for UI Purposes." ui_info=1 referenced_by_code=1 >
}

class DomainAbilityStatistic : GameStatistic
{
	bool myIsDefaultEnabled FALSE < hidden=0 >
}

class TrackableActionStatistic : GameStatistic
{
	bool myIsDefaultEnabled TRUE < hidden=1 >

	bool myIncrementOncePerTrigger TRUE < hidden=1 tooltip="If true, the statistic will increment only once every time the game trigger happens, instead of using the value associated with it." >

	GameStatisticGameValue myGameValue < hidden=1 init_set=1 >
	GameStatisticEventBlockList myEventBlocks

	varmap myUIDescription < hidden=1 bhv="localization" tooltip="Description of the statistic for UI Purposes." ui_info=1 referenced_by_code=1 >
}

class GameConditionGameStatistic : GameCondition
{
	GameConditionType myType GameStatistic < hidden=1 >

	GameStatistic* myGameStatistic
	int myTargetValue 1
	GameConditionOperator myOperator GreaterThanOrEqual
}

class GameConditionContextHasGameStatistic : GameCondition
{
	GameConditionType myType ContextHasGameStatistic < hidden=1 >

	GameStatistic* myGameStatistic
}

list GameStatisticsList
{
	GameStatistic*
}

class GameConditionContextIsOneOfGameStatistics : GameCondition
{
	GameConditionType myType ContextIsOneOfGameStatistics < hidden=1 >
	GameStatisticsList myGameStatisticsList < tooltip="Condition is true if the game statistic changed is in the list." >
}