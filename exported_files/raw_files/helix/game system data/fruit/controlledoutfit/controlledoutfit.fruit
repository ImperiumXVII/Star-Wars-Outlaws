include "helix/game system data/fruit/equipment/equipment_set.fruit"

//Keep in sync with enum ControlledOutfitAnimationState in HC_ControlledOutfitConstantData.h
enum ControlledOutfitAnimationState
{
	Default
	StormTrooper
	RokanaRaider
}

enum SlotOverrideType
{
	Equipment
	Visuals
	EquipmentAndVisuals
}

class ControlledOutfitSlotInfo
{
	EquipmentSlotGroupType myGroup Unassigned
	EquipmentSlotTag myTag Main
	SlotOverrideType mySlotOverrideType EquipmentAndVisuals < tooltip="Decides what parts of the equipment slot will be overridden." >
}

list ControlledOutfitSlotInfoList
{
	ControlledOutfitSlotInfo
}

list RemoveConsumableItemUIDs
{
	uid < bhv="constantData" constantDataType="item" subTypeFilter="CurrencyItem">
}

class ControlledOutfit < uid=auto >
{
	EquipmentSet* myEquipmentSet
	ControlledOutfitSlotInfoList mySlotOverrides < tooltip="SlotGroups present in this list will retain the gear equiped from the original gearset." >
	bool myShouldUnlockBlasterMenu false < tooltip="If set to true it will allow you to access the menu to change blaster modules while in this controlled outfit" >
	ControlledOutfitAnimationState myAnimationState Default < tooltip="Used in animation system to know if the outfit needs special animations">
	RemoveConsumableItemUIDs myConsumableItemsToRemove
	bool myShouldRemoveSliceKit false < tooltip="If set to true it will remove the slice kit item from the inventory. Can be given back the same way as other removed equipment items, and will also be given back when the outfit is removed." >
}
