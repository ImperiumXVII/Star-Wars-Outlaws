class LegendRankUIInfo < ui_info=1 >
{
	varmap myName < bhv="localization" ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" >
}

class LegendRank < uid=auto >
{
	LegendRankUIInfo myUIInfo
	int myMaxLegendPoints 0
	uid myReward < bhv="constantData" constantDataType="reward" >
}