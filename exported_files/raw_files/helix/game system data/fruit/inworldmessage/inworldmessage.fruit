include "helix/game system data/fruit/ui/uienums.fruit"

class InWorldMessage < uid=auto >
{
	varmap myHeader < bhv="localization" ui_info_debug_ui_name=1 >
	varmap myDescription < bhv="localization" >
	file myImage < bhv="asset" assettype="texture" >
	file myUIGraph "helix/ui/Graphs/hud_in_world_message.muigraph" < bhv="asset" assettype="GUI" >
}

class InWorldMessageFixedFathierRace : InWorldMessage
{	
	uid myFaction < bhv="constantData" constantDataType="faction" tooltip="Used by the fathier races system to know which message to chose.">
}

class Sign
{
	UICardinalDirection myCardinalDirection
	uid myLocation < bhv="constantData" constantDataType="uilocalizedlocation" >
}

list SignList
{
	Sign
}

class InWorldMessageSignPost : InWorldMessage
{
	varmap myHeader < hidden=1 >
	varmap myDescription < hidden=1 >
	file myImage < hidden=1 >
	file myUIGraph "helix/ui/Graphs/hud_in_world_message_signpost.muigraph" < bhv="asset" assettype="GUI" >

	SignList mySigns
}