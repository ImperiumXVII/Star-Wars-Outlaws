include "helix/game system data/fruit/effects/effects.fruit"
include "helix/game system data/fruit/effects/fluffy.fruit"

enum ImpactValueType
{
	Constant
	Speed
}

class ImpactRealizationOnFragmentables
{
	ImpactValueType myEnvironmentalDamageValueType Constant < tooltip = "If the type is Speed, then EnvironmentalDamage will be multiplied by the imapct speed" >
	float myEnvironmentalDamage 100.0
	float myEnvironmentalDamageVariation 15.0
	string myEnvironmentalDamageTags < tooltip = "list of destruction damage tags, separated by colon (;)" >
	bool myBulletImpact true
	bool myExplosionReaction false
	float myExplosionReactionRadius 1.0 < tooltip = "Explosion reaction radius ONLY on the object that receives the impact; basically the radius of the area affected by the explosion reaction" >
}

class ImpactRealizationOnPhyisics
{
	ImpactValueType myEnergyValueType Constant < tooltip = "If the type is Speed, then ImpactEnergy will be multiplied by the imapct speed" >
	float myImpactEnergy 1.0 < tooltip = "This value will be multiplied by the mass of the object to trigger a physic object reaction" >
}

class ImpactRealizationBendShockwave
{
	float myBendStrength 1.0 < min=0.0 max=50.0 >
	float myTrampleStrength 1.0 < min=0.0 max=50.0 >
	float myVelocity 5.0 < min=0.0 max=50.0 >
	float myWidth 1.0 < min=0.0 max=50.0 >
	float myRadius 1.0 < min=0.0 max=50.0 >
}

class ImpactRealizationOnWater
{
	bool mySplashAddSurface true
	float mySplashStrength 1.f
	float mySplashSize 0.25f
	bool mySplashAddFoam true
	float mySplashFoamStrength 0.5f
}

class ImpactRealizationOnFluffy
{
	FluffyDeformation myDeformation < tooltip = "Deformation is a simple cilinder shape applied to the fluffy surface" >
	bool myDecalEnabled false
	FluffyDecal myDecal < tooltip = "The fluffy decal accepts textures to define a more fine but expensive deformation isntead of the simple cylinder deformation" >
}

class ImpactRealization < uid=auto >
{
	bool myImpactSpeedThresholdEnabled false < tooltip = "If true, the impact speed needs to be higher than the threshold to trigger the impact realization" >
	float myImpactSpeedThreshold 1.0
	
	EffectsByMaterials myEffects
	
	bool myImpactOnFragmentablesEnabled false
	ImpactRealizationOnFragmentables myFragmentables < tooltip = "This defines how the impact will affect fragmentable graph objects that implement the destruction system" >
	
	bool myImpactOnPhysicsEnabled false
	ImpactRealizationOnPhyisics myPhysics < tooltip = "This adds a physical push reaction against the object receives the imapct if it is a physic dynamic object" >
	
	bool myImpactOnBendShockwaveEnabled false
	ImpactRealizationBendShockwave myBendShockwave < tooltip = "This adds a bend shockwave (used primarily to bend the greass)" >
	
	bool myImpactOnWaterEnabled false
	ImpactRealizationOnWater myWater
	
	bool myImpactOnFluffy false
	ImpactRealizationOnFluffy myFluffy < tooltip = "This defines how the impact affects fluffy/deformable terrain (i.e. sand, snow...)" >

	bool myOverrideStaggerValue false < tooltip = "If true, the victim of the imapct will apply this stagger value instead of the normal one" >
	float myOverridenStaggerValue 0.f
	
	bool myOverrideStaggerDuration false < tooltip = "If true, the victim of the imapct will apply this stagger duration instead of the normal one. IMPORTANT: If you change this value remeber to also change OverriddenStaggerDisplacement to keep the speed consistent." >
	float myOverriddenStaggerDuration 0.f
	
	bool myOverrideStaggerDisplacement false < tooltip = "If true, the victim of the imapct will apply this stagger displacement distance instead of the normal one. IMPORTANT: If you change this value remeber to also change OverriddenStaggerDuration to keep the speed consistent." >
	float myOverriddenStaggerDisplacement 0.f
}
