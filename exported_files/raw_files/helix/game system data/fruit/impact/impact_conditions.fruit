include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/bodypart/bodypart.fruit"
include "snowdrop/modules/core/physics/collisionmaterials.fruit"

class GameConditionImpact < abstract=1 > : GameCondition
{

}

list GameConditionImpactList
{
	GameConditionImpact
	GameConditionImpactGroup
	GameConditionTimeOfDay
	GameConditionRandom
	GameConditionFormula
	GameConditionContextAgentHasFaction
	GameConditionContextAgentHasStatusEffect
	GameConditionContextAgentIsSpaceship
	GameConditionContextAgentIsSpecies
	GameConditionContextAgentIsNPC
	GameConditionContextAgentIsPlayer
	GameConditionContextAgentIsPlayerPet
	GameConditionContextAgentIsPlayerSpeeder
	GameConditionContextAgentIsSpecificNPC
	GameConditionContextAgentIsSpecificSpaceshipType
	GameConditionContextContextAgentIsVehicle
	GameConditionContextAgentHasCombatRole
	GameConditionContextAgentIsAlive
	GameConditionContextAgentIsInEMInterferenceVolume
	GameConditionContextAgentHasItemEquipped
}

class GameConditionImpactGroup : GameConditionGroupBase
{
	GameConditionImpactList myConditions
}

class GameConditionImpactHitBodyPart : GameConditionImpact
{
	GameConditionType myType ImpactHitBodyPart < hidden=1 >

	BodyPartType myBodyPartType None
}

class GameConditionImpactWaterLevel : GameConditionImpact
{
	GameConditionType myType ImpactWaterLevel < hidden=1 >

	float myLevel 0.0 < min=0.0 >
	GameConditionOperator myOperator GreaterThan
}

class GameConditionImpactWaterDepth : GameConditionImpact
{
	GameConditionType myType ImpactWaterDepth < hidden=1 >

	float myDepth 0.0 < min=0.0 >
	GameConditionOperator myOperator GreaterThan
}

class GameConditionImpactMaterial : GameConditionImpact
{
	GameConditionType myType ImpactMaterial < hidden=1 >

	CollisionMaterial* myMaterial
}

class GameConditionImpactIsFatal : GameConditionImpact
{
	GameConditionType myType ImpactIsFatal < hidden=1 >
}
