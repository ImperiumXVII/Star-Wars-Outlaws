//NOTE: the first value is returned by default when
//no other moment information is specified in a sequence
enum SequenceMoment
{
	None
	
	Intro
	Idle
	Breaker
	Main
	Post
	Outro
	OneShot
	AtAttention_Intro
	AtAttention_Idle
	AtAttention_Outro
	MACAP_INTERACTION	
	MACAP_RELEASE
	TO_DIALOGUE
	DIALOGUE_IDLE
	TO_IDLE
	TO_POST
	Post_To_Idle
	UNUSED
}