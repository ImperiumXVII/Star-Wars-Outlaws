include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/input/rumble.fruit"
include "helix/game system data/fruit/player/playeragentstate.fruit"

class CameraShakeByPlayerState
{
	ShakeCameraModifier* myCameraShake
	PlayerAgentState myPlayerAgentState
}

list CameraShakeByPlayerStateList
{
	CameraShakeByPlayerState
}

class PlayerImpactFeedback
{
	ShakeCameraModifier* myDefaultCameraShake
	CameraShakeByPlayerStateList myCameraShakesByPlayerState
	uid myRumble < bhv="constantData" constantDataType="rumble" >
}

class PlayerImpactFeedbackConfig
{
	PlayerImpactFeedback myBaseFeedback
	float myLargeDamageThreshold 2.0
	PlayerImpactFeedback myLargeDamageFeedback
	float myTime 1.0 < tooltip="We need to wait this amopunt of time to process a new feedback once ahs been triggered (unless the new one has more priority)" >
}
