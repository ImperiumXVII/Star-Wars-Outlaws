include "helix/game system data/fruit/achievement/achievement.fruit"

class SCETrophyGroup < uid=auto >
{
	string myGroupNumber "" < tooltip="The group number value taken from UDS Management portal for this specific Trophy Group. E.g 0000 for baseGameGroup" >	
	string myTrophyGroupObjectId "" < tooltip="The groups object id value taken from UDS Management portal for this specific Trophy Group. E.g _baseGameGroup" >
	varmap myLocalizedGroupName	< bhv="localization" >
	ReleaseGroup myReleaseGroup < tooltip="Assign the in-engine ReleaseGroup value to this trophy group" >
}