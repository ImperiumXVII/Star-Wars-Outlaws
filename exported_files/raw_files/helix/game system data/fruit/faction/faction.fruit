include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "helix/game system data/fruit/gamevalues/gamevalues.fruit"

class Faction < uid=auto >
{
	bool myIsHiddenInEditor FALSE < tooltip="Hides the faction in the editor." >

	varmap myUIName < bhv="localization" >
	varmap myUIQuestIntroBeatName < bhv="localization" tooltip="What will be shown in the journal when a quest for this faction is still in its intro beat">
	string myUIIconInner < bhv="sprite" tooltip="Inner part of glowing icon." >
	string myUIIconOuter < bhv="sprite" tooltip="Outer part of glowing icon." >
	string myUIIconNPC < bhv="sprite" tooltip="Solid NPC faction icon" >
	uid myUIColor < bhv="color" >
	file myUIIconGraphObjectFile < bhv=asset assettype=object >

	RBTagsTag* myFactionTag
	
	uid myLeader < bhv="constantData" constantDataType="npc" tooltip="Used for reputation UI menu" >
	uid myReplacingLeader < bhv="constantData" constantDataType="npc" tooltip="Used for reputation UI menu when the faction switches leader for story reasons" >
	FactionLeaderActiveGameValue myIsReplacingLeaderActive < can_be_set=1 tooltip="Used if a replacing leader is set to see if it should be active" >
	uid myDefaultQuestMapRefData < bhv="constantData" constantDataType="mapref" tooltip="[Optional] Map ref data used for quests tied to this faction." >
}

list Factions
{
	Faction*
}

// This enum needs to be kept in sync with the HC_FactionRelation enum in code/helix/HClient/HC_FactionRelation.h
enum FactionRelation
{
	Friendly					// An agent will not be aggressive towards a Friendly agent.
	Neutral						// An NPC won't go into combat with a Neutral agent. A player can harm a Neutral or higher agent.
	Suspicious					// An NPC will try to arrest (or some other similar non-combat reaction) a Suspicious agent when it detects them.
	Aggressive					// An NPC will immediately go into combat with an Aggressive agent when it detects them.
	WantedFactionRelation		// The relationship between the Player and another agent is dependent on the Player's Wanted level.
	PlayerReputationRelation	// The relationship between the Player and another agent is dependent on the Player's Reputation level with that faction.
}

list FactionRelationList
{
	FactionRelation
}

class FactionRelationEntry
{
	Faction* myFaction
	FactionRelation myRelation
}

list FactionRelationEntryList
{
	FactionRelationEntry
}

class FactionRelations < uid=auto >
{
	Faction* myFaction
	FactionRelationEntryList myFactionRelations
}