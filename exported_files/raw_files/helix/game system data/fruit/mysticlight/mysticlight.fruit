class Event
{
	string myMysticLightName	// This name needs to be sent to MSI!
	int myPriority	// Highest value is the one gets shown. If multiple events has the same priority then the last-in-the-list event get shown. Not needed to be sent to MSI.
}

list EventList
{
	Event
}

class TriggerEvent
{
	string myMysticLightName	// This name needs to be sent to MSI!
	int myDurationInMilliseconds 	// This duration is not something we has control over. You need to ask MSI how long the animation of the trigger event is and put it here.
}

list TriggerEventList
{
	TriggerEvent
}

class Hotkey
{
	string myActionName	// This name is the of the game action. Not the key it is mapped to.
	color myColor
}

list HotkeyList
{
	Hotkey
}

class StatusBar
{
	string myMysticLightName	// This name needs to be sent to MSI togheteher with all StatusBarEffects that will be used with this status bar!
}

list StatusBarList
{
	StatusBar
}

class StatusBarEffect
{
	string myMysticLightName	// This name needs to be sent to MSI together with the associating color!
	color myColor	// This color needs to be sent to MSI together with the associating Mystic Light name!
}

list StatusBarEffectList
{
	StatusBarEffect
}

class Settings
{
	string myGameName	// This name needs to be sent to MSI
	int myAppId	< min=0, max=65535, default=0 >	// This is provided by MSI. MSI usually send you the ID as two halfs as separate numbers, so if you don't want to stitch the numbers together yourself use the myAppIdFirstPart and myAppIdSecondPart instead and set this to zero.
	int myAppIdFirstPart	< min=0, max=255, default=0 >	// This is provided by MSI.
	int myAppIdSecondPart	< min=0, max=255, default=0 >	// This is provided by MSI.
	EventList myEvents
	TriggerEventList myTriggerEvents
	HotkeyList myHotkeys
	StatusBarList myStatusBars
	StatusBarEffectList myStatusBarEffects
}