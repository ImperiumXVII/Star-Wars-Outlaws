//keep in sync with HC_QuestType in HC_QuestType.h
enum QuestType
{
	Main
	SeasonPassExclusive
	Expert
	Faction
	Hidden
	TrailblazerPuzzle
	Contract
	ArtifactLocation
	ImperialCompound
	Event
	PetTrail
	ScoundrelLegacy
	Sabacc
	Encounter
}

//keep in sync with State in HC_Quest.h
enum QuestState
{
	None
	Reveal
	Intro
	Started
	Failed
	Outro
	Completed
}

//keep in sync with State in HC_QuestBeat.h
enum QuestBeatState
{
	None
	Started
	Failed
	Completed
	Limbo
}

//keep in sync with HC_QuestBeatMood in HC_QuestBeatMood.h
//the order is important, since its used for sorting beats "importance". Higher is better
enum QuestBeatMood
{
	RelaxedNoSpawnpoints
	Relaxed
	Focused
}

//keep in sync with HC_QuestToastUIDisplayMode in HC_QuestToastUIDisplayMode.h
enum QuestToastUIDisplayMode
{
	All
	None
	OnlyStart
	OnlyFinish
}