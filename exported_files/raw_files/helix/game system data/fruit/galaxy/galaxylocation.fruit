include "helix/game system data/fruit/gamevalues/gamevalues.fruit" 
include "helix/game system data/fruit/reputation/reputation.fruit"
include "snowdrop/modules/core/audio/audio.fruit"

// keep in sync with HC_GalaxyLocationType
enum GalaxyLocationType
{
	Surface
	Region
	City
	Settlement
	Area
	Orbit
	SpaceStation
	Territory
	District
	Cantina
}

// keep in sync with HC_GalaxyLocationUnlockState
enum GalaxyLocationUnlockState
{
	Locked
	Unlocked
}

list GalaxyLocationTypeList
{
	GalaxyLocationType
}

class GalaxyLocationFogOfWarSettings
{
	bool myIsEnabled false
	float myDistancePerCell 10
	int myCellsPerStep 16
	float myDistanceBetweenReveal 10
	float myRevealRadius 20
}

list GalaxyMapGateList
{
	GalaxyMapGate
}

class GalaxyMapGate
{
	uid myGalaxyLocation < bhv="constantData" constantDataType="galaxylocation" >
	vec3f myPosition < tooltip="In world XYZ coordinates - determines where the map gate is shown on the UI map of the parent location. Y will be raycasted if 0." >
	float myRadius 80.0 < tooltip="In real world size (m) - determines the size of the map gate when shown on the UI map of the parent location." >
}

class Icon
{
	vec3f myPosition < tooltip="In world XYZ coordinates - determines where the icon will be placed" >
	float myRotation 0 < bhv="degree_angle" tooltip="Determines how much the icon will be rotated" >
	string mySprite < bhv="sprite" tooltip="Sprite for icon" >
}

list Icons
{
	Icon
}

class GalaxyLocationUIMapSettings
{
	bool myIsEnabled FALSE < tooltip="Does this location have a UI map representation or not. If false, the parent map is shown instead." >
	bool myIsHidden FALSE < tooltip="If true, this location does not show up on the UI map, but can still post notifications" >
	bool myIsTemporary FALSE < tooltip="If true, this locations only shows while the player is inside of it. " >
	bool myShowOnParent FALSE < tooltip="Is this location physically present on the parent map (a smooth camera transition can be used instead of a fade to black.)" >
	file myGraphObject < bhv=asset assettype="Object" tooltip="Mesh representation of the map." >
	int myMapModelScaleDown 1 < min=1 tooltip="Scale by which the map model is scaled down" > 
	vec3f myBoundsMin < tooltip="Map bounds min" >
	vec3f myBoundsMax < tooltip="Map bounds max" >
	GalaxyLocationFogOfWarSettings myFogOfWarSettings
	uid myZoomSettings <  bhv="constantData" constantDataType="uimapzoomsettings" tooltip="Zoom settings to apply in the UI map" >
	file myMapEnvironmentPreset < bhv=asset assettype="Environment" >
	bool myMapRenderFog FALSE
	GalaxyMapGateList myMapGates < tooltip="List of other galaxy location maps accessible on the UI map of the parent location." >
	vec3f myDummyMapRefPositionOnParent < tooltip="For map refs, if the map is disabled or displayed on top of parent location, where is the map ref placed in parent coordinates?" >
	vec3f myDummyPositionOnParent < tooltip="For camera, if the map is disabled or displayed on top of parent location, where are we looking at in parent coordinates? XZ for offset, Y for camera distance." >
	float myDummyViewAngleOnParent 0.0 < min=0.0 max=90.0 tooltip="At what angle to we look at the parent map if this map is showing on top of the parent? 0 = straight down" >
	vec3f myLabelOffset < tooltip="Offset for the name label shown at the center of this location's volume, when looking at the parent." >
	Icons myCustomIcons < tooltip="Custom Icons that can be used to highlight things not necessarilly placed in the level" >
}

class GalaxyLocation < uid=auto >
{
	GalaxyLocationType myType
	uid myLocalizedLocation < bhv="constantData" constantDataType="uilocalizedlocation" >
	uid myLevelInfo < bhv="constantData" constantDataType="levelinfo" tooltip="The level/map this galaxy location belongs to" >
	file mySaveGameTexture < tooltip="Background image of the location used for save games." bhv=asset assettype="texture" >	
	file myGraphicalTexture < tooltip="Graphical representation of the location that uses simple lines and shapes." bhv=asset assettype="texture" >	
	GalaxyLocationUnlockedGameValue myUnlockedValue < init_set=1 tooltip="Whether this location is default unlocked for gameplay/progression systems, e.g. can we hyperjump or land here?" >
	GalaxyLocationDiscoveredGameValue myDiscoveredValue < init_set=1 tooltip="Whether this location is discovered (name is known and visible on maps)." >
	GalaxyLocationDiscoveredGameValue myVisitedValue < init_set=1 >
	bool myUseForGuidance true
	bool myShouldPostLocationEvent true
	bool myShouldPostLocationEventOnceOnly false
	bool myIsOpportunityLocation false
	bool myIsScannable true < tooltip="If set, the location can be identified using the space scanner" >
	uid myMainLandingZone < bhv="constantData" constantDataType="landingzone" tooltip="Landing zone to fast travel to by default for this location." >
	uid myVariantShipMainLandingZone < bhv="constantData" constantDataType="landingzone" tooltip="Landing zone to fast travel to by default when in Rokana Raiders ship." >
	uid myFaction < bhv="constantData" constantDataType="faction" tooltip="Faction this location belongs to" >
	ReputationTier myFactionReputationTier
	GalaxyLocationUIMapSettings myUIMapSettings
	AudioState myMusicState < tooltip="If not set, the parent's state will be used." >
}

list Locations
{
	Location
}

class Location
{
	GalaxyLocation* myGalaxyLocation
	Locations mySubLocations
}