include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/gamevalues/gamevalues.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"

//match to enum in HC_ReputationTier.h
enum ReputationTier
{
	Terrible
	Bad
	Fair
	Good
	Excellent
}

class ReputationTierDefinition
{
	float myPercentage 0.2 < tooltip="How much of the bar this stage represents." >
	ReputationTierLockedGameValue myIsLocked < can_be_set=1 tooltip="[OPTIONAL]: If set, this reputation tier can be locked." >
	varmap myImpactDescription < bhv="localization" ui_info=1 >
	RBTagsTag* myTag
	uid myFirstTimeReachedReward < bhv="constantData" constantDataType="reward" >
	float myReputationGainModifier 1.0
	float myReputationLossModifier 1.0
}

class ReputationDefinitionTemplate < uid=auto >
{
	Faction* myFaction

	int myInitialValue 0
	int myMaxValue 1000
	bool myIsUnlockedByDefault false
	float myFactionKillSquadCooldown 0
	ReputationTier myFactionKillSquadMaxReputationTier Terrible
	ReputationTierDefinition myTerribleReputation
	ReputationTierDefinition myBadReputation
	ReputationTierDefinition myFairReputation
	ReputationTierDefinition myGoodReputation
	ReputationTierDefinition myExcellentReputation
	uid myFirstTimeReachedMaxReputationReward < bhv="constantData" constantDataType="reward" >

	ReputationTierGameValue myTier < hidden=1 init_set=1 >
	ReputationUnlockedGameValue myUnlocked < hidden=1 init_set=1 >
}

class ReputationDefinition : ReputationDefinitionTemplate
{
}