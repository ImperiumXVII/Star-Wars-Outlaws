include "helix/game system data/fruit/restriction/playerrestriction.fruit"
include "helix/game system data/fruit/melee/melee_move.fruit"
include "helix/game system data/fruit/animation/animation_channel_event.fruit"
include "helix/game system data/fruit/player/movement.fruit"
include "helix/game system data/fruit/effects/effects.fruit"
include "helix/game system data/fruit/melee/melee_conditions.fruit"
include "helix/game system data/fruit/sound/audiocomponentparameters.fruit"
include "helix/game system data/fruit/camera/cameramodifier.fruit"
include "helix/game system data/fruit/camera/camerasoftedgedata.fruit"

class MeleeDetectionArea
{
	float myDistance 2.0f
	float myAngle 90.0f
}

class MeleeDetectionConfig
{
	MeleeDetectionArea myFrontArea < tooltip="This area is used always." >
	MeleeDetectionArea myInputArea < tooltip="We only use this area when the player press input forward direction." >
	MeleeDetectionArea myCameraArea
	MeleeDetectionArea myPassiveArea < tooltip="We only use this area when the character is not receiving directional input and normal detection fails." >
	MeleeDetectionArea myKeepTargetArea < tooltip="If the current targets remains in this area we skip the search for more candidates." >
}

class MeleeDetectionCustomConfig
{
	MeleeDetectionConfig myConfig
	GameConditionMeleeValue myCondition
}

list MeleeDetectionCustomConfigList
{
	MeleeDetectionCustomConfig
}

class MeleeContext
{
	float myGraceTime 3.0f < tooltip="Time we keep alive the melee context after the last melee move" >
	bool myExtendedLookAt false < tooltip="If true the look at cam modifier will be applied during the whole context, not just during execution" >
	float myAreaRadius 15.0f
}

class MeleeWeaponAudio
{
	EmitterLabel* myEmitterLabel
	AudioEvent myMeleeHitAudioEvent
	AudioEvent myMeleeBlockAudioEvent
	AudioEvent myMeleeMissAudioEvent
}

class MeleeWeapon
{
	string myBoneAlias
	AnimationChannelEventType myAnimationChannelEventType Melee_RightFist
	MeleeWeaponAudio myAudio
	uid myHitRumble < bhv="constantData" constantDataType="rumble" >
	uid myHitBlockedRumble < bhv="constantData" constantDataType="rumble" >
	uid myStartExecutionRumble < bhv="constantData" constantDataType="rumble" >
}

list MeleeWeaponList
{
	MeleeWeapon
}

class MeleeCamera
{
    CameraSoftEdgeData myRestrictionPitchSoftEdgeData < tooltip="Soft pitch on orientation restriction" >
    CameraSoftEdgeData myRestrictionYawSoftEdgeData < tooltip="Soft yaw on orientation restriction" >
    vec2f myOrientationRestriction 10.0;10.0 < tooltip="How much camera is allowed to move around yaw + pitch in degrees" >
	float myScaledTargetHeightToRemoveFromLookAt 0.15f
	float myLookAtHorizontalOffsetAngle 0.f
	float myBreakCameraSpringConstant 150.f
	float myBreakCameraDampingRatio 0.75f
	float myLazyRetentionSpringConstant 200.f
	float myLazyRetentionDampingRatio 1.f
	float myShoulderSpringConstant 100.f
	float myTimeToBreakLookAt 1.f
	CameraModifierTransition myLookAtTransition
	CameraModifierTransition myShoulderBlendOut
	bool myUseBreakSpring true
	bool myUseBreakTime true
	bool myUseOrientationRestriction true
	bool myUseLookAt true
	bool myUseLazyRetention false
	bool myUseShoulderSwitch true
	SwayCameraModifier* mySwayModifier
	CameraModifierTransition myPunchPivotOffsetBlendOut
	float myPunchPivotOffsetSpringConstant 100.f
	float myMinPunchPivotOffset 0.4 < tooltip="Final value based on melee adrenaline" >
	float myMaxPunchPivotOffset 0.5 < tooltip="Final value based on melee adrenaline" >
}

class MeleeCharge
{
	bool myEnabled true
	float myChargeTime 2.0 < tooltip="Max time we can spend charging a melee move" >
	FOVCameraModifier* myFOVCameraModifier
	ShakeCameraModifier* myShakeCameraModifier
	uid myRumble < bhv="constantData" constantDataType="rumble" >
}

class MeleeMovement
{
	bool myMovementWithoutTargetEnabled true
	PlayerMovementConfig* myMovementMeleeContextConfig
	PlayerMovementConfig* myMovementApproachingConfig
	PlayerMovementConfig* myMovementExecutionConfig
}

class MeleeConfig < uid=auto >
{	
	float myDetectionAimDirectionWeight 0.2f < min= 0.0 max=1.0 tooltip="Weight of the aim direction to find candidate in oposition to distance" >
	float myDetectionWithInputAimDirectionWeight 0.3f < min= 0.0 max=1.0 tooltip="Weight of the aim direction to find candidate in oposition to distance when input is provided" >
	MeleeDetectionConfig myDefaultDetectionConfig
	MeleeDetectionCustomConfigList myCustomDetectionConfigs
	
	float myLastMoveGraceTime 0.5f
	float myTargetPointDistance 2.0f < tooltip="This is the distance the player will try to maintain while execution melee moves" >
	float myEffectivePunchDistance 3.0f < tooltip="This is the distance that most likely will connect a succesful punch. If we are clsoer than this, approaching state won't be triggered" >
	float myApproachingMaxTime 3.0f < tooltip="If the approaching state takes more time than this value it will be cancelled" >
	float myApproachingPersecutionMaxTime 1.0f < tooltip="If the approaching state takes more time than this with Kay running on the same direction as the target (because is escaping?) it will eb cancelled" >
	float myApproachingRunAwayTargetSpeed 2.f < tooltip="If the the target speed is greater than this during approaching on player's opposite direction, we consider it as is trying to run away" >
	float myApproachingPathDistanceTolerance 1.25f < tooltip="The pathing for the approach will have a max distance budget based on this tolerance multiplied by the inital straight distance. This way if the path grows too much bc corrections it will fail to execute." >
	float myExecutionTurnRate 15.0f < tooltip="Turn rate in degrees per second" >
	
	float myFistRadius 0.25f
	string myOnlyTargetExtraFistRadius "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.220993 0.214721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 0.51, }, }, numKeys = 2, }" < bhv=inputgraph >
	
	float mySpecializedFistRadius 0.25f < tooltip="If the target has head or legs, we'll use this size against it first" >
	string myOnlyTargetExtraSpecializedFistRadius "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.270235 -0.002532, }, outTangents = { 0.220993 0.214721, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 0.51, }, }, numKeys = 2, }" < bhv=inputgraph >
	
	float myAdrenalineTimeToStartCooling 1.0f < tooltip="How long it takes for start loosing adrenaline after the last adrenaline addition" >
	float myAdrenalineCoolingOverTime 0.3f < tooltip="Cooling points per second while overheat has not been triggered" >
	float myAdrenalineMoveDurationMultiplier 0.1f < tooltip="Based on how much adrenaline the player has, this multiplier will affect the melee moves durations. So basically, if the value is 0.1, the moves will be a 10% faster: final_melee_move_duration = melee_move_duration - melee_move_duration*(adrenaline*adrenaline_multiplier)" >
	
	float myLockMotionTargetAngle 20.f < tooltip="When the motion is not locked during a melee move execution, if the player moves on a direction relative to the target bigger than this value, the move execution will end" >
	
	EffectsByMaterials myGenericHitImpactEffects
	EffectsByMaterials myGenericBlockedImpactEffects
	 
	float myForwardImpactDirectionAngle 20.f < tooltip="When clamping impact directions, if the angle is bigger than this threshold the directions will be left or right and if it is inside, front" >
	float myLateralImpactAngle 35.f < tooltip="Relative to the forward direction, angle used for build left and right impcts" >
	MeleeCamera myMeleeCamera
	MeleeContext myMeleeContext
	MeleeCharge myMeleeCharge
	MeleeMovement myMeleeMovement
	
	bool myPerfectPunchEnabled false
	
	PlayerRestriction* myMeleeMoveRestrictions < tooltip="Prevented actions while in a melee move: Approaching + Execution" >
	PlayerRestriction* myMeleeContextRestrictions < tooltip="Prevented actions while in the melee context" >
	PlayerRestriction* myMeleeApproachingRestrictions < tooltip="Prevented actions while in the melee Move Approaching state" >
	PlayerRestriction* myMeleeExecutionRestrictions < tooltip="Prevented actions while in the melee Move Execution state" >
	PlayerRestriction* myMeleeUninterruptibleExecutionRestrictions < tooltip="Prevented actions while in the melee Uninterruptible execution track" >
	
	MeleeWeaponList myWeapons
	
	MeleeMoveList myMoves
	
	file myGameScript "" < bhv=asset assettype="Game Script/Generic" >

	string myDamageBaseMultiplier 1.0  < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Multiplier applied to all melee damage for agent" >
	float myPerfectMoveDamageMultiplier 2.0f < tooltip="If a melee move is considered perfect (we nailed the input in during the previous punch) will apply this multiplier to the damage" >	
	GameConditionMeleeValue myIsTargetWeakCondition
	
	float myMovementInputDeadZone 0.1f
	float myUserCancelInputTimeApproaching 0.25 
	float myUserCancelInputTimeContext 0.75
	float myCrouchIntentBufferTime 0.75
	
	float myPetPositionAngle 10.f < tooltip="Angle we add to the direction to target to build the pet position">
	float myPetPositionDistance 5.f < tooltip="Distance to target to build the pet position">
}
