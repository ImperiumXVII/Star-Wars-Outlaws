include "helix/game system data/fruit/animation/animation_channel_event.fruit"
include "helix/game system data/fruit/sound/audiocomponentparameters.fruit"
include "helix/game system data/fruit/ai/npcweapon.fruit"
include "helix/game system data/fruit/melee/combatmeleetype.fruit"
include "helix/game system data/fruit/impact/impact.fruit"

//Need to match enum in code: HC_NPCMeleeEnums.h
enum MeleePositionType
{
	Highest
	Lowest
	Average
	Random
}

//Need to match enum in code: HC_NPCMeleeEnums.h
enum MeleeMultipleHitsExemptPolicy
{
	Always
	UntilSeparation
}

class MeleeDetectionShape < abstract=1 >
{
	string myBoneAliasName < tooltip="Alias of a bone. Needs to be setup in NPC's animation system first." >
	vec3f myOffset < tooltip="Offset linked to the bone orientation" >
}

class MeleeDetectionBox : MeleeDetectionShape
{
	vec3f myBoxSize
	vec3f myOrientationOffset
}

class MeleeDetectionCylinder : MeleeDetectionShape
{
	float myRadius
	float myHeight
	vec3f myOrientationOffset
}

class MeleeDetectionSphere : MeleeDetectionShape
{
	float myRadius
}

list MeleeDetectionShapeList
{
	MeleeDetectionShape
}

class MeleeDetectionSetup
{
	string mySetupName
	MeleeMultipleHitsExemptPolicy myMultipleHitsExemptPolicy Always < tooltip="Exempt policy when a victim has been hit more than once during the same melee gate.\n\n- Always: Ignore subsequent hits for ever.\n- UntilSeparation: The victim can be hit again as soon as it stops contacting with any detection shapes." >
	MeleeDetectionShapeList myDetectionShapes
	bool myPiercingHit false < tooltip="If hit detection should go through and report everything on the cast trajectory,\ninstead of stopping at the earliest non-piercing hit.\n\nNB: Normally you don't need this, use with caution." >
}

list MeleeDetectionSetupList
{
	MeleeDetectionSetup
}

class NPCMeleeWeaponAudio
{
	NPCWeapon* myWeapon
	EmitterLabel* myEmitterLabel
	AudioEvent myMeleeHitAudioEvent
	AudioEvent myMeleeMissAudioEvent
	AudioEvent myShoveHitAudioEvent
	
	AudioEvent myMeleeHitNpcAudioEvent
	AudioEvent myShoveHitNpcAudioEvent
}

list NPCMeleeWeaponAudioList
{
	NPCMeleeWeaponAudio
}

class NPCUnarmedMeleeAudio
{
	EmitterLabel* myEmitterLabel
	CombatMeleeType myMeleeType
	AudioEvent myMeleeAudioEvent
}

list NPCUnarmedMeleeAudioList
{
	NPCUnarmedMeleeAudio
}

class NPCMeleeConfig < uid=auto >
{
	NPCMeleeWeaponAudioList myMeleeWeaponsAudio
	MeleeDetectionSetupList myDetectionSetups
	NPCUnarmedMeleeAudioList myUnarmedMeleeAudio
	ImpactRealization* myHitImpact
}
