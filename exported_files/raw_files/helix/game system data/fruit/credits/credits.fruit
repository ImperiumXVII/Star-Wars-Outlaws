
// Keep in sync with code/Helix/HClient/HC_UICreditsData.h
enum CreditsItemType
{
	Logo
	Department
	Title
	Name
	Partner
	Studio
	IntroText
	Text
}

class CreditsItemBase
{
	bool myEndGameOnly false
}

list CreditsItemBases
{
	CreditsItemBase
}

class CreditsItem : CreditsItemBase
{
	string myValue
	string myLanguage
	string myLocalizedValue
	CreditsItemType myType
}

class Break : CreditsItemBase
{
}

class Spacing : CreditsItemBase
{
	int myValue
}

class Page : CreditsItemBase
{
	float myDuration
	CreditsItemBases myItems
}

list Pages
{
	Page
}

list Textures
{
	file myTexture < bhv=asset assettype=texture >
}

list Fonts
{
	string
}

class Project
{
	Pages myPages
	Textures myTextures
	Fonts myFonts
}

list ProjectFiles
{
	file
}

class Credits
{
	ProjectFiles myProjectFiles
	Textures myTextures
	Fonts myFonts
}