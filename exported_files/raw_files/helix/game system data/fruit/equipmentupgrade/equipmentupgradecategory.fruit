include "helix/game system data/fruit/item/item_includes.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/talent/talent.fruit"
include "helix/game system data/fruit/equipment/equipment_set.fruit"
include "helix/game system data/fruit/equipmentupgrade/equipmentupgradeenums.fruit"

list UpgradeUIDList
{
	uid < bhv="constantData" constantDataType="equipmentupgrade">
}

class EquipmentUpgradeCategory < uid=auto >
{
	UpgradeCategory myUpgradeCategory
	UpgradeCategoryUITag myUITag
	EquipmentSlotGroupType mySlotGroupType Unassigned
	EquipmentSlotTag mySlotTag Main
	varmap myCategoryName < bhv="localization" >
	varmap myCategoryShortName < bhv="localization" >
	UpgradeUIDList myUpgrades
}