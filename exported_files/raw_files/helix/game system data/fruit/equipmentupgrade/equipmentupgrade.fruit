include "helix/game system data/fruit/item/item_includes.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/talent/talent.fruit"
include "helix/game system data/fruit/equipment/equipment_set.fruit"
include "helix/game system data/fruit/equipment/equipment.fruit"
include "helix/game system data/fruit/equipmentupgrade/equipmentupgradecategory.fruit"

list GameConditionItemList
{
	GameConditionPlayerHasItem
	GameConditionIsStoreAddonActive
}

class UpgradeTierTalent
{
	Talent* myTalent
	GameConditionItemList myUnlockConditions
}

list UpgradeTierTalentList
{
	UpgradeTierTalent
}

class UpgradeTier
{
	EquipmentItem* myEquipmentItem
	GameConditionItemList myUnlockConditions
	UpgradeTierTalentList myTalents < tooltip="These talents are currently only used for when you switch between blaster weapon modules. For other upgrades put the talents on the item itself." >
	bool myRequiresManualUnlock true < tooltip="If set to false, the tier will be unlocked automatically when all requiremets are fulfilled.\nWarning: the required materials will be automatically consumed (if any is set)" >
	bool myAutoEquipOnUnlock false < tooltip="If true, the upgrade item will be automatically equipped ONLY WHEN the slot is either empty or the currently equipped item is the previous item in the upgrade tree (including the placeholder)" >
}

list UpgradeTierList
{
	UpgradeTier
}

class EquipmentUpgrade < uid=auto >
{
	UpgradeTierList myEquipmentUpgradeTiers
	GameConditionItemList myDiscoveryConditions
	GameConditionItemList myHiddenConditions
	EquipmentUpgradeCategory* myCategory
	EquipmentItem* myPlaceholderEquipmentItem < tooltip="This indicates the item that is equipped by default in this upgrade's slot as a placeholder for visuals until the base tier level is unlocked. This will not enforce that this is the case (should match the default equipment set's default item), but is used to handle equipping the base level upgrade without stomping on a selection the player has already made." >
}