// Keep in sync with HC_InputChallengeType in HC_InputChallengeEnum.h
enum InputChallengeType
{
	Custom
	ButtonSequence
	ButtonMashing
	ButtonHold
	DecoyButtons
	TimedButtons
	ButtonCombination
	TimedSlider
	OscillatingStick
	MovingStick
	AimingStick
}

// Keep in sync with HC_InputChallengeProgressReductionMode in HC_InputChallengeEnum.h
enum InputChallengeProgressReductionMode
{
	NoReduction
	SteppedReduction
	ContinuousReduction
}

// Keep in sync with HC_InputChallengeUIElementBehaviour in HC_InputChallengeEnum.h
enum InputChallengeUIElementBehaviour
{
	Default
	Decoy
	Stick
}

// Keep in sync with HC_InputChallengeLoopingMode in HC_InputChallengeEnum.h
enum InputChallengeLoopingMode
{
	NoLoop
	PingPong
	Restart
}

// Keep in sync with HC_InputChallengeButtonOutcome in HC_InputChallengeEnum.h
enum InputChallengeButtonOutcome
{
	Good
	Avarage
	Bad
}

// Keep in sync with HC_InputChallengeProgressState in HC_InputChallengeEnum.h
enum InputChallengeProgressState
{
	Increasing
	Decreasing
	Stable
}

// Keep in sync with HC_InputChallengeProgressEvaluationModeType in HC_InputChallengeEnum.h
enum InputChallengeProgressEvaluationModeType
{
	Linear
	Logarithmic
	Curve
}