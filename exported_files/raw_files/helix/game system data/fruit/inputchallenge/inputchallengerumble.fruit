include "helix/game system data/fruit/input/rumble.fruit"
include "helix/game system data/fruit/inputchallenge/inputchallengeenum.fruit"

class InputChallengeButtonOutcomeRumble
{
	InputChallengeButtonOutcome myOutcome
	uid myOnChallengeProgress < bhv="constantData" constantDataType="rumble" >
}

list InputChallengeButtonOutcomeRumbles
{
	InputChallengeButtonOutcomeRumble
}

class InputChallengeRumble < uid=auto >
{
	uid myOnChallengeStarted < bhv="constantData" constantDataType="rumble" >
	uid myOnChallengeSucceeded < bhv="constantData" constantDataType="rumble" >
	uid myOnChallengeFailed < bhv="constantData" constantDataType="rumble" >
	uid myOnChallengeInputFailed < bhv="constantData" constantDataType="rumble" >
	uid myOnChallengeTimedOut < bhv="constantData" constantDataType="rumble" >
	uid myOnChallengeProgress < bhv="constantData" constantDataType="rumble" >
	uid myOnChallengeProgressStopped < bhv="constantData" constantDataType="rumble" >
	uid myOnCorrectButtonPressed < bhv="constantData" constantDataType="rumble" >
	uid myOnWrongButtonPressed < bhv="constantData" constantDataType="rumble" >
	InputChallengeButtonOutcomeRumbles myChallengeButtonOutcomeRumbles
}