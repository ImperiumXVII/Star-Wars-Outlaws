list GearGraphCompatibilityTagList
{
	GearGraphCompatibilityTag
}

class GearGraphInfoListWrapper < uid=auto >
{
	GearGraphCompatibilityTag myTag
	GearGraphCompatibilityTagList myIncompatibleTags
	GearGraphInfoList myGearGraphInfos
}

class VehicleGearGraphInfoListWrapper : GearGraphInfoListWrapper
{
}

list CharacterVisualsPartList
{
	GearGraphInfoList
	GearGraphInfoListWrapper*
}

list ColorVariationList
{
	color
}

class MaterialVariation
{
	uid myMaterial < tooltip="The UID of the corresponding material node inside the gear graph" hidden=true >
	int myWeight 1 < tooltip="The weight influence used for randomizing between materials for individual meshes." min=1 max=50 >
	AgentTagsList myAgentTagsList
}

list MaterialVariationList
{
	MaterialVariation
}

class GearMesh
{
	uid myUID < tooltip="The UID of the corresponding mesh node inside the gear graph" hidden=true >
	MaterialVariationList myMaterialVariations < tooltip="The material nodes connected to the gear mesh node" >
}

list GearMeshList
{
	GearMesh
}

class MaterialCombination
{
	CharacterVisualsMaterialCombinationID myID < bhv=charactermaterialcombination >
	int myWeight 1 < tooltip="The weight influence used for randomizing between material combinations." min=1 >
}

list MaterialCombinationList
{
	MaterialCombination
}

class GearGraphInfoBase
{
	file myGearGraph "" < bhv=charactervisualfile type=gear generate_from_graph_button=1 >
	int myWeight 1 < tooltip="The weight influence used for randomizing between gear graphs." min=0 max=50 >
	ColorVariationList myColorVariations
	GearMeshList myGearMeshList < tooltip="The gear mesh nodes available in the gear graph" >
	MaterialCombinationList myMaterialCombinationList < tooltip="If not empty, one of these material combinations will be picked for the gear graph and used to pick a material for each mesh (except for the meshes with an entry in GearMeshList)" >
	AgentTagsList myAgentTagsList
	GearGraphList myIncompatibleGearGraphs
	CharacterVisualsPartList myChildCharacterVisualsParts
	bool myIsEmpty false < hidden=true >
}

class GearGraphInfo : GearGraphInfoBase
{
	
}

class EmptyGearGraphInfo : GearGraphInfoBase
{
	file myGearGraph "" < hidden=true >
	ColorVariationList myColorVariations < hidden=true >
	bool myIsEmpty true < hidden=true >
}

class CharacterGraph
{
	file myCharacterGraph "" < bhv=charactervisualfile type=character >
	AgentTagsList myAgentTagsList	
}

list CharacterGraphList
{
	CharacterGraph
}

class CharacterVisualsBase < uid=auto abstract=true >
{
	file myCharacterGraph "" < bhv=charactervisualfile type=character >
	CharacterGraphList myCharacterGraphs
	CharacterVisualsPartList myCharacterVisualsParts
	GearGraphList myCharacterVisualLogicItems
}

class CharacterVisuals : CharacterVisualsBase
{
	bool myIsForVehicles false < hidden=true >
}

class VehicleCharacterVisuals : CharacterVisualsBase
{
	bool myIsForVehicles true < hidden=true >
}