list PlayerAgentTagsList
{
	RBTagsTag*  < compact_view=1 bhv=rbtags rbtags_filter="~+Agent" >
}

class PlayableCharacterConfig < uid = auto >
{
	CharacterVisualsBase* myCharacterVisuals
	EquipmentSet* myEquipmentSet
	DialogueCharacterHelix* myDialogueCharacterConstantData
	PlayerAgentTagsList myAgentRBTags
	PlayerHealth* myPlayerHealthConstantData
	AudioParameters myAudioParameters < tooltip="The parameters for setting up this agent's audio component" >
}