include "helix/game system data/fruit/settings/healthsettings.fruit"
include "helix/game system data/fruit/restriction/playerrestriction.fruit"

class PlayerHealth < uid = auto >
{
	HealthSettings myHealthSettings
	float myLowHealthWarningThreshold 0.3f < tooltip="Fixed health amount. When reached, the player will be warned that their health is very low." >
	string myHealthToRestoreOnReviveFormula 1 < tooltip="Amount of health to restore once revived." bhv=formulaEditor formulaResolveContextType=AgentAttributes >
	float myBrinkOfDeathAnimationDuration 5.f < tooltip="Duration of the brink of death animation phase where the player is on the ground - it is also how long the status will last." >
	PlayerRestriction* myBrinkOfDeathRestrictions < tooltip="The actions prevented when you are in the Brink of Death state" >
	float myDeathSpeedRampDownDuration 0.1f < tooltip="Time for the current speed to Rampdown to zero when dying." >
	float myDeathAnimationDuration 3.f
	float myCoopDeathAnimationDuration 20.f
}