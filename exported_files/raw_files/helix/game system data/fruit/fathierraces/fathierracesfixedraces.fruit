include "helix/game system data/fruit/faction/faction.fruit"
include "helix/game system data/fruit/fathierraces/fathierracesstatuses.fruit"

class FixedFathiersRacesCreditThreshold
{
	int myMinimumAmount < tooltip="The minimum amount of betting item the player should have to use this threshold. If player's amount is other multiple thresholds' minimum amount, the one with the highest minimum amount will be used." >
	FathierStatusList myAllowedStatus
}

list FixedFathiersRacesCreditThresholds
{
	FixedFathiersRacesCreditThreshold
}

// Keep in sync with HC_EnigmaFathierProperty in HC_FathierRacesFixedRaces.fruit
enum EnigmaFathierProperty
{
	Sex
	Age
	Weight
	Height
	BetRatio
	FathierName
	JockeyName
	JockeyDescription
}

// Keep in sync with HC_EnigmaFathierPropertyTest in HC_FathierRacesFixedRaces.fruit
enum EnigmaFathierPropertyTest
{
	Unique
	Lowest
	Highest
}

list FixedFathierRacesFactionMessageDescriptions
{
	varmap < bhv="localization" >
}

class FixedFathiersRacesFactionMessage
{
	uid myFaction < bhv="constantData" constantDataType="faction" tooltip="A message with an invalid faction will be used if no faction is set in the in world message or if the faction doesn't have a message">
	varmap myHeader < bhv="localization" tooltip="The text displayed in the header of the in world message.">
	FixedFathierRacesFactionMessageDescriptions myDescriptions < bhv="localization" tooltip="The texts displayed in the description of the in world message. One is selected at random for each message.">
}

list FixedFathiersRacesFactionMessages
{
	FixedFathiersRacesFactionMessage
}

class FixedFathierRacesEnigma < uid=auto >
{
	EnigmaFathierProperty myFathierProperty  < tooltip="The property to test to enable this enigma. Is set at None, the enigma will always be enabled." >
	EnigmaFathierPropertyTest myPropertyTest < tooltip="The test to do on the property to enable this enigma." >
	FixedFathiersRacesFactionMessages myFactionMessages < tooltip="The messages displayed depending on the faction used." >
	varmap myReminder < bhv="localization" tooltip="The text displayed in the betting menu to remind the player of the enigma.">
}

list FixedFathierRacesEnigmas
{
	FixedFathierRacesEnigma
}

list FixedFathierRacesEnigmasList
{
	FixedFathierRacesEnigmas
}

class ProceduralFixedRacesSettings
{
	FixedFathiersRacesCreditThresholds myFixedRacesCreditsThresholds < tooltip="Set the fathiers statuses that can be chosen for procedural fixed fathier races. Threshold should be sorted from lowest to highest minimum amount." >
	FixedFathierRacesEnigmasList myFixedRacesEnigmas < tooltip="When selecting an enigma for a procedural fixed races, the enigmas in ths first array will be selected first. If none of them is enabled, an enigma in the second array will be selected, and so on." >
	varmap myMaleTag < bhv="localization" tooltip="The tag used in an in world message to display that the fathier is a male.">
	varmap myFemaleTag < bhv="localization" tooltip="The tag used in an in world message to display that the fathier is a female.">
	int myMaxNumberOfForbiddenEnigmas < min = 0 tooltip="When an enigma is resolved, it's forbidden until this number of enigmas is done.">
	float myProceduralEnigmasCooldown < tooltip="When the player finishes a race fixed by a procedural enigma, they must wait this duration to have another enigma spawned." >
}