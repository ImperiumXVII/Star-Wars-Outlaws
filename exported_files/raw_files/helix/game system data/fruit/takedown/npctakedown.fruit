include "helix/game system data/fruit/ai/motion/motionenums.fruit"
include "helix/game system data/fruit/npcmove/moveevaluation.fruit"
include "helix/game system data/fruit/npc/npctagslists.fruit"

list NPCTakedownDataList
{
	NPCTakedownData
}

list NPCTakedownVariationList
{
	NPCTakedownVariationData
}

class NPCTakedownData
{
	bool myIsTargetPlayer false
	AnimSystemType myNPCTargetAnimSystemType None
	NPCTakedownVariationList myTakedownVariations
}

class NPCTakeDownAnimatedCameraData
{
	bool myEnablePresetCamera false
	vec3f myPresetCameraOffset 0.0;0.0;0.0 < tooltip="Preset camera offset from owner(attacker) position." >
	float myMaxDistanceToPresetCamera 5.f < tooltip="If distance between game camera and preset camera is larger than this value, we use cut instead of blend as transition." >
	float myMaxAngleRangeToPresetCamera 60.f < tooltip="If distance between game camera direction and preset camera to target direction is larger than this value, we use cut instead of blend as transition." >
	float myBlendInTime 1.f
	float myBlendOutTime 1.f
	float mySafetyAreaCheckRadius 2.f < tooltip="Cylinder cast radius, if collisions are found, we won't switch camera." >
	float mySafetyAreaCheckHeight 1.f < tooltip="Cylinder cast height, if collisions are found, we won't switch camera." >
}

class NPCTakedownVariationData
{
	float myWeight 1.f
	NPCMoveEvaluationConfig* myMoveEvaluationConfig
	bool myEnableSafetyAreaCheck false
	float mySafetyAreaCheckRadius 0.5f
	float mySafetyAreaCheckHeight 1.f
	vec3f mySafetyAreaOffset 0.0;0.0;0.0 
	float myDamage 0.f < tooltip="Set a large value if this takedown can kill target directly." >
	bool myClampDamageToNotKillVictim false
	NPCTakeDownAnimatedCameraData myCameraPreset
	
	float mySlowMotionDuration 0
	string mySlowDownScale "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { }, outTangents = { }, properties = { }, values = { }, numKeys = 0, }" < bhv=inputgraph tooltip="Snapping multiplier over time (x=1 is mySnapDuration)">
}

class NPCTakedownConfig < uid=auto >
{
	string myTakedownAnimVariableName ""
	string myTakedownDamageEventName ""
	NPCAgentTagsList myForbidAgentRBTags
	NPCTakedownDataList myTakedownData
}