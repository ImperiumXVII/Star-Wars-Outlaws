class GameConditionTakedownAerialConstraints
{
	bool myEnableAerialConstraints false < tooltip="If true, the aerial constraints will be considered in the game condition check" >
	bool myRequireNoNavMeshConnectionOnSlopes false < tooltip="If true, player and target must be on different navmesh islands when on slopes" >
	float myMaxFallDistanceThreshold 11.0 < min=0.0 tooltip="If the current fall distance is higher than this threshold, the takedown will not be enabled" >
}