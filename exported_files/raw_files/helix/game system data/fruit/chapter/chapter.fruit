include "helix/game system data/fruit/reward/reward.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/rewardpreview/rewardpreview.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"

list ChapterGameConditions
{
	GameConditionFlag
	GameConditionChapterCompleted
	GameConditionFormula
}

class ChapterConditionalUIInfo < ui_info=1 >
{
	ChapterGameConditions myConditions < tooltip="Automatically true if empty" ui_info=0 >
	varmap myTitle < bhv="localization" ui_info=0 >
	varmap myNarrativeSummary < bhv="localization" >
}

list ChapterConditionalUIInfoList
{
	ChapterConditionalUIInfo
}

class Chapter < uid=auto >
{
	ChapterConditionalUIInfoList myUIInfo
	Reward* myReward
	RewardPreview* myRewardPreview < tooltip="To preview rewards that can't be resolved from the actual reward." >
	RBTagsTag* myRBTag
	ChapterGameConditions myIsImmediateGameConditions
}

