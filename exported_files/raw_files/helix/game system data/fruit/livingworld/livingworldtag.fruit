include "helix/game system data/fruit/gameconditions/gameconditions.fruit"

list LivingWorldTagGameConditions
{
	GameConditionQuestState
	GameConditionQuestBeatState
	GameConditionPlayerHasIntel
	GameConditionPlayerHasReputation
	GameConditionPlayerHasWantedLevel
	GameConditionPlayerHasItem
}

class LivingWorldTag < uid=auto >
{
	float myCooldown 0 < tooltip="In seconds." >
	bool myShouldSaveCooldown FALSE
	LivingWorldContentGameValue myTicket < can_be_set=1 tooltip="[OPTIONAL]: If set, this game value will track the number of active content locations with this tag." >
	LivingWorldContentGameValue myTicketMax < can_be_set=1 tooltip="[OPTIONAL]: If set, this game value will be the max number of allowed locations with this tag active at the same time." >
	int myPriorityModifier 0 < tooltip="Added to the priority of the tag when content with the tag is activated." >
	LivingWorldTagGameConditions myUnlockConditions < tooltip="If not all conditions are true content with this tag won't spawn" >
}

list LivingWorldTagList
{
	LivingWorldTag*
}