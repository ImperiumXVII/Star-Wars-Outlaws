include "helix/game system data/fruit/item/item.fruit"

class ArcadeGameLeaderboardScoreByPlayer
{
	string myPlayerAlias
	int myPlayerScore
	float myPercentageChanceToBeReplacedByNewNPCScore < min = 0 max = 1 tooltip="[New NPC Score] Percentage (between 0 and 1) to replace the leaderboard score by an other score later" >
	int myNPCScoreToAddMin < min = 0 tooltip="[New NPC Score] Minimum score added to the current score entry " >
	int myNPCScoreToAddMax < min = 0 tooltip="[New NPC Score] Maximum score added to the current score entry " >
}

list ArcadeGameLeaderboard
{
	ArcadeGameLeaderboardScoreByPlayer
}

list ArcadeGameNPCNameList
{
	string
}

list ArcadeMandatoryUIGraphs
{
	file < bhv = "asset" assettype = "GUI" tooltip = "Mandatory UI graphs to run the arcade game." >
}

class ArcadeGame < uid=auto abstract=1 >
{
	Item* myCreditCurrency
	int myCreditCost
	string myPlayerLeaderboardAlias < tooltip="The hard coded name the player will be represented by in the leaderboard." >
	ArcadeGameLeaderboard myStaticLeaderboard < tooltip="The hard coded scores of the best players for this specific game. Will be used at runtime to determine player's position among the top players." >
	float myMouseSensitivity 1 < min = 0.001 tooltip="Arcade specific mouse sensitivity" >
	bool myHasIntroState false
	float myTimeBeforeNewNPCScoreMin < min = 0 tooltip="[New NPC Score] Min time (in Seconds) before having a new npc score after the last leaderboard seen (random between timeBeforeNewNPCScoreMin and timeBeforeNewNPCScoreMax)" >
	float myTimeBeforeNewNPCScoreMax < min = 0 tooltip="[New NPC Score] Max time (in Seconds) before having a new npc score after the last leaderboard seen (random between timeBeforeNewNPCScoreMin and timeBeforeNewNPCScoreMax)" >
	ArcadeGameNPCNameList myNPCNameList < min = 0 tooltip="[New NPC Score] When a new NPC score is added to the leaderboad, we randomly take a npc name from this list" >
	ArcadeMandatoryUIGraphs myMandatoryGraphs < tooltip="Mandatory UI graphs to run the arcade game." >
}

/////////////////////////////////////////////////////////////////

class ArcadeGameRacingFeedback
{
	vec3f myCameraBoosterMoveDirection 0.0;0.0;0.0 < tooltip="Camera Booster Feedback : Direction of the camera transltation when we take a booster" >
	string myCameraBoosterOffsetByBoostersCount < bhv=inputgraph tooltip="Camera Booster Feedback : Curve defining the camera distance in function of the consecutive boosters take by the player">
	float myCameraBoosterStartMoveDuration 0 < min= 0 tooltip="Camera Booster Feedback : Duration of the camera translation when we take a booster">
	float myCameraBoosterEndMoveDuration 0 < min= 0 tooltip="Camera Booster Feedback : Duration of the camera translation when we loose the boost">
	string myCameraBoosterStartMoveCurve < bhv=inputgraph tooltip="Camera Booster Feedback : Curve of the camera translation when we take a booster">
	string myCameraBoosterEndMoveCurve < bhv=inputgraph tooltip="Camera Booster Feedback : Curve of the camera translation when we loose the boost">

	string myCameraObstacleMoveCurve < bhv=inputgraph tooltip="Camera Obstacle Feedback : Curve of the camera shake when we collide with an obstacle">
	float myCameraObstacleMoveDuration 0 < min= 0 tooltip="Camera Obstacle Feedback : Duration of the camera shake when we collide with an obstacle">
	float myCameraObstacleMoveDistance 0 < min= 0 tooltip="Camera Obstacle Feedback : Distance of the camera shake when we collide with an obstacle">
	vec3f myCameraObstacleMoveDirection 0.0;0.0;0.0 < tooltip="Camera Obstacle Feedback : Direction of the camera shake when we collide with an obstacle">
}

class ArcadeGame3DRacing : ArcadeGame
{
	// CAMERA
	vec3f myCameraOffsetToPlayer 0.0;0.0;0.0 < tooltip="Offset from the Player Ship" >
	vec3f myCameraLookatOffsetFromPlayer 0.0;0.0;0.0 < tooltip="Look At Position Offset from the Player Ship" >
	float myEndingCameraDistanceFromFinishingLine 0 < min = 0 tooltip="If a value is set, the camera will stop x meters before the finishing line" >
	
	// RACE
	int myBaseCorridorIndex 1 < min=0 tooltip="Player ship starting corridor (between 0 and Corridors Count -1)" >
	int myCorridorsCount 3 < min=0 tooltip="Number of corridors for the race" >
	float myDistanceBetweenTwoCorridors 0 < min=0 tooltip="Distance (in meters) between two corridors" >
	float myWaitDurationBeforeLeaderboard 1.0 < min=0 tooltip="The time (in seconds) it takes to display the leaderboard once the player ship has reached the arrival line" >

	// PLAYER
	float myPlayerInvincibilityCooldown 2 < min=0 tooltip="The time (in seconds) it takes after a collision for a player to be able to collide again." >
	string mySpeedOverDistance < bhv=inputgraph tooltip="The speed (in meters per second, min 0) curve over distance. The x axis represents the distance (normalized : 0 = start / 1 = end) travelled since the start of the race." >
	string mySpeedReductionOnCollisionOverDistance < bhv=inputgraph tooltip="The speed (in meters per second, min 0) reduction curve applied to the player when colliding with an obstacle over distance. The x axis represents the distance (normalized : 0 = start / 1 = end) travelled since the start of the race." >
	string myReaccelerationOverDistance < bhv=inputgraph tooltip="The speed (in meters per second, min 0) used to reaccelerate once the player has collided with an obstacle over distance. The x axis represents the distance (normalized : 0 = start / 1 = end) travelled since the start of the race." >
	string myStrafeDurationOverDistance < bhv=inputgraph tooltip="The strafe duration (in seconds, min 0) to switch corridors over distance. The x axis represents the distance (in meters) travelled since the start of the race." >
	string myStrafeCurve < bhv=inputgraph tooltip="The strafe curve. The x axis represents the distance between the start and the end of the strafe (between 0 and 1), and the y axis the speed of the strafe. (between 0 and 1)" >
	float myMaxPlayerSpeed 0 < min=0 tooltip="Max speed of the player ship (0 = no max speed)" >
	string myStartRaceCurve < bhv=inputgraph tooltip="Curve of the start speed. X axis between 0 and 1 is the percentage of StartRaceDuration. Y axis is a percentage between 0 and 1 that defines the percentage of the initial speed">
	float myStartRaceDuration 0 < min=0 tooltip="Duration of the start race speed" >
	bool myIsJumpActive false < tooltip="If true, the player ship will be able to jump from the first corridor to the last corridor when strafing to the wall" >
	bool myHasStartScreenPlayableLoop false < tooltip="If true, the ship will move during the start screen, between the start pos and the end pos defined in the race level init script" >

	// SPAWNABLE ELEMENTS SETTINGS
	float myBoosterSpeedBonus 1 < min=0 tooltip="The speed bonus that will be applied to the player ship" >
	float myBoosterDuration 0 < min=0 tooltip="The duration of the booster speed bonus. If it's equal to 0, the duration will be infinite" >
	bool myIsBoosterBonusAdditive false < tooltip="If true, the booster bonus will be added to the player ship bonus in order to accumulate several boosters bonus. Otherwise, the speed bonus will be added just once" >

	// FEEDBACKS
	ArcadeGameRacingFeedback myFeedbacks
}

/////////////////////////////////////////////////////////////////

class ArcadeGameRailShooterComboLevel
{
	int myRequiredPointsToReachThisLevel < min=0 tooltip="The required points to reach this combo level" >
	float myPointsMultiplier 1 < min=0 tooltip="If the player reaches this level, the points will be multiplied by this value" >
	bool mySuperShootUnlocked false < tooltip="If the player reaches this level, he will unlock the super shoot" >
	int myComboIndexWhenStunned < min=0 tooltip="When you are stunned, the combo level is set to this index" >
}

list ArcadeGameRailShooterComboLevelList
{
	ArcadeGameRailShooterComboLevel
}

list ArcadeGameRailShooterProjectilesOffsetFromCameraList
{
	vec3f
}

class ArcadeGameRailShooterTargetKilledScore
{
	string myTargetID < tooltip="Unique ID of the target" >
	int myKilledScore < tooltip="Score we add when we kill the target" >
}
list ArcadeGameRailShooterTargetKilledScoreList
{
	ArcadeGameRailShooterTargetKilledScore
}

class ArcadeGameRailShooter : ArcadeGame
{
	string mySpeedOverDistance < bhv=inputgraph tooltip="The speed (in meters per second, min 0) curve over distance. The x axis represents the distance (normalized : 0 = start / 1 = end) travelled since the start" >
	float myCameraLookAtDistanceOnSpline 0.1 < min=0 tooltip="The camera look at distance on the spline">
	vec3f myPlayerShipOffsetToCamera 0.0;0.0;0.0
	ArcadeGameRailShooterTargetKilledScoreList myTargetKilledScoreList
	ArcadeGameRailShooterProjectilesOffsetFromCameraList myProjectilesOffsetFromCamera < tooltip="Offsets from camera of the projectiles. The list count also determines the number of projectiles launched">
	float myProjectileSpeed 0 < min=0 tooltip="The speed of the projectile (in meters per second)" >
	bool myTargetInstantKill true < tooltip="If true, the aimed target will be instantly killed. If false, we are waiting the projectile to reach the target to kill it">
	float myStunDuration 0 < min=0 tooltip="The duration of the stun. The stun is when we collide with an obstacle and we cannot shoot anymore." >
	float myRaycastDistance 20 < min=0 tooltip="Distance of the raycast for the shoot (in meters)" >
	string myCrosshairSpeedMultiplierOverDistance < bhv=inputgraph tooltip="Speed multiplier of the crosshair depending on the distance traveled on the screen. X axis = distance traveled,Y axis = speed multiplier" >
	float myCrosshairAccelerationMeasureDuration 0 < min=0 tooltip="Duration measurement time for crosshair acceleration">
	float myAimAssistSpeed 0 < min=0 tooltip="Speed of the aim assist">
	bool myResetCrosshairAccelerationWhenInputIsZero false
	ArcadeGameRailShooterComboLevelList myCombosLevels
	float myShootCooldownDuration 0 < min=0 tooltip="Cooldown duration between the shoots" >
	float myAudioSpatializationScale 0 < min = 0 tooltip="Scale applied to the distance between the camera and the targets (asteroids/ships) for the audio spatialization" >
	float myCameraTurnRotationAmplitude 0 < min=0 tooltip="[Rotation of the player camera when it take turns] : amplitude of the rotation" >
	float myCameraTurnRotationNextPositionDistance 0 < min=0 tooltip="[Rotation of the player camera when it take turns] : It is used to determinate the next position of the camera" >
	float myCameraUpVectorMaxX 0 < min=0 tooltip="We used the Up vector of the camera to rotate it. It is the maximum of the X value from the Up vector" >
	float myEnemyShipTurnRotationAmplitude < min=0 tooltip="[Rotation of the enemy ships when it take turns] : amplitude of the rotation" >
	float myEnemyShipTurnRotationNextDistance < min=0 tooltip="[Rotation of the enemy ships when it take turns] : It is used to determinate the next position of the ship">
	float myEnemyShipMaxRotation < min=0 tooltip="[Rotation of the enemy ships when it take turns] : we used the local Z rotation of the ship to rotate it. It is the maximum of the Z rotation in Degrees">
	float myEndingDistanceFromLastSplinePoint 0 < min=0 tooltip="The ending sequence is the last part of the game, we can trigger VFX/sounds in this part. This value is the distance (in meters) from the last spline point">
}