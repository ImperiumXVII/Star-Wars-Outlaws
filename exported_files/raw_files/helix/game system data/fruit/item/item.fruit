{
	Standard
	Premium
	Cosmetic
}

class Item < uid=auto >
{
	varmap myName < bhv="localization" ui_info=1 referenced_by_code=1 ui_info_debug_ui_name=1 tooltip="For items where you're dealing with large amounts(credits), the plural form should be used. For unique(particular clothing item) or low amount items(grenade), singular should be preferred." >
	varmap myDescription < bhv="localization" ui_info=1 >
	varmap myGameplayDescription < bhv="localization" ui_info=1 >
	varmap myWhereToFind < bhv="localization" ui_info=1 tooltip="For displaying information on where the player can find an item.">
	varmap myHint < bhv="localization" ui_info=1 tooltip="For displaying additional info about an item." >
	varmap myWantedByVendor < bhv="localization" ui_info=1 tooltip="For displaying information about vendors that might be interested in this item." >
	bool myDisplayAmountInLog true < ui_info=1 tooltip="If TRUE, when gaining or losing the item, should the amount be shown. Example: FALSE for unique items." >
	string myIcon < bhv="sprite" ui_info=1 referenced_by_code=1 >
	bool myIconUseAlphaMask TRUE < ui_info=1 >
	string myWatermark < bhv="sprite" ui_info=1 >
	file myThumbnail < bhv="asset" assettype="texture" ui_info=1 >
	file myHighresImage < bhv="asset" assettype="texture" ui_info=1 >
	file myGraphObject < bhv=asset assettype=object hidden=1 ui_info=1 >
	ItemCategory myCategory
	ItemTier myTier Small < ui_info=1 >
	ItemQuality myQuality Standard
	file myVideo < bhv="asset" assettype="webm" ui_info=1 >
	
	InventoryPouch myInventoryPouch
	string myAgentInventoryCapacity < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Not set means unlimited, but can be capped by pouch capacity" >
	string mySpeederInventoryCapacity < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Not set means unlimited, but can be capped by pouch capacity" >
	string mySpaceshipInventoryCapacity < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Not set means unlimited, but can be capped by pouch capacity" >
	string myRokanaSpaceshipInventoryCapacity < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Not set means unlimited, but can be capped by pouch capacity" >
	string myPetInventoryCapacity < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="Not set means unlimited, but can be capped by pouch capacity" >
	PlayerInventoryType myDefaultInventory Agent
	bool myShowInventoryAddNotifications TRUE
	bool myShowInventoryRemoveNotifications TRUE
	bool myShouldAutoSave FALSE < tooltip="This will request an autosave if the item is added to, or removed from the inventory" >
		
	file myLootGraphObject "" < bhv=asset assettype=object tooltip="If set, when spawning this item as loot it will use this graph object instead." >
	file mySpaceOverrideLootGraphObject "" < bhv=asset assettype=object tooltip="If set, overrides 'LootGraphObject' in space levels." >
	bool myAllowUsingLootGraphObjectWithAnyAmount TRUE < tooltip="If TRUE, when spawning this item as loot at ANY amount it will use the graph object specified in myLootGraphObject. If FALSE, then the graph object will only be used if the item is spawned as one item." >
	ItemBlockedLootBehavior myBlockedLootBehavior Default < tooltip="What happens when the item can't be picked up." >
	bool myIsAutoLoot FALSE < tooltip="If true, the loot pile will be considered auto-lootable, not requiring the player to manually interact with it." >
	bool myCanEnterPetTunnels TRUE < tooltip="If set to false and the Pet steals this loot and needs to go back through a Manual Pet Tunnel, he will drop the loot containing this item." >

	int myBuyPrice
	bool myCanBeSold TRUE < tooltip="If the item can be sold to a vendor or not" >
	bool myHideAtVendorIfCantBeAddedToInventory FALSE < tooltip="If this is set to true the item won't show up in the vendor if it can't be added to the player inventory. It will still show if the player doesn't have enough money to buy it." >
	
	ItemAmountGameValue myAmount < can_be_set=1 tooltip="[OPTIONAL]: If set, this game value will track the amount of this item in the agent inventory to be used in formulas." >

	Intel* myKeyPartIntel < tooltip="[OPTIONAL]: This Intel is for Key Parts, you should not use it for other intent. It will be activated when the player found the hint to found it" >
}

class CurrencyItem : Item
{
	ItemTotalGainedGameValue myTotalGained < can_be_set=1 tooltip="[OPTIONAL]: If set, this game value will track the gained amount of currency." >
}

class RewardGivingItem : Item
{
	string myAgentInventoryCapacity < hidden=1 >
	string mySpeederInventoryCapacity < hidden=1 >
	string mySpaceshipInventoryCapacity < hidden=1 >
	PlayerInventoryType myDefaultInventory Agent < hidden=1 >
	bool myShowInventoryAddNotifications FALSE < hidden=1 >
	bool myShowInventoryRemoveNotifications FALSE < hidden=1 >
	ItemBlockedLootBehavior myBlockedLootBehavior HideGraphObject
	bool myHideAtVendorIfCantBeAddedToInventory TRUE
	ItemAmountGameValue myAmount < hidden=1 >

	uid myReward < bhv="constantData" constantDataType="reward" >
}

class UpgradeItem : Item
{
	string mySpeederInventoryCapacity < hidden=1 >
	string mySpaceshipInventoryCapacity < hidden=1 >
	ItemCategory myCategory Upgrade
	InventoryPouch myInventoryPouch VisibleUpgrades
	TalentList myTalents < tooltip="Applied when item is added to inventory." >
}

class ReputationLootItem : Item
{
	uid myReputation < bhv="constantData" constantDataType="reputation" can_be_set=1 >
	uid mySameFactionSellReward < bhv="constantData" constantDataType="reward" >
	uid myOtherFactionSellReward < bhv="constantData" constantDataType="reward" >
}

class InWorldMessageItem : Item
{
	string myAgentInventoryCapacity < hidden=1 >
	string mySpeederInventoryCapacity < hidden=1 >
	string mySpaceshipInventoryCapacity < hidden=1 >
	PlayerInventoryType myDefaultInventory Agent < hidden=1 >
	bool myShowInventoryAddNotifications FALSE < hidden=1 >
	bool myShowInventoryRemoveNotifications FALSE < hidden=1 >
	uid myInWorldMessage < bhv="constantData" constantDataType="inworldmessage" >
}

class ItemStack
{
	Item* myItem
	int myAmount 1
}

list ItemStackList
{
	ItemStack
}