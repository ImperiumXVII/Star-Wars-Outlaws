class ConsumedItemConfig
{
	bool myShouldRefill false < tooltip="If true the inventory will be refilled with the maximum capacity of this item after reaching the count of 0" >
	bool myFullRefillOnEquip false < tooltip="If true, the consumed item is going to be refilled to the maximum capacity when the equipment is equipped" >
	bool myCanRefillDuringCombat false
	bool myRefillOnlyWhenEmpty true
	bool myRefillStepByStep false
	string myRefillStepFormula 0.0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="The number of items refilled each step" >
	string myRefillDurationFormula 0.0 < bhv=formulaEditor formulaResolveContextType=AgentAttributes tooltip="The time (in seconds) it takes to refill" >
	bool myResetRefillTimerOnItemConsumed false
}