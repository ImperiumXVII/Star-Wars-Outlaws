include ./uienums.fruit
include "helix/game system data/fruit/galaxy/galaxylocation.fruit"

class UIZoomLevelSetting
{
	UIMapObjectType myMapType
	vec2f myZoomInOutRange 0;1 < min=0.0 max=1.0 tooltip="Between what zoom values (0-1) should we show" >
}

list UIZoomLevelSettings
{
	UIZoomLevelSetting
}

class UIGalaxyLocationTypeRange
{
	GalaxyLocationType myGalaxyLocationType
	vec2f myZoomInOutRange 0;1 < min=0.0 max=1.0 tooltip="Between what zoom values (0-1) should we show labels" >
}

list UIGalaxyLocationTypeRanges
{
	UIGalaxyLocationTypeRange
}

class UIMapZoomSettings < uid=auto ui_info=1 >
{
	float myInitialZoom 0.5 < min=0.0 max=1.0 tooltip="At what zoom level (0-1) is the camera when opening the map? 0 = fully zoomed out, 1 = fully zoomed in" >
	vec3f myInitialLookAtOffset < tooltip="Offset for the initial camera lookat when opening the map." >
	float myFocusZoom 0.5 < min=0.0 max=1.0 tooltip="At what zoom level (0-1) should we be when focusing on a MapRef? 0 = fully zoomed out, 1 = fully zoomed in" >
	float myViewAngle 0.0 < min=0.0 max=90.0 tooltip="At what angle to we look at the map? 0 = straight down" >
	float myMapRotation 0 < bhv="degree_angle" tooltip="At what angle is the map rotated around Y?" >
	vec4f myBoundaryPadding 0;0;0;0 < tooltip="Increase the bounds of the map in world meters and allow the cursor and camera to move around more. Left/Top/Right/Bottom." >
	float myLandingSelectionDistance 1500.0 < tooltip="How many meters (in map scale) above the terrain is the camera positioned when in landing site selection mode?" >
	vec2f myZoomInOutRange 100.0;1000.0 < min=1.0 tooltip="How many meters (in map scale) above the terrain is the camera positioned when fully zoomed in (x) and out (y)?" referenced_by_code=1 >
	float myCameraSpeedMultipler 1.0
	float myCameraZoomSpeedMultiplier 1.0
	bool myDisableCameraPanning false
	UIZoomLevelSettings mySettings < ui_info=0 >
	UIGalaxyLocationTypeRanges myGalaxyLocationTypeRanges < ui_info=0 >
	float myWorldUIScaleFactor 1.0 < tooltip="Affects the scale of UI texts and textures that are drawn in world space" >
	float myWorldFactionUIScaleFactor 1.0 < tooltip="Affects the scale of Faction UI icon and texts in world space" >
	float myMapGroundPlane 0.0 < tooltip="The Y height where map refs and labels are placed if raycasting does not hit anything" >
}