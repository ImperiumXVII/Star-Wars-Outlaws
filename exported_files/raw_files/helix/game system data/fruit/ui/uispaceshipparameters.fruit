class UISpaceshipParameters < uid=auto >
{
	float myMinimumWorldMarkedDisplayDistance 200.f < tooltip="Minimum distance in meters from which marker is displayed" >
	float myLockOnDistance 1200.f < tooltip "Maximum distance in meters for lock on" >
	float mySmallMarkerDisplayLimit 2000.f < tooltip="Minimum distance in meters from which marker is displayed" >
	float myRhombusMarkerDisplayLimit 3000.f < tooltip="Minimum distance in meters from which marker is displayed" >
	float myRadarTransparencyThreshold 800.f < tooltip="" >
	float myRadarDisplayLimit 1500.f < tooltip="" >
}