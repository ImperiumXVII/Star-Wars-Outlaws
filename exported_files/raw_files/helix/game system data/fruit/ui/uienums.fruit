{
	Regular
	Medium
	Bold
	Thin
}

enum UIMapLoadState
{
	Idle
	WaitForMeshes
	PrepareSharedData
	PrepareGraphs
	Cleanup
}

enum UIMapObjectType < useCategories=1 >
{
	Undefined
	
	< startCategory="Regions">
	Region
	SubRegion
	< endCategory="" >

	< startCategory="Labels" >
	LabelTop
	LabelMiddle
	LabelBottom
	LabelSubLocation
	< endCategory="" >
	
	< startCategory="Map Refs" >
	MapRefTop
	MapRefMiddle
	MapRefBottom
	< endCategory="" >
	
	< startCategory="Areas" >
	FactionTerritory
	FactionTerritoryDataLabel
	< endCategory="" >
}

