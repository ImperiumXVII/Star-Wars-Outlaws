

enum UIGraphObjectAnimationID < useCategories=1 >
{
	Undefined

	< startCategory="Menu" >
	MenuIdle
	< endCategory="" >

	< startCategory="Pet Commands" >
	PetAttackPose
	PetDistractPose
	PetPushButtonPose
	PetSabotagePose
	PetStealPose
	PetUseTraversalPropPose
	PetFetchPose
	< endCategory="" >
	
	< startCategory="Reputation Tier Animations" >
	ReputationTierBad
	ReputationTierFair 
	ReputationTierGood
	< endCategory="" >
}

class UIGraphObjectAnimation
{
	UIGraphObjectAnimationID myUIGraphObjectAnimationID
	string myAnimation
}

list UIGraphObjectAnimationList
{
	UIGraphObjectAnimation
}

class UIGraphObjectSettings < uid=auto >
{
	UIGraphObjectAnimationList myUIGraphObjectAnimations
}