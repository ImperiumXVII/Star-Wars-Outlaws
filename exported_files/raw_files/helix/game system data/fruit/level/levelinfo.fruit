include "snowdrop/game system data/fruit/level_metadata.fruit"
include "snowdrop/modules/core/audio/billboardsettings.fruit"
include "helix/game system data/fruit/rbtags/rbtags.fruit"
include "helix/game system data/fruit/dialogue character/dialogue_character.fruit"
include "helix/game system data/fruit/cameralens/cameralenspreset.fruit"
include "helix/game system data/fruit/gameconditions/gameconditions.fruit"
include "helix/game system data/fruit/level/levelinfoenums.fruit"

list LevelInfoDisabledGameConditions
{
	LevelInfoDisabledGameConditionGroup
	GameConditionQuestBeatState
	GameConditionQuestState
}

class LevelInfoDisabledGameConditionGroup : GameConditionGroupBase
{
	LevelInfoDisabledGameConditions myConditions
}

list LevelWorldTagsList
{
	RBTagsTag*  < compact_view=1 bhv=rbtags rbtags_filter="~+World" >
}

class LevelInfo < uid=auto > : LevelMetadataBase
{
	LevelInfoType myType Planet
	bool myIsTimeOfDayEnabled true
	bool myAreProgressionGraphsEnabled true
	bool mySupportsPackaging true
	LevelWorldTagsList myWorldRBTags
	CameraLensPreset* myCameraLensPreset  < tooltip="[OPTIONAL]: If specified the level will load a specific camera lens to drive the optical post effects." >
	DialogueCharacterHelix* myCommsScannerDialogueCharacter
	BillboardingState* myBillboardingState
	LevelInfoDisabledGameConditions myDisableConditions < tooltip="If unlocked and all true, level will be disabled. If OR is needed, add a group." >

	int myLandingMinTimeOfDayInSeconds 43200 < min=0 max=86400 tooltip="The min time of day set while landing, in seconds." >
	int myLandingMaxTimeOfDayInSeconds 43200 < min=0 max=86400 tooltip="The max time of day set while landing, in seconds." >

	float myCompassRotation 0.0 < bhv=angle tooltip="Offset the compass cardinal directions with this many degrees while on this level." >
}
