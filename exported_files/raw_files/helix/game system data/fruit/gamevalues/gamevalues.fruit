// Keep synced with HC_GameValueConstantData.h
enum GameValueType
{
	Integer
	Bool
	ReputationTier
	IntelState
	DomainOfMasteryAbilityState
	DomainOfMasteryExpertSetState
	OverheardState
	QuestState
	QuestBeatState
	GalaxyLocationUnlockedState
	NPCOverrideDifficulty
}

enum GameValueCategory
{
	Default
	Graph
	ProgressionGraph
	LandingZone
	Reputation
	Item
	LivingWorldContent
	Quest
	QuestBeat
	Intel
	DomainOfMasteryExpertSet
	GameStatistic
	Galaxy
	Jukebox
	Faction
	Vendor
	SpaceTravel
	Overheard
	UIDiscoveryZone
	MapRef
	Wanted
	ContractPart
}

class GameValue < uid=auto abstract=1 always_override=1 >
{
	string myDescription < tooltip="Unused in the game. Description of the Game Value for documentation purposes." >

	int myDefaultValue 0

	bool myIsPersisted TRUE < tooltip="Decide if the value is persisted." >

	string myVariableAttributeName < tooltip="[OPTIONAL] If empty, it will be generated by the position of the variable in the hierarchy of fruit classes." >

	bool myCanBeEditedFromScript FALSE
	bool myCanBeEditedFromUI FALSE
	bool myCanBeEditedFromProgressionGraph FALSE

	GameValueType myIntendedType Integer < tooltip="Type recommended to use for this game value. Does not restrict to this type only." >
	GameValueCategory myCategory Default < tooltip="Used to categorize Game Values in formula editor popup menu." >
	int myParentLevelsToUseInInstanceName 1 < hidden=1 tooltip="-1 goes to the highest possible parent level in the file" >
}

list GameValueRefList
{
	GameValue*
}

class GraphGameValue : GameValue
{
	bool myCanBeEditedFromScript TRUE
	bool myCanBeEditedFromUI TRUE
	GameValueCategory myCategory Graph
}

