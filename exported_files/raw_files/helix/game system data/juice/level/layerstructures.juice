			}
			myLayers
			{
				GroupLayer _[Level_suffix]?Quests
				{
					GroupLayer "[Quest] [Quest_suffix]"
					{
						LayerStructurePresetLayers BeatLayers
						{
							myPreset = QuestBeatPreset 00000000000000000000000000000000
						}
						LayerStructurePresetLayers GeneralLayers
						{
							myCustomParameters
							{
								string Beat[BeatIndex] General
							}
							myPreset = QuestBeatPreset 00000000000000000000000000000000
						}
					}
				}
			}
		}
