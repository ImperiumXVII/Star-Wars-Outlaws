DatabankTutorialEntry sabaccrules_10_ban_01 < uid=E52E0D4365B22FBE00021694F4F4452E > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Ban category\nText describing the ban state for sabacc tables\", enabled = true, guid = #E52E0D4365B23082000216A7BD995601, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 9975, text = \"Failing at cheating increases opponents' <b>suspicion</b>, eventually getting you <b>caught and banned from the table</b>.\n\nYou will need to <b>wait for things to calm down</b> before coming back to play at the same table.\", type = \"MenuLine\"}"
