DatabankTutorialEntry sabaccrules_06_drawandstand_01 < uid=E52E0D4365B22F12000216811C6B3D05 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Draw & Stand category\nText describing the base actions draw and stand\nShould focus on describing the cost of each\", enabled = true, guid = #E52E0D4365B230340002169C32B833C4, lineVersion = 9, maxLength = 0, productId = -1, sectionId = 9975, text = \"To <b>draw a card</b>, you must <b>invest 1 chip</b>.\n\n<b>Standing</b> will <b>pass your turn for free</b>, saving chips when your hand is good enough.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_06_drawandstand_02 < uid=E52E0D4365B22F12000216824BBE4329 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 02 - Draw & Stand category\nText describing the base actions draw and stand\nShould focus on describing the 4 draw deck choices\", enabled = true, guid = #E52E0D4365B2303A0002169D56A4EAF9, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 9975, text = \"You can <b>draw the top card of any deck</b> on the table, including the discard decks. After drawing a Sand or Blood card, you must discard a card from the same family, <b>always keeping one card of each family in hand</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_07_reveal_01 < uid=E52E0D4365B22F120002168392452445 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Reveal category\nText describing the reveal round conditions to trigger\nShould focus on describing the 3 turns leading to a reveal\", enabled = true, guid = #E52E0D4365B230430002169EC89253A1, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 9975, text = \"Each <b>round lasts 3 turns</b>, giving you 3 opportunities to improve your hand.\nAfter each player has played 3 times, <b>everyone reveal their hands</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tableoverview.dds
}

DatabankTutorialEntry sabaccrules_07_reveal_02 < uid=E52E0D4365B22F120002168409CB404A > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 02 - Reveal category\nText describing the reveal round conditions to trigger\nShould focus on describing the stand off mechanic, where a round of standing leads to an early reveal\", enabled = true, guid = #E52E0D4365B230490002169FD56828DF, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 9975, text = \"<b>If every player stands</b> during a turn, <b>everyone reveal their hands</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tableoverview.dds
}

DatabankTutorialEntry sabaccrules_08_win_01 < uid=E52E0D4365B22FBE0002168DE62FE692 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Win category\nText describing the win condition for a round\nShould focus on describing best sabacc hand, or smallest value as well as tie\", enabled = true, guid = #E52E0D4365B23052000216A026BD07A5, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 9975, text = \"You <b>win the round</b> if you have the <b>best hand</b> at the table. Two or more players can be winners in case of a tie.\n\n<b>If no one has a Sabacc hand</b>, the player with <b>the lowest hand value</b> — the difference of card values — using the lowest cards <b>wins</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tableoverview.dds
}

DatabankTutorialEntry sabaccrules_08_win_02 < uid=E52E0D4365B22FBE0002168EE5E942CE > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 02 - Win category\nText describing the win condition for a round\nShould focus on describing best sabacc hand, or smallest value as well as tie\", enabled = true, guid = #E52E0D4365B2305A000216A1573FD2A9, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 9975, text = \"The <b>round winner</b> takes their <b>invested chips back</b> to their stock.\n\nWithout a Sabacc hand, you are <b>taxed an amount equal to the difference of your card values</b>.\nWith a <b>losing Sabacc hand</b>, you are taxed <b>1 chip</b>.\nAll <b>taxed chips</b> are <b>lost</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tableoverview.dds
}

DatabankTutorialEntry sabaccrules_08_win_03 < uid=E52E0D4365B22FBE0002168FD5C61790 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 03 - Win category\nText describing the win condition for the game\nShould focus on describing the consequence of losing a round, and the game final win condition\", enabled = true, guid = #E52E0D4365B23060000216A20D6A8CB4, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 9975, text = \"If your chips stock is empty by the end of the reveal phase, <b>you are eliminated</b> from the game.\n\nYou <b>win</b> the game upon being the <b>last player with chips in stock</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tableoverview.dds
}

