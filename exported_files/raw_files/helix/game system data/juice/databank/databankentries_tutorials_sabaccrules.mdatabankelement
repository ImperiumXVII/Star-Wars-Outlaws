DatabankTutorialEntry sabaccrules_01_goal_01 < uid=E52E0D4365B2164200041A387E30CDAF > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content - Goal category\nText describing the high level objective & ingredients of the game\nShould focus on 2 cards in hand, 3 turns, lowest pair to win, last with chips wins \", enabled = true, guid = #E52E0D4365B21AB800080536F68F11A4, lineVersion = 10, maxLength = 0, productId = -1, sectionId = 9975, text = \"In Kessel Sabacc, you invest chips to improve your hand and <b>get a pair</b>, a Sabacc hand. To <b>win a round</b>, you need to <b>have the best hand</b> at the end of <b>3 turns</b>.\n\nThe <b>last player with chips in stock wins</b> the game, and the content of the credits pot.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tableoverview.dds
}

DatabankTutorialEntry sabaccrules_02_cards_01 < uid=E52E0D4365B22DFB00021667EE61F321 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content - Cards category\nText describing the sabacc cards\nShould focus on the 1-to-6 values and the 2 families\", enabled = true, guid = #E52E0D4365B22E390002166BAE21ACE0, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 9975, text = \"Hands are made of <b>2 cards</b>, one from each family — <b>Sand</b> and <b>Blood</b> — with values going from <b>1 to 6</b>.\n\nThe card value is depicted by its <b>header</b> and <b>central symbol</b>.\n\nThere are <b>3 cards for each value per family</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_03_handsandranks_01 < uid=E52E0D4365B22E730002166D2251D0BD > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Hands and Ranks category\nText describing the hand value rule\nShould focus on the card to card difference and Sabacc hand being a zero in value\", enabled = true, guid = #E52E0D4365B2300300021695D4E3C238, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 9975, text = \"<b>Minimize</b> your hand value, meaning the difference of your card values.\n\nA <b>Sabacc hand</b> is a pair and has a hand value of <b>zero</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_03_handsandranks_02 < uid=E52E0D4365B22F120002167BCC70A82E > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 02 - Hands and Ranks category\nText describing the hand ranks order\nShould focus on the lower is better rule\", enabled = true, guid = #E52E0D4365B2300B00021696DDF685A7, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 9975, text = \"<b>Sabacc hands</b> are <b>ranked</b> based on the <b>value of their paired cards</b>.\n\nThe <b>closer</b> the cards' values are to <b>zero</b>, the <b>stronger</b> the Sabacc hand is.\", type = \"MenuLine\"}"
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_04_sylopimpostor_01 < uid=E52E0D4365B22F120002167C969627A4 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Sylop and Impostor category\nText describing the sylop\nShould focus on the wild card aspect and number of instance per family\", enabled = true, guid = #E52E0D4365B2301100021697CEB5DD3D, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 9975, text = \"When revealed, the <b>Sylop will take the value of the other card in your hand</b>, forming a pair and a Sabacc hand.\n\nThere is <b>1 Sylop per family</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_04_sylopimpostor_02 < uid=E52E0D4365B22F120002167D0A5DFBE3 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 02 - Sylop and Impostor category\nText describing the impostor\nShould focus on the dice aspect and number of instance per family\", enabled = true, guid = #E52E0D4365B2301A00021698983E2CF0, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 9975, text = \"When revealed, the <b>Impostor will take the value of one of 2 dice thrown</b>, completing your hand.\n\nThere are <b>3 Impostors per family</b>.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_04_sylopimpostor_03 < uid=E52E0D4365B22F120002167E97F80F5E > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 03 - Sylop and Impostor category\nText describing the impostor sabacc and sylop sabacc ranking\nShould focus on explaining the equality of ranking between a standard sabacc and a sabacc obtained through sylop or impostor\", enabled = true, guid = #E52E0D4365B23021000216995206CFCD, lineVersion = 9, maxLength = 0, productId = -1, sectionId = 9975, text = \"<b>Sylop Sabacc or Impostor Sabacc</b> are <b>equivalent to a standard Sabacc hand</b> of the same value.\n\n A <b>pair of Sylops</b> is Pure Sabacc, the <b>best hand</b> of the game.\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_05_shifttokens_01 < uid=E52E0D4365B22F120002167FDE80F457 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 01 - Shift tokens category\nText describing the shift tokens usage in sabacc\nShould focus on the number of tokens per game, when to use and that it can't be used multiple times\", enabled = true, guid = #E52E0D4365B230270002169A3BB4A397, lineVersion = 9, maxLength = 0, productId = -1, sectionId = 9975, text = 'Kessel Sabacc is played with <b>3 Shift Tokens</b>, which are powerful game modifiers.\n\nA Shift Token can be played <b>once in the game</b>, and only at the beginning of your turn, <b>before Standing or Drawing</b>.\n\nYou can display the active Shift Tokens by pressing <gameaction src=\"SabaccOpenShiftLog\">.', type = \"MenuLine\"}"
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_tablecloseupview.dds
}

DatabankTutorialEntry sabaccrules_05_shifttokens_02 < uid=E52E0D4365B22F1200021680F90C4324 > : databankentries_tutorials_sabaccrules
{
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Sabacc ruleset panel content 02 - Shift tokens category\nText describing the shift tokens collection in sabacc\nShould focus on how/where to collect new tokens\", enabled = true, guid = #E52E0D4365B2302E0002169B5B88CDE9, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 9975, text = \"You can <b>expand your Shift Tokens deck</b> by finding <b>new tokens in the world, winning them at specific tables or buying them on the black market.</b>\", type = \"MenuLine\""
	myPicture helix/baked/ui/loose_images/databank/tutorials/sabacc/databank_tutorials_sabacc_kaywins.dds
