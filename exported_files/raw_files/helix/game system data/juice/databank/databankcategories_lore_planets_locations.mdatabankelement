	myDescription "branch = \"\", contextComment = \"Desc of Lore_Planet_AKI_Location_11\", enabled = true, guid = #D00CF65464E372290001108795C1497F, lineVersion = 40, maxLength = 50, productId = 6, sectionId = 9957, text = \"The Ahia-Ko people have left numerous temples behind before going extinct, and many of them feature advanced techniques that are still inspiring new architects on Akiva. Historians are still unraveling the meaning of different buildings and temples, discovering that the Ahia-Ko were complex people with different schools of thought.\", type = \"MenuLine\""
