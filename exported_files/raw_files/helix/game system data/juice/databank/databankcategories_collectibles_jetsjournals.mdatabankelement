include "helix/game system data/fruit/databank/databank.fruit"
include "helix/game system data/juice/item/items_jetsjournalscollectibles.mitem"

DatabankKordosJournalEntry Collectibles_JetsJournals_01 < uid=D00CF65464C7CFBA0000DFD8F13520C1 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 01 - transcription\", enabled = true, guid = #D00CF65464C7CFD70000DFD9567AEFA1, lineVersion = 14, maxLength = 50, productId = 6, sectionId = 10534, text = \"The Empire is just as corrupt as anyone else. This whole galaxy runs on kickbacks and favors, and the Empire is no different. You just have to be careful not to bribe the wrong Imperial, or you will have to blast your way out.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D1440000DFE1C07A7B35 > = items_Collectibles_JetsJournals_01 D00CF65464C7D07A0000DFDCB4EEEEB3
}

DatabankKordosJournalEntry Collectibles_JetsJournals_02 < uid=D00CF65464C7D5E30000E0E5AD693CC7 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 02 - transcription\", enabled = true, guid = #D00CF65464C7D5AC0000E0D84591EE47, lineVersion = 15, maxLength = 50, productId = 6, sectionId = 10534, text = \"If you end up on the ISB's most wanted list, it's just a matter of time before they find you. There's no easy way to escape. The ISB have informants and agents everywhere, and those agents are true believers who will take you down with them.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D5E30000E0E69D684048 > = items_Collectibles_JetsJournals_02 D00CF65464C7D49D0000E036CDF2C116
}

DatabankKordosJournalEntry Collectibles_JetsJournals_03 < uid=D00CF65464C7D5E30000E0E7322F0028 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 03 - transcription\", enabled = true, guid = #D00CF65464C7D5BB0000E0DC79298D48, lineVersion = 15, maxLength = 50, productId = 6, sectionId = 10534, text = \"The biggest mistake you can make in this business is working with rebels. They have no credits, and no matter where they go, the Empire is right behind them. There is no chance that outfit will amount to anything.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D5E30000E0E839419B91 > = items_Collectibles_JetsJournals_03 D00CF65464C7D49D0000E0387DE4612A
}

DatabankKordosJournalEntry Collectibles_JetsJournals_04 < uid=D00CF65464C7D5E30000E0E9DD2A177A >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 04 - transcription\", enabled = true, guid = #D00CF65464C7D5CA0000E0E061CE7955, lineVersion = 18, maxLength = 50, productId = 6, sectionId = 10534, text = \"Akiva is fine, even if it's an old separatist world. It might get warm and humid but at least everyone minds their own business. And, best of all, the Empire is only there every fourth cycle.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D5E30000E0EA029F6697 > = items_Collectibles_JetsJournals_04 D00CF65464C7D49D0000E03A30057535
}

DatabankKordosJournalEntry Collectibles_JetsJournals_05 < uid=D00CF65464C7D5E30000E0EB48FB08AC >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 05 - transcription\", enabled = true, guid = #D00CF65464C7D5D70000E0E425A5D804, lineVersion = 21, maxLength = 50, productId = 6, sectionId = 10534, text = \"Myrra is great, when it's not under water. There are plenty of clients moving stock from there, and they keep a low profile. They are old timers, just like myself, because rookies who make mistakes tend to disappear in the jungle.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D5E30000E0EC7D538F31 > = items_Collectibles_JetsJournals_05 D00CF65464C7D49D0000E03C9BAB35BC
}

DatabankKordosJournalEntry Collectibles_JetsJournals_06 < uid=D00CF65464C7D6440000E10184340E8A >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 06 - transcription\", enabled = true, guid = #D00CF65464C7D5FF0000E0F078F85491, lineVersion = 21, maxLength = 50, productId = 6, sectionId = 10534, text = \"The Alcazar is starting to become my favorite watering hole this side of the core. I could say a thing or two about the owner, but it is a solid place to get information. In this business, you do not get very far without information.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D6440000E10295CE6408 > = items_Collectibles_JetsJournals_06 D00CF65464C7D49D0000E03ECC6DB33F
}

DatabankKordosJournalEntry Collectibles_JetsJournals_07 < uid=D00CF65464C7D6440000E10337931A4D >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 07 - transcription\", enabled = true, guid = #D00CF65464C7D60D0000E0F4AA19A396, lineVersion = 23, maxLength = 50, productId = 6, sectionId = 10534, text = \"The separatists have an advanced droid factory underneath Myrra that produces an impressive amount of droids. The broken ones are dropped in one end, and moments later, new and shiny ones come out the other, ready to be deployed in the field.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D6440000E104CB6B97E4 > = items_Collectibles_JetsJournals_07 D00CF65464C7D49D0000E0400C3B21D1
}

DatabankKordosJournalEntry Collectibles_JetsJournals_08 < uid=D00CF65464C7D6440000E105EF0F905D >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 08 - transcription\", enabled = true, guid = #D00CF65464C7D61E0000E0F8532FC0FE, lineVersion = 25, maxLength = 50, productId = 6, sectionId = 10534, text = \"When dealing with the Ashiga you need to be aware that, even though they don't have eyes, they can spot a liar a parsec away. They have highly developed senses for pheromones and vibrations. The moment you try to fool them, they will cut you down without hesitation.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D6440000E10609074790 > = items_Collectibles_JetsJournals_08 D00CF65464C7D49D0000E042AC743D12
}

DatabankKordosJournalEntry Collectibles_JetsJournals_09 < uid=D00CF65464C7D6440000E107A6E9758F >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 09 - transcription\", enabled = true, guid = #D00CF65464C7D62A0000E0FCB623CAAD, lineVersion = 27, maxLength = 50, productId = 6, sectionId = 10534, text = \"The Ashiga are artists when it comes to gunsmithing, producing some of the finest blaster rifles in the galaxy. Their craft can make a fortune on the black market, but it is very difficult to get a hold of one. As always, the Ashiga want to keep everything to themselves.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D6440000E10831AA0201 > = items_Collectibles_JetsJournals_09 D00CF65464C7D49D0000E0444801D0EC
}

DatabankKordosJournalEntry Collectibles_JetsJournals_10 < uid=D00CF65464C7D6440000E109A2B4F111 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 10 - transcription\", enabled = true, guid = #D00CF65464C7D6370000E1002D7A2FD4, lineVersion = 29, maxLength = 50, productId = 6, sectionId = 10534, text = \"Crimson Dawn is an interesting syndicate. Dryden Vos enjoys dressing up and hosting elaborate parties, but he's got the temper of a blurrg. He will not last long. When you reach the top, you need people you trust to have your back.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D6440000E10A91BC1910 > = items_Collectibles_JetsJournals_10 D00CF65464C7D49D0000E04644AE4D25
}

DatabankKordosJournalEntry Collectibles_JetsJournals_11 < uid=D00CF65464C7D66F0000E1131D29AFA7 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 11 - transcription\", enabled = true, guid = #D00CF65464C7D64E0000E10E69F3546A, lineVersion = 31, maxLength = 50, productId = 6, sectionId = 10534, text = \"A lot of inexperienced smugglers will ask me how to deal with bounty hunters, but the answer is very simple. Bounty hunters only care for credits, so unless you can outbid a crime lord, your best approach is to blast them and hope they didn't bring friends.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D66F0000E1148C2ED523 > = items_Collectibles_JetsJournals_11 D00CF65464C7D49D0000E04895E16EBF
}

DatabankKordosJournalEntry Collectibles_JetsJournals_12 < uid=D00CF65464C7D66F0000E115D32300FC >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 12 - transcription\", enabled = true, guid = #D00CF65464C7D65A0000E1128B47ADBE, lineVersion = 33, maxLength = 50, productId = 6, sectionId = 10534, text = \"Being a successful smuggler depends on how you handle your cargo. You need a ship with secret compartments, and usually you will have to make them yourself. I'm proud to say that the Trailblazer is so good in this regard that even I can't find all of them anymore.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D66F0000E11665BF6D7B > = items_Collectibles_JetsJournals_12 D00CF65464C7D49D0000E04A1130D59B
}

DatabankKordosJournalEntry Collectibles_JetsJournals_13 < uid=D00CF65464C7D6820000E11B7227AFF8 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 13 - transcription\", enabled = true, guid = #D00CF65464C7D6760000E11A9A63520A, lineVersion = 35, maxLength = 50, productId = 6, sectionId = 10534, text = \"People who think Vandor is cold have clearly not visited Kijimi. Even with the thermal systems around the city, the planet is barely habitable unless you have a steady supply of soup and gristmeal tea.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D6820000E11C8A6CD4DF > = items_Collectibles_JetsJournals_13 D00CF65464C7D49D0000E04C56D68372
}

DatabankKordosJournalEntry Collectibles_JetsJournals_14 < uid=D00CF65464C7D6AD0000E12946208A7C >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 14 - transcription\", enabled = true, guid = #D00CF65464C7D6840000E120E4D07C94, lineVersion = 37, maxLength = 50, productId = 6, sectionId = 10534, text = \"If you ever have anything stolen, it is likely that it will eventually end up in the Thieves District on Kijimi. I must admit that I have fenced a fair share of goods here myself.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D6AD0000E12ACD3CD975 > = items_Collectibles_JetsJournals_14 D00CF65464C7D4BF0000E06394FEFFDB
}

DatabankKordosJournalEntry Collectibles_JetsJournals_15 < uid=D00CF65464C7D6AD0000E12B1348E5FE >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 15 - transcription\", enabled = true, guid = #D00CF65464C7D6930000E1242031F212, lineVersion = 39, maxLength = 50, productId = 6, sectionId = 10534, text = \"You cannot be in this trade without dealing with the Hutts. It is a fact of life. But you must make sure to stay on their good side. They have deep pockets, plenty of bounty hunters and a nasty sadistic streak.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D6AD0000E12C1492EAD6 > = items_Collectibles_JetsJournals_15 D00CF65464C7D4BF0000E0650ABBCAFE
}

DatabankKordosJournalEntry Collectibles_JetsJournals_16 < uid=D00CF65464C7D6AD0000E12D56A3F152 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 16 - transcription\", enabled = true, guid = #D00CF65464C7D6A40000E128CD195891, lineVersion = 41, maxLength = 50, productId = 6, sectionId = 10534, text = \"I like Chalmun's cantina. It has a rough and tumble feel, but you have to remember to keep one hand on the blaster and one eye on the exit. You never want to find yourself cornered in a basement.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D6AD0000E12E7D7F7D82 > = items_Collectibles_JetsJournals_16 D00CF65464C7D4BF0000E067CE16F476
}

DatabankKordosJournalEntry Collectibles_JetsJournals_17 < uid=D00CF65464C7D7280000E13F4CACE6F6 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 17 - transcription\", enabled = true, guid = #D00CF65464C7D6F50000E132657E2493, lineVersion = 43, maxLength = 50, productId = 6, sectionId = 10534, text = \"My father used to work for Jabba and kept telling me that Jabba never forgets. My father ended up getting dragged back to Tatooine for owing him a few thousand credits. As far as I know, he is still down there in the Sarlacc pit...\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7280000E1405BD66BBB > = items_Collectibles_JetsJournals_17 D00CF65464C7D54E0000E0BD0059CE7E
}

DatabankKordosJournalEntry Collectibles_JetsJournals_18 < uid=D00CF65464C7D7280000E141B3D4EEDD >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 18 - transcription\", enabled = true, guid = #D00CF65464C7D7020000E136F373E069, lineVersion = 45, maxLength = 50, productId = 6, sectionId = 10534, text = \"Mos Eisley gets a bad reputation, for a good reason. Everyone is a scoundrel, including the Jawas, the droidsmiths and even the water merchants. If that bothers you, you are in the wrong line of work.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7280000E1426930002B > = items_Collectibles_JetsJournals_18 D00CF65464C7D54E0000E0BF2FCF5061
}

DatabankKordosJournalEntry Collectibles_JetsJournals_19 < uid=D00CF65464C7D7280000E1434280C0AD >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 19 - transcription\", enabled = true, guid = #D00CF65464C7D7100000E13AD459E0F3, lineVersion = 47, maxLength = 50, productId = 6, sectionId = 10534, text = \"I always wondered, out of all the places in Hutt Space, why Jabba set up shop on Tatooine. I think he just loves sitting in that palace, watching his subjects suffer in the desert.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7280000E144AAE3F0F5 > = items_Collectibles_JetsJournals_19 D00CF65464C7D54E0000E0C1A5FF2810
}

DatabankKordosJournalEntry Collectibles_JetsJournals_20 < uid=D00CF65464C7D7280000E145BE554172 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 20 - transcription\", enabled = true, guid = #D00CF65464C7D71C0000E13EBE8C964A, lineVersion = 49, maxLength = 50, productId = 6, sectionId = 10534, text = \"Most people think the Tusken are all one and the same. That's a big mistake, as there are many different tribes with their own cultures and values. So don't go out there assuming you know anything, because you probably don't.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D7280000E146578D3FCB > = items_Collectibles_JetsJournals_20 D00CF65464C7D54E0000E0C30FF63887
}

DatabankKordosJournalEntry Collectibles_JetsJournals_21 < uid=D00CF65464C7D7950000E14F3F294BD1 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 21 - transcription\", enabled = true, guid = #D00CF65464C7D7750000E14A8C9ABF7D, lineVersion = 51, maxLength = 50, productId = 6, sectionId = 10534, text = \"The water tax... what kind of monster would tax farmers on the one thing that sustains life on this cruel, desert world? No one but Jabba would have that idea, even though it remains one of Tatooine's biggest mysteries what he uses it for.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D7950000E1508352C3A4 > = items_Collectibles_JetsJournals_21 D00CF65464C7D54E0000E0C5E13502E1
}

DatabankKordosJournalEntry Collectibles_JetsJournals_22 < uid=D00CF65464C7D7950000E15196F71318 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 22 - transcription\", enabled = true, guid = #D00CF65464C7D78A0000E14EE68D617A, lineVersion = 53, maxLength = 50, productId = 6, sectionId = 10534, text = \"I was not surprised that the Clone Wars paved the way for the Empire. The galaxy was in pieces, and everyone wanted to be done with the war. I don't think they realized the price they paid. Maybe they never will.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D7950000E1521BFC360D > = items_Collectibles_JetsJournals_22 D00CF65464C7D54E0000E0C77C4ADBC4
}

DatabankKordosJournalEntry Collectibles_JetsJournals_23 < uid=D00CF65464C7D7F90000E16B82B696B6 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 23 - transcription\", enabled = true, guid = #D00CF65464C7D7970000E156AF538BA8, lineVersion = 55, maxLength = 50, productId = 6, sectionId = 10534, text = \"The Kessel Run is a real test for a pilot. Some pilots want to use precaution and stay within the regular twenty parsec route, but most pilots who end up successful in this business will at least pass through the Corkscrew.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7F90000E16C53515215 > = items_Collectibles_JetsJournals_23 D00CF65464C7D54E0000E0C938ED296F
}

DatabankKordosJournalEntry Collectibles_JetsJournals_24 < uid=D00CF65464C7D7F90000E16D26FC95DA >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 24 - transcription\", enabled = true, guid = #D00CF65464C7D7A80000E15A25FEB1B3, lineVersion = 57, maxLength = 50, productId = 6, sectionId = 10534, text = \"The Pykes are an institution, and as long as you adapt to their ways you will find a moderate amount of success. Smugglers like us will always have a place in their plan. The key is to nod along and take the credits.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7F90000E16EB75A878D > = items_Collectibles_JetsJournals_24 D00CF65464C7D54E0000E0CBE7E83FD5
}

DatabankKordosJournalEntry Collectibles_JetsJournals_25 < uid=D00CF65464C7D7F90000E16F816FB4F6 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 25 - transcription\", enabled = true, guid = #D00CF65464C7D7BF0000E15E6867DCED, lineVersion = 59, maxLength = 50, productId = 6, sectionId = 10534, text = \"Many smugglers who pass through Toshara make the mistake that Mirogana is the center of commerce. Stay on Toshara long enough, you will realize that the diner in Jaunta's Hope is a much more interesting venue. The speakeasy downstairs has Imperials and criminals alike doing business, far away from the Pykes in Mirogana.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D7F90000E17058779F34 > = items_Collectibles_JetsJournals_25 D00CF65464C7D54E0000E0CDF7A594C7
}

DatabankKordosJournalEntry Collectibles_JetsJournals_26 < uid=D00CF65464C7D7F90000E1719AE783A5 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 26 - transcription\", enabled = true, guid = #D00CF65464C7D7D00000E1621F45E8FA, lineVersion = 61, maxLength = 50, productId = 6, sectionId = 10534, text = \"It is commonly thought that Canto Bight has the best sabacc tables, but you should not underestimate Makal's in Mirogana. I recently partnred up with a Gallusian card counter named Bosnok, and together we made nearly ten thousand credits in one night. You will not see that type of action at the Daystar Casino.\", type = \"MenuLine\""
	myItem < uid=D00CF65464C7D7F90000E172F9E2199B > = items_Collectibles_JetsJournals_26 D00CF65464C7D54E0000E0CF2E764F60
}

DatabankKordosJournalEntry Collectibles_JetsJournals_27 < uid=D00CF65464C7D7F90000E17305D6CA55 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 27 - transcription\", enabled = true, guid = #D00CF65464C7D7DE0000E166E90E5344, lineVersion = 63, maxLength = 50, productId = 6, sectionId = 10534, text = \"Mirogana has changed over the years, and every time I visit, it seems that the Empire is pulling back and the Pykes are taking over. But you must look beyond the streets and territories. As long as the Empire holds the spaceport, they are in charge.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7F90000E174E1BC7BE4 > = items_Collectibles_JetsJournals_27 D00CF65464C7D54E0000E0D1C070E26C
}

DatabankKordosJournalEntry Collectibles_JetsJournals_28 < uid=D00CF65464C7D7F90000E17547E036DD >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 28 - transcription\", enabled = true, guid = #D00CF65464C7D7ED0000E16A427A69A9, lineVersion = 65, maxLength = 50, productId = 6, sectionId = 10534, text = \"There is no place quite like Toshara. You have the Pykes and the Empire side by side, and for a small cut you can get an Imperial certificate for almost anything. It is not always worth it, but sometimes you need to get goods off your hands.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464C7D7F90000E176AE27D17B > = items_Collectibles_JetsJournals_28 D00CF65464C7D54E0000E0D3E26087A6
}

DatabankKordosJournalEntry Collectibles_JetsJournals_29 < uid=D00CF654651EDBF10009AA40A0507663 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 29 - transcription\", enabled = true, guid = #D00CF654651EDBA10009AA33C5D2FB0E, lineVersion = 67, maxLength = 50, productId = 6, sectionId = 10534, text = \"Hey, this is Jet Kordo. Look, if we're gonna pull off this job, we need precautions.\n\nThat thing you're holding is a holotracker. Trade league members use them to find vaults to store contraband, but I've taken a couple of those vaults off the grid. No one's gonna find them but us.\n\nWhich means we can store all our equipment, and the score, in these vaults until it's safe to get out.\nThe holo image changes to a map that looks like a tracking device.\n\nJust don't lose that holotracker and the discs. Because we don't want anyone else to find these vaults and take the score, now, do we?\", type = \"MenuLine\""
	myItem < uid=D00CF654651EDBF10009AA41561706C1 > = items_Collectibles_JetsHeist_01 D00CF654651EDB740009AA20E0C26771
}

DatabankKordosJournalEntry Collectibles_JetsJournals_30 < uid=D00CF654651EDBF10009AA4216511BD4 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 30 - transcription\", enabled = true, guid = #D00CF654651EDBBF0009AA37DDBF0879, lineVersion = 71, maxLength = 50, productId = 6, sectionId = 10534, text = \"<font preset=\\"Medium Bodytext\\">H1-0N:</font> Jet. Are you here? My sensors-- What are you doing? Jet? Who is that on the ground?\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Hion! Hold on, don't panic. I had to, okay? Dorhal sold us out.\n\n<font preset=\\"Medium Bodytext\\">H1-0N:</font> What did you do..?\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Hion, I can prove he betrayed us! He put the whole heist at risk. Let's go to the backup vault. I can prove it.\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651EDBF10009AA43DE4C7E15 > = items_Collectibles_JetsHeist_02 D00CF654651EDB740009AA2228951685
}

DatabankKordosJournalEntry Collectibles_JetsJournals_31 < uid=D00CF654651EDBF10009AA44FD8CE8D1 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 31 - transcription\", enabled = true, guid = #D00CF654651EDBCF0009AA3BAFCCA1C7, lineVersion = 71, maxLength = 50, productId = 6, sectionId = 10534, text = \"I had a great time in Nar Shaddaa. You really know how to host. Showed a guy a good time. I'm just confirming the deal is still on. Kordo's gonna hit the palace tonight, so be ready. Oh, and keep a clean perimeter watch. He's got a hunter outside with killer aim.\n\nI'm looking forward to doing more business with ya. I'll send you the coordinates to another vault here on Akiva, you can contact me there.\", type = \"MenuLine\""
	myItem < uid=D00CF654651EDBF10009AA451343D8AF > = items_Collectibles_JetsHeist_03 D00CF654651EDB740009AA24C2D6B4CA
}

DatabankKordosJournalEntry Collectibles_JetsJournals_32 < uid=D00CF654651EDBF10009AA468D52EEA8 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 32 - transcription\", enabled = true, guid = #D00CF654651EDBDA0009AA3FCB007AB9, lineVersion = 75, maxLength = 50, productId = 6, sectionId = 10534, text = \"<font preset=\\"Medium Bodytext\\">JET KORDO:</font> The recording was here! Hion, I swear... Dank Farrik! It must've been in the other vault...\n\n<font preset=\\"Medium Bodytext\\">H1-0N:</font> Jet, this is a serious accusation. We had Dorhal vetted.\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Yes! I'm positive. He got cozy with the Hutts and sold us out. No wonder it got messy, he told them everything!\n\n<font preset=\\"Medium Bodytext\\">H1-0N:</font> Are you alright, Jet? Your biometrics appear unstable...\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> I'm fine! Just... go to the other vault here on Akiva. Listen to the recording. I gotta talk to Raatha.\", type = \"MenuLine\""
	myItem < uid=D00CF654651EDBF10009AA47305395C1 > = items_Collectibles_JetsHeist_04 D00CF654651EDB740009AA26C7850584
}

DatabankKordosJournalEntry Collectibles_JetsJournals_33 < uid=D00CF654651EDC180009AA545C96AD93 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 33 - transcription\", enabled = true, guid = #D00CF654651EDBF50009AA4B11E4E028, lineVersion = 75, maxLength = 50, productId = 6, sectionId = 10534, text = \"Hion, it's Jet. Leaving this here in case you're wondering where we're at. Raatha was followed and this location is compromised. We're moving to the other vault for security. Be careful. And don't trust anyone.\", type = \"MenuLine\""
	myItem < uid=D00CF654651EDC180009AA55C9220C37 > = items_Collectibles_JetsHeist_05 D00CF654651EDB740009AA2864A9A89C
}

DatabankKordosJournalEntry Collectibles_JetsJournals_34 < uid=D00CF654651EDC180009AA564BB4AAC8 >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 34 - transcription\", enabled = true, guid = #D00CF654651EDC010009AA4F626867AD, lineVersion = 79, maxLength = 50, productId = 6, sectionId = 10534, text = \"<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Forget it, Raatha! You're not getting Dorhal's cut.\n\n<font preset=\\"Medium Bodytext\\">RAATHA:</font> Hey, I did my part!\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Well, you didn't do it well.\n\n<font preset=\\"Medium Bodytext\\">RAATHA:</font> Kriff's sake, Jet! I told you, they moved security inside! I couldn't get a shot!\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> You're a professional bounty hunter. You're telling me you couldn't get a single shot? Makes me wonder if you and Dorhal--\n\n<font preset=\\"Medium Bodytext\\">RAATHA:</font> Hey! I took those goons off your back when you escaped. I'm in this as much as you!\n\n<font preset=\\"Medium Bodytext\\">H1-0N:</font> Jet, she's correct. If it wasn't for Raatha, you would have gotten caught.\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> And that was her fault to begin with.\n\n<font preset=\\"Medium Bodytext\\">RAATHA:</font> Fine! I'm leaving. But don't come to me when you need a crew, Jet, because I'm never working with you again.\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651EDC180009AA574AFB5BB3 > = items_Collectibles_JetsHeist_06 D00CF654651EDB740009AA2AEC3A50D6
}

DatabankKordosJournalEntry Collectibles_JetsJournals_35 < uid=D00CF654651EDC180009AA58A3E89D4A >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 35 - transcription\", enabled = true, guid = #D00CF654651EDC100009AA53DA3B6EBB, lineVersion = 81, maxLength = 50, productId = 6, sectionId = 10534, text = \"<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Naist? You here? Please tell me you've got some good news...\n\n<font preset=\\"Medium Bodytext\\">NAIST:</font> Jet? Jet... I'm back here...\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Hey-- woah. What happened to you.\n\n<font preset=\\"Medium Bodytext\\">NAIST:</font> That doshing Rodian didn't have my back. Had to handle the Hutts myself.\n\n<font preset=\\"Medium Bodytext\\">H1-0N:</font> Naist, let me assess your injuries.\n\n<font preset=\\"Medium Bodytext\\">NAIST:</font> It's fine... just give me my cut and I'm out.\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Your... wait, you didn't bring anything with you?\n\n<font preset=\\"Medium Bodytext\\">NAIST:</font> You kidding me now, Kordo? Does it look like I could have carried anything here? I'm lucky I got out at all!\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> You useless--! If you think you're getting a single credit...\n\n<font preset=\\"Medium Bodytext\\">H1-0N:</font> Jet, please. Stop.\n\n<font preset=\\"Medium Bodytext\\">JET KORDO:</font> Hion..? Hion, can you stand? Come on, I... I'll take you back to the ship...\", type = \"MenuLine\""
	myItem < uid=D00CF654651EDC180009AA597A727EB4 > = items_Collectibles_JetsHeist_07 D00CF654651EDB740009AA2CA7C4A784
}

DatabankKordosJournalEntry Collectibles_JetsJournals_36 < uid=D00CF654651EDD030009AA5E6D940C1F >
{
	myDescription "aurabesh = false, branch = \"\", contextComment = \"Databank - Collectible - Jet's Journals - 36 - transcription\", enabled = true, guid = #D00CF654651EDCEF0009AA5D0A430436, lineVersion = 81, maxLength = 50, productId = 6, sectionId = 10534, text = \"Hion... Hion, it's Jet... though I guess you can't hear me anymore.\n\nLook, I never meant for this to happen. The crew betrayed me. I didn't have a choice...\n\nGuess it's true what they say, that this job isn't meant for friends. Easier to split the credits when it's just yourself, right?\n\nThere's nothing I can do for you. I gotta disappear... ditch the Trailblazer...\n\nI just want you to know, I'm not the bad guy here. I just... work best alone.\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651EDD030009AA5F2D6D0E3C > = items_Collectibles_JetsHeist_08 D00CF654651EDB740009AA2E7C3F6719
}

