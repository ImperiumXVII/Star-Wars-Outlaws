{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - Glamok&Yabassi03 - 13 - description\", enabled = true, guid = #D00CF654651D5B370000D08E4D1ED2AD, lineVersion = 17, maxLength = 50, productId = -1, sectionId = 3640, text = \"A police procedural series featuring the unlikely pairing of two Coruscant Police officers who couldn’t be more different, but who share a passion for truth and justice.\", type = \"MenuLine\""
	myIcon "mySpriteId = -689299570, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_glarnokyabassi.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_glarnok_and_yabassi_03_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama glamok&yabassi_03\", enabled = true, guid = #6D16199B654A5C8C0028583B17F7F73B, lineVersion = 9, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on Glarnok & Yabassi...\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> Hands up, Frudeki. You're not gonna squeeze yourself outta this one.\n<font preset=\\"Medium Bodytext\\">MAYOR FRUDEKI:</font> Detective Yabassi. Glarnok. Is this supposed to be some kind of joke?\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> The only joke is the one you've been pulling on your hard-working Imperial constituents!\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> You're under arrest on suspicion of fraud and murder. You can't hide behind your office anymore.\n<font preset=\\"Medium Bodytext\\">MAYOR FRUDEKI:</font> Well, let's head to the station and I'm sure we can sort this out...\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> Glarnok! Look out!\n<font preset=\\"Medium Bodytext\\">MAYOR FRUDEKI:</font> For the Rebel Alliance!\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> Traitor!\", type = \"MenuLine\""
	myItem < uid=D00CF654651D5B460000D0920CA4837A > = items_Collectibles_Holodramas_Glamok&Yabassi03_13 D00CF654651D57780000D05D82E4C985
}

DatabankHolodramaEntry Collectibles_Holodramas_AdventuresofFluxRomak02_14 < uid=D00CF654651D5B970000D09BE5C28FF5 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - AdventuresofFluxRomak02 - 14 - description\", enabled = true, guid = #D00CF654651D5B5E0000D096333C16E6, lineVersion = 16, maxLength = 50, productId = -1, sectionId = 3640, text = \"An action-adventure series about the Galactic Commander Flux Romak and his adventures in Wild Space.\", type = \"MenuLine\""
	myIcon "mySpriteId = 1665528304, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_02.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_fluxmagnetar.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_flux_romak_02_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama adventureofflux_02\", enabled = true, guid = #6D16199B654A5CC800285E327F4EDBDC, lineVersion = 7, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on The Adventures of Flux Magnetar...\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> Dornigar's done, but I'm not leaving until Bolaxia is free.\n<font preset=\\"Medium Bodytext\\">BOLAXIAN FARMER 1:</font> It's too late... all our soldiers are captured. You can't defeat the King yourself.\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> No, not by myself... all of you will help.\n<font preset=\\"Medium Bodytext\\">BOLAXIAN FARMER 2:</font> But how? We're but simple krill farmers! We won't stand a chance against the King's guard.\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> Back on my home planet, I used to be a farmer too... I woke up at dawn and carried barrels of dustgrain all day. But when I enlisted, I realized I had been training my whole life.\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> With my help, you will all turn from farmers into the fiercest warriors in all of Wild Space. And together, we will finally free Bolaxia!\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651D5B970000D09C43F5916E > = items_Collectibles_Holodramas_AdventuresofFluxRomak02_14 D00CF654651D57780000D05F00D1521E
}

DatabankHolodramaEntry Collectibles_Holodramas_AdventuresofFluxRomak03_15 < uid=D00CF654651D5B970000D09DB30CC4A6 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - AdventuresofFluxRomak03 - 15 - description\", enabled = true, guid = #D00CF654651D5B8A0000D09A5176F967, lineVersion = 17, maxLength = 50, productId = -1, sectionId = 3640, text = \"An action-adventure series about the Galactic Commander Flux Romak and his adventures in Wild Space.\", type = \"MenuLine\""
	myIcon "mySpriteId = 1665528304, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_02.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_fluxmagnetar.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_flux_romak_03_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama adventureofflux_03\", enabled = true, guid = #6D16199B654A5CDB00286023680156C9, lineVersion = 8, maxLength = 0, productId = 6, sectionId = 10539, text = '<font preset=\"Medium Bodytext\">ANNOUNCER:</font> Previously on The Adventures of Flux Magnetar...\n<font preset=\"Medium Bodytext\">FLUX MAGNETAR:</font> We have seized the fortress! Shatter the cages. Let the proud people of Bolaxia run free!\n<font preset=\"Medium Bodytext\">DORNIGAR:</font> Flux Magnetar... look how far you have come.\n<font preset=\"Medium Bodytext\">FLUX MAGNETAR:</font> Dornigar? But... I saw you fall.\n<font preset=\"Medium Bodytext\">DORNIGAR:</font> And yet here I stand. You know, we are not so different, you and I. We will both do anything to get what we want.\n<font preset=\"Medium Bodytext\">PEMA:</font> Flux! Help me!\n<font preset=\"Medium Bodytext\">FLUX MAGNETAR:</font> Let him go, Dornigar! The fleet is on the way. You have already lost.\n<font preset=\"Medium Bodytext\">DORNIGAR:</font> But will they be here in time to save your love? What do you say, Flux? Can you risk it?', type = \"MenuLine\""
	myItem < uid=D00CF654651D5B970000D09E5557AE61 > = items_Collectibles_Holodramas_AdventuresofFluxRomak03_15 D00CF654651D57780000D061E15E3571
}

