	myIcon "mySpriteId = -689299570, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_glarnokyabassi.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_glarnok_and_yabassi_02_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama glamok&yabassi_02\", enabled = true, guid = #6D16199B654A5C770028560222E422E2, lineVersion = 9, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on Glarnok & Yabassi...\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> Yabassi, what are you doing here?\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> What, I'm gonna let my partner just sit alone in bacta all day? Forget it, Glarnok. Besides, I need your help with the case.\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> Oh yeah? What's the problem?\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> I traced the blaster to a shop on level 1313. But get this: there are no records of the shop existing in the first place.\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> That's gotta be a mistake. A blaster can't just pop up outta nowhere.\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> That's what I'm thinking. So I looked up the revisions. And get this - the lot's signed to someone we know.\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> Frudeki..? But that's...\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> That's right, Glarnok. It's mayor Frudeki himself!\", type = \"MenuLine\""
	myItem < uid=D00CF654651D5B460000D090028BEC60 > = items_Collectibles_Holodramas_Glamok&Yabassi02_12 D00CF654651D57780000D05B0A0B080F
}

