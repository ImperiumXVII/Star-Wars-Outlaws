	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - BaradiumDynasty 01- 01 - description\", enabled = true, guid = #D00CF65464F89BC100009CE8B3B9CE5C, lineVersion = 11, maxLength = 50, productId = -1, sectionId = 3640, text = \"A long-running serialized drama about two competing dynasties in the lucrative baradium industry. \", type = \"MenuLine\""
	myIcon "mySpriteId = -1803972174, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_baradiumdynasty.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_baradium_dynasty_01_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama BaradiumDynasty_01\", enabled = true, guid = #6D16199B654A5A8A002828018354C6DD, lineVersion = 14, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on Baradium Dynasty...\n<font preset=\\"Medium Bodytext\\">TALESH:</font> I can't see you anymore... I think my father knows.\n<font preset=\\"Medium Bodytext\\">DIARA:</font> So what if he knows? We have nothing to be ashamed of. I love you.\n<font preset=\\"Medium Bodytext\\">TALESH:</font> I know... but the thing is. There's something I've been meaning to tell you.\n<font preset=\\"Medium Bodytext\\">DIARA:</font> What is it? You can tell me anything.\n<font preset=\\"Medium Bodytext\\">TALESH:</font> Your mother. She's...\n<font preset=\\"Medium Bodytext\\">DIARA:</font> ...finally given you the promotion?\n<font preset=\\"Medium Bodytext\\">TALESH:</font> No... your mother proposed to me... and I said yes.\", type = \"MenuLine\""
	myItem < uid=D00CF65464F89BF90000C75A98202745 > = items_Collectibles_Holodramas_BaradiumDynasty01_01 D00CF65464F875EF0000C8EE5689F28A
}

DatabankHolodramaEntry Collectibles_Holodramas_FamilyonFrontierWorlds01_02 < uid=D00CF65464F89CA10002D61B9A25D1A7 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - FamilyonFrontierWorlds01 - 02 - description\", enabled = true, guid = #D00CF65464F89C8C0002D6163BE12D4C, lineVersion = 11, maxLength = 50, productId = -1, sectionId = 3640, text = \"A heart-felt drama series about a family of settlers that overcomes the many hardships of life in the Outer Rim.\", type = \"MenuLine\""
	myIcon "mySpriteId = 627278155, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_familyfrontier.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_frontier_worlds_01_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama FamilyFrontier_01\", enabled = true, guid = #6D16199B654A5B7E00283FE57A08E570, lineVersion = 8, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Last time on Family of the Frontier Worlds...\n<font preset=\\"Medium Bodytext\\">DOC:</font> I've got some bad news...\n<font preset=\\"Medium Bodytext\\">MALINA:</font> What is it, doc?\n<font preset=\\"Medium Bodytext\\">DOC:</font> The infection. It's worse than I thought. I tried cleaning the wound but...\n<font preset=\\"Medium Bodytext\\">SUNA:</font> Mama, what does that mean?\n<font preset=\\"Medium Bodytext\\">DOC:</font> If we don't get that bacta within the hour... I don't think she'll survive the night.\n<font preset=\\"Medium Bodytext\\">MALINA:</font> Well that settles it.\n<font preset=\\"Medium Bodytext\\">SUNA:</font> Mama? Where are you going?\n<font preset=\\"Medium Bodytext\\">MALINA:</font> I'm going to get that bacta.\n<font preset=\\"Medium Bodytext\\">DOC:</font> But there's a storm out there!\n<font preset=\\"Medium Bodytext\\">MALINA:</font> I know... but for void's sake, I will not lose another bantha.\", type = \"MenuLine\""
	myItem < uid=D00CF65464F89CA10002D61CB6BDF5AE > = items_Collectibles_Holodramas_FamilyonFrontierWorlds01_02 D00CF65464F8766E0000C8FFE996C897
}

DatabankHolodramaEntry Collectibles_Holodramas_LoveOnDeckFive01_03 < uid=D00CF65464F89CA10002D61D8C229A3F >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - LoveOnDeckFive01 - 03 - description\", enabled = true, guid = #D00CF65464F89C970002D61A0078CCC3, lineVersion = 13, maxLength = 50, productId = -1, sectionId = 3640, text = \"A romantic comedy series about an exclusive Chandrilan cruiser that has both guests and crew members alike get swept off their feet in the face of love.\", type = \"MenuLine\""
	myIcon "mySpriteId = 1628180829, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_lovedeck.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_love_on_deck_01_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama loveondeckfive_01\", enabled = true, guid = #6D16199B654A5BD400284884A217EED2, lineVersion = 8, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> You're watching Love on Deck 5...\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> This ship is a lot fancier than I thought, Captain. But there's one thing I would change.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> Change! That's impossible!\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Every night, I'm sitting alone in the dining room. I'm the most famous singer in the Core, but no one ever asks me to dinner.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> Well, we can't have that. Will you do me the honor tonight?\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Why Captain, are you asking me out on a date?\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> I believe I am.\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Well fine, but make sure your chief officer knows. I'm trying to make her jealous.\", type = \"MenuLine\"}"
	myItem < uid=D00CF65464F89CA10002D61E4AFA41AC > = items_Collectibles_Holodramas_LoveonDeckFive01_03 D00CF65464F876860000C90B8D1EDA48
}

DatabankHolodramaEntry Collectibles_Holodramas_Glamok&Yabassi01_04 < uid=D00CF6546514004800011E6305065F88 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - Glamok&Yabassi01 - 04- description\", enabled = true, guid = #D00CF6546514002500011E5E3BD4171D, lineVersion = 15, maxLength = 50, productId = -1, sectionId = 3640, text = \"A police procedural series featuring the unlikely pairing of two Coruscant Police officers who couldn’t be more different, but who share a passion for truth and justice.\", type = \"MenuLine\""
	myIcon "mySpriteId = -689299570, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_glarnokyabassi.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_glarnok_and_yabassi_01_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama glamok&yabassi_01\", enabled = true, guid = #6D16199B654A5C53002852506D043A91, lineVersion = 7, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on Glarnok & Yabassi...\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> Really, sleemo? You're telling me these droids just started robbing vaults on their own?\n<font preset=\\"Medium Bodytext\\">DROIDSMITH:</font> Honest, officer. I don't know what you're talking about.\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> He's pulling your tendril, Yabassi. That's an expensive looking jacket for an average droidsmith.\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> Yeah... you're right. Where'd you get that jacket, friend?\n<font preset=\\"Medium Bodytext\\">DROIDSMITH:</font> What, this old thing? Bought it used... down on level 1420... it's a fake.\n<font preset=\\"Medium Bodytext\\">GLARNOK:</font> Looks like the real deal to me. Alright, we’re taking you to the station.\n<font preset=\\"Medium Bodytext\\">ASSASSIN DROID:</font> [Beeps ominously]\n<font preset=\\"Medium Bodytext\\">YABASSI:</font> Glarnok! Look out!\", type = \"MenuLine\""
	myItem < uid=D00CF6546514004800011E64E526C125 > = items_Collectibles_Holodramas_Glamok&Yabassi01_04 D00CF6546513FFFD00011E57A0EC3C19
}

DatabankHolodramaEntry Collectibles_Holodramas_AdventuresofFluxRomak01_05 < uid=D00CF6546514004800011E65BD5F3CBC >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - AdventuresofFluxRomak01 - 05 - description\", enabled = true, guid = #D00CF6546514003B00011E62F291B633, lineVersion = 15, maxLength = 50, productId = -1, sectionId = 3640, text = \"An action-adventure series about the Galactic Commander Flux Romak and his adventures in Wild Space.\", type = \"MenuLine\""
	myIcon "mySpriteId = 1665528304, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_02.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_fluxmagnetar.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_flux_romak_01_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama adventureofflux_01\", enabled = true, guid = #6D16199B654A5CA700285ACB0804D526, lineVersion = 8, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on The Adventures of Flux Magnetar...\n<font preset=\\"Medium Bodytext\\">DORNIGAR:</font> Flux Magnetar. Only you could be so bold to stage an uprising against the King.\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> Let 'em go, Dornigar. This is between you and me.\n<font preset=\\"Medium Bodytext\\">DORNIGAR:</font> If only it were so simple. The King has ordained me judge and jury, Flux. And I'm afraid I have no choice but to give you the strictest punishment on Bolaxia.\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> Go ahead... do your worst.\n<font preset=\\"Medium Bodytext\\">DORNIGAR:</font> So be it. Flux Magnetar, I sentence you to trial by combat... in the burning pits of Mount Vardosh!\n<font preset=\\"Medium Bodytext\\">PEMA:</font> Oh Flux...\n<font preset=\\"Medium Bodytext\\">FLUX MAGNETAR:</font> Don't worry, darling. I'll find a way out. Somehow...\", type = \"MenuLine\""
	myItem < uid=D00CF6546514004800011E66C200250A > = items_Collectibles_Holodramas_AdventuresofFluxRomak01_05 D00CF6546513FFFD00011E5918B4C2A1
}

DatabankHolodramaEntry Collectibles_Holodramas_BaradiumDynasty02_06 < uid=D00CF654651D5A740000D06769622C37 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - BaradiumDynasty 02- 06 - description\", enabled = true, guid = #D00CF654651D5A5F0000D066BED38B55, lineVersion = 12, maxLength = 50, productId = -1, sectionId = 3640, text = \"A long-running serialized drama about two competing dynasties in the lucrative baradium industry. \", type = \"MenuLine\""
	myIcon "mySpriteId = -1803972174, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_baradiumdynasty.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_baradium_dynasty_02_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama BaradiumDynasty_02\", enabled = true, guid = #6D16199B654A5B4400283A10C4864F4F, lineVersion = 8, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on Baradium Dynasty...\n<font preset=\\"Medium Bodytext\\">TALESH:</font> I did it. I told Diara about us.\n<font preset=\\"Medium Bodytext\\">DIARA’S MOTHER:</font> That's great, darling. Now we can move ahead with the wedding.\n<font preset=\\"Medium Bodytext\\">TALESH:</font> It's just... it feels like we're moving too fast.\n<font preset=\\"Medium Bodytext\\">DIARA’S MOTHER:</font> Too fast? The wedding's in a week. If you're having doubts, you can always... talk to me.\n<font preset=\\"Medium Bodytext\\">TALESH:</font> No it's just... the last thing I want is for this to be about credits.\n<font preset=\\"Medium Bodytext\\">DIARA’S MOTHER:</font> Don't worry, darling. It's all there in the prenuptial. I just need your holo-seal. Sign it, and all will be well...\", type = \"MenuLine\""
	myItem < uid=D00CF654651D5A740000D068638CAF66 > = items_Collectibles_Holodramas_BaradiumDynasty02_06 D00CF654651D56B10000CFF748777890
}

DatabankHolodramaEntry Collectibles_Holodramas_BaradiumDynasty03_07 < uid=D00CF654651D5AC20000D06DE7B255E0 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - BaradiumDynasty 03- 07 - description\", enabled = true, guid = #D00CF654651D5AB00000D06C0F763F2C, lineVersion = 13, maxLength = 50, productId = -1, sectionId = 3640, text = \"A long-running serialized drama about two competing dynasties in the lucrative baradium industry. \", type = \"MenuLine\""
	myIcon "mySpriteId = -1803972174, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_baradiumdynasty.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_baradium_dynasty_03_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama BaradiumDynasty_03\", enabled = true, guid = #6D16199B654A5B5D00283CB9FFDB23EE, lineVersion = 9, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Previously on Baradium Dynasty...\n<font preset=\\"Medium Bodytext\\">DIARA:</font> How could you do this, mother? Talesh Makeric was my lover!\n<font preset=\\"Medium Bodytext\\">DIARA’S MOTHER:</font> Oh calm yourself, Diara. I'm only marrying him for the credits. In a cycle, we'll be divorced and he's all yours.\n<font preset=\\"Medium Bodytext\\">DIARA:</font> But... he doesn't even want me anymore.\n<font preset=\\"Medium Bodytext\\">DIARA’S MOTHER:</font> Well, what do you expect from a Makeric. They're all the same. Cold, heartless...\n<font preset=\\"Medium Bodytext\\">TALESH:</font> Cruel?\n<font preset=\\"Medium Bodytext\\">DIARA:</font> Talesh? What are you doing here?\n<font preset=\\"Medium Bodytext\\">TALESH:</font> I'm afraid I have some bad news. There was an accident at the refinery. My father... he's dead.\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651D5AC20000D06E70A2C968 > = items_Collectibles_Holodramas_BaradiumDynasty03_07 D00CF654651D56B10000CFF9D3D4541D
}

DatabankHolodramaEntry Collectibles_Holodramas_FamilyonFrontierWorlds02_08 < uid=D00CF654651D5ADE0000D073A1D63581 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - FamilyonFrontierWorlds02 - 08 - description\", enabled = true, guid = #D00CF654651D5AC50000D072EE777719, lineVersion = 12, maxLength = 50, productId = -1, sectionId = 3640, text = \"A heart-felt drama series about a family of settlers that overcomes the many hardships of life in the Outer Rim.\", type = \"MenuLine\""
	myIcon "mySpriteId = 627278155, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_familyfrontier.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_frontier_worlds_02_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama FamilyFrontier_02\", enabled = true, guid = #6D16199B654A5B9F00284341627E9A5A, lineVersion = 8, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Last time on Family of the Frontier Worlds...\n<font preset=\\"Medium Bodytext\\">MALINA:</font> Well, the storm's finally over, but it's gonna take a lot of repairs.\n<font preset=\\"Medium Bodytext\\">SUNA:</font> I can help, mama. C-85 showed us how to solder in school.\n<font preset=\\"Medium Bodytext\\">MALINA:</font> I know, honey... but it'll take a bit more than that save the farm. With the crops all but destroyed... we might have to sell the skyhopper.\n<font preset=\\"Medium Bodytext\\">NOJAK:</font> I can't believe you!\n<font preset=\\"Medium Bodytext\\">MALINA:</font> Nojak, wait... ugh, there he goes again.\n<font preset=\\"Medium Bodytext\\">SUNA:</font> Where's he going, mama?\n<font preset=\\"Medium Bodytext\\">MALINA:</font> Probably running with that swoop gang down by the river... but I hope I'm wrong...\", type = \"MenuLine\""
	myItem < uid=D00CF654651D5ADE0000D074DEB66F0A > = items_Collectibles_Holodramas_FamilyonFrontierWorlds02_08 D00CF654651D56F40000D0119C318BE1
}

DatabankHolodramaEntry Collectibles_Holodramas_FamilyonFrontierWorlds03_09 < uid=D00CF654651D5AF00000D079A461F085 >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - FamilyonFrontierWorlds03 - 09 - description\", enabled = true, guid = #D00CF654651D5AE00000D078BE6253E1, lineVersion = 13, maxLength = 50, productId = -1, sectionId = 3640, text = \"A heart-felt drama series about a family of settlers that overcomes the many hardships of life in the Outer Rim.\", type = \"MenuLine\""
	myIcon "mySpriteId = 627278155, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_familyfrontier.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_frontier_worlds_03_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama FamilyFrontier_03\", enabled = true, guid = #6D16199B654A5BB5002845795643149C, lineVersion = 7, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> Last time on Family of the Frontier Worlds...\n<font preset=\\"Medium Bodytext\\">MALINA:</font> Nojak. It's time to come home.\n<font preset=\\"Medium Bodytext\\">NOJAK:</font> Why? So you can boss me around the farm. Take away everything I love? No, I'm done with that.\n<font preset=\\"Medium Bodytext\\">MALINA:</font> So you'd rather hang around here, selling pell rocks with these swoop heads?\n<font preset=\\"Medium Bodytext\\">NOJAK:</font> They're my friends.\n<font preset=\\"Medium Bodytext\\">MALINA:</font> You can tell yourself that. But we both know this isn't the life you wanted. You had dreams. You were gonna be a pilot.\n<font preset=\\"Medium Bodytext\\">NOJAK:</font> How would I do that if we don't even have a skyhopper?\n<font preset=\\"Medium Bodytext\\">MALINA:</font> We'll figure it out... we always do. Just come home, Nojak... come home.\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651D5AF00000D07A386DBBA3 > = items_Collectibles_Holodramas_FamilyonFrontierWorlds03_09 D00CF654651D56F40000D013214E01AE
}

DatabankHolodramaEntry Collectibles_Holodramas_LoveOnDeckFive02_10 < uid=D00CF654651D5B200000D0830EFB6C4A >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - LoveOnDeckFive02 - 10 - description\", enabled = true, guid = #D00CF654651D5AF30000D07EB44DE182, lineVersion = 14, maxLength = 50, productId = -1, sectionId = 3640, text = \"A romantic comedy series about an exclusive Chandrilan cruiser that has both guests and crew members alike get swept off their feet in the face of love.\", type = \"MenuLine\""
	myIcon "mySpriteId = 1628180829, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_lovedeck.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_love_on_deck_02_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama loveondeckfive_02\", enabled = true, guid = #6D16199B654A5BF600284BF820C95B3F, lineVersion = 9, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> You're watching Love on Deck 5...\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Well Captain, I must thank you for a lovely evening.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> The pleasure's all mine.\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> But I think your waiter should skip the hover boots next time.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> I'll make sure to tell them.\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Do you think your chief officer saw us?\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> With those horns, you're quite hard to miss.\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Oh Captain... you're not making this easy on me.\", type = \"MenuLine\"}"
	myItem < uid=D00CF654651D5B200000D084EE61EDE6 > = items_Collectibles_Holodramas_LoveonDeckFive02_10 D00CF654651D57120000D02077043B75
}

DatabankHolodramaEntry Collectibles_Holodramas_LoveOnDeckFive03_11 < uid=D00CF654651D5B200000D0857430B87C >
{
	myDescription "aurabesh = false, contextComment = \"Databank - Collectible - Holodramas - LoveOnDeckFive03 - 11 - description\", enabled = true, guid = #D00CF654651D5B100000D082E80F9DD4, lineVersion = 15, maxLength = 50, productId = -1, sectionId = 3640, text = \"A romantic comedy series about an exclusive Chandrilan cruiser that has both guests and crew members alike get swept off their feet in the face of love.\", type = \"MenuLine\""
	myIcon "mySpriteId = 1628180829, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_databank_holodramas_icon_01.spritesheet\""
	myTextureIcon helix/baked/ui/loose_images/databank/holodramas/databank_holodramas_thumbnail_lovedeck.dds
	myAudioLog helix/dialoguegraphs/a_collectibles_holodramas_love_on_deck_03_graph.mdialoguegraph
	myAudioTranscription "aurabesh = false, branch = \"\", contextComment = \"Audiotranscription of the holodrama loveondeckfive_03\", enabled = true, guid = #6D16199B654A5C0800284DC836DA92B9, lineVersion = 10, maxLength = 0, productId = 6, sectionId = 10539, text = \"<font preset=\\"Medium Bodytext\\">ANNOUNCER:</font> You're watching Love on Deck 5...\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> I'm sorry it didn't work out with the chief officer.\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> It's like they say, Captain. You only butcher the songs you don't sing.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> I don't think I've heard that expression...\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> At any rate, I hope we will see you again.\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> Oh, you will. I just booked another ticket.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> You did?\n<font preset=\\"Medium Bodytext\\">BELLIS:</font> So you'd better practice that valachord, because tomorrow night I'm bringing you up on stage.\n<font preset=\\"Medium Bodytext\\">CAPTAIN:</font> On stage? That's impossible!\", type = \"MenuLine\""
	myItem < uid=D00CF654651D5B200000D086E0456A13 > = items_Collectibles_Holodramas_LoveonDeckFive03_11 D00CF654651D57250000D02D2493F4E5
}

