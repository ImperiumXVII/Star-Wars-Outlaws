		myTumbleMaxDuration 2.5
		myTumblingType LoseControl
		myShouldTargetColliders TRUE
		myTumbleFindTargetRadius 1500.0
		myTumbleFindTargetAngle 45.0
		myTumbleFallingCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -500 0, }, outTangents = { 500 0, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 2000 -2000, }, }, numKeys = 2, }"
