include snowdrop/font/fontfamily.fruit

FontFamilies myFontFamilies
{
	FontFamily Aurebesh
	{
		Regular helix/baked/ui/fonts/Aurebesh/LFL_AUREBESH.TTF
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 16
				myLineHeight 11
				myAscenderHeight 6
				myDescenderHeight -5
			}
		}
	}
	FontFamily FuturaNowHeadline
	{
		Bold helix/baked/ui/fonts/FuturaNow/FuturaNowHeadline-Blk.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
				myLineHeight -60
				myAscenderHeight -38
				myDescenderHeight 22
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
			FontFamilyLanguageBackup japanese
			{
				myLanguageName japanese
				myFontFamilies "Shorai Sans"
			}
			FontFamilyLanguageBackup korean
			{
				myLanguageName korean
				myFontFamilies "Hanyang Headline"
			}
			FontFamilyLanguageBackup simplifiedchinese
			{
				myLanguageName simplifiedchinese
				myFontFamilies DFPHeiW7-A
			}
			FontFamilyLanguageBackup traditionalchinese
			{
				myLanguageName traditionalchinese
				myFontFamilies DFPNHeiXBold-B5
			}
		}
	}
	FontFamily ProximaNova
	{
		Regular helix/baked/ui/fonts/Proxima_nova/ProximaNova-Regular.otf
		Bold helix/baked/ui/fonts/Proxima_nova/ProximaNova-Bold.otf
		RegularItalic helix/baked/ui/fonts/Proxima_nova/ProximaNova-RegularIt.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 48
				myLineHeight -8
				myAscenderHeight -4
				myDescenderHeight 4
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
			FontFamilyLanguageBackup japanese
			{
				myLanguageName japanese
				myFontFamilies "Arial Unicode"
			}
			FontFamilyLanguageBackup korean
			{
				myLanguageName korean
				myFontFamilies "Arial Unicode"
			}
			FontFamilyLanguageBackup simplifiedchinese
			{
				myLanguageName simplifiedchinese
				myFontFamilies DFPHeiW3-A
			}
			FontFamilyLanguageBackup traditionalchinese
			{
				myLanguageName traditionalchinese
				myFontFamilies DFPHeiMedium-B5
			}
		}
	}
	FontFamily Marvin
	{
		Bold helix/baked/ui/fonts/Marvin/MarvinVisionsBig-Bold.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 40
				myLineHeight -14
				myAscenderHeight -8
				myDescenderHeight 6
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
			FontFamilyLanguageBackup japanese
			{
				myLanguageName japanese
				myFontFamilies "Shorai Sans"
			}
			FontFamilyLanguageBackup korean
			{
				myLanguageName korean
				myFontFamilies "Hanyang Headline"
			}
			FontFamilyLanguageBackup simplifiedchinese
			{
				myLanguageName simplifiedchinese
				myFontFamilies DFPHeiW7-A
			}
			FontFamilyLanguageBackup traditionalchinese
			{
				myLanguageName traditionalchinese
				myFontFamilies DFPNHeiXBold-B5
			}
		}
	}
	FontFamily Scoundrels_MS
	{
		Regular helix/baked/ui/fonts/scoundrels/Scoundrels+Arabic.otf
	}
	FontFamily "----------- Fallback Fonts ------------"
	{
	}
	FontFamily "Shorai Sans"
	{
		Bold "helix/baked/ui/fonts/localization-fonts/Shorai Sans StdN - Extra Bold.ttf"
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
				myLineHeight -27
				myAscenderHeight -13
				myDescenderHeight 14
			}
		}
	}
	FontFamily "Hanyang Headline"
	{
		Regular ""
		Bold "helix/baked/ui/fonts/localization-fonts/Hanyang Headline Bold.ttf"
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
				myLineHeight -10
				myAscenderHeight -10
			}
		}
	}
	FontFamily "Arial Unicode"
	{
		Regular "helix/baked/ui/fonts/localization-fonts/Arial Unicode MS.TTF"
		Medium ""
		Bold ""
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 32
				myLineHeight -4
				myAscenderHeight -2
				myDescenderHeight 2
			}
		}
	}
	FontFamily DFPHeiW3-A
	{
		Regular helix/baked/ui/fonts/localization-fonts/DFPHeiW3-A.ttf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 32
				myLineHeight 2
				myAscenderHeight 1
				myDescenderHeight -1
			}
		}
	}
	FontFamily DFPHeiW7-A
	{
		Regular ""
		Medium helix/baked/ui/fonts/localization-fonts/DFPHeiW7-A.ttf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
			}
		}
	}
	FontFamily DFPNHeiXBold-B5
	{
		Bold helix/baked/ui/fonts/localization-fonts/DFPNHeiXBold-B5.ttf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
			}
		}
	}
	FontFamily DFPHeiMedium-B5
	{
		Medium helix/baked/ui/fonts/localization-fonts/DFPHeiMedium-B5.ttf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 32
				myLineHeight 2
				myAscenderHeight 1
				myDescenderHeight -1
			}
		}
	}
	FontFamily Arabic
	{
		Regular helix/baked/ui/fonts/arabic/ArialArabicMT.ttf
	}
	FontFamily Proxima-NoAsian
	{
		Regular helix/baked/ui/fonts/Proxima_nova/ProximaNova-Regular.otf
		Bold ""
		RegularItalic ""
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 48
				myLineHeight -8
				myAscenderHeight -4
				myDescenderHeight 4
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
		}
	}
	FontFamily FuturaNowHeadline-NoAsian
	{
		Bold helix/baked/ui/fonts/FuturaNow/FuturaNowHeadline-Blk.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
				myLineHeight -60
				myAscenderHeight -38
				myDescenderHeight 22
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
		}
	}
	FontFamily "----------- Credits Fonts ------------"
	{
	}
	FontFamily "FuturaNowHeadline Credits"
	{
		Bold helix/baked/ui/fonts/FuturaNow/FuturaNowHeadline-Blk.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 80
				myLineHeight -60
				myAscenderHeight -38
				myDescenderHeight 22
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
		}
	}
	FontFamily "Marvin Credits"
	{
		Bold helix/baked/ui/fonts/Marvin/MarvinVisionsBig-Bold.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 40
				myLineHeight -14
				myAscenderHeight -8
				myDescenderHeight 6
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
		}
	}
	FontFamily "ProximaNova Credits"
	{
		Regular helix/baked/ui/fonts/Proxima_nova/ProximaNova-Regular.otf
		Bold helix/baked/ui/fonts/Proxima_nova/ProximaNova-Bold.otf
		RegularItalic helix/baked/ui/fonts/Proxima_nova/ProximaNova-RegularIt.otf
		myMetricAdjustments
		{
			FontMetricAdjustment All
			{
				myRelativeToFontSize 48
				myLineHeight -8
				myAscenderHeight -4
				myDescenderHeight 4
			}
		}
		myLanguageSpecificBackupFontFamilies
		{
		}
	}
}

