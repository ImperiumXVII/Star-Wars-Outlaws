ButtonDisplayInfo "Display Information"
{
	myInlineButtonTextureScale 1.5
	myAndOperator "aurabesh = false, contextComment = 'This is added between button icons or names, if multiple are required to perform a single action. For example \"Ctrl + Space\".', enabled = true, guid = #15AAF5F66050E8160000003129057270, lineVersion = 5, maxLength = 0, productId = 6, sectionId = 375, text = \" + \", type = \"MenuLine\""
	myOrOperator "aurabesh = false, contextComment = \"\", enabled = true, guid = #15AAF5F663CEA5720000163B87006978, lineVersion = 1, maxLength = 0, productId = -1, sectionId = -1, text = \", \", type = \"MenuLine\""
	myUnboundButtonText "aurabesh = false, contextComment = \"This is shown when a button-press has not been bound to any available key. For example if the game wants to show the jump button, but no key is set as the jump button.\", enabled = true, guid = #15AAF5F66051D17200000262192B757F, lineVersion = 5, maxLength = 0, productId = 6, sectionId = 375, text = \"Unbound\", type = \"MenuLine\""
	myPositiveAxisFormat "aurabesh = false, contextComment = \"This format is applied to a button name or icon to indicate a positive direction. For example Up or Right. 0=Button Name/Icon\", enabled = true, guid = #15AAF5F661A646CB000019EC342DC3AB, lineVersion = 9, maxLength = 0, productId = 6, sectionId = 375, text = \"{0}+\", type = \"MenuLine\""
	myNegativeAxisFormat "aurabesh = false, contextComment = \"This format is applied to a button name or icon to indicate a negative direction. For example Down or Left. 0=Button Name/Icon\", enabled = true, guid = #15AAF5F661A646D5000019EED769E446, lineVersion = 9, maxLength = 0, productId = 6, sectionId = 375, text = \"{0}-\", type = \"MenuLine\""
	myAndOperatorSpeechSynthesis and
	myOrOperatorSpeechSynthesis ,
}

