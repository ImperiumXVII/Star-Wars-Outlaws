include "helix/game system data/fruit/ui/uievent.fruit"

UIEventSettingsRoot Root
{
	myUIEventQueues
	{
		UIEventQueueDefinition "Center Screen"
		{
			myId CenterScreen
			myQueueDependencies
			{
			}
			myIsActiveInUIStates
			{
				UIState "" Planet
				UIState "" Space
			}
			myUnallowedExecutionStates
			{
				UIExecutionState "" IsInLoadingScreen
				UIExecutionState "" ExclusiveMode
				UIExecutionState IsInCinematicTransition IsInCinematicTransition
			}
		}
		UIEventQueueDefinition General
		{
			myId General
			myQueueDependencies
			{
				UIEventQueueId "" CenterScreen
			}
			myIsActiveInUIStates
			{
				UIState "" Planet
				UIState "" Space
			}
			myUnallowedExecutionStates
			{
				UIExecutionState "" IsInLoadingScreen
				UIExecutionState "" ExclusiveMode
				UIExecutionState IsInCinematicTransition IsInCinematicTransition
			}
		}
		UIEventQueueDefinition Log
		{
			myId Log
			myIsActiveInUIStates
			{
				UIState "" Planet
				UIState "" Space
				UIState "" Cinematic
			}
			myUnallowedExecutionStates
			{
				UIExecutionState "" IsInLoadingScreen
				UIExecutionState IsInCinematicTransition IsInCinematicTransition
			}
		}
		UIEventQueueDefinition Situational
		{
			myId Situational
			myIsActiveInUIStates
			{
				UIState "New UIState (0)" Planet
				UIState "New UIState (1)" Space
			}
			myUnallowedExecutionStates
			{
				UIExecutionState "" IsInLoadingScreen
				UIExecutionState "" ExclusiveMode
				UIExecutionState IsInCinematicTransition IsInCinematicTransition
			}
		}
		UIEventQueueDefinition Ubiconnect
		{
			myId Ubiconnect
			myIsActiveInUIStates
			{
				UIState "" Frontend
				UIState "" Planet
				UIState "" Space
				UIState "" GameMenu
			}
			myUnallowedExecutionStates
			{
				UIExecutionState "Don't display when overlay is open" IsShowingUbiConnectOverlay
				UIExecutionState IsInCinematicTransition IsInCinematicTransition
			}
		}
		UIEventQueueDefinition Status
		{
			myId Status
			myIsActiveInUIStates
			{
				UIState "New UIState (1)" Planet
				UIState "New UIState (2)" Space
				UIState "New UIState (3)" Cinematic
			}
			myUnallowedExecutionStates
			{
				UIExecutionState "" IsInLoadingScreen
				UIExecutionState IsInCinematicTransition IsInCinematicTransition
			}
		}
	}
	myUIEvents
	{
		UIEventTypeGroup Character
		{
			UIEventType "Reputation Change"
			{
				myQueueId Log
				myDuration 5.0
				myTimeout 10.0
				myFields
				{
					varmap Faction "value = { #&16DEADE65F7DDB52000000D22C63D964, }, valueType = \"Faction Constant Data\""
					varmap "Change Direction" "value = 1, valueType = \"integer\""
					varmap Reason "value = { aurabesh = false, branch = \"\", contextComment = \"\", enabled = false, guid = #00000000000000000000000000000000, lineVersion = 0, maxLength = 0, productId = -1, sectionId = -1, text = \"\", type = \"MenuLine\", }, valueType = \"loc-string\""
					varmap Change "value = 0, valueType = \"integer\""
				}
			}
			UIEventType "Reputation Tier Change"
			{
				myQueueId CenterScreen
				myDuration 10.0
				myFields
				{
					varmap Faction "value = { #&16DEADE65F7DDB52000000D22C63D964, }, valueType = \"Faction Constant Data\""
					varmap "Prior Tier" "value = \"Terrible\", valueType = \"HC_ReputationTier\""
					varmap "New Tier" "value = \"Terrible\", valueType = \"HC_ReputationTier\""
					varmap "Prior Value" "value = 100, valueType = \"integer\""
					varmap "New Value" "value = 800, valueType = \"integer\""
					varmap "Change Direction" "value = 1, valueType = \"integer\""
					varmap "Tier Reached For The First Time" "value = false, valueType = \"bool\""
					varmap Reason "value = { aurabesh = false, branch = \"\", contextComment = \"\", enabled = false, guid = #00000000000000000000000000000000, lineVersion = 0, maxLength = 0, productId = -1, sectionId = -1, text = \"\", type = \"MenuLine\", }, valueType = \"loc-string\""
				}
			}
			UIEventType "Reputation Unlock"
			{
				myQueueId CenterScreen
				myDuration 6.0
				myIsDurationInfinite FALSE
				myIsTimeoutInfinite TRUE
				myFields
				{
					varmap Faction(s) "value = { #&16DEADE65F7DDA76000000C74AD19DCA, #&16DEADE65F7DDA76000000C847FBD2A1, }, valueType = \"Faction Constant Data\""
				}
			}
		}
