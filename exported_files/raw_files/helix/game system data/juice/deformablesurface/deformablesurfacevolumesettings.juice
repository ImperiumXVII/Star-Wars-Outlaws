		myFadeRenderDistance 50.0
		myMaxPersistanceDistance 120.0
		myRTSetting = "Sand RTQuality"
	}
	myMedium
	{
		myUseQuarterNormals TRUE
		myMaxSimulationDistance 50.0
		myMaxRenderDistance 150.0
		myFadeRenderDistance 100.0
		myMaxPersistanceDistance 170.0
		myRTSetting = "Sand RTQuality"
	}
	myHigh
	{
		myUseQuarterNormals TRUE
		myMaxSimulationDistance 100.0
		myMaxRenderDistance 200.0
		myFadeRenderDistance 150.0
		myMaxPersistanceDistance 220.0
		myRTSetting = "Sand RTQuality"
	}
	myUltra
	{
		myMaxSimulationDistance 150.0
		myMaxRenderDistance 250.0
		myFadeRenderDistance 200.0
		myMaxPersistanceDistance 350.0
		myRTSetting = "Sand RTQuality"
	}
	myMax
	{
		myMaxSimulationDistance -1.0
		myMaxRenderDistance -1.0
		myFadeRenderDistance -1.0
		myMaxPersistanceDistance -1.0
		myRTSetting = "Sand RTQuality"
	}
}

DeformableSurfaceSetting "Shallow Sand Texture" < uid=5E4B823163BFDB26000FBD74C0EE1AC6 >
{
	myHide FALSE
	myMaterial helix/materials/mat_deformable_surface_sand.mmaterial
	myTerrainType Sand
	myTexelsPerUnit 16
	myBlurRho 0.9
	myBlurStrength 0.8
	myMaxDeformationMultiplier 3.0
	myUseMedianFilterSmoothing TRUE
	myMedianFilterSamplePos 5
	myUseContrastEnhancement TRUE
	myLowerKeyPoint 0.1;0.2
	myUpperKeyPoint 0.8;0.9
	myGenerateObjectIdTexture FALSE
	myDeformableSurfaceAnimationSettings
	{
		myAnimationType Edge
		myAll
		{
			myDeformationAnimationEdgeThreshold 0.1
			myDeformationAnimationSpeedInMetersPerSecond 0.3
			myDeformationAnimationUpperLimit 0.8
		}
	}
	myCollisionMaterialName FluffySand
	myOverrideCollisionMaterialFromVolumeModifier TRUE
	myTrianglesPerMeter 64.0
	myMinDrawDist 4.0
	myLodDistPow 0.6
	myRTMaterialColor 0xffb18d6d
	myDeformableSurfaceQualitySettings : Sand_QualitySettings
	{
	}
	myUseExternalSDF FALSE
}

