{
	myMessage "aurabesh = false, branch = \"MAIN\", contextComment = \"An error message shown in a popup if the game for some reason tried to resume progress without being able to find any saved games. It instead suggests the player manually pick a game, or start a new one.\", enabled = true, guid = #BA9D046A659D87180000346666514AA3, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 10153, text = \"No saves to resume from. Can't resume game.\nPlease manually Load game or begin a New game.\", type = \"MenuLine\"}"
