ErrorMessage "[SaveGame] Season pass revoked" < uid=49D82446669908FE0005435C6CE303B0 >
{
	myMessage "branch = \"TU1\", contextComment = \"Error message triggered if the player's access to the season pass is revoked while they have progress in the season pass quest.\", enabled = true, guid = #49D82446669909010005435DB83AA120, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 10153, text = \"The <b>Star Wars Outlaws Season Pass</b> is not accessible. One or more save games require access to the Season Pass in order to play. These save games have been disabled.\n\nPlease purchase the Season Pass to enable these save games or load an older save game.\", type = \"MenuLine\"}"
}

