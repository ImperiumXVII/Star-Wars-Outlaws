	myDescription "branch = \"DLC2\", contextComment = \"Gameplay description for the second volatile cargo hold upgrade. With this cargo modifier, the cargo has some amount of Health. When the cargo is fully loaded, the player is prevented from healing the cargo, however with this upgrade this is negated.\", enabled = true, guid = #2AE2EC8567ADFB2700033ACADC2A6976, lineVersion = 10, maxLength = 0, productId = -1, sectionId = 12361, text = \"Allows repairs when the <b>cargo is fully loaded</b>.\", type = \"MenuLine\""
