{
	myDescription "branch = \"DLC2\", contextComment = \"Gameplay description for the first ionized cargo hold upgrade. With this cargo modifier, the cargo gains charge then becomes unstable for some time. During this time, the player is in danger as they take extra ion damage. With this upgrade, they take less damage when hit.\", enabled = true, guid = #2AE2EC8567AE015100033F1DE161C201, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 12361, text = \"Reduce <b>ion buildup gained</b> while the cargo is unstable.\", type = \"MenuLine\""
