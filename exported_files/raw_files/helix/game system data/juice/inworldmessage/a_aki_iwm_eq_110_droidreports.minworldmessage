InWorldMessage a_aki_Iwm_EQ_110_FirstReport < uid=C9E22992653918EA0000DF0C7B49B2CC > : a_aki_iwm_EQ_110_DroidReports
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Droid Reports  - 01 - Header\", enabled = true, guid = #C9E22992653918EA0000DEE77C5D48E8, lineVersion = 17, maxLength = 0, productId = 6, sectionId = 9265, text = \"Unit 647 reporting:\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Droid Reports  - 01 - Description\", enabled = true, guid = #C9E22992653918EA0000DEE83359544F, lineVersion = 16, maxLength = 0, productId = 6, sectionId = 9265, text = \"The onset of storm season has given the insurgents an insurmountable tactical advantage. Preparations are being made to evacuate Akiva.\n\nI am to defend the relay while units 437 and 416 deploy to the field. Risk is high. These conditions exceed our operational limits, and 437 is reporting difficulty on his approach to the Blood Tree. But we cannot fail.\", type = \"MenuLine\""
}

InWorldMessage a_aki_Iwm_EQ_110_SecondReport < uid=C9E22992653918EA0000DF0D99CF7592 > : a_aki_iwm_EQ_110_DroidReports
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Droid Reports  - 02 - Header\", enabled = true, guid = #C9E22992653918EA0000DEE9188911E3, lineVersion = 16, maxLength = 0, productId = 6, sectionId = 9265, text = \"Unit 437 reporting:\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Droid Reports  - 02 - Description\", enabled = true, guid = #C9E22992653918EA0000DEEAAC327087, lineVersion = 15, maxLength = 0, productId = 6, sectionId = 9265, text = \"Fortunately, the insurgents have yet to discover our fuel cache. But at this rate it will only be a matter of time before all our field positions are compromised. Unit 416 is en route to our northern base west of Sashin village to perform a full data wipe while I stay here and monitor enemy movements. We must not fail.\", type = \"MenuLine\""
}

InWorldMessage a_aki_Iwm_EQ_110_ThirdReport < uid=C9E22992653918EA0000DF0ED4C1DA77 > : a_aki_iwm_EQ_110_DroidReports
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Droid Reports  - 03 - Header\", enabled = true, guid = #C9E22992653918EA0000DEEB3ABE77E1, lineVersion = 15, maxLength = 0, productId = 6, sectionId = 9265, text = \"Unit 416 reporting:\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Droid Reports  - 03 - Description\", enabled = true, guid = #C9E22992653918EA0000DEECC3BCA7D5, lineVersion = 16, maxLength = 0, productId = 6, sectionId = 9265, text = \"The relay satellite is unresponsive. I have encoded our surveillance data directly into this report in case normal transmission fails.\n\nI will deploy detonation charges around the base to ensure it does not fall into insurgent hands. Unfortunately, the monsoon has damaged my actuators, so I am unlikely to escape the blast. But the mission demands we take such risks.\", type = \"MenuLine\""
}

