{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 All transmissions- Header\", enabled = true, guid = #C9E22992657084CC00105F0C31BE758B, lineVersion = 18, maxLength = 0, productId = 6, sectionId = 9264, text = \"Hidden transmission\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 All transmissions- Description\", enabled = true, guid = #C9E22992657084CC00105F0D2423375B, lineVersion = 19, maxLength = 0, productId = 6, sectionId = 9264, text = \"A message that was encoded in one of the Separatist transmissions. It contains coordinates on the surface of Akiva and an entry code.\", type = \"MenuLine\""
}

InWorldMessage a_aki_Iwm_EQ_110_GearRoom < uid=C9E229926569FB59000056B945FA9D86 > : a_aki_iwm_EQ_110_DroidReports
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Gear Room Lore - Header\", enabled = true, guid = #C9E229926569FB48000056B7D2B25C72, lineVersion = 16, maxLength = 0, productId = 6, sectionId = 9265, text = \"Final research log\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"InWorld Message - EQ_110 Gear Room- Description\", enabled = true, guid = #C9E229926569FB48000056B8A29FF2F6, lineVersion = 17, maxLength = 0, productId = 6, sectionId = 9265, text = \"Test Unit 08-B has produced fascinating results. The garment's cobolite weave can produce a weapons amplification field 2.41m in diameter. Unfortunately, battle droids exposed to the effect become violently disoriented. Given their importance to the war effort, Command has ordered us to halt our work until peace is secured. Sadly, I must admit I agree.\n\nDr. Aiyah Pellorean\nResearch Director\", type = \"MenuLine\"}"
}

