InWorldMessage A_TAT_MS323_PykeRailroad_IWM_01 < uid=D4F6307965365F5C001C345E14D92018 >
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"[DEV] MS323 Journal 01 IWM\", enabled = true, guid = #D4F6307965365F5C001C345C83FADC0D, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 8557, text = \"Day 1\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"[DEV] MS323 Journal 01 IWM\", enabled = true, guid = #D4F6307965365F5C001C345D9E6A79E7, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 8557, text = \"So here I am, making my own opportunities. They call this place Tatooine. Our benefactor is convinced this miserable dust bowl harbors phrik worth millions. Whoever they are, I hope they’re right.\n\nEveryone in camp a story, but something tells me I’m not the only one with a bounty on my head. I can see it on their faces – everyone’s hiding something. We get along fine, but I won’t pretend to know truly know them, let alone call them friends. \n\nIt is what it is, a ragtag group of criminals looking to change their fortunes.\", type = \"MenuLine\""
}

InWorldMessage A_TAT_MS323_PykeRailroad_IWM_02 < uid=D4F630796536619F000108E25836EE9D >
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"[DEV] MS323 Journal 02 IWM\", enabled = true, guid = #D4F6307965366161000108DDDA889B17, lineVersion = 10, maxLength = 0, productId = -1, sectionId = 8557, text = \"Day 92\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"[DEV] MS323 Journal 02 IWM\", enabled = true, guid = #D4F6307965366161000108DEEF1D3282, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 8557, text = \"Almost three months of toil, digging, loading, building, blasting rock, cutting paths, choking on sand, and for what? A fistful of phrik… That glimmer of hope we shared when we got here is already fading. Supply ships becoming increasingly sparse, rations are running low, and we’ve already lost half our crew.\n\nOur benefactor’s growing impatient, demanding results. I’m starting to worry there’s nothing here.\", type = \"MenuLine\""
}

InWorldMessage A_TAT_MS323_PykeRailroad_IWM_03 < uid=D4F630796536619F000108E3C285420E >
{
	myHeader "aurabesh = false, branch = \"\", contextComment = \"[DEV] MS323 Journal 03 IWM\", enabled = true, guid = #D4F6307965366169000108E0C07725D0, lineVersion = 9, maxLength = 0, productId = -1, sectionId = 8557, text = \"Day 140\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"[DEV] MS323 Journal 03 IWM\", enabled = true, guid = #D4F6307965366169000108E15EB94EEA, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 8557, text = \"It’s just me now. The last of the crew left yesterday when our supply ship didn’t show up. I guess that means our benefactor has suspended operations.\n\nIt’s too bad I’ll have to leave all this equipment behind, but I’d rather spend the rest of my days in a penal colony than sleep another night in this place. Heard there’s a town beyond the Dune Sea. Perhaps I could hand myself in, tell whoever’ll listen who I really am.\", type = \"MenuLine\""
}

