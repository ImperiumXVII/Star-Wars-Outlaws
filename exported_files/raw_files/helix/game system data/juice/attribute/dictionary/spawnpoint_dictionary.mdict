include "helix/game system data/fruit/attribute/attribute_dictionary.fruit"

AttributeDictionary spawnpoint_dictionary
{
	myFormulaResolveContextType Global
	myAttributeDefinitionCategories
	{
		AttributeDefinitionList "Use Conditions"
		{
			AttributeDefinition TestAlwaysTrue < uid=F8252D3C61E6BD1800002B3185872B21 >
			{
				myOriginalFormula Player.IsAlive
			}
			AttributeDefinition TestGymRegressionQuestStarted < uid=F8252D3C61E6BD2C00002B33946380B3 >
			{
				myOriginalFormula "regression.myQuestStateGameValue = QuestState.Started OR regression.myQuestStateGameValue = QuestState.Outro"
			}
			AttributeDefinition PlayerIsWanted < uid=F8252D3C6246A5F500002C14C854EF09 >
			{
				myOriginalFormula "Wanted.Level > 0"
			}
			AttributeDefinition PlayerIsNotWanted < uid=F8252D3C6246A60E00002C17869A517F >
			{
				myOriginalFormula "Wanted.Level = 0"
			}
		}
	}
}

