CustomListParameter Planets
{
	string Akiva AKI
	string Cantonica CAN
	string Kijimi KIJ
	string Toshara TOS
	string Tatooine TAT
	string "COOP Maps" COOP
}

EditType "Living World Encounter"
{
	myName "Encounter [Location]_[Idx]_[DescriptiveName]"
	myType LivingWorldContent
	myFileSelection
	{
		myAssetType ASSETTYPE_LIVINGWORLDCONTENT
		myDefaultSelection livingworldencounters
	}
	myParameters
	{
		TextParameter Location
		{
			myExampleText TOS
		}
		TextParameter Idx
		{
			myExampleText 00
		}
		TextParameter DescriptiveName
		{
		}
	}
	myMembers
	{
		Member myCompletedGameValue
		{
			myOperations
			{
				SetOperation Set
				{
				}
			}
		}
		Member myActivateGameCondition
		{
			myChildren
			{
				Member myType
				{
					myOperations
					{
						AssignString "New AssignString (0)"
						{
							myValue Formula
						}
					}
				}
				Member myFormula
				{
					myOperations
					{
						AssignString "New AssignString (0)"
						{
							myValue "\"[MemberName].myCompletedGameValue != 1\""
						}
					}
				}
				Member myContextType
				{
					myOperations
					{
						AssignString "New AssignString (0)"
						{
							myValue LivingWorldContentLocation
						}
					}
				}
			}
		}
		Member myDeactivateGameCondition
		{
			myChildren
			{
				Member myType
				{
					myOperations
					{
						AssignString "New AssignString (0)"
						{
							myValue Formula
						}
					}
				}
				Member myFormula
				{
					myOperations
					{
						AssignString "New AssignString (0)"
						{
							myValue "\"[MemberName].myCompletedGameValue = 1 AND LivingWorldContentLocation.DistanceToPlayer > ContentLocationDistanceNear\""
						}
					}
				}
				Member myContextType
				{
					myOperations
					{
						AssignString "New AssignString (0)"
						{
							myValue LivingWorldContentLocation
						}
					}
					myChildren
					{
					}
				}
			}
		}
	}
}

