					myValue "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER"
					myType Text
				}
				CreditsItem "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,"
				{
					myValue "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,"
					myType Text
				}
				CreditsItem "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN"
				{
					myValue "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN"
					myType Text
				}
				CreditsItem "THE SOFTWARE."
				{
					myValue "THE SOFTWARE."
					myType Text
				}
				Spacing Spacing
				{
					myValue 100
				}
				CreditsItem ITAL_MIN_LOGO
				{
					myValue ITAL_MIN_LOGO
					myType Logo
				}
			}
		}
	}
}

