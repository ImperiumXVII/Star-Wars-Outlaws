include "helix/game system data/fruit/melee/melee_move.fruit"
include "helix/game system data/juice/melee/kay_meleemove_base.mmeleemove"

MeleeMove kay_meleemove_normal_sprint < uid=A207755D6242FCF100003215699A8BA2 > : kay_meleemove_base
{
	myApproachingEnabled TRUE
	myExecutionDurationMin 1.5
	myExecutionDurationMax 1.5
	myRangeExecution 6.0
	myExecutionSequence
	{
		myGenericTracks
		{
			CameraShakeTrack BaseCamShake
			{
				myCamShake < uid=4AA8064D64526A1B0019436C7583419A > = player_melee_punch_base B0ED9250625FD32B0000403767915B64
			}
		}
		myCustomTracks
		{
			MeleeHitTrack Hit
			{
				myStartCyclePos 0.15
				myEndCyclePos 0.35
				myDamage 0.0
			}
			MeleeMovingSpeedingUpTrack MovingSpeedingUp
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleeMovingTrack Moving
			{
				myEndCyclePos 0.3
			}
			MeleeBufferingTrack MeleeBuffering
			{
				myStartCyclePos 0.35
			}
			MeleeTurnTrack Turn
			{
				myEndCyclePos 1.0
			}
			MeleeStartNextMoveTrack "Start Next Move"
			{
				myStartCyclePos 0.35
			}
			MeleePerfectInputTrack PerfectInput
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleePerfectStartNextMoveTrack "Perfect Start Next Move"
			{
				myStartCyclePos 0.6
				myEndCyclePos 0.8
			}
			MeleeUninterruptibleTrack Uninterruptible
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.8
			}
		}
	}
	myMoveNoTargetSpeed 5.0
	myMoveMaxSpeed 15.0
	myStartConditions
	{
		myTargetInRange
		{
			myEnabled TRUE
		}
		myGameCondition
		{
			GameConditionMeleeGroup And
			{
				myConditions
				{
					GameConditionMeleeTargetIsValid HasTarget
					{
					}
					GameConditionMeleeAttackerIsInMovementState "Is Sprinting"
					{
						myState Sprint
					}
					GameConditionMeleeTargetDistance "Min Distance To Target"
					{
						myIs3D TRUE
						myDistance 2.0
					}
					GameConditionMeleeAttackerSpeed "Is 3m/s or higher"
					{
						myTargetSpeed 3.0
					}
					GameConditionMeleeTargetPreferredAttack "Not Low Target"
					{
						myIsNegated TRUE
						myPreferredAttack Kick
					}
				}
			}
		}
	}
}

