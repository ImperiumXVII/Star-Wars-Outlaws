include "helix/game system data/fruit/melee/melee_move.fruit"
include "helix/game system data/juice/camera/modifiers/player_melee_punch_initialize_hit.mcameramodifier"
include "helix/game system data/juice/camera/modifiers/player_melee_punch_knockout.mcameramodifier"
include "helix/game system data/juice/melee/kay_meleemove_base.mmeleemove"

MeleeMove kay_meleemove_normal_initial_KO_sprint < uid=5CFE16D564E8559D00063C6A0C41FE8C > : kay_meleemove_base
{
	myApproachingEnabled TRUE
	myExecutionDurationMin 1.5
	myExecutionDurationMax 1.5
	myRangeExecution 6.0
	myExecutionSequence
	{
		myGenericTracks
		{
			CameraShakeTrack BaseCamShake
			{
				myCamShake < uid=5CFE16D564E8559D00063C6B30326892 > = player_melee_punch_base B0ED9250625FD32B0000403767915B64
			}
		}
		myCustomTracks
		{
			MeleeHitTrack Hit
			{
				myStartCyclePos 0.15
				myEndCyclePos 0.35
				myDamage 0.0
			}
			MeleeMovingSpeedingUpTrack MovingSpeedingUp
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleeMovingTrack Moving
			{
				myEndCyclePos 0.3
			}
			MeleeBufferingTrack MeleeBuffering
			{
				myStartCyclePos 0.35
			}
			MeleeTurnTrack Turn
			{
				myEndCyclePos 1.0
			}
			MeleeStartNextMoveTrack "Start Next Move"
			{
				myStartCyclePos 0.35
			}
			MeleePerfectInputTrack PerfectInput
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleePerfectStartNextMoveTrack "Perfect Start Next Move"
			{
				myStartCyclePos 0.6
				myEndCyclePos 0.8
			}
			MeleeUninterruptibleTrack Uninterruptible
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.8
			}
		}
	}
	myMoveNoTargetSpeed 5.0
	myMoveMaxSpeed 15.0
	myHit
	{
		myCamShake < uid=5CFE16D564E8559D00063C6CC68DD280 > = player_melee_punch_knockout 5CFE16D564E86F7F000AFD1F6F9BD767
	}
	myStartConditions
	{
		myTargetInRange
		{
			myEnabled TRUE
		}
		myGameCondition
		{
			GameConditionMeleeGroup "Multiple Conditions"
			{
				myConditions
				{
					GameConditionMeleeTargetIsValid "Has Target"
					{
					}
					GameConditionMeleeIsFirstMoveInTheContext FirstAttackInContext
					{
					}
					GameConditionMeleeTargetDistance "Min Distance to Target"
					{
						myIs3D TRUE
						myDistance 2.0
					}
					GameConditionMeleeTargetNumPunchesToDie "KO attack"
					{
						myIsNegated FALSE
						myOperator Equal
					}
					GameConditionMeleeAttackerIsInMovementState "Is Sprinting"
					{
						myState Sprint
					}
					GameConditionMeleeAttackerSpeed "Is 3m/s or higher"
					{
						myTargetSpeed 3.0
					}
					GameConditionMeleeTargetPreferredAttack "Not Low Target"
					{
						myIsNegated TRUE
						myPreferredAttack Kick
					}
				}
			}
		}
	}
}

