		myCustomTracks
		{
			MeleeHitTrack Hit
			{
				myStartCyclePos 0.2
				myEndCyclePos 0.4
				myDamage 0.0
			}
			MeleeMovingSpeedingUpTrack MovingSpeedingUp
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleeMovingTrack Moving
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.21
			}
			MeleeBufferingTrack MeleeBuffering
			{
				myStartCyclePos 0.2
				myEndCyclePos 1.0
			}
			MeleeTurnTrack Turn
			{
				myEndCyclePos 1.0
			}
			MeleeStartNextMoveTrack StartNextMove
			{
				myStartCyclePos 0.4
				myEndCyclePos 1.0
			}
