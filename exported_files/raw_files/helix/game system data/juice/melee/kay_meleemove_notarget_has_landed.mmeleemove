			{
				myStartCyclePos 0.0
				myEndCyclePos 0.4
			}
			MeleePerfectStartNextMoveTrack MeleePerfectStartNextMoveTrack
			{
				myStartCyclePos 0.25
				myEndCyclePos 0.5
			}
			MeleeLocomotionFreeTrack MeleeLocomotionFreeTrack
			{
				myStartCyclePos 0.45
			}
		}
	}
	myMoveMaxSpeed 10.0
	myHit
	{
		myDamage 1.0
		mySlowDownTimeScale "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.32492617 -0.0019296732, -0.048275869 0, }, outTangents = { 0.67740929 0.006862741, 0.055027828 0.00032679958, 0 0, }, properties = { 1299, 275, 2051, }, values = { 0 0, 0.8551724 0.2, 1 0, }, }, numKeys = 3, }"
		mySlowDownDuration 0.0
	}
	myStartConditions
	{
