		{
			myEnabled FALSE
			myDistance 10.0
		}
		myGameCondition
		{
			GameConditionMeleeGroup "Multiple Conditions"
			{
				myOperator And
				myConditions
				{
					GameConditionMeleeGroup "Land or Crouched (Or)"
					{
						myOperator Or
						myConditions
						{
							GameConditionMeleeHasLanded "Has Landed"
							{
								myTimeSinceLanded 0.33
							}
							GameConditionMeleeAttackerIsInMovementState "Is Crouched"
							{
								myState Crouch
							}
						}
					}
					GameConditionMeleeTargetIsValid HasNoTarget
					{
						myIsNegated TRUE
					}
					GameConditionMeleeAttackerIsInMovementState "Not Powerslide"
					{
						myIsNegated TRUE
						myState PowerSlide
					}
					GameConditionMeleeAttackerIsInMovementState "Not Powerslide Exit"
					{
						myIsNegated TRUE
						myState ExitPowerslide
					}
				}
			}
