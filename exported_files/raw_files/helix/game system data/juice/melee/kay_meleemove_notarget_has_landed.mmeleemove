{
	myApproachingEnabled FALSE
	myExecutionDurationMin 1.7
	myExecutionDurationMax 2.0
	myRangeExecution 4.0
	myExecutionSequence
	{
		myGenericTracks
		{
			CameraShakeTrack BaseCamShake
			{
				myCamShake < uid=5CFE16D56527AED2001C9F603A9220F6 > = player_melee_punch_base B0ED9250625FD32B0000403767915B64
			}
