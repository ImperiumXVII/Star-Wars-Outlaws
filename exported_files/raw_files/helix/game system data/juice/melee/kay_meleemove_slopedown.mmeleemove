include "helix/game system data/fruit/melee/melee_move.fruit"
include "helix/game system data/juice/melee/kay_meleemove_base.mmeleemove"

MeleeMove kay_meleemove_slopedown < uid=5CFE16D564CB9ECF0042FE779CA31027 > : kay_meleemove_base
{
	myApproachingEnabled FALSE
	myApproachingMinSpeed 10.0
	myExecutionDurationMin 1.5
	myExecutionDurationMax 1.5
	myRangeExecution 3.5
	myExecutionSequence
	{
		myGenericTracks
		{
			CameraShakeTrack BaseCamShake
			{
				myCamShake < uid=5CFE16D564CB9ECF0042FE78CA95AC89 > = player_melee_punch_base B0ED9250625FD32B0000403767915B64
			}
		}
		myCustomTracks
		{
			MeleeHitTrack Hit
			{
				myStartCyclePos 0.25
				myEndCyclePos 0.4
			}
			MeleeMovingSpeedingUpTrack MovingSpeedingUp
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleeMovingTrack Moving
			{
				myEndCyclePos 0.275
			}
			MeleeBufferingTrack MeleeBuffering
			{
				myStartCyclePos 0.4
			}
			MeleeTurnTrack Turn
			{
				myEndCyclePos 0.6
			}
			MeleeStartNextMoveTrack "Start Next Move"
			{
				myStartCyclePos 0.55
			}
			MeleePerfectInputTrack PerfectInput
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.0
			}
			MeleePerfectStartNextMoveTrack "Perfect Start Next Move"
			{
				myStartCyclePos 0.6
				myEndCyclePos 0.8
			}
			MeleeUninterruptibleTrack Uninterruptible
			{
				myStartCyclePos 0.0
				myEndCyclePos 0.6
			}
			MeleeLocomotionFreeTrack "Free Locomotion"
			{
				myStartCyclePos 0.7
			}
		}
	}
	myMoveNoTargetSpeed 5.0
	myMoveMaxSpeed 12.0
	myStartConditions
	{
		myTargetInRange
		{
			myEnabled TRUE
		}
		myGameCondition
		{
			GameConditionMeleeGroup And
			{
				myConditions
				{
					GameConditionMeleeAttackerIsInMovementState Ground
					{
					}
					GameConditionMeleeAttackerIsInMovementState Powersliding
					{
						myIsNegated TRUE
						myState PowerSlide
					}
					GameConditionMeleeTargetHeightDelta HeightDiff
					{
						myHeightDelta 0.45
					}
					GameConditionMeleeTargetIsValid "Has Target"
					{
					}
					GameConditionMeleeTargetNumPunchesToDie "Not last attack"
					{
						myNumPunchesToDie 2
						myOperator GreaterThanOrEqual
					}
				}
			}
		}
	}
}

