						{
							myFaction 16DEADE65F7DDA76000000C74AD19DCA
							myHeader "aurabesh = false, branch = \"\", contextComment = \"Header for the Unique FathierSex procedural enigma, used for Crimson Dawn faction, displayed on an InWorldMessage Datapad.\", enabled = true, guid = #E52E0D43655B6AB0000157157212CA6A, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = 'Description variation 1 for the Unique FathierSex procedural enigma, used for Crimson Dawn faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B6AB0000157165870907C, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 3683, text = \"Apparently there's only one <b>{0} fathier</b> in the next race, and they've done something to guarantee that it wins.\", type = \"MenuLine\""
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = 'Description variation 2 for the Unique FathierSex procedural enigma, used for Crimson Dawn faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B6AB0000157171094C246, lineVersion = 15, maxLength = 0, productId = -1, sectionId = 3683, text = \"Everything points to a <b>{0} fathier</b> winning the next race.\", type = \"MenuLine\""
