					{
						FixedFathiersRacesFactionMessage Any
						{
							myHeader "aurabesh = false, contextComment = \"Header for the Unique JockeyDescription procedural enigma, used for Neutral faction (ie no faction), displayed on an InWorldMessage Datapad.\", enabled = true, guid = #E52E0D4364A583D10000F1FAA0E232D5, lineVersion = 10, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = \"Description variation 1 for the Unique JockeyDescription procedural enigma, used for Neutral faction (ie no faction), displayed on an InWorldMessage Datapad. {0} is the name of the origin planet of the jockey who will win the race.\", enabled = true, guid = #E52E0D4364A583D10000F1FBCF6DF3CD, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 3683, text = \"Here's a tip. I just bet half my salary on a <b>jockey from {0}</b> to win the next race. I've got someone who owed me that intel, and they're never wrong.\", type = \"MenuLine\"}"
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = \"Description variation 2 for the Unique JockeyDescription procedural enigma, used for Neutral faction (ie no faction), displayed on an InWorldMessage Datapad. {0} is the name of the origin planet of the jockey who will win the race.\", enabled = true, guid = #E52E0D4364A583D10000F1FC25973FE5, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 3683, text = \"Okay, get this. I've got a person on the inside who says that a <b>jockey from {0}</b> is definitely gonna win the next race. You didn't hear it from me.\", type = \"MenuLine\""
							}
						}
						FixedFathiersRacesFactionMessage Pyke
						{
							myFaction 16DEADE65F7DDB52000000D22C63D964
							myHeader "aurabesh = false, branch = \"\", contextComment = \"Header for the Unique JockeyDescription procedural enigma, used for Pyke faction, displayed on an InWorldMessage Datapad.\", enabled = true, guid = #E52E0D43655B95D30001CFB3D91A180D, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = \"Description variation 1 for the Unique JockeyDescription procedural enigma, used for Pyke faction, displayed on an InWorldMessage Datapad. {0} is the name of the origin planet of the jockey who will win the race.\", enabled = true, guid = #E52E0D43655B95D30001CFB4D885C22E, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 3683, text = \"The <b>jockey from {0}</b> is on our payroll and has made all the preparations we asked. He is definitely going to win the next race.\", type = \"MenuLine\""
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = \"Description variation 2 for the Unique JockeyDescription procedural enigma, used for Pyke faction, displayed on an InWorldMessage Datapad. {0} is the name of the origin planet of the jockey who will win the race.\", enabled = true, guid = #E52E0D43655B95D30001CFB56A959FC3, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 3683, text = \"Someone told me that the next race has a <b>jockey from {0}</b> and they're involved in a big rigging operation. That's the one we should keep an eye on, if you ask me.\", type = \"MenuLine\""
							}
						}
