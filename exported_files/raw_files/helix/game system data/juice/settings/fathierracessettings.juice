				{
					myFathierProperty Sex
					myFactionMessages
					{
						FixedFathiersRacesFactionMessage Any
						{
							myHeader "aurabesh = false, contextComment = \"Header for the Unique FathierSex procedural enigma, used for Neutral faction (ie no faction), displayed on an InWorldMessage Datapad.\", enabled = true, guid = #E52E0D4364A585980000F20247FC1852, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = 'Description variation 1 for the Unique FathierSex procedural enigma, used for Neutral faction (ie no faction), displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D4364A585980000F203ADA9BEE1, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 3683, text = \"My contact in Canto Bight said the next race will only have one <b>{0} fathier</b>, and that's the one we should bet on. You know what to do.\", type = \"MenuLine\"}"
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = 'Description variation 2 for the Unique FathierSex procedural enigma, used for Neutral faction (ie no faction), displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D4364A585980000F204788DDCD3, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 3683, text = \"Rumor has it a <b>{0} fathier</b> will win the next race.\", type = \"MenuLine\""
							}
						}
						FixedFathiersRacesFactionMessage Pyke
						{
							myFaction 16DEADE65F7DDB52000000D22C63D964
							myHeader "aurabesh = false, branch = \"\", contextComment = 'Header for the Unique FathierSex procedural enigma, used for Pyke faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B681C00015706B505BA77, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = 'Description variation 1 for the Unique FathierSex procedural enigma, used for Pyke faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B681C00015707262E142C, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 3683, text = \"Okay, so apparently the next race will just have one <b>{0} fathier</b>. That's supposedly code for those in the know, so we should bet on that one.\", type = \"MenuLine\"}"
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = 'Description variation 2 for the Unique FathierSex procedural enigma, used for Pyke faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B681C00015708AB0FFBC0, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 3683, text = \"Everything's gone according to plan. Look out for a <b>{0} fathier</b> to win the next race.\", type = \"MenuLine\"}"
							}
						}
						FixedFathiersRacesFactionMessage Hutt
						{
							myFaction 16DEADE65F7DDA76000000C847FBD2A1
							myHeader "aurabesh = false, branch = \"\", contextComment = \"Header for the Unique FathierSex procedural enigma, used for Hutt faction, displayed on an InWorldMessage Datapad.\", enabled = true, guid = #E52E0D43655B6A960001570BB5A32A33, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = 'Description variation 1 for the Unique FathierSex procedural enigma, used for Hutt faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B6A960001570C61A616BC, lineVersion = 19, maxLength = 0, productId = -1, sectionId = 3683, text = \"Something's up with the next race. There's only one <b>{0}</b> in the paddock, and that's supposedly the given winner.\", type = \"MenuLine\"}"
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = 'Description variation 2 for the Unique FathierSex procedural enigma, used for Hutt faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B6A960001570DBAF93031, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 3683, text = \"The next race is fixed, and a <b>{0} fathier</b> is going to win.\", type = \"MenuLine\""
							}
						}
						FixedFathiersRacesFactionMessage Ashiga
						{
							myFaction 4728ADF9620B6C2B0000201F5FC5C937
							myHeader "aurabesh = false, branch = \"\", contextComment = \"Header for the Unique FathierSex procedural enigma, used for Ashiga faction, displayed on an InWorldMessage Datapad.\", enabled = true, guid = #E52E0D43655B6AA30001571072C268C7, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 3683, text = \"About the next race\", type = \"MenuLine\""
							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = 'Description variation 1 for the Unique FathierSex procedural enigma, used for Ashiga faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B6AA30001571101C9A616, lineVersion = 17, maxLength = 0, productId = -1, sectionId = 3683, text = \"Had a look around the stables and saw some credits being passed around. Seems like the next race will only have one <b>{0}</b>. I'd bet on that one.\", type = \"MenuLine\"}"
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = 'Description variation 2 for the Unique FathierSex procedural enigma, used for Ashiga faction, displayed on an InWorldMessage Datapad. {0} is replaced by \"male\" or \"female\".', enabled = true, guid = #E52E0D43655B6AA30001571278AA5C48, lineVersion = 15, maxLength = 0, productId = -1, sectionId = 3683, text = \"I've got on good authority that a <b>{0} fathier</b> is going to win the next race.\", type = \"MenuLine\"}"
							}
						}
