							myDescriptions
							{
								varmap "Variation 1" "aurabesh = false, branch = \"\", contextComment = \"Description variation 1 for the Unique JockeyDescription procedural enigma, used for Hutt faction, displayed on an InWorldMessage Datapad. {0} is the name of the origin planet of the jockey who will win the race.\", enabled = true, guid = #E52E0D43655B95D70001CFB975F23A22, lineVersion = 13, maxLength = 0, productId = -1, sectionId = 3683, text = \"We've got some leverage on a <b>jockey from {0}</b>, and he assures us that the next race is fixed. If he's wrong, we know what to do with him.\", type = \"MenuLine\""
								varmap "Variation 2" "aurabesh = false, branch = \"\", contextComment = \"Description variation 2 for the Unique JockeyDescription procedural enigma, used for Hutt faction, displayed on an InWorldMessage Datapad. {0} is the name of the origin planet of the jockey who will win the race.\", enabled = true, guid = #E52E0D43655B95D70001CFBA4B4C49B7, lineVersion = 12, maxLength = 0, productId = -1, sectionId = 3683, text = \"I know I owe you a bunch of credits, but I've got something better. The next race will be won by a <b>jockey from {0}</b>. I swear on it.\", type = \"MenuLine\"}"
							}
