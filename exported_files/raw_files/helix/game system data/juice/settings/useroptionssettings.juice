			myDescription "branch = \"DLC2\", contextComment = \"Description of the setting to enable accessibility shortcuts on the PS5 controller. This version of the setting should ONLY appear on PS5.\", enabled = true, guid = #49D82446674474C10013E24318F0B935, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 11114, text = \"Enable accessibility shortcuts to easily toggle accessibility features on or off.\n\nSwipe <b>touchpad up</b> to toggle autowalk.\nSwipe <b>touchpad down</b> to toggle high contrast mode.\nSwipe <b>touchpad left</b> to toggle menu narration.\", type = \"MenuLine\""
