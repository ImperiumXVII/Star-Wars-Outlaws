		StringControl "[Video] Upscaler quality"
		{
			myUserOption Video_UpscalerQuality
			myUserOptionName "aurabesh = false, branch = \"\", contextComment = \"Name of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality.\", enabled = true, guid = #BA9D046A645B926E0000B47D6FA3D955, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = \"Upscaler quality\", type = \"MenuLine\""
			myDescription "aurabesh = false, branch = \"\", contextComment = \"Description of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality.\", enabled = true, guid = #BA9D046A645B926E0000B47EA4AF1030, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"The base resolution scaling factor used by the upscaler.\", type = \"MenuLine\""
			myNeedsConfirmApply TRUE
			myExclusiveToPlatforms
			{
				Platform_Enum "" PC
			}
			myStrings
			{
				varmap Performance "aurabesh = false, branch = \"\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. Selects to focus entirely on performance over quality.\", enabled = true, guid = #BA9D046A645B93DE0000B4895D0E348B, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"Performance\", type = \"MenuLine\""
				varmap "Favor performace" "aurabesh = false, branch = \"\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. Selects to favor performance over quality, but not entirely.\", enabled = true, guid = #BA9D046A645B93DE0000B48AB39DED42, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Favor performance\", type = \"MenuLine\""
				varmap Balanced "aurabesh = false, branch = \"\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. Selects to give a balance between quality and performance.\", enabled = true, guid = #BA9D046A645B93DE0000B48BF30183F6, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Balanced\", type = \"MenuLine\""
				varmap "Favor quality" "aurabesh = false, branch = \"\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. Selects to favor quality over performance, but not entirely.\", enabled = true, guid = #BA9D046A645B93DE0000B48C354FDE89, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Favor quality\", type = \"MenuLine\""
				varmap Quality "aurabesh = false, branch = \"\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. Selects to focus entirely on quality over performance.\", enabled = true, guid = #BA9D046A645B93DE0000B48D19C91EC7, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Quality\", type = \"MenuLine\""
				varmap "Native AA" "branch = \"MAIN\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. This uses native anti-aliasing.\", enabled = true, guid = #8F3847EB66389A9D001E2A217CADF0A7, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Native AA\", type = \"MenuLine\""
				varmap DLAA "aurabesh = false, branch = \"\", contextComment = \"Option value of the user option which adjust the quality for the upscaling algorithm, allowing choosing between performance and quality. This uses native anti-aliasing for DLSS.\", enabled = true, guid = #E42C5D0F66E2B7D7000000CB298738F4, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"DLAA\", type = \"MenuLine\""
			}
			myDefaultIndex 2
			myShouldWrap FALSE
		}
		StringControl "[Video] Upscaler mode"
		{
			myUserOption Video_UpscalerMode
			myUserOptionName "aurabesh = false, branch = \"\", contextComment = \"Name of the user option to select the upscaler mode, which can be Fixed or Biased\", enabled = true, guid = #BA9D046A64B019F100002896B8E0D911, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 3614, text = \"Upscaler mode\", type = \"MenuLine\""
			myDescription "aurabesh = false, branch = \"\", contextComment = \"Description of the user option that determines the upscaler mode\", enabled = true, guid = #BA9D046A64B019F100002897EE9172DE, lineVersion = 9, maxLength = 0, productId = -1, sectionId = 10603, text = 'Which mode should be used when upscaling graphics to your output resolution.\n\n<color name=\"Menu Yellow\">Off:</color> No upscaling will be used and the screen will be rendered at native output resolution.\n<color name=\"Menu Yellow\">Fixed:</color> Upscaling is based on a fixed rendering resolution to the native output resolution. Which fixed scaling is used, is decided by the scaling quality.\n<color name=\"Menu Yellow\">Biased:</color> Upscaling which is based on the fixed rendering solution, but in addition biases it towards a 4k output resolution.', type = \"MenuLine\""
			myNeedsConfirmApply TRUE
			myExclusiveToPlatforms
			{
				Platform_Enum "" PC
			}
			myStrings
			{
				varmap Off "aurabesh = false, branch = \"\", contextComment = \"Needs clarification what these actually mean. Please ignore for now.\", enabled = true, guid = #BA9D046A64B01A7A00009CCD19ADC1F5, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 3614, text = \"Off\", type = \"MenuLine\""
				varmap Fixed "aurabesh = false, branch = \"\", contextComment = \"Needs clarification what these actually mean. Please ignore for now.\", enabled = true, guid = #BA9D046A64B01A7A00009CCEC0AA2F30, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 3614, text = \"Fixed\", type = \"MenuLine\""
				varmap Biased "aurabesh = false, branch = \"\", contextComment = \"Needs clarification what these actually mean. Please ignore for now.\", enabled = true, guid = #BA9D046A64B01A7A00009CCFCBA9CDEC, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 3614, text = \"Biased\", type = \"MenuLine\""
			}
			myShouldWrap FALSE
		}
		StringControl "[Video] Vertical Sync"
		{
			myUserOption Video_VerticalSync
			myUserOptionName "aurabesh = false, branch = \"\", contextComment = \"Name for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing.\", enabled = true, guid = #BA9D046A645B87560000B4629827842D, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = \"Vertical sync\", type = \"MenuLine\""
			myDescription "aurabesh = false, branch = \"\", contextComment = \"Description for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing.\", enabled = true, guid = #BA9D046A645B87560000B463C9D98189, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = 'Sync the display of the scene to the refresh rate of the monitor to avoid screen tearing. Turning this option off can increase performance significantly.\n\n<color name=\"Menu Yellow\">Off:</color> Does not sync the presenting of frames with the refresh rate of the monitor.\n<color name=\"Menu Yellow\">On:</color> Sync the presenting of a new frame to the next monitor refresh.\n<color name=\"Menu Yellow\">Half-rate:</color> Sync the presenting of a new frame to every second monitor refresh.\n<color name=\"Menu Yellow\">Third-rate:</color> Sync the presenting of a new frame to every third monitor refresh.\n<color name=\"Menu Yellow\">Quarter-rate:</color> Sync the presenting of a new frame to every fourth monitor refresh.', type = \"MenuLine\""
			myNeedsConfirmApply TRUE
			myExclusiveToPlatforms
			{
				Platform_Enum "" PC
			}
			myStrings
			{
				varmap Off "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing. This value specifies no syncing.\", enabled = true, guid = #BA9D046A645B88550000B46E30DC6BE5, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 10603, text = \"Off\", type = \"MenuLine\""
				varmap "Every frame" "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing. This value specifies syncing every frame.\", enabled = true, guid = #BA9D046A645B88550000B46F3926CA5F, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = \"Every frame\", type = \"MenuLine\""
				varmap "Every 2 frames" "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing. This value specifies syncing every other frame.\", enabled = true, guid = #BA9D046A645B88550000B470083363D6, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Half-rate\", type = \"MenuLine\""
				varmap "Every 3 frames" "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing. This value specifies syncing every three frame.\", enabled = true, guid = #BA9D046A645B88550000B471AAD87485, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Third-rate\", type = \"MenuLine\""
				varmap "Every 4 frames" "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which ensures the computer and screen syncs up, to reduce or remove screen tearing. This value specifies syncing every four frame.\", enabled = true, guid = #BA9D046A645B88550000B4727988A178, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Quarter-rate\", type = \"MenuLine\""
			}
			myDefaultIndex 1
			myShouldWrap FALSE
		}
