				varmap Auto "branch = \"MAIN\", contextComment = \"Option value for the user option which selects the current high-dynamic range(HDR) mode. Selects to automatically choose whether HDR is on or off based on device specifications..\", enabled = true, guid = #BA9D046A66424E51000000D4177E8EAD, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"Auto\", type = \"MenuLine\""
				varmap HDR10 "branch = \"MAIN\", contextComment = \"Option value for the user option which selects the current high-dynamic range(HDR) mode. Selects to always use HDR if available on the device.\", enabled = true, guid = #BA9D046A66424E51000000D5C343D2D0, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"On\", type = \"MenuLine\""
