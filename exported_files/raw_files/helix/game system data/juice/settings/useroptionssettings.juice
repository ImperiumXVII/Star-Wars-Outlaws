		StringControl "[Video Advanced] Frame Generation (Switch)"
		{
			myUserOption Video_Advanced_FrameGeneration_Switch
			myUserOptionName "branch = \"TASK2\", contextComment = \"New user option for Frame generation (replaces the old setting)\", enabled = true, guid = #49D82446673B669D00008BED29805000, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Frame generation\", type = \"MenuLine\""
			myDescription "branch = \"TASK2\", contextComment = \"Description of new user option for Frame generation (replaces the old setting)\", enabled = true, guid = #49D82446673B669D00008BEE9400393C, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 10603, text = 'Select to enable frame generation, a technique that analyzes the visual output from the game and generates additional frames from them, which results in higher framerate.\n\n<color name=\"Menu Yellow\">Off:</color> Frame generation is disabled\n<color name=\"Menu Yellow\">2x:</color> Frame generation is enabled and will generate an extra frame to increase FPS by up to 2x\n<color name=\"Menu Yellow\">3x:</color> Frame generation is enabled and will generate two extra frames to increase FPS by up to 3x\n<color name=\"Menu Yellow\">4x:</color> Frame generation is enabled and will generate three extra frames to increase FPS by up to 4x', type = \"MenuLine\""
			myNeedsConfirmApply TRUE
			myExclusiveToPlatforms
			{
				Platform_Enum PC PC
			}
			myStrings
			{
				varmap Off "branch = \"TASK2\", contextComment = \"Setting for the new Frame Generation user option, this turns it off\", enabled = true, guid = #49D82446673B672800008BF5D93B2154, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Off\", type = \"MenuLine\""
				varmap 2x "branch = \"TASK2\", contextComment = \"Setting for the new Frame Generation user option, this generates 2x extra frames\", enabled = true, guid = #49D82446673B672800008BF61BAD916A, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"2x\", type = \"MenuLine\""
				varmap 3x "branch = \"TASK2\", contextComment = \"Setting for the new Frame Generation user option, this generates 3x extra frames\", enabled = true, guid = #49D82446673B672800008BF7BA3D4DEB, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"3x\", type = \"MenuLine\""
				varmap 4x "branch = \"TASK2\", contextComment = \"Setting for the new Frame Generation user option, this generates 4x extra frames\", enabled = true, guid = #49D82446673B672800008BF884E9DCCE, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"4x\", type = \"MenuLine\""
			}
			myDefaultIndex 1
		}
