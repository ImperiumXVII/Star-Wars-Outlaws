		StringControl "[Video] NVIDIA Reflex"
		{
			myUserOption Video_NvReflex
			myUserOptionName "aurabesh = false, branch = \"MAIN\", contextComment = \"User option for NVIDIA low latency\", enabled = true, guid = #8F3847EB65D89A6B000655756ADE26C4, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = \"NVIDIA Reflex low latency\", type = \"MenuLine\""
			myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"Description of user option for NVIDIA low latency\", enabled = true, guid = #8F3847EB65D89A6B0006557631D06865, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 10603, text = 'NVIDIA Reflex is a technique used to reduce system latency and improves PC responsiveness.\n\n<color name=\"Menu Yellow\">Off:</color> Low Latency mode is disabled.\n<color name=\"Menu Yellow\">On:</color> Low Latency mode is now enabled and optimizes system latency.\n<color name=\"Menu Yellow\">On + Boost:</color> Low Latency mode is now enabled and optimizes system latency. In Boost mode, NVIDIA Reflex will save slightly more latency and attempt to optimize latency in CPU bound cases. This option can slightly decrease FPS and increase GPU power draw.', type = \"MenuLine\""
			myNeedsConfirmApply TRUE
			myExclusiveToPlatforms
			{
				Platform_Enum PC PC
			}
			myStrings
			{
				varmap Off "aurabesh = false, branch = \"MAIN\", contextComment = \"Option for NVIDIA low latency, this turns it off\", enabled = true, guid = #8F3847EB65D89B6A0006557A0A3EB6D3, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Off\", type = \"MenuLine\""
				varmap On "aurabesh = false, branch = \"MAIN\", contextComment = \"Option for NVIDIA low latency, this turns it on\", enabled = true, guid = #8F3847EB65D89B6A0006557B3E3CB4B6, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"On\", type = \"MenuLine\""
				varmap "On + Boost" "aurabesh = false, branch = \"MAIN\", contextComment = \"Option for NVIDIA low latency, this turns it on and enables a boost (see description for the setting)\", enabled = true, guid = #8F3847EB65D89B6A0006557C79D55563, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"On + boost\", type = \"MenuLine\""
			}
			myShouldWrap FALSE
		}
