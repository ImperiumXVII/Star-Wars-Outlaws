			myDescription "branch = \"TU5\", contextComment = \"Description of the user option to change the size of hit feedback UI (shown when hitting an enemy with a weapon)\", enabled = true, guid = #49D82446671F5576000553E06C144044, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 11203, text = \"Adjust the size of the hit feedback in the user interface, when damaging an enemy with a weapon.\", type = \"MenuLine\""
