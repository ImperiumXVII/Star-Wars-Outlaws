			myDescription "branch = \"TU2\", contextComment = \"Description of the user option to allow an accessibility shortcut on gamepad and keyboard that can quickly enable a selected accessibility feature. PLEASE NOTE: The game action defined here will have to be changed at a later date.\", enabled = true, guid = #49D8244666C72690000AF9B3C5B67011, lineVersion = 11, maxLength = 0, productId = -1, sectionId = 11231, text = 'Use <gameaction src=\"AutoWalk\"> to toggle the selected accessibility feature.', type = \"MenuLine\""
