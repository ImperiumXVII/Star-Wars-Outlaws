				varmap "High contrast mode" "branch = \"TU2\", contextComment = \"Accessibility feature to render the world and specific objects in high contrast colors to reduce cognitive and visual load on players\", enabled = true, guid = #49D8244666C72760000B25A3859155F3, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 11231, text = \"High contrast mode\", type = \"MenuLine\""
