		myHardcodedStrings
		{
			myDisplayNameFormat "aurabesh = false, branch = \"\", contextComment = \"The format to use to display a monitor index and name in the settings menu. 0 = Monitor index. 1 = Monitor name. Name is not localizable, as it's given by Windows itself.\", enabled = true, guid = #BA9D046A64E6194000016F88C9F5D93A, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"{0} {1}\", type = \"MenuLine\""
			myDisplayNameFormatPrimary "aurabesh = false, branch = \"\", contextComment = \"The format to use to display a monitor index and name set as the primary monitor in the settings menu. 0 = Monitor index. 1 = Monitor name. Name is not localizable, as it's given by Windows itself.\", enabled = true, guid = #BA9D046A64E6194000016F898BAD71C9, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"{0} {1} (Primary)\", type = \"MenuLine\""
			myCustomGraphicsPreset "aurabesh = false, branch = \"\", contextComment = \"Option value for when no existing graphics presets fit with the settings, as individual overrides has been changed by the player.\", enabled = true, guid = #BA9D046A64E6199200016F8CF6BE89C0, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 10603, text = \"Custom\", type = \"MenuLine\""
			myWindowModeWindowed "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects the display mode for the game, selecting window-mode.\", enabled = true, guid = #15AAF5F66075925E0000002CBD2582D0, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"Window\", type = \"MenuLine\""
			myWindowModeBorderless "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects the display mode for the game, selecting borderless window-mode.\", enabled = true, guid = #15AAF5F66075925E0000002D6F702756, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 10603, text = \"Borderless Window\", type = \"MenuLine\""
			myWindowModeFullscreen "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects the display mode for the game, selecting exclusive fullscreen.\", enabled = true, guid = #15AAF5F66075925E0000002EC2D7ABBB, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"Exclusive Fullscreen\", type = \"MenuLine\""
			myUpscalerTAAName "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects which upscaling algorithm should be used, selecting software anti-aliasing over time.\", enabled = true, guid = #BA9D046A645B81540000B45EA93C2AE2, lineVersion = 6, maxLength = 0, productId = 6, sectionId = 10603, text = \"Temporal Anti-aliasing\", type = \"MenuLine\""
			myUpscalerFSR3Name "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects which upscaling algorithm should be used, selecting AMD's hardware upscaling for supported graphics-cards..\", enabled = true, guid = #BA9D046A645B81540000B45F6A277119, lineVersion = 10, maxLength = 0, productId = 6, sectionId = 10603, text = \"AMD FSR 3\", type = \"MenuLine\""
			myUpscalerXeSSName "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects which upscaling algorithm should be used, selecting Intel's hardware upscaling for supported graphics-cards..\", enabled = true, guid = #BA9D046A645B81540000B460BAD23B21, lineVersion = 7, maxLength = 0, productId = 6, sectionId = 10603, text = \"Intel XeSS\", type = \"MenuLine\""
			myUpscalerDLSSName "aurabesh = false, branch = \"\", contextComment = \"Option value for the user option which selects which upscaling algorithm should be used, selecting Nvidia's hardware upscaling for supported graphics-cards..\", enabled = true, guid = #BA9D046A645B81540000B461D004CFF5, lineVersion = 7, maxLength = 0, productId = 6, sectionId = 10603, text = \"NVIDIA DLSS\", type = \"MenuLine\""
			myUpscalerPSSRName "branch = \"TU5\", contextComment = \"Option value for the user option which selects which upscaling algorithm should be used, selecting PlayStations's hardware upscaling for supported consoles..\", enabled = true, guid = #264E2F37674EFD510002324F1813F933, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = \"PSSR\", type = \"MenuLine\"}"
			myMonitorNameFormat "branch = \"MAIN\", contextComment = \"Option value format for the user option which selects the monitor to display the game on. Used when a monitor other than the primary one is selected. 0 = Monitor number. 1 = Monitor Name.\", enabled = true, guid = #BA9D046A663A4569000000C9F542BF2E, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10603, text = \"{0}: {1}\", type = \"MenuLine\""
			myMonitorNameFormatPrimary "branch = \"MAIN\", contextComment = \"Option value format for the user option which selects the monitor to display the game on. Used when the primary monitor is selected, which is usually the one the player uses the most. 0 = Monitor number. 1 = Monitor Name.\", enabled = true, guid = #BA9D046A663A4569000000CA6CAB93FF, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 10603, text = \"{0}: {1} (Primary)\", type = \"MenuLine\""
