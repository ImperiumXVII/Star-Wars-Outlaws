							myDepth 0.5
						}
					}
				}
				myEffect helix/particles/vfx_exp_water_imploder_01.mparticles
			}
		}
		myImpactEffect
		{
			myEffects
			{
				myDefaultEffect helix/particles/vfx_exp_generic_sonic_imploser_01.mparticles
				myEffectsByConditions
				{
				}
			}
			myCastForImpactGroundDistance 1.0
		}
		myGameplayDamageSection
		{
			mySize 1.0
			myBlockerType None
			myDamageType Physical
			myDamageTargetType All
			myDamageFormula 1.0
			myDefaultDamage 0.0
			myDamageSelf TRUE
			myFriendlyFireEnabled TRUE
		}
		myPhysicsSection
		{
			mySize 3.0
			myImpactEnergy -50.0
		}
		myAudioSection
		{
			myDetonationEvent
			{
				myGuid 47E6E9B7E5EF192090ECB7F64AB5F9B0
			}
			myUnderWaterDetonationEvent
			{
				myGuid 42B38E469F83BEF1B636C9A953F22DAB
			}
			myShockwaveLoopStartEvent
			{
				myGuid 4A42DA94E5F686C8A657EE6E04CEBEA4
			}
			myShockwavePlayerImpactEvent
			{
				myGuid 00000000000000000000000000000000
			}
			myEmitterSphereRadius 10.0
		}
	}
	myExtraDetonationList
	{
		ExplosionDetonation Explode
		{
			myPropagationSpeed 150.0
			myStartTime 1.0
			myPhysicsSection
			{
				mySize 7.0
				myImpactEnergy 150.0
			}
			myAudioSection
			{
				myDetonationEvent
				{
					myGuid 00000000000000000000000000000000
				}
			}
		}
	}
}

