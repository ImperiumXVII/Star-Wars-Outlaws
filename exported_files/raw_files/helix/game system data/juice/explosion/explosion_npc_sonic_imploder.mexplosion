Explosion explosion_npc_sonic_imploder < uid=4171A7E165256047002175C9A0A6693D > : explosion_template
{
	myDefaultRadius 4.0
	myDetonation
	{
		myPropagationSpeed 150.0
		myStartTime 2.5
		myBaseEffect helix/particles/vfx_exp_sonic_imploder.mparticles
		myBaseEffectsByConditions
		{
			BaseEffectByConditions "Is Under Water"
			{
				myConditions
				{
					myConditions
					{
						GameConditionImpactWaterDepth "New GameConditionImpactWaterDepth"
