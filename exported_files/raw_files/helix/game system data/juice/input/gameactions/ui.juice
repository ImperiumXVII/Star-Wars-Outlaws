TriggerGameAction "[UI] Move Horizontal (Dummy)"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Gamepad Left"
				{
					myInputActionType HoldDown
					myInputAction = UI_MOVE_LEFT
				}
				ConditionalInputAction "Gamepad Right"
				{
