TriggerGameAction "[Weapon] LockAimChangeTargetR"
{
	myConditionalInputActions
	{
		ConditionalActionGroup Conditions
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup SimpleRightAndLeft
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalGameActionState ControlType
						{
							myGameActionState IsAimLockControlType_SimpleRightAndLeft
						}
						ConditionalActionGroup Input
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction Gamepad
								{
									myInputActionType Pressed
									myTimer 150
									myInputAction = RIGHT_STICK_RIGHT
								}
								ConditionalInputAction Keyboard
								{
									myTimer 150
									myInputAction = KB_E
								}
							}
						}
					}
				}
				ConditionalActionGroup CameraOffset
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalGameActionState ControlType
						{
							myGameActionState IsAimLockControlType_CameraOffset
						}
						ConditionalActionGroup Input
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction Gamepad
								{
									myInputActionType Pressed
									myTimer 150
									myInputAction = RIGHT_BUMPER_R1
								}
								ConditionalInputAction Keyboard
								{
									myTimer 150
									myInputAction = KB_E
								}
							}
						}
					}
				}
			}
		}
	}
	myGameAction LockAimChangeTargetR
	myExcludeInActionContexts
	{
		DeadContext TRUE
		SpaceshipContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

