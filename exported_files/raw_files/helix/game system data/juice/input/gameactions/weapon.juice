include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction "[Weapon] Shoot"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Right Trigger Hold Down"
				{
					myInputActionType Analog
					myInputAction = RIGHT_TRIGGER_R2
				}
				ConditionalInputAction "Mouse Trigger Pressed"
				{
					myInputActionType HoldDown
					myForceDisplayAsTapInUI TRUE
					myInputAction = KB_SHOOT
				}
			}
		}
	}
	myGameAction Shoot
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		GadgetContext TRUE
		GrapplingContext TRUE
		HoloReaderCompassContext FALSE
		HoloReaderMapContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		ThrowableContext TRUE
		TransportSneakingContext FALSE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		CustomAnimationContext TRUE
		RappelContext TRUE
	}
}

