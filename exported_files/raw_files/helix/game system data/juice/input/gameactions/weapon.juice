		VehicleContext TRUE
	}
}

TriggerGameAction "[Weapon] PickupWeaponEquip"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType DoublePress
					myInputAction = UI_DPAD_LEFT
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType SinglePress
					myInputAction = KB_PICKUPWEAPON_HOLD
				}
			}
		}
	}
	myGameAction PickupWeaponEquip
}

