TriggerGameAction "[Weapon] Reload"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "R1 Pad"
				{
					myInputActionType PressedAfterTime
					myTimer 200
					myNegate FALSE
					myToggle FALSE
					myClearToggle FALSE
					myInputAction = RIGHT_BUMPER_R1
				}
				ConditionalInputAction "Keyboard R"
				{
					myInputActionType SinglePress
					myTimer 0
					myNegate FALSE
					myToggle FALSE
					myClearToggle FALSE
					myInputAction = KB_TOOL_RELOAD
				}
			}
		}
	}
	myGameAction Reload
	myRequireNewInputOnContextChange TRUE
	myIsCinematicAction FALSE
	myIsExclusiveToggle FALSE
	myConsoleCommand ""
	myActionContexts
	{
		BinocularsContext FALSE
		DeadContext FALSE
		DefaultContext TRUE
		FreeCameraContext FALSE
		GrapplingContext FALSE
		PetModeContext FALSE
		SequenceContext FALSE
		ThrowableContext FALSE
		TransportSneakingContext FALSE
		TrickShotContext FALSE
		UIContext FALSE
		VehicleContext FALSE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		DefaultContext FALSE
		EquipmentOverheatContext TRUE
		FreeCameraContext FALSE
		GrapplingContext TRUE
		PetModeContext FALSE
		SequenceContext FALSE
		SpaceshipContext TRUE
		ThrowableContext TRUE
		TransportSneakingContext FALSE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

