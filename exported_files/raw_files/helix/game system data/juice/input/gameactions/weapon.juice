TriggerGameAction "[Weapon] Unholster"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Controller
				{
					myInputAction = Y_TRIANGLE
				}
				ConditionalActionGroup Keyboard
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction "Normal Case"
						{
							myInputActionType Pressed
							myTimer 180
							myInputAction = KB_TOGGLE_HOLSTER
						}
						ConditionalActionGroup "Pickup Weapon in Holster"
						{
							myOperator And
							myConditionalInputActions
							{
								ConditionalGameActionState "Is Pickup In Holster?"
								{
									myGameActionState IsPickableWeaponInHolster
								}
								ConditionalActionGroup Input
								{
									myOperator Or
									myConditionalInputActions
									{
										ConditionalInputAction Module_1
										{
											myInputAction = KB_WEAPON_MODULES_SLOT_MODULE1
										}
										ConditionalInputAction Module_2
										{
											myInputAction = KB_WEAPON_MODULES_SLOT_MODULE2
										}
										ConditionalInputAction Module_3
										{
											myInputAction = KB_WEAPON_MODULES_SLOT_MODULE3
										}
										ConditionalInputAction Stun
										{
											myInputAction = KB_STUN_TOGGLE
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	myGameAction Unholster_Keyboard
	myIsCinematicAction FALSE
	myIsExclusiveToggle TRUE
	myActionContexts
	{
		ThrowableContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		CoopContext TRUE
		DeadContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		ThrowableContext FALSE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

