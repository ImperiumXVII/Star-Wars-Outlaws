TriggerGameAction "[DUMMY] [Weapon] Zoom actions for contextual controls"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input actions for keyboard and gamepad"
		{
			myConditionalInputActions
			{
				ConditionalActionGroup Keyboard
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction KB_ZoomIn
						{
							myInputAction = KB_ZOOM_IN
						}
						ConditionalInputAction KB_ZoomOut
						{
							myInputAction = KB_ZOOM_OUT
						}
					}
				}
				ConditionalActionGroup Gamepad
				{
					myConditionalInputActions
					{
						ConditionalInputAction Gamepad_ZoomInOut
						{
							myInputAction = RIGHT_STICK_BUTTON
						}
					}
				}
			}
		}
	}
	myGameAction Contextual_Zoom
}

TriggerGameAction "[Weapon] ShoulderSwap"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType Pressed
					myTimer 0
					myNegate FALSE
					myToggle FALSE
					myClearToggle FALSE
					myInputAction = LEFT_STICK_BUTTON
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType SinglePress
					myTimer 0
					myNegate FALSE
					myToggle FALSE
					myClearToggle FALSE
					myInputAction = KB_SHOULDER_SWAP
				}
			}
		}
	}
	myGameAction ShoulderSwap
	myRequireNewInputOnContextChange TRUE
	myIsCinematicAction FALSE
	myIsExclusiveToggle FALSE
	myConsoleCommand ""
	myActionContexts
	{
		BinocularsContext FALSE
		DeadContext FALSE
		DefaultContext TRUE
		FreeCameraContext FALSE
		GrapplingContext FALSE
		PetModeContext FALSE
		SequenceContext FALSE
