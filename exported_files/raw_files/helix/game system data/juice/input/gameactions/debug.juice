TriggerGameAction "[Debug] Toggle Freecam"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Gamepad
				{
					myConditionalInputActions
					{
						ConditionalInputAction R3
						{
							myInputActionType DoublePress
							myTimer 250
							myInputAction = RIGHT_STICK_BUTTON
						}
						ConditionalInputAction L3
						{
							myInputActionType HoldDown
							myTimer 0
							myInputAction = LEFT_STICK_BUTTON
						}
					}
				}
				ConditionalActionGroup KB_Mouse
				{
					myConditionalInputActions
					{
						ConditionalInputAction Home
						{
							myInputActionType Pressed
							myTimer 0
							myInputAction = KB_TOGGLE_FREECAM
						}
					}
				}
			}
		}
	}
	myGameAction FreeCamToggle
	myActionContexts
	{
		DefaultContext TRUE
		FreeCameraContext TRUE
	}
}

TriggerGameAction "[Debug] Teleport to Freecam"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Gamepad
				{
					myConditionalInputActions
					{
						ConditionalInputAction R3
						{
							myInputActionType PressedAfterTime
							myTimer 500
							myInputAction = RIGHT_STICK_BUTTON
						}
						ConditionalInputAction L3
						{
							myInputActionType HoldDown
							myTimer 0
							myInputAction = LEFT_STICK_BUTTON
						}
					}
				}
				ConditionalActionGroup KB_Mouse
				{
					myConditionalInputActions
					{
						ConditionalInputAction Insert
						{
							myInputActionType Pressed
							myTimer 0
							myInputAction = KB_TELEPORT_FREECAM
						}
					}
				}
			}
		}
	}
	myGameAction FreeCamTeleportToCam
	myActionContexts
	{
		DefaultContext FALSE
		FreeCameraContext TRUE
	}
}

