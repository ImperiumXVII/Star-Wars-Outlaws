TriggerGameAction "[Debug] FreeCam Speed up"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Right Trigger R2"
				{
					myInputActionType Analog
					myInputAction = RIGHT_TRIGGER_R2
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType HoldDown
					myInputAction = KB_SPRINT
				}
			}
		}
	}
	myGameAction FreeCamSpeedUp
	myActionContexts
	{
		DefaultContext FALSE
		FreeCameraContext TRUE
	}
}

