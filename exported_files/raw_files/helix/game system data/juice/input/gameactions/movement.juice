						ConditionalInputAction Gamepad
						{
							myInputActionType DoublePress
							myTimer 260
							myInputAction = B_CIRCLE
						}
					}
				}
				ConditionalActionGroup "KB Press + Movement"
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalInputAction "KB Press"
						{
							myInputActionType HoldDown
							myTimer 0
							myInputAction = KB_DODGE
						}
					}
				}
			}
		}
	}
	myGameAction Dodge
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
