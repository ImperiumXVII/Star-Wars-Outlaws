include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction "[Movement] Move"
{
	myConditionalInputActions
	{
		ConditionalInputAction "Left Stick Left Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_LEFT
		}
		ConditionalInputAction "Left Stick Right Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_RIGHT
		}
		ConditionalInputAction "Left Stick Up Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_UP
		}
		ConditionalInputAction "Left Stick Down Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_DOWN
		}
		ConditionalInputAction "UP KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_UP
		}
		ConditionalInputAction "Left KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_LEFT
		}
		ConditionalInputAction "Down KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_DOWN
		}
		ConditionalInputAction "Right KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_RIGHT
		}
	}
	myGameAction Move
}

TriggerGameAction "[Movement] Move Left"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalRotatedInputAction "Rotated Left Stick Left Analog"
				{
					myInputActionType Analog
					myForwardInputAction = LEFT_STICK_UP
					myBackInputAction = LEFT_STICK_DOWN
					myLeftInputAction = LEFT_STICK_LEFT
					myRightInputAction = LEFT_STICK_RIGHT
					myExpectedInputAction = LEFT_STICK_LEFT
				}
				ConditionalRotatedInputAction "Left KB"
				{
					myInputActionType Analog
					myForwardInputAction = KB_MOVE_UP
					myBackInputAction = KB_MOVE_DOWN
					myLeftInputAction = KB_MOVE_LEFT
					myRightInputAction = KB_MOVE_RIGHT
					myExpectedInputAction = KB_MOVE_LEFT
				}
			}
		}
	}
	myGameAction MoveLeft
	myActionContexts
	{
		SequenceContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext FALSE
		GadgetSelectionContext FALSE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext FALSE
	}
}

