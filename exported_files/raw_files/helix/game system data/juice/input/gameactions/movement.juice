		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Gamepad
				{
					myConditionalInputActions
					{
						ConditionalInputAction Gamepad
						{
							myInputActionType HoldDownAfterTime
							myTimer 250
							myInputAction = B_CIRCLE
						}
					}
				}
				ConditionalInputAction KB
				{
					myInputActionType HoldDownAfterTime
					myTimer 250
					myInputAction = KB_CROUCH
				}
			}
		}
	}
	myGameAction HangLetGo
	myIsExclusiveToggle FALSE
	myExcludeInActionContexts
	{
		DeadContext TRUE
		GrapplingContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		ThrowableContext TRUE
		TransportSneakingContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Movement] Cancel Traversal Any"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "KB Press"
				{
					myInputActionType HoldDown
					myTimer 0
					myInputAction = KB_CROUCH
				}
				ConditionalActionGroup Gamepad
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalInputAction Gamepad
						{
							myInputActionType HoldDown
							myTimer 0
							myToggle FALSE
							myInputAction = B_CIRCLE
						}
					}
				}
			}
		}
	}
	myGameAction CancelTraversalAny
}

