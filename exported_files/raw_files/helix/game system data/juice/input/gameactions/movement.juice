TriggerGameAction "[Movement] Jump"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Gamepad
				{
					myConditionalInputActions
					{
						ConditionalInputAction "A_Cross Pressed"
						{
							myInputActionType Pressed
							myToggle FALSE
							myInputAction = A_CROSS
						}
					}
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType Pressed
					myInputAction = KB_TRAVERSAL
				}
			}
		}
	}
	myGameAction Jump
	myRequireNewInputOnContextChange TRUE
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		GadgetSelectionContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Movement] Not Moving"
{
	myConditionalInputActions
	{
		ConditionalGameAction "Not Moving Left"
		{
			myNegate TRUE
			myGameAction MoveLeft
		}
		ConditionalGameAction "Not Moving Right"
		{
			myNegate TRUE
			myGameAction MoveRight
		}
		ConditionalGameAction "Not Moving Forward"
		{
			myNegate TRUE
			myGameAction MoveForward
		}
		ConditionalGameAction "Not Moving Backward"
		{
			myNegate TRUE
			myGameAction MoveBackward
		}
	}
	myGameAction NotMoving
	myExcludeInActionContexts
	{
		UIContext TRUE
	}
}

TriggerGameAction "[Movement] Toggle Sprint"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Left Stick Pressed"
				{
					myInputActionType PressedAfterTime
					myTimer 50
					myForceDisplayAsTapInUI TRUE
					myInputAction = LEFT_STICK_BUTTON
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType PressedAfterTime
					myTimer 50
					myForceDisplayAsTapInUI TRUE
					myInputAction = KB_SPRINT
				}
			}
		}
	}
	myGameAction Sprint
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		SpaceshipContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext FALSE
	}
}

TriggerGameAction "[Movement] Held Sprint"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Hold
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalActionGroup "Input Actions"
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction "Left Stick Pressed"
								{
									myInputActionType HoldDown
									myInputAction = LEFT_STICK_BUTTON
								}
								ConditionalInputAction "KB Pressed"
								{
									myInputActionType HoldDown
									myInputAction = KB_SPRINT
								}
							}
						}
					}
				}
			}
		}
	}
	myGameAction SprintHeld
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		SpaceshipContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext FALSE
	}
}

