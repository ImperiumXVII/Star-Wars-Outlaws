							myInputActionType Pressed
							myTimer 0
							myToggle FALSE
							myInputAction = B_CIRCLE
						}
					}
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myToggle FALSE
					myInputAction = KB_CROUCH
				}
			}
		}
	}
	myGameAction Crouch
	myIsExclusiveToggle FALSE
	myActionContexts
	{
		HoloReaderMapContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		GrapplingContext TRUE
		MeleeContext FALSE
		PetModeContext TRUE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		TutorialPauseContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext TRUE
	}
}

TriggerGameAction "[Movement] Traversal"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType HoldDown
					myForceDisplayAsTapInUI TRUE
					myInputAction = KB_TRAVERSAL
				}
				ConditionalInputAction "A or +"
				{
					myInputActionType HoldDown
					myForceDisplayAsTapInUI TRUE
					myInputAction = A_CROSS
				}
			}
		}
	}
	myGameAction Traversal
	myRequireNewInputOnContextChange FALSE
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

