				}
				ConditionalInputAction Right
				{
					myInputActionType Analog
					myTimer 75
					myInputAction = UI_INPUTCHALLENGE_RIGHT_STICK_RIGHT
				}
				ConditionalInputAction Left
				{
					myInputActionType Analog
					myTimer 75
					myInputAction = UI_INPUTCHALLENGE_RIGHT_STICK_LEFT
				}
				ConditionalInputAction MouseKb
				{
					myInputActionType HoldDown
					myTimer 10
					myInputAction = UI_INPUTCHALLENGE_MOUSE_RIGHT_KB
				}
			}
		}
	}
	myGameAction InputChallengeRightStickIdentifier
	myActionContexts
	{
		DefaultContext FALSE
		InputChallengeContext TRUE
	}
}

TriggerGameAction [InputChallenge]LeftStickIdentifier
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Down
				{
					myInputActionType Analog
					myInputAction = UI_INPUTCHALLENGE_LEFT_STICK_DOWN
				}
				ConditionalInputAction UP
				{
					myInputActionType Analog
					myInputAction = UI_INPUTCHALLENGE_LEFT_STICK_UP
				}
				ConditionalInputAction Right
				{
					myInputActionType Analog
					myTimer 75
					myInputAction = UI_INPUTCHALLENGE_LEFT_STICK_RIGHT
				}
				ConditionalInputAction Left
				{
					myInputActionType Analog
					myTimer 75
					myInputAction = UI_INPUTCHALLENGE_LEFT_STICK_LEFT
				}
				ConditionalInputAction MouseKb
				{
					myInputActionType HoldDown
					myTimer 10
					myInputAction = UI_INPUTCHALLENGE_MOUSE_LEFT_KB
				}
			}
		}
	}
	myGameAction InputChallengeLeftStickIdentifier
	myActionContexts
	{
		DefaultContext FALSE
		InputChallengeContext TRUE
	}
}

