include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction [InputChallenge]FaceButtonDown
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType Pressed
					myTimer 300
					myInputAction = UI_INPUTCHALLENGE_FACEBUTTON_DOWN
				}
				ConditionalInputAction MouseKb
				{
					myInputActionType Pressed
					myTimer 300
					myInputAction = UI_INPUTCHALLENGE_FACEBUTTON_DOWN_KB
				}
			}
		}
	}
	myGameAction InputChallengeFaceButtonDown
	myRequireNewInputOnContextChange TRUE
	myIsCinematicAction FALSE
	myActionContexts
	{
		DefaultContext FALSE
		InputChallengeContext TRUE
	}
}

