				{
					myTimer 300
					myInputAction = UI_MOVE_DOWN
				}
				ConditionalInputAction MouseKb
				{
					myTimer 300
					myInputAction = UI_MOVE_DOWN_KB
				}
			}
		}
	}
	myGameAction DoubleDrawCheatSwapCard
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
		AimScopeContext FALSE
		ArcadeGameContext FALSE
		BinocularsContext FALSE
		CoopDownedContext FALSE
		DeadContext FALSE
		DefaultContext FALSE
		FreeCameraContext FALSE
		GadgetContext FALSE
		GadgetSelectionContext FALSE
		GrapplingContext FALSE
		HoloReaderMapContext FALSE
		HyperspaceJumpMenuContext FALSE
		HyperspacePreparationReadyContext FALSE
		InputChallengeContext FALSE
		MeleeContext FALSE
		SequenceContext FALSE
		TextChatContext FALSE
		ThrowableContext FALSE
		TrickShotContext FALSE
		TutorialPauseContext FALSE
		UIContext FALSE
		VehicleContext FALSE
		WeaponModuleSelectionContext FALSE
	}
}

TriggerGameAction [Sabacc]FastMode
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Keyboard
				{
					myTimer 300
					myInputAction = UI_QUATERNARYINTERACT_KB
				}
				ConditionalInputAction Gamepad
				{
					myTimer 300
					myInputAction = UI_QUATERNARYINTERACT
				}
			}
		}
	}
	myGameAction SabaccFastMode
	myActionContexts
	{
		DefaultContext FALSE
		SabaccContext TRUE
		UIContext FALSE
	}
	myExcludeInActionContexts
	{
		DefaultContext TRUE
	}
}

