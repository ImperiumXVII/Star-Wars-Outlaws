TriggerGameAction [Sabacc]DoubleDrawCheatPadMove
{
	myConditionalInputActions
	{
		ConditionalInputAction "Left Stick Left Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_LEFT
		}
		ConditionalInputAction "Left Stick Right Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_RIGHT
		}
		ConditionalInputAction "Left Stick Up Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_UP
		}
		ConditionalInputAction "Left Stick Down Analog"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_DOWN
		}
		ConditionalInputAction "UP KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_UP
		}
		ConditionalInputAction "Left KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_LEFT
		}
		ConditionalInputAction "Down KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_DOWN
		}
		ConditionalInputAction "Right KB"
		{
			myInputActionType Analog
			myInputAction = KB_MOVE_RIGHT
		}
	}
	myGameAction DoubleDrawCheatPadMove
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
}

