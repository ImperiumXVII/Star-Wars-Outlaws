include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction "[Abilities] Trick Shot Use"
{
	myConditionalInputActions
	{
		ConditionalActionGroup Conditions
		{
			myConditionalInputActions
			{
				ConditionalActionGroup "Input Actions"
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction "Mouse Trigger Pressed"
						{
							myInputActionType SinglePress
							myInputAction = KB_X
						}
						ConditionalActionGroup GamePad
						{
							myConditionalInputActions
							{
								ConditionalInputAction LBL1
								{
									myInputActionType HoldDown
									myTimer 100
									myInputAction = LEFT_STICK_BUTTON
								}
								ConditionalInputAction RBR1
								{
									myInputActionType HoldDown
									myTimer 100
									myInputAction = RIGHT_STICK_BUTTON
								}
							}
						}
					}
				}
				ConditionalActionGroup State
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalGameActionState IsAiming
						{
							myNegate TRUE
							myGameActionState IsAiming
						}
					}
				}
			}
		}
	}
	myGameAction TrickShotUse
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		GrapplingContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		ThrowableContext FALSE
		UIContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Abilities] Trick Shot Shoot"
{
	myConditionalInputActions
	{
		ConditionalActionGroup Conditions
		{
			myConditionalInputActions
			{
				ConditionalActionGroup "Input Actions"
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction Gamepad
						{
							myInputActionType SinglePress
							myInputAction = RIGHT_BUMPER_R1
						}
						ConditionalInputAction "Mouse Trigger Pressed"
						{
							myInputActionType SinglePress
							myInputAction = KB_USE_CONSUMABLE_2
						}
					}
				}
				ConditionalActionGroup State
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalGameActionState IsAiming
						{
							myNegate TRUE
							myGameActionState IsAiming
						}
					}
				}
			}
		}
	}
	myGameAction TrickShotShoot
	myActionContexts
	{
		DefaultContext FALSE
		TrickShotContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		SpaceshipContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

