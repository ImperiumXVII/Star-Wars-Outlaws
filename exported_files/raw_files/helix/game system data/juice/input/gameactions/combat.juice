include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction "[Combat] Melee"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Melee action + No modifiers"
		{
			myConditionalInputActions
			{
				ConditionalActionGroup "Melee Action"
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction "Mouse Trigger Pressed"
						{
							myInputActionType HoldDown
							myTimer 0
							myForceDisplayAsTapInUI TRUE
							myInputAction = KB_MELEE
						}
						ConditionalActionGroup GamepadGroup
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalActionGroup HoldDown_0
								{
									myConditionalInputActions
									{
										ConditionalInputAction "New ConditionalInputAction"
										{
											myInputActionType HoldDown
											myTimer 0
											myForceDisplayAsTapInUI TRUE
											myInputAction = X_SQUARE
										}
										ConditionalInputAction "Not holding Left Stick"
										{
											myInputActionType HoldDown
											myNegate TRUE
											myForceDisplayAsTapInUI TRUE
											myInputAction = GP_ADRENALINE_RUSH_USE_A
										}
									}
								}
								ConditionalActionGroup HoldDown_100_ARClash
								{
									myConditionalInputActions
									{
										ConditionalInputAction "Left stick Held Down"
										{
											myInputActionType HoldDown
											myNegate FALSE
											myForceDisplayAsTapInUI TRUE
											myInputAction = GP_ADRENALINE_RUSH_USE_A
										}
										ConditionalInputAction "Tap X_Square"
										{
											myInputActionType ReleaseBeforeTime
											myTimer 150
											myForceDisplayAsTapInUI TRUE
											myInputAction = X_SQUARE
										}
									}
									myIgnoreInUI TRUE
								}
							}
						}
					}
				}
			}
		}
	}
	myGameAction Melee
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext TRUE
	}
}

TriggerGameAction "[Combat] Takedown"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = X_SQUARE
				}
				ConditionalInputAction "Mouse Trigger Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_MELEE
				}
			}
		}
	}
	myGameAction Takedown
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext TRUE
	}
}

TriggerGameAction "[Combat] Takedown Alternate"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup GamepadGroup
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalActionGroup "Normal - hold"
						{
							myConditionalInputActions
							{
								ConditionalInputAction "Hold X_Square"
								{
									myInputActionType HoldDown
									myTimer 0
									myForceDisplayAsTapInUI TRUE
									myInputAction = X_SQUARE
								}
								ConditionalGameActionState "Not using alternate preset"
								{
									myNegate TRUE
									myGameActionState IsUsingAlternatePreset
								}
							}
						}
						ConditionalActionGroup "Alternate - tap"
						{
							myConditionalInputActions
							{
								ConditionalInputAction "Tap X_Square"
								{
									myInputActionType ReleaseBeforeTime
									myTimer 150
									myForceDisplayAsTapInUI TRUE
									myInputAction = X_SQUARE
								}
								ConditionalGameActionState "Using alternate preset"
								{
									myGameActionState IsUsingAlternatePreset
								}
							}
						}
					}
				}
				ConditionalInputAction "Mouse Trigger Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_MELEE
				}
			}
		}
	}
	myGameAction TakedownAlternate
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		DeadContext TRUE
		PetModeContext TRUE
		SpaceshipContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
		WeaponModuleSelectionContext TRUE
	}
}

