include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"
include snowdrop/modules/core/input/gameactions.fruit

TriggerGameAction "[FathierRaces] Look Around"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "New ConditionalActionGroup"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Middle Mouse Click"
				{
					myInputActionType PressAndRepeat
					myTimer 0
					myInputAction = MIDDLE_CLICK
				}
				ConditionalInputAction "Right Stick Down Analog"
				{
					myInputActionType Analog
					myInputAction = RIGHT_STICK_DOWN
				}
				ConditionalInputAction "Right Stick Up Analog"
				{
					myInputActionType Analog
					myInputAction = RIGHT_STICK_UP
				}
				ConditionalInputAction "Right Stick Left Analog"
				{
					myInputActionType Analog
					myInputAction = RIGHT_STICK_LEFT
				}
				ConditionalInputAction "Right Stick Right Analog"
				{
					myInputActionType Analog
					myInputAction = RIGHT_STICK_RIGHT
				}
			}
		}
	}
	myGameAction FathierRacesLookAround
	myActionContexts
	{
		SequenceContext TRUE
	}
}

TriggerGameAction "[FathierRaces] Move Left"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Keyboard
				{
					myInputActionType HoldDown
					myTimer 300
					myInputAction = UI_MOVE_LEFT_KB
				}
				ConditionalInputAction Gamepad
				{
					myInputActionType HoldDown
					myTimer 100
					myInputAction = RIGHT_STICK_LEFT
				}
			}
		}
	}
	myGameAction FathierRacesHoloLeft
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
	}
}

TriggerGameAction "[FathierRaces] Move Right"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Keyboard
				{
					myInputActionType HoldDown
					myTimer 300
					myInputAction = UI_MOVE_RIGHT_KB
				}
				ConditionalInputAction Gamepad
				{
					myInputActionType HoldDown
					myTimer 100
					myInputAction = RIGHT_STICK_RIGHT
				}
			}
		}
	}
	myGameAction FathierRacesHoloRight
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
	}
}

TriggerGameAction "[FathierRaces] Change FOV"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "New ConditionalActionGroup"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Right Stick Button"
				{
					myInputAction = RIGHT_STICK_BUTTON
				}
				ConditionalInputAction Hold_MouseRight
				{
					myInputActionType Pressed
					myInputAction = KB_AIM
				}
			}
		}
	}
	myGameAction FathierRacesChangeFOV
	myIsCinematicAction TRUE
	myActionContexts
	{
		SequenceContext TRUE
	}
}

