include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"
include "helix/game system data/juice/input/inputactions_game.juice"
include "helix/game system data/juice/input/inputactions_ui.juice"

TriggerGameAction "[Photomode] Crane Up"
{
	myConditionalInputActions
	{
		ConditionalActionGroup InputActions
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction KB
				{
					myInputActionType Analog
					myInputAction = UI_PHOTOMODE_CRANEUP_KB
				}
				ConditionalInputAction Gamepad
				{
					myInputActionType Analog
					myInputAction = UI_PHOTOMODE_CRANEUP
				}
			}
		}
	}
	myGameAction PhotoModeCraneUp
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
		PhotoModeContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
		UIContext FALSE
	}
}

