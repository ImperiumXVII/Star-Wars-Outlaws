TriggerGameAction "[Photomode] Move Camera"
{
	myConditionalInputActions
	{
		ConditionalActionGroup InputActions
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "LS Up"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = LEFT_STICK_UP
				}
				ConditionalInputAction "LS Left"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = LEFT_STICK_LEFT
				}
				ConditionalInputAction "LS Right"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = LEFT_STICK_RIGHT
				}
				ConditionalInputAction "LS Down"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = LEFT_STICK_DOWN
				}
				ConditionalInputAction "KB Up"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = UI_PHOTOMODE_CAMERA_FORWARD_KB
				}
				ConditionalInputAction "KB Left"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = UI_PHOTOMODE_CAMERA_LEFT_KB
				}
				ConditionalInputAction "KB Down"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = UI_PHOTOMODE_CAMERA_BACK_KB
				}
				ConditionalInputAction "KB Right"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = UI_PHOTOMODE_CAMERA_RIGHT_KB
				}
			}
		}
	}
	myGameAction PhotoModeMoveCamera
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
		PhotoModeContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
	}
}

