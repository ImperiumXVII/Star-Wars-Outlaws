TriggerGameAction "[Photomode] Rotate Camera"
{
	myConditionalInputActions
	{
		ConditionalActionGroup InputActions
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "RS Up"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = RIGHT_STICK_UP
				}
				ConditionalInputAction "RS Left"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = RIGHT_STICK_LEFT
				}
				ConditionalInputAction "RS Right"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = RIGHT_STICK_RIGHT
				}
				ConditionalInputAction "RS Down"
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = RIGHT_STICK_DOWN
				}
				ConditionalInputAction Mouse
				{
					myInputActionType Analog
					myTimer 0
					myInputAction = LEFT_CLICK
				}
			}
		}
	}
	myGameAction PhotoModeRotateCamera
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
		PhotoModeContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
	}
}

