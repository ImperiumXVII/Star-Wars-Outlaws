include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction "[Camera] Look Up"
{
	myConditionalInputActions
	{
		ConditionalInputAction "Right Stick Up Analog"
		{
			myInputActionType Analog
			myInputAction = RIGHT_STICK_UP
		}
		HardcodedUIInput "[UI-only] Mouse forward"
		{
			myButtonName MOUSE_YAXIS
			myAxisDirection 1
		}
	}
	myGameAction LookUp
	myActionContexts
	{
		UIContext FALSE
		SequenceContext TRUE
	}
	myExcludeInActionContexts
	{
		WeaponModuleSelectionContext FALSE
		GadgetSelectionContext FALSE
		AimScopeContext FALSE
		AdrenalineRushContext FALSE
	}
}

