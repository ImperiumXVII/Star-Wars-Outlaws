		HardcodedUIInput "[UI-only] Mouse forward"
		{
			myButtonName MOUSE_YAXIS
			myAxisDirection 1
		}
		HardcodedUIInput "[UI-only] Mouse left"
		{
			myButtonName MOUSE_XAXIS
			myAxisDirection -1
		}
		HardcodedUIInput "[UI-only] Mouse right"
		{
