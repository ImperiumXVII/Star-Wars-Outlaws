TriggerGameAction "[UI] Open Galaxy Location (shortcut)"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "New ConditionalActionGroup"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Side button forward"
				{
					myInputActionType ReleaseBeforeTime
					myTimer 300
					myInputAction = M_SIDE_FORWARD
				}
				ConditionalInputAction "Double-Click LMB"
				{
					myInputActionType DoublePress
					myTimer 250
					myInputAction = LEFT_CLICK
				}
			}
		}
	}
	myGameAction UIMapOpenGalaxyLocationShortcut
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
}

TriggerGameAction "[UI] Close Galaxy Location (shortcut)"
{
	myConditionalInputActions
	{
		ConditionalInputAction "Side button back"
		{
			myInputActionType ReleaseBeforeTime
			myTimer 300
			myInputAction = M_SIDE_BACKWARD
		}
	}
	myGameAction UIMapCloseGalaxyLocationShortcut
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
}

TriggerGameAction "[UI Map Debug] Debug Teleport"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "New ConditionalActionGroup (0)"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup "Left Trigger + D-Pad Down"
				{
					myConditionalInputActions
					{
						ConditionalInputAction "New ConditionalInputAction (0)"
						{
							myInputActionType HoldDown
							myInputAction = LEFT_TRIGGER_L2
						}
						ConditionalInputAction "New ConditionalInputAction (2)"
						{
							myInputAction = D_PAD_DOWN
						}
					}
				}
				ConditionalActionGroup "LMB + RMB"
				{
					myConditionalInputActions
					{
						ConditionalInputAction "New ConditionalInputAction"
						{
							myInputActionType HoldDown
							myInputAction = LEFT_CLICK
						}
						ConditionalInputAction "New ConditionalInputAction_0"
						{
							myInputActionType HoldDown
							myInputAction = RIGHT_CLICK
						}
					}
				}
			}
		}
	}
	myGameAction UIMapDebugTeleport
	myRequireNewInputOnContextChange FALSE
}

