	}
}

TriggerGameAction [MultiOHC]Listen
{
	myConditionalInputActions
	{
		ConditionalActionGroup Input
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Console
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = RIGHT_STICK_BUTTON
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_INTERACT
				}
			}
		}
	}
	myGameAction MultiOHCListen
	myActionContexts
	{
		DefaultContext FALSE
		SequenceContext TRUE
		UIContext TRUE
	}
}

TriggerGameAction [MultiOHC]Exit
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType ReleaseBeforeTime
					myTimer 600
					myInputAction = UI_CANCEL
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType ReleaseBeforeTime
					myTimer 600
					myInputAction = UI_CANCEL_KB
				}
			}
		}
	}
	myGameAction MultiOHCExit
	myActionContexts
	{
		DefaultContext FALSE
		SequenceContext TRUE
		UIContext TRUE
	}
}

