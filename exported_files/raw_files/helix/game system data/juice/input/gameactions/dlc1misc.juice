include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"
include snowdrop/modules/core/input/gameactions.fruit

TriggerGameAction [Sabacc]NixScamUIStart_Hold
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction GamePad
				{
					myInputActionType PressedAfterTime
					myTimer 500
					myInputAction = D_PAD_UP
				}
				ConditionalInputAction MouseKb
				{
					myInputActionType PressedAfterTime
					myTimer 500
					myInputAction = UI_MOVE_UP_KB
				}
			}
		}
	}
	myGameAction CheatNixScamUIStartHold
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
}

TriggerGameAction [Sabacc]NixScamUIStart_Press
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myTimer 300
					myInputAction = D_PAD_UP
				}
				ConditionalInputAction MouseKb
				{
					myTimer 300
					myInputAction = UI_MOVE_UP_KB
				}
			}
		}
	}
	myGameAction CheatNixScamUIStart
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
}

TriggerGameAction [Sabacc]NixScamSelectTargetLeft
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Keyboard
				{
					myInputActionType PressAndRepeat
					myTimer 200
					myInputAction = UI_MOVE_LEFT_KB
				}
				ConditionalInputAction Gamepad
				{
					myInputActionType PressAndRepeat
					myTimer 200
					myInputAction = UI_MOVE_LEFT
				}
				ConditionalInputAction Gamepad_0
				{
					myInputActionType PressAndRepeat
					myTimer 200
					myInputAction = RIGHT_STICK_LEFT
				}
			}
		}
	}
	myGameAction CheatNixScamSelectTargetLeft
	myActionContexts
	{
		DefaultContext FALSE
		UIContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
	}
}

