TriggerGameAction "[Pet] [Special] Activate Input Combo"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType HoldDownAfterTime
					myTimer 0
					myForceDisplayAsTapInUI TRUE
					myInputAction = LEFT_BUMPER_L1
				}
				ConditionalInputAction MouseKb
				{
					myInputActionType HoldDownAfterTime
					myTimer 0
					myForceDisplayAsTapInUI TRUE
					myInputAction = KB_HOLD_PETMODE
				}
			}
		}
	}
	myGameAction ActivateInputCombo
	myRequireNewInputOnContextChange TRUE
	myActionContexts
	{
		PetModeContext FALSE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		TrickShotContext TRUE
	}
}

TriggerGameAction "[Pet] [Special] Keep Input Combo Alive"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Gamepad - Order Pet Command Advanced"
				{
					myInputActionType HoldDown
					myInputAction = X_SQUARE
				}
				ConditionalInputAction "MouseKb - Order Pet Command Advanced"
				{
					myInputActionType HoldDown
					myInputAction = KB_SEND_PET_ORDER_ADVANCED
				}
				ConditionalInputAction "Gamepad - Order Pet Command Advanced Alternate"
				{
					myInputActionType HoldDown
					myInputAction = A_CROSS
				}
				ConditionalInputAction "MouseKb - Order Pet Command Advanced Alternate"
				{
					myInputActionType HoldDown
					myInputAction = KB_SEND_PET_ORDER_ADVANCED_ALTERNATE
				}
				ConditionalInputAction "Gamepad - Enter And Exit Pet Aggressive Mode From Pet Mode"
				{
					myInputActionType HoldDown
					myInputAction = Y_TRIANGLE
				}
				ConditionalInputAction "MouseKb - Enter And Exit Pet Aggressive Mode From Pet Mode"
				{
					myInputActionType HoldDown
					myInputAction = KB_TRIGGER_PET_AGGRESSIVE_MODE
				}
			}
		}
	}
	myGameAction KeepInputComboAlive
	myRequireNewInputOnContextChange FALSE
	myActionContexts
	{
		PetModeContext TRUE
	}
}

