					myInputAction = KB_PROGRESSIVE_ZOOM_IN
				}
				ConditionalInputAction "KB Wheel Down"
				{
					myInputActionType Analog
					myInputAction = KB_PROGRESSIVE_ZOOM_OUT
				}
				ConditionalInputAction "Controller Left Trigger Hold"
				{
					myInputActionType Analog
					myInputAction = LEFT_TRIGGER_L2
				}
				ConditionalInputAction "Controller Right Trigger Hold"
				{
					myInputActionType Analog
					myInputAction = RIGHT_TRIGGER_R2
				}
			}
		}
	}
