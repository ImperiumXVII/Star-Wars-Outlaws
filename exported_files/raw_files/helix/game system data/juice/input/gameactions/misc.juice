include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"
include snowdrop/modules/core/input/gameactions.fruit

TriggerGameAction "[Misc] Start"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Start Pressed (OR)"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Controller
				{
					myInputActionType ReleaseBeforeTime
					myTimer 300
					myInputAction = UI_MAINMENU
				}
				ConditionalInputAction KB
				{
					myInputAction = UI_MAINMENU_KB
				}
			}
		}
	}
	myGameAction MiscStart
}

TriggerGameAction "[Misc] Interact"
{
	myConditionalInputActions
	{
		ConditionalActionGroup Input
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Console
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = RIGHT_STICK_BUTTON
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_INTERACT
				}
			}
		}
	}
	myGameAction Interact
	myExcludeInActionContexts
	{
		AimScopeContext TRUE
		GrapplingContext TRUE
		HyperspacePreparationReadyContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Misc] Hold Interact"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Only allow if Force Over Heat is unavailable"
		{
			myConditionalInputActions
			{
				ConditionalGameActionState "Cannot Force Over Heat"
				{
					myNegate TRUE
					myGameActionState CanForceOverHeat
				}
				ConditionalGameActionState "Equipment Not Over Heating"
				{
					myNegate TRUE
					myGameActionState IsEquipmentOverHeat
				}
				ConditionalActionGroup "Input Actions"
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction "Y-Triangle Pressed"
						{
							myInputActionType HoldDown
							myTimer 0
							myInputAction = Y_TRIANGLE
						}
						ConditionalInputAction "KB Pressed"
						{
							myInputActionType HoldDown
							myTimer 0
							myInputAction = KB_INTERACT
						}
					}
				}
			}
		}
	}
	myGameAction HoldInteract
	myExcludeInActionContexts
	{
		AimScopeContext TRUE
		GrapplingContext TRUE
		HyperspacePreparationReadyContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Misc] FusionCutterInteract"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Hold if force over heat available but instant if not"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup "Hold if force over heat available"
				{
					myConditionalInputActions
					{
						ConditionalGameActionState Condition
						{
							myRequireNewInput FALSE
							myGameActionState CanForceOverHeat
						}
						ConditionalActionGroup "Input Actions"
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction "X-Square Pressed"
								{
									myInputActionType HoldDownAfterTime
									myTimer 0
									myInputAction = Y_TRIANGLE
								}
								ConditionalInputAction "KB Pressed"
								{
									myInputActionType HoldDownAfterTime
									myTimer 0
									myInputAction = KB_ACTION_3
								}
							}
						}
					}
				}
				ConditionalActionGroup "Instant if force over heat unavailable"
				{
					myConditionalInputActions
					{
						ConditionalGameActionState Condition
						{
							myNegate TRUE
							myGameActionState CanForceOverHeat
						}
						ConditionalActionGroup "Input Actions"
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction "X-Square Pressed"
								{
									myInputActionType HoldDownAfterTime
									myInputAction = Y_TRIANGLE
								}
								ConditionalInputAction "KB Pressed"
								{
									myInputActionType HoldDownAfterTime
									myInputAction = KB_ACTION_3
								}
							}
						}
					}
				}
			}
		}
	}
	myGameAction FusionCutterInteract
	myActionContexts
	{
		SequenceContext TRUE
	}
	myExcludeInActionContexts
	{
		AimScopeContext TRUE
		GrapplingContext TRUE
		VehicleContext TRUE
	}
}

