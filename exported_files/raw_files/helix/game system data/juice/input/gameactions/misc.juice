TriggerGameAction ArcadeGameRailShooterMoveLeft
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalRotatedInputAction "Rotated Left Stick Left Analog"
				{
					myInputActionType Analog
					myForwardInputAction = LEFT_STICK_UP
					myBackInputAction = LEFT_STICK_DOWN
					myLeftInputAction = LEFT_STICK_LEFT
					myRightInputAction = LEFT_STICK_RIGHT
					myExpectedInputAction = LEFT_STICK_LEFT
				}
				ConditionalRotatedInputAction "Left KB"
				{
					myInputActionType Analog
					myForwardInputAction = KB_MOVE_UP
					myBackInputAction = KB_MOVE_DOWN
					myLeftInputAction = KB_MOVE_LEFT
					myRightInputAction = KB_MOVE_RIGHT
					myExpectedInputAction = KB_MOVE_LEFT
				}
				ConditionalRotatedInputAction "Rotated Right Stick Left Analog"
				{
					myInputActionType Analog
					myForwardInputAction = RIGHT_STICK_UP
					myBackInputAction = RIGHT_STICK_DOWN
					myLeftInputAction = RIGHT_STICK_LEFT
					myRightInputAction = RIGHT_STICK_RIGHT
					myExpectedInputAction = RIGHT_STICK_LEFT
				}
				ConditionalInputAction Dpad_Left
				{
					myInputActionType Analog
					myInputAction = D_PAD_LEFT
				}
			}
		}
	}
	myGameAction ArcadeGameRailShooterMoveLeft
	myActionContexts
	{
		ArcadeGameContext TRUE
		DefaultContext FALSE
	}
}

