	{
		AdrenalineRushContext TRUE
		TutorialPauseContext TRUE
		PhotoModeContext TRUE
	}
}

TriggerGameAction "[Misc] UnpinTargetAll"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator And
			myConditionalInputActions
			{
				ConditionalActionGroup "Input Actions"
				{
					myOperator Or
					myConditionalInputActions
					{
						ConditionalInputAction Controller
						{
							myInputActionType HoldDownAfterTime
							myTimer 200
							myInputAction = UI_SECONDARYINTERACT
						}
						ConditionalInputAction KB
						{
							myInputActionType HoldDownAfterTime
							myTimer 200
							myInputAction = KB_E
						}
					}
				}
			}
		}
		ConditionalGameActionState "Not in Interact Context"
		{
			myNegate TRUE
			myGameActionState IsAnyPlayerInteractionNearby
		}
	}
	myGameAction Unpin
}

TriggerGameAction "[Misc] MountSpeeder"
{
	myConditionalInputActions
	{
		ConditionalActionGroup Input
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Console
				{
					myInputActionType HoldDown
					myTimer 0
					myForceDisplayAsTapInUI TRUE
					myInputAction = RIGHT_STICK_BUTTON
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType HoldDown
					myTimer 0
					myForceDisplayAsTapInUI TRUE
					myInputAction = KB_INTERACT
				}
			}
		}
	}
	myGameAction MountSpeeder
	myExcludeInActionContexts
	{
		AimScopeContext TRUE
		GrapplingContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Misc] Accessibility Setting"
{
	myConditionalInputActions
	{
		ConditionalActionGroup Touch
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup "New ConditionalActionGroup"
				{
					myConditionalInputActions
					{
						ConditionalInputAction "On Foot"
						{
							myInputActionType PressedAfterTime
							myTimer 300
							myInputAction = START
						}
						ConditionalInputAction Space
						{
							myInputActionType PressedAfterTime
							myTimer 300
							myInputAction = START_TRAILBLAZER
						}
						ConditionalInputAction Speeder
						{
							myInputActionType PressedAfterTime
							myTimer 300
							myInputAction = START_SPEEDER
						}
					}
				}
			}
		}
	}
	myGameAction UIAccessibilityShortcut
	myRequireNewInputOnContextChange FALSE
	myActionContexts
	{
		SabaccContext TRUE
		UIContext TRUE
	}
	myExcludeInActionContexts
	{
		UIContext FALSE
	}
}

