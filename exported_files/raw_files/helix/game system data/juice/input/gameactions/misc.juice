TriggerGameAction "[Misc] CancelInteraction"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad_Cancel
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = B_CIRCLE
				}
				ConditionalInputAction Gamepad_Interact
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = RIGHT_STICK_BUTTON
				}
				ConditionalInputAction Keypad_Cancel
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_CANCEL
				}
				ConditionalInputAction Keypad_Interact
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_E
				}
				ConditionalInputAction Gamepad_Up
				{
					myInputActionType PressedAfterTime
					myTimer 1000
					myInputAction = LEFT_STICK_UP
				}
				ConditionalInputAction Gamepad_Down
				{
					myInputActionType PressedAfterTime
					myTimer 1000
					myInputAction = LEFT_STICK_DOWN
				}
				ConditionalInputAction Gamepad_Left
				{
					myInputActionType PressedAfterTime
					myTimer 1000
					myInputAction = LEFT_STICK_LEFT
				}
				ConditionalInputAction Gamepad_Right
				{
					myInputActionType PressedAfterTime
					myTimer 1000
					myInputAction = LEFT_STICK_RIGHT
				}
				ConditionalInputAction Keypad_Up
				{
					myInputActionType PressedAfterTime
					myTimer 500
					myInputAction = KB_MOVE_UP
				}
				ConditionalInputAction Keypad_Down
				{
					myInputActionType PressedAfterTime
					myTimer 500
					myInputAction = KB_MOVE_DOWN
				}
				ConditionalInputAction Keypad_Left
				{
					myInputActionType PressedAfterTime
					myTimer 500
					myInputAction = KB_MOVE_LEFT
				}
				ConditionalInputAction Keypad_Right
				{
					myInputActionType PressedAfterTime
					myTimer 500
					myInputAction = KB_MOVE_RIGHT
				}
			}
		}
	}
	myGameAction CancelInteraction
	myActionContexts
	{
		SequenceContext TRUE
	}
}

