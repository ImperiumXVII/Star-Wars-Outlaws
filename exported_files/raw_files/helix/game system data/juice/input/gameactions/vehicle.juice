TriggerGameAction "[Speeder] YawLeft"
{
	myConditionalInputActions
	{
		HardcodedUIInput "[UI-only] Mouse left"
		{
			myButtonName MOUSE_XAXIS
			myAxisDirection -1
		}
		ConditionalActionGroup "New ConditionalActionGroup"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalRotatedInputAction "Rotated Right Stick Left Analog"
				{
					myInputActionType Analog
					myForwardInputAction = LEFT_STICK_UP_SPEEDER
					myBackInputAction = LEFT_STICK_DOWN_SPEEDER
					myLeftInputAction = LEFT_STICK_LEFT_SPEEDER
					myRightInputAction = LEFT_STICK_RIGHT_SPEEDER
					myExpectedInputAction = LEFT_STICK_LEFT_SPEEDER
				}
				ConditionalInputAction "KB A"
				{
					myInputActionType Analog
					myInputAction = KB_SPEEDER_ROLL_LEFT
				}
			}
		}
	}
	myGameAction Speeder_YawLeft
	myActionContexts
	{
		DefaultContext FALSE
		HoloReaderCompassContext FALSE
		HoloReaderMapContext FALSE
		VehicleContext TRUE
	}
	myExcludeInActionContexts
	{
		AdrenalineRushContext FALSE
		FreeCameraContext TRUE
		GadgetSelectionContext FALSE
		HoloReaderCompassContext TRUE
		HoloReaderMapContext TRUE
		UIContext TRUE
	}
}

