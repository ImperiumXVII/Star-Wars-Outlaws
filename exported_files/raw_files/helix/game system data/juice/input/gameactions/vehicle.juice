					{
						ConditionalInputAction "X_SQUARE Pressed"
						{
							myInputActionType Pressed
							myTimer 0
							myInputAction = RIGHT_STICK_BUTTON_SPEEDER
						}
						ConditionalGameActionState "Using Alternate Preset"
						{
							myGameActionState IsUsingAlternatePreset
						}
						ConditionalInputAction "Not holding left stick"
						{
							myInputActionType HoldDown
							myNegate TRUE
							myInputAction = GP_ADRENALINE_RUSH_USE_A
						}
					}
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_VEHICLE_BOOST
				}
			}
		}
	}
	myGameAction BoostAlternateTap
