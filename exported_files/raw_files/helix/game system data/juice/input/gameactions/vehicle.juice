}

TriggerGameAction "[Speeder] Boost"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Gamepad
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalInputAction "X_SQUARE Pressed"
						{
							myInputActionType Pressed
							myTimer 0
							myInputAction = X_SQUARE_SPEEDER
						}
						ConditionalGameActionState "Using Alternate Preset"
						{
							myNegate TRUE
							myGameActionState IsUsingAlternatePreset
						}
					}
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_VEHICLE_BOOST
				}
			}
		}
	}
	myGameAction Boost
	myActionContexts
	{
		DefaultContext FALSE
		VehicleContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		FreeCameraContext TRUE
		UIContext TRUE
	}
}

TriggerGameAction "[Speeder] Boost Alternate Hold"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Gamepad
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalInputAction "X_SQUARE Pressed"
						{
							myInputActionType ReleaseBeforeTime
							myTimer 150
							myInputAction = X_SQUARE_SPEEDER
						}
						ConditionalGameActionState "Using Alternate Preset"
						{
							myGameActionState IsUsingAlternatePreset
						}
						ConditionalInputAction "Holding left stick"
						{
							myInputActionType HoldDown
							myInputAction = GP_ADRENALINE_RUSH_USE_A
						}
					}
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_VEHICLE_BOOST
				}
			}
		}
	}
	myGameAction BoostAlternateHold
	myActionContexts
	{
		DefaultContext FALSE
		VehicleContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		FreeCameraContext TRUE
		UIContext TRUE
	}
}

