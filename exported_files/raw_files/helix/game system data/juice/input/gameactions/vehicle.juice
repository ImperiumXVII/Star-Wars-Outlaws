include "helix/game system data/fruit/input/gameinput.fruit"
include "helix/game system data/juice/input/inputactions.juice"

TriggerGameAction "[Speeder] Call Vehicle"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad
				{
					myInputActionType ReleaseBeforeTime
					myTimer 300
					myInputAction = D_PAD_RIGHT
				}
				ConditionalInputAction Keyboard
				{
					myInputActionType Pressed
					myTimer 100
					myInputAction = KB_CALL_VEHICLE
				}
			}
		}
	}
	myGameAction CallVehicle
	myActionContexts
	{
		DefaultContext TRUE
		GadgetSelectionContext FALSE
	}
	myExcludeInActionContexts
	{
		AimScopeContext TRUE
		ArcadeGameContext TRUE
		BinocularsContext TRUE
		CoopContext TRUE
		DeadContext TRUE
		FreeCameraContext TRUE
		GadgetContext TRUE
		GadgetSelectionContext FALSE
		GrapplingContext TRUE
		HoloReaderMapContext TRUE
		MeleeContext TRUE
		PetModeContext TRUE
		SequenceContext TRUE
		SpaceshipContext TRUE
		ThrowableContext FALSE
		TransportSneakingContext TRUE
		TrickShotContext TRUE
		UIContext TRUE
		VehicleContext TRUE
	}
}

TriggerGameAction "[Speeder] ExitVehicle"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction Gamepad_B_Circle
				{
					myInputActionType HoldDownAfterTime
					myTimer 100
					myInputAction = B_CIRCLE_SPEEDER
				}
				ConditionalInputAction MouseKb
				{
					myInputActionType HoldDownAfterTime
					myTimer 100
					myInputAction = KB_EXIT_VEHICLE
				}
			}
		}
	}
	myGameAction ExitVehicle
	myRequireNewInputOnContextChange TRUE
	myActionContexts
	{
		DefaultContext FALSE
		TransportSneakingContext TRUE
		VehicleContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		FreeCameraContext TRUE
		UIContext TRUE
	}
}

TriggerGameAction "[Speeder] LookBack"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Hold
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalActionGroup "Input Actions"
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction Gamepad_Y_Triangle
								{
									myInputActionType HoldDown
									myInputAction = Y_TRIANGLE_SPEEDER
								}
								ConditionalInputAction "KB Pressed"
								{
									myInputActionType HoldDown
									myInputAction = KB_VEHICLE_LOOKBACK
								}
							}
						}
					}
				}
			}
		}
	}
	myGameAction LookBack
	myActionContexts
	{
		DefaultContext FALSE
		HoloReaderCompassContext FALSE
		HoloReaderMapContext FALSE
		VehicleContext TRUE
	}
	myExcludeInActionContexts
	{
		BinocularsContext TRUE
		FreeCameraContext TRUE
		GadgetContext FALSE
		GadgetSelectionContext TRUE
		HoloReaderCompassContext TRUE
		HoloReaderMapContext TRUE
		SpaceshipContext TRUE
		SpaceshipPursuitModeContext TRUE
		UIContext TRUE
	}
}

