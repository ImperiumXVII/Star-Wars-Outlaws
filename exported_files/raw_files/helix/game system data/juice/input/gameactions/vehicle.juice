		ConditionalInputAction "Left stick Right"
		{
			myInputActionType Analog
			myInputAction = LEFT_STICK_RIGHT_SPEEDER
		}
		HardcodedUIInput "[UI-only] Mouse left"
		{
			myButtonName MOUSE_XAXIS
			myAxisDirection -1
		}
		HardcodedUIInput "[UI-only] Mouse Right"
		{
			myButtonName MOUSE_XAXIS
			myAxisDirection 1
		}
	}
