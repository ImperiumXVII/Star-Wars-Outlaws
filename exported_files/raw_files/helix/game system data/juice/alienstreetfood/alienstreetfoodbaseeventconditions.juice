include "helix/game system data/fruit/gameconditions/gameconditions.fruit"

GameConditionGroup "Reached Step 1"
{
	myConditions
	{
		GameConditionInputChallengeStep "Step 1"
		{
			myChallengeStepToCheck 1
		}
	}
}

GameConditionGroup "Progress Greater Than 0"
{
	myConditions
	{
		GameConditionInputChallengeProgress "Progress Greater than 0"
		{
		}
	}
}

GameConditionGroup "Progress Less Than or Equal to 0"
{
	myConditions
	{
		GameConditionInputChallengeProgress "Progress less or equal to 0"
		{
			myOperator LessThanOrEqual
		}
	}
}

GameConditionGroup "Progress Decreasing"
{
	myConditions
	{
		GameConditionInputChallengeProgressState "Started Decreasing"
		{
			myProgressStateToCheck Decreasing
		}
	}
}

GameConditionGroup "Progress Increasing"
{
	myConditions
	{
		GameConditionInputChallengeProgressState "Started Decreasing"
		{
			myProgressStateToCheck Increasing
		}
	}
}

