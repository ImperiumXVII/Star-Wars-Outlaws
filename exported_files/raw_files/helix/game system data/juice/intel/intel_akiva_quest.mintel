Intel C_MQ_005_GraveLocationIntel < uid=49CE584F67CFF17400317E6CFA87592B >
{
	myName "branch = \"DLC2\", contextComment = \"Name/header of the MQ005 Intel that leads to the Grave Location\", enabled = true, guid = #49CE584F67CFF17400317E6D63A877DA, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 12861, text = \"Qorvino's Map\", type = \"MenuLine\"}"
	myDescription "branch = \"DLC2\", contextComment = \"This is simply the same text as written on the Datapad player picks up\", enabled = true, guid = #49CE584F67CFF17400317E6ED21F1FF5, lineVersion = 4, maxLength = 0, productId = -1, sectionId = 12861, text = \"From Your Old Captain\n\nKnew you couldn't stay away, Hel. You'll never lose that itch in your trigger finger.\n\nThe blasted map didn't do me much good, but maybe you'll have a better shot at it. If you can pull it from my bony grip, that is.\n\nI'll be waiting for you under the three palms. Make your old man proud.\n\nQorvino\", type = \"MenuLine\"}"
	myIcon "mySpriteId = -1216650690, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_intel_icons.spritesheet\""
	myImage helix/baked/ui/loose_images/billboard_datapad_c_mq_005.dds
	myMapRefData < uid=49CE584F67CFF20B00317E71F6E49C70 > = mapref_intel_template B581CAC860E2F58400009A538031089F
	myTargetLevelInfo 9C4B6A046012E6B0000001B224713F01
	myStateGameValue < uid=49CE584F67CFF20B00317E72DC2ED5EE >
	{
	}
}

