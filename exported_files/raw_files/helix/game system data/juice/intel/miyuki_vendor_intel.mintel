	myName "branch = \"DLC2\", contextComment = 'Name for the intel about finding the superior gear \"Toshara Ruffian Pants\". The name of the intel refers to the place where the item is.', enabled = true, guid = #2AE2EC85679B998F003058B9D43518A7, lineVersion = 18, maxLength = 0, productId = -1, sectionId = 12361, text = \"Sealed Cave\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Narrative description for the intel pointing to the superior gear \\"Toshara Ruffian Pants\\". The intel is found at a Miyuki vendor, and has a paired item (find oasis ID), so they need to be similar (but don't need to be exactly the same). The text mentions Jet Kordo because there's a Jet Journal in the cave. He doesn't have to be directly mentioned but it helps tying things together.\", enabled = true, guid = #2AE2EC85679B9996003058BB93C18BE1, lineVersion = 25, maxLength = 0, productId = -1, sectionId = 12361, text = \"The Miyuki Trade League found in their records a report from Jet Kordo confirming that he left a piece of superior gear and supplies  to use for members of the league. (TO BE WRITTEN)\", type = \"MenuLine\"}"
	myObjectiveText "branch = \"DLC2\", contextComment = 'Objective for the intel pointing to the superior gear \"Toshara Ruffian Pants\". The is on Toshara in a cave called \"Amberine Cabve\". it is on the west/northwest of the Pyke Poaching Station..', enabled = true, guid = #2AE2EC85679B9992003058BA0FB59BC9, lineVersion = 20, maxLength = 0, productId = -1, sectionId = 12361, text = \"The cave is west of the Pyke Poaching Station. (TO BE WRITTEN)\", type = \"MenuLine\""
	myStateGameValue < uid=2AE2EC85679B7B13001644FDB0B4B941 >
	{
	}
}

