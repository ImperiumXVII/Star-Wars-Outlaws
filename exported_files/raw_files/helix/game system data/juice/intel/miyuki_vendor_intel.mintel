{
	myName "branch = \"DLC2\", contextComment = \"Name for the intel about finding the weapon overdrive active system. The name refers to the place where the player can find the treasure.\", enabled = true, guid = #2AE2EC85679B7C400016450277AF3EFE, lineVersion = 20, maxLength = 0, productId = -1, sectionId = 12361, text = \"Smuggler's Hideout\", type = \"MenuLine\"}"
	myDescription "branch = \"DLC2\", contextComment = \"Narrative description for the intel pointing to the Weapon Overdrive active system. The intel is found at a Miyuki vendor, and has a paired item (find oasis ID), so they need to be similar (but don't need to be exactly the same). The intel points to a hideout in Tatooine called \\"Smuggler's Hideout\\". it is in a canyon east of the Dune Sea in Tatooine.\", enabled = true, guid = #2AE2EC85679B7C6C00164503D16E35FA, lineVersion = 19, maxLength = 0, productId = -1, sectionId = 12361, text = \"Miyuki Trade League discovered that a competing smuggler group is holding rare ship tech in a hideout on the way to the dune sea. (TO BE WRITTEN\", type = \"MenuLine\""
	myObjectiveText "branch = \"DLC2\", contextComment = \"Objective for the intel pointing to the Weapon Overdrive active system. The item is in a hideout called \\"Smuggler's Hideout\\". It is in Tatooine in a canyon, east of the Dune Sea.\", enabled = true, guid = #2AE2EC85679B7C6F00164504F2A23D44, lineVersion = 24, maxLength = 0, productId = -1, sectionId = 12361, text = \"The hideout is in a canyon east of the Dune Sea.\", type = \"MenuLine\"}"
	myTargetLevelInfo 8F2AC097626BDD5C00002F2423EFE372
	myStateGameValue < uid=2AE2EC85679B7A45001644F03752E180 >
	{
	}
}

