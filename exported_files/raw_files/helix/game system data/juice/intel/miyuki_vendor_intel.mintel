	myName "branch = \"DLC2\", contextComment = 'Name for the intel about finding the minor charm \"Dragon Krayt Fang\". The name of the intel refers to the place where the item is.', enabled = true, guid = #2AE2EC85679B9737002A2AC554D5EA2E, lineVersion = 19, maxLength = 0, productId = -1, sectionId = 12361, text = \"Abandoned Tusken Camp\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Narrative description for the intel pointing to the Dragon Krayt Fang minor charm. The intel is found at a Miyuki vendor, and has a paired item (find oasis ID), so they need to be similar (but don't need to be exactly the same). The intel points to an abandoned tusken camp in a canyon beween the pillar forest and the Imperial compound Fort Sunfire.\", enabled = true, guid = #2AE2EC85679B9739002A2AC6026BBB43, lineVersion = 19, maxLength = 0, productId = -1, sectionId = 12361, text = \"Scavengers founds an abandonned Tusken camp but are too afraid to explore it. Miyuki scouts confirm that they left something valuable behind. (TO BE WRITTEN)\", type = \"MenuLine\"}"
	myObjectiveText "branch = \"DLC2\", contextComment = \"Objective for the intel pointing to the Krayt Dragon Fang minor charm. The item is in an abandoned tusken camp is in Tatooine in a canyon, east of the Dune Sea.\", enabled = true, guid = #2AE2EC85679B98C8003026391EB9FCF1, lineVersion = 16, maxLength = 0, productId = -1, sectionId = 12361, text = \"The camp is hidden in canyon east of the Pillar Forest (TO BE WRITTEN)\", type = \"MenuLine\""
	myTargetLevelInfo 8F2AC097626BDD5C00002F2423EFE372
	myStateGameValue < uid=2AE2EC85679B7B13001644F9DA99FFE4 >
	{
