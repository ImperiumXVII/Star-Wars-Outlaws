}

Intel ITL5103_AKI_MTL_JarwalBloomMajorCharm < uid=2AE2EC85679B7B13001644FA972C4D31 > : "TOS ITL TEMPLATE"
{
	myName "branch = \"DLC2\", contextComment = \"Name for the intel about finding the major charm \\"Jarwal Bloom\\". The name of the intel refers to the place where the item is. The name of the treasure location on the map is \\"Blackstone's retreat\\", but the player wouldn't know that at this point.\", enabled = true, guid = #2AE2EC85679B996B003058B38E927480, lineVersion = 18, maxLength = 0, productId = -1, sectionId = 12361, text = \"Mountainside Hideout\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Narrative description for the intel pointing to the Jarwal Bloom major charm. The intel is found at a Miyuki vendor, and has a paired item (find oasis ID), so they need to be similar (but don't need to be exactly the same). The intel points to a hideout in Akiva in the eastern face of Mount Selesa.\", enabled = true, guid = #2AE2EC85679B996E003058B4FDC2C721, lineVersion = 18, maxLength = 0, productId = -1, sectionId = 12361, text = \"Miyuki Scouts found a discovered a locked hideout in the mountains. A stolen manifest suggest that a treasure was hidden in it. (TO BE WRITTEN)\", type = \"MenuLine\"}"
	myObjectiveText "branch = \"DLC2\", contextComment = \"Objective for the intel pointing to the Jarwal Bloom major charm. The item is in a hideout called \\"Blackstone's Retreat\\". it is on Akiva on the eastern face of Mount Selesa, accessible from the river.\", enabled = true, guid = #2AE2EC85679B9971003058B584E53195, lineVersion = 20, maxLength = 0, productId = -1, sectionId = 12361, text = \"The hideout is on the eastern face of Mount Selesa. (TO BE WRITTEN)\", type = \"MenuLine\"}"
	myTargetLevelInfo 9C4B6A046012E6B0000001B224713F01
	myStateGameValue < uid=2AE2EC85679B7B13001644FB184C9C43 >
	{
