Item lwitem_loot_goblin_tie_reaper < uid=2AE2EC8565B0DCC6002AF2518B70047C > : valuable_template
{
	myName "aurabesh = false, branch = \"MAIN\", contextComment = 'Name of the item the player gains from destroying a lone Tie Reaper outside of Empire controled space. Narratively the ship was spying for information and the data is highly sensitive and important to the empire. It could something along the lines of \"Special Forces survey Data\". The event can be played multiple time so the player can get this item multiple times.', enabled = true, guid = #2AE2EC8565B0E64D002AF88E51D6F6ED, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 10475, text = \"Imperial Operations Data\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = 'Description of the item the player gains from destroying a lone Tie Reaper outside of Empire controled space. Narratively the ship was spying for information and the data is highly sensitive and important to the empire. It could something along the lines of \"Special Forces survey Data\". The event can be played multiple time so the player can get this item multiple times.', enabled = true, guid = #2AE2EC8565B0E650002AF88FC53F5B31, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 10475, text = \"A datacard containing sensitive surveillance and communications logs.\", type = \"MenuLine\""
	myGameplayDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"This item's only purpose is to be sold to vendors.\", enabled = true, guid = #2AE2EC8565B0E667002AF89262B8AED5, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 10378, text = \"This item has no use but can be sold to a merchant for credits.\", type = \"MenuLine\"}"
	myIcon "mySpriteId = 794161984, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_quest_items_icons_04.spritesheet\""
	myTier SmallPlus
	myBuyPrice 1000
}

