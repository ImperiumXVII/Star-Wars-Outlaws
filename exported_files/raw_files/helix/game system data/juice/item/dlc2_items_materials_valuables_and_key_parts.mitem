	myWhereToFind "branch = \"DLC2\", contextComment = \"Description for where to find an upgrade material that allows the player to upgrade the ion shields of the Traiblazer and the new ion configuration for the Blaster. Used in item Mat_Blaster_And_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A40920003CFFDC76DF9FE, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 12361, text = \"Can be found in cargo crates in the <b>Khepi System.</b>\n\nUsed as plating on <b>Rokana Raider ships.</b>\", type = \"MenuLine\""
	myHint "branch = \"DLC2\", contextComment = \"Description for where to find an upgrade material that allows the player to upgrade the ion shields of the Traiblazer and the new ion configuration for the Blaster. Used in item Mat_Blaster_And_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A40960003CFFECEF93599, lineVersion = 6, maxLength = 0, productId = -1, sectionId = 12361, text = \"Can be found in cargo crates in the <b>Khepi System.</b>\n\nUsed as plating on <b>Rokana Raider ships.</b>\", type = \"MenuLine\""
	myIcon "mySpriteId = -739775052, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_materials_icons_05.spritesheet\""
