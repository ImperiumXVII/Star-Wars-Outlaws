CurrencyItem Mat_Ship_DLC2_01 < uid=2AE2EC85670CE2A3000000D59EC7ADFB > : mat_template
{
	myName "branch = \"DLC2\", contextComment = \"Name for an upgrade material that allows the player to upgrade their cargo hold for better contraband contracts. Used in item Mat_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A35CA0001D1317D273E1C, lineVersion = 15, maxLength = 0, productId = 6, sectionId = 12361, text = \"Cargo Signature Scrambler\", type = \"MenuLine\""
	myDescription "branch = \"DLC2\", contextComment = \"Lore description for an upgrade material that allows the player to upgrade their cargo hold for better contraband contracts. Used in item Mat_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A36810001D132B82A5CEA, lineVersion = 14, maxLength = 0, productId = 6, sectionId = 12361, text = \"This black market circuitry makes it harder for Imperial scanners to detect and read cargo signatures. Experienced smugglers never leave dock without it.\", type = \"MenuLine\""
	myGameplayDescription "branch = \"DLC2\", contextComment = \"Gameplay description for an upgrade material that allows the player to upgrade their cargo hold for better contraband contracts. Used in item Mat_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A37290001D133B82C34F8, lineVersion = 9, maxLength = 0, productId = -1, sectionId = 12361, text = \"Illegal circuitry used to <b>upgrade the Trailblazer's Cargo Hold.</b>\", type = \"MenuLine\"}"
	myWhereToFind "branch = \"DLC2\", contextComment = \"Description for where to find an upgrade material that allows the player to upgrade their cargo hold for better contraband contracts. Used in item Mat_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A37740001D13474EC520A, lineVersion = 8, maxLength = 0, productId = -1, sectionId = 12361, text = \"Awarded for <b>finishing Miyuki Contracts from the Miyuki Trade League.</b>\n\nCan be purchased from <b>Miyuki Traders.</b>\", type = \"MenuLine\""
	myHint "branch = \"DLC2\", contextComment = \"Description for where to find an upgrade material that allows the player to upgrade their cargo hold for better contraband contracts. Used in item Mat_Ship_DLC2_01.\", enabled = true, guid = #2AE2EC85672A37750001D135F0E4DA66, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 12361, text = \"Awarded for <b>finishing Miyuki Contracts from the Miyuki Trade League.</b>\n\nCan be purchased from <b>Miyuki Traders.</b>\", type = \"MenuLine\""
	myIcon "mySpriteId = 1976203175, mySpritesheet = F\"helix/ui/spritesheets/ui_spritesheet_materials_icons_05.spritesheet\""
	myCategory Material
	myBuyPrice 500
}

