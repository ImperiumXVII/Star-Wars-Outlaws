{
	myDescription "branch = \"TU1\", contextComment = \"Lore description for a bundle of Blaster materials given by the Hutts\", enabled = true, guid = #2AE2EC856672A2FB001AC904862C5C21, lineVersion = 18, maxLength = 0, productId = 149, sectionId = 10323, text = \"The Hutt Cartel are involved with gunrunners and arms dealers across the Outer Rim and have access to some of the most powerful hardware available.\", type = \"MenuLine\""
	myGameplayDescription "branch = \"TU1\", contextComment = \"Gameplay description for a bundle container upgrade materails for the player's Blaster.\", enabled = true, guid = #2AE2EC856672A2FF001AD3FD962B3982, lineVersion = 11, maxLength = 0, productId = 149, sectionId = 10323, text = \"A bundle containing materials to <b>upgrade the Blaster.</b>\", type = \"MenuLine\"}"
	myReward 2AE2EC856672A731001C8AE61B0DE173
}

RewardGivingItem ItemBundle_PykeRepGood < uid=2AE2EC856672A3B4001C803A539B4338 > : ItemBundle_ShipParts_01
{
	myDescription "branch = \"TU1\", contextComment = \"Lore description for a bundle of ship materials given by the Pykes\", enabled = true, guid = #2AE2EC856672A33A001B6EA2151F3FDE, lineVersion = 16, maxLength = 0, productId = 149, sectionId = 10323, text = \"The Pyke Syndicate relies on skilled pilots with ships that can smuggle goods through the most challenging systems. They have access to some of the best ship parts on the market.\", type = \"MenuLine\""
	myGameplayDescription "branch = \"TU1\", contextComment = \"Gameplay description for a bundle container upgrade materails for the player's Ship.\", enabled = true, guid = #2AE2EC856672ACDC001F2A2F203DC34E, lineVersion = 6, maxLength = 0, productId = 149, sectionId = 10323, text = \"A bundle containing materials to <b>upgrade the Trailblazer.</b>\", type = \"MenuLine\"}"
