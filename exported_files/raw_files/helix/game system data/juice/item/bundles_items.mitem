RewardGivingItem ItemBundle_AshigaRepGood < uid=2AE2EC856672A3B4001C803794973180 > : ItemBundle_BlasterParts_01
{
	myDescription "branch = \"TU1\", contextComment = \"Lore description for a bundle of Blaster materials given by the Ashiga\", enabled = true, guid = #2AE2EC856672A02D0017AF27B1A747BC, lineVersion = 14, maxLength = 0, productId = 149, sectionId = 10323, text = \"The Ashiga Clan have a long history of making fine blasters, using high quality components that are difficult to find. They take pride in sharing equipment wth their best partners.\", type = \"MenuLine\""
	myGameplayDescription "branch = \"TU1\", contextComment = \"Gameplay description for a bundle container upgrade materails for the player's Blaster.\", enabled = true, guid = #2AE2EC856672AC10001E2CF508B0DAF6, lineVersion = 11, maxLength = 0, productId = 149, sectionId = 10323, text = \"A bundle containing materials to <b>upgrade the Blaster.</b>\", type = \"MenuLine\""
	myReward 2AE2EC856672A731001C8AD83E3FA2BF
}

RewardGivingItem ItemBundle_CrimsonDawnRepGood < uid=2AE2EC856672A3B4001C803870BEBA67 > : ItemBundle_SpeederParts_01
{
	myDescription "branch = \"TU1\", contextComment = \"Lore description for a bundle of speeder materials given by the Crimson Dawn\", enabled = true, guid = #2AE2EC856672A2DB001A73F92A074204, lineVersion = 13, maxLength = 0, productId = 149, sectionId = 10323, text = \"Crimson Dawn has agents across the galaxy who need to be prepared to drop everything in a moment and make a hasty escape. They understand the value of a fast and reliable speeder.\", type = \"MenuLine\""
	myGameplayDescription "branch = \"TU1\", contextComment = \"Gameplay description for a bundle container upgrade materials for the player's speeder.\", enabled = true, guid = #2AE2EC856672A2D6001A660CCEDFFC89, lineVersion = 11, maxLength = 0, productId = 149, sectionId = 10323, text = \"A bundle containing materials to <b>upgrade the Speeder.</b>\", type = \"MenuLine\"}"
	myReward 2AE2EC856672A731001C8AE26C9CD00E
}

