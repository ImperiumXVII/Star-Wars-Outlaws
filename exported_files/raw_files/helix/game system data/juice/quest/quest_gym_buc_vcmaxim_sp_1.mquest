	myName "aurabesh = false, contextComment = \"TEST. DO NOT TRANSLATE.\", enabled = true, guid = #82BA8ED36294D06A0000DD9FDD240699, lineVersion = 4, maxLength = 0, productId = 6, sectionId = 653, text = \"Retrieve the evidence against your client\", type = \"MenuLine\""
	myDescription "aurabesh = false, contextComment = \"TEST. DO NOT TRANSLATE.\", enabled = true, guid = #82BA8ED36294D06A0000DDA0CEC1FC3F, lineVersion = 4, maxLength = 0, productId = 6, sectionId = 653, text = \"Kay receives a contract from [Z] on planet [Y], town [X] to infiltrate in [Z]'s old house, get access to his hangar and to ‘liberate’ all the evidence of his involvement with the Rebels that are soon to be found by the Empire forces, because, now the entire area is under the Empire's control, which already were tipped about the Rebels involvement and are conducting a full-scale investigation over the town and took over our client's neighborhood, while his hangar becoming the Empire's Command Center. \nThe client also offered to help with a distraction, by faking the attack over the town's power plant on our signal and helping Kay with the evacuation.\", type = \"MenuLine\""
