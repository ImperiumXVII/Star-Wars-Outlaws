Quest A_MQ_100_DisruptTheHive < uid=BFA41A0261B36D3600000442ABE68872 >
{
	myName "aurabesh = false, branch = \"\", contextComment = \"mission title\", enabled = true, guid = #BFA41A0261C1F52E00014FBE2B4AC113, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 9122, text = \"The Hive\", type = \"MenuLine\""
	myIntroDescription "aurabesh = false, branch = \"\", contextComment = \"quest intro description mq100\", enabled = true, guid = #5E5892256539145A001F4F3FD3BE3F07, lineVersion = 3, maxLength = 0, productId = -1, sectionId = 9122, text = \"Ank has made her way with the explosives to Qi'ra, setting the stage for the Ashiga Clan mutiny. Qi'ra and Ank are waiting for Kay inside a tunnel in order to support Krisk in the seizing of the throne.\", type = \"MenuLine\""
	myDescription "aurabesh = false, branch = \"\", contextComment = \"quest  description mq100\", enabled = true, guid = #5E58922565391461001F4F406174DDB7, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 9122, text = \"Krisk and Qi'ra need Kay to infiltrate the Ashiga Clan stronghold from the tunnels and shut down the turrets in the courtyard. This will allow Krisk and the other Ashiga mutineers to take over the Hive.\", type = \"MenuLine\"}"
	myImage helix/baked/ui/loose_images/quest_bilboard/journal_billboard_mq_100.dds
