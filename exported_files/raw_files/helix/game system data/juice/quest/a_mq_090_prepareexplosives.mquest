	myIntroDescription "aurabesh = false, branch = \"\", contextComment = \"A_MQ_090 Quest description\", enabled = true, guid = #842ECCE4650BD44B000171481753B128, lineVersion = 7, maxLength = 0, productId = -1, sectionId = 9118, text = \"Kay has made a deal with Queen Ashiga to release Ank from the weapons factory, but the Queen's daughter Krisk, the heir to the Ashiga Clan throne, has contacted Kay to discuss an alternative.\", type = \"MenuLine\"}"
	myDescription "aurabesh = false, branch = \"MAIN\", contextComment = \"A_MQ_090 Quest description\", enabled = true, guid = #842ECCE465F4144100053C8B80E3B0B7, lineVersion = 5, maxLength = 0, productId = -1, sectionId = 9118, text = \"Krisk is colluding with Qi'ra from Crimson Dawn to take down the Queen and lay claim of the Ashiga Clan throne. They have given Kay access to Ank in the Ashiga Clan weapons factory in exchange for her help with the coup.\", type = \"MenuLine\"}"
	myImage helix/baked/ui/loose_images/quest_bilboard/journal_billboard_mq_090.dds
