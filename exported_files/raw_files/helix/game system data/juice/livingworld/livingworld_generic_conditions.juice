GameConditionPlayerHasWantedLevel "Player is not wanted"
{
	myOperator LessThanOrEqual
}

GameConditionPlayerHasWantedLevel "Player is wanted"
{
	myOperator GreaterThan
}

GameConditionPlayerHasWantedLevel "Player is wanted 1 or more"
{
	myWantedLevel 1
	myOperator GreaterThanOrEqual
}

GameConditionPlayerHasWantedLevel "Player is wanted 2 or more"
{
	myWantedLevel 2
	myOperator GreaterThanOrEqual
}

GameConditionPlayerHasWantedLevel "Player is Wanted 2 or less"
