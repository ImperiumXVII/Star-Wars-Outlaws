}

LivingWorldGameConditionGroup "Distance to Player is between Near and Extremely Near"
{
	myConditions
	{
		GameConditionContextLivingWorldContentLocation_DistanceToPlayer distance
		{
			myDistance = ContentLocationDistanceNear
			myOperator LessThanOrEqual
		}
		GameConditionContextLivingWorldContentLocation_DistanceToPlayer Distance
		{
			myDistance 50.0
		}
	}
}

