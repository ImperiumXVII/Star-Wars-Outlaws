}

GameConditionGroup "Player is Wanted 4 or 5"
{
	myOperator Or
	myConditions
	{
		GameConditionPlayerHasWantedLevel "Player is Wanted 4"
		{
			myWantedLevel 4
			myOperator Equal
		}
		GameConditionPlayerHasWantedLevel "Player is Wanted 5"
		{
			myWantedLevel 5
			myOperator Equal
		}
	}
}

