include snowdrop/modules/tool/keyword/nodeeditorautokeywords.fruit

Category Origin
{
	myToolTip "Shows the source branch in which the resource was created"
	myKeywords
	{
		KeywordNodeEditorAuto Integ4_helix
		{
		}
		KeywordNodeEditorAuto Integ4_helix
		{
		}
	}
}

Category Common
{
	myCategories
	{
		Category Helpers
		{
			myToolTip "These will be automatically marked depending on the content of the node graph."
			myKeywords
			{
				KeywordNodeEditorAuto Branding
				{
				}
				KeywordNodeEditorAuto Climbable
				{
					myToolTip "Graph has JumpHint node enabled and Climb option selected."
					myNodes
					{
						Node AI/JumpHint
						{
							myPinConditions
							{
							}
							myStateConditions
							{
								StateConditionInteger TypeMask
								{
									myComparisonType MaskComparison
									myValue 4
								}
							}
						}
					}
				}
				KeywordNodeEditorAuto CoverSystem
				{
					myToolTip "Graph has cover rail."
					myNodes
					{
						Node Prefab/Rail
						{
							myPinConditions
							{
							}
						}
						Node "Prefab/Cover Hint"
						{
						}
					}
				}
				KeywordNodeEditorAuto CoverVaultSupported
				{
					myToolTip "Graph has JumpHint node enabled and Vault option selected."
					myNodes
					{
						Node AI/JumpHint
						{
							myPinConditions
							{
							}
							myStateConditions
							{
								StateConditionInteger TypeMask
								{
									myComparisonType MaskComparison
									myValue 128
								}
							}
						}
					}
				}
				KeywordNodeEditorAuto Dynamic
				{
					myToolTip "Graph has dynamic collision node."
					myNodes
					{
						Node Prefab/CollisionDynamic
						{
						}
					}
				}
				KeywordNodeEditorAuto Destroyable
				{
					myToolTip "Graph has Fragmentable node."
					myNodes
					{
						Node Prefab/Fragmentable
						{
						}
					}
				}
				KeywordNodeEditorAuto Echo
				{
				}
				KeywordNodeEditorAuto Expensive
				{
				}
				KeywordNodeEditorAuto ExpensiveVegetation
				{
				}
				KeywordNodeEditorAuto HasAudio
				{
					myToolTip "Graph has Audio Node."
				}
				KeywordNodeEditorAuto HasWindEffect
				{
					myToolTip "Graph has Get Wind Vector node."
					myNodes
					{
						Node "World/Get Wind Vector"
						{
						}
					}
				}
				KeywordNodeEditorAuto Interactable
				{
					myToolTip "Graph contains Interaction Point node or InteractionData prefab."
					myNodes
					{
						Node "Prefab/Interaction Point Simple"
						{
						}
						Node Prefab/InteractionData
						{
						}
					}
				}
				KeywordNodeEditorAuto IsSteps
				{
					myToolTip "Graph contains Old Stairs prefab or Hunter Stairs prefab."
					myKeywordFlags
					{
					}
					myNodes
					{
						Node Prefab/Stairs
						{
						}
						Node "Prefab/Hunter Stairs"
						{
						}
					}
				}
				KeywordNodeEditorAuto LightingAsset
				{
					myToolTip "Graph has a Light Prefab."
					myNodes
					{
						Node Prefab/Light
						{
						}
					}
				}
				KeywordNodeEditorAuto Loot
				{
				}
				KeywordNodeEditorAuto mCloth
				{
					myToolTip "Graph contains mCloth or Cloth prefab."
					myNodes
					{
						Node Prefab/Cloth
						{
						}
					}
				}
				KeywordNodeEditorAuto Skinned
				{
					myToolTip "Graph has Skinned Mesh."
					myNodes
					{
						Node "Prefab/Mesh Skinned"
						{
						}
					}
				}
				KeywordNodeEditorAuto "Small Destroyable"
				{
				}
				KeywordNodeEditorAuto Vegetation
				{
				}
				KeywordNodeEditorAuto "NPC Interactions"
				{
				}
				KeywordNodeEditorAuto BlankProps
				{
					myToolTip "Graph has all meshes visibility turned OFF."
				}
				KeywordNodeEditorAuto Vaultable
				{
					myToolTip "Graph has jump hint node."
					myNodes
					{
						Node AI/JumpHint
						{
							myPinConditions
							{
							}
						}
					}
				}
				KeywordNodeEditorAuto Particles
				{
					myToolTip "Graph contains ParticleSys."
					myNodes
					{
						Node Prefab/ParticleSys
						{
						}
					}
				}
				KeywordNodeEditorAuto Tweakable
				{
					myToolTip "Graph has Inputs."
					myCustomRoutine autokeyword.graph.hasinputs
				}
				KeywordNodeEditorAuto "Continuous Update"
				{
					myToolTip "Graph has active nodes."
					myCustomRoutine autokeyword.graph.hasdynamicnodes
				}
				KeywordNodeEditorAuto HasLastLOD
				{
					myToolTip "The graph has a mesh with enabled Last LOD pin."
					myNodes
					{
						Node Prefab/Mesh
						{
							myPinConditions
							{
								PinCondition "Last LOD"
								{
									myExpectedValue TRUE
								}
							}
						}
					}
				}
				KeywordNodeEditorAuto HasGeneratedLastLOD
				{
					myToolTip "The graph has an auto generated Last LOD."
					myCustomRoutine autokeyword.graph.hasgeneratedlastlod
				}
				KeywordNodeEditorAuto HasImpostor
				{
					myToolTip "The graph has an Impostor node."
					myNodes
					{
						Node Prefab/Impostor
						{
						}
					}
				}
				KeywordNodeEditorAuto ScatterAsset
				{
					myToolTip "Tagging of assets used in the Scattering tool"
					myNodes
					{
						Node "Prefab/Scatter Properties"
						{
						}
					}
				}
				KeywordNodeEditorAuto PlaceholderVFX
				{
					myToolTip "Graph contains Placeholder ParticleSys for faking Dynamics"
					myKeywordFlags
					{
					}
					myNodes
					{
						Node Prefab/ParticleSys
						{
							myPinConditions
							{
							}
							myStateConditions
							{
								StateConditionString label
								{
									myValue DEV_vfx_fake_dynamic
								}
							}
						}
					}
				}
				KeywordNodeEditorAuto AudioVolumeTrigger
				{
					myToolTip "Graph contains Audio Volume Trigger"
					myNodes
					{
						Node "Prefab/Audio/Audio Trigger Volume"
						{
							myStateConditions
							{
								StateConditionString label
								{
									myValue "Prefab/Audio/Audio Trigger Volume"
								}
							}
						}
						Node HC_PrefabNodeAudioTriggerVolume
						{
							myStateConditions
							{
								StateConditionString label
								{
									myValue "Audio Trigger Volume Constant Data"
								}
							}
						}
					}
				}
			}
		}
	}
}

