Category Contextual
{
	myToolTip "Anyone can add these keywords."
	myCategories
	{
	}
	myKeywords
	{
		Keyword Debug
		{
			myToolTip "Assets that are used for Debugging and not for the final game. Use of Debug Nodes is allowed in these assets"
			myColor 0x00cc6cff
		}
		Keyword Dev
		{
			myToolTip "Assets intended to be used during production, but we do not want to end up in the final game (reference, blockout, scale meters etc)."
			myColor 0xffff8c00
			myKeywordFlags
			{
				KeywordFlag TestingWarningDevAssets WarnOnCheckout
			}
		}
		Keyword DoNotUse
		{
			myToolTip "Assets marked with this keyword are invalid for Release!"
			myColor 0x00eb2828
			myKeywordFlags
			{
				KeywordFlag DoNotUseAsset InvalidForRelease
			}
		}
		Keyword "Not Realtime"
		{
			myToolTip "Not a real time asset, can't be used in a production map."
			myColor 0xfff2e555
		}
		Keyword "Tatooine Only"
		{
			myColor 0xfffeb12b
		}
		Keyword "Cantonica Only"
		{
		}
		Keyword "Kijimi Only"
		{
			myColor 0xff005b81
		}
		Keyword "Toshara Only"
		{
			myColor 0xff6e4c2a
		}
		Keyword "Space Only"
		{
		}
		Keyword "Akiva Only"
		{
		}
		Keyword FP
		{
		}
		Keyword "Template Only"
		{
			myToolTip "Keyword to tag assets that should only be placed in Templates and not solo in production maps"
			myColor 0xffc07a00
		}
		Keyword "Test Asset"
		{
			myToolTip "Asset used only for testing purposes, not planned to be used in released builds"
			myColor 0xff4797ff
			myKeywordFlags
			{
				KeywordFlag InvalidForRelease InvalidForRelease
			}
		}
		Keyword Voice
		{
			myToolTip "Asset is of use to Voice Design"
			myColor 0xff800091
		}
		Keyword Corpses
		{
			myToolTip Corpse
			myColor 0xff725b5b
		}
	}
}

