				Keyword UNDERGROUND
				{
				}
			}
		}
	}
	myKeywords
	{
		Keyword "Use Sector Streaming"
		{
			myToolTip "This setting is applied to prop assets to influence their default streaming.\n---\nIf enabled, at level bake the prop is removed from normal streaming buckets and baked into a streaming sector.\nSuch props are streamed using a separate sector-based streaming process. The same streaming as is used for scattering.\nSince the bake is part of the level bake, this setting only impacts the prop on runtime; not in the editor.\n * Static mesh optimization is enabled depending on the prop.\n * Only uniform scaling is supported.\n * The props no longer have UIDs, so they can't be referenced from e.g. scripts."
		}
	}
}

