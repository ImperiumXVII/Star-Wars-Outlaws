class Input
{
	bool RemoveSpawnedGraphObject < default = FALSE >
}

class Output
{
	bool IsOngoing < default = TRUE >
	bool IsFirstFrame < default = FALSE >
	bool HasImpacted < default = FALSE >
	bool HasExpired < default = FALSE >
	float ShapeRadius < default = 0.0 >
	float DistanceSinceLastFrame < default = 0.0 >
	float DistanceFromSource < default = 0.0 >
	int LaserColorIndex < default = 0 >
	vec3f Velocity < default=0.0;0.0;0.0 >
}
