class Input
{
	mat44 Muzzle_Position
	mat44 Secondary_Muzzle_Position
	mat44 Scope_Flare_Position
	mat44 Stock_Position
	int Weapon_Size
	int Weapon_Attachement_Size
	int Weapon_GripType
	int Weapon_ForeGripType
	string PartsId < default="" >
}

class Output
{
	mat44 HolsteredTransform
	vec3f WorldAimPos
	bool IsAiming
	bool IsReloading
	bool IsVisible
	bool FireImpulse
	int FireRateRPM
	int LaserColorIndex
	int WeaponModuleColorIndex
	bool IsUsedByPlayer
	bool IsPhysicsEnabled
	bool IsHolstered
	bool IsOverHeat
	float OverHeatPerc
	int OverHeatActiveCoolingResult // NotResolved(0), PerfectSuccess(1), Success(2), Failure(3)
	bool IsCharging
	float ChargeProgress
	bool IsUsingWeaponSkillOne
	bool IsUsingWeaponSkillTwo
	bool IsUsingWeaponSkillThree
	bool IsUsingWeaponSkillFour
}
