class Input
{
	string PartsId < default="" >
}

class Output
{
	int FireImpulse < default=0 >
	int LastHitFrame < default=0 >
	int CurrentLOD < default=0 >
	int CurrentReflexLOD < default=6 >
	float Health < default=0 >
	float MaxHealth < default=0 >
	float Speed < default=0 >
	float SpeedBoost < default=0 >
	float WindShieldTransparency < default=0 >
	bool CollisionEnabledInWorld < default=TRUE >
	bool IsSprinting < default=FALSE >
	bool IsCrouched < default=FALSE >
	bool IsAlive < default=TRUE >
	bool IsInAutoMove < default=FALSE >
	bool IsInFirstPersonMode < default=FALSE >
	bool IsInInvisibleTraversal < default=FALSE >
	bool IsTeleportedThisFrame < default=FALSE >
	float TeleportationThreshold < default=4 >
	string ReflexState < default="" >
	float Float1 < default=0 >
	float Float2 < default=0 >
	float Float3 < default=0 >
	float Float4 < default=0 >
	bool ColorOverride < default=FALSE >
	bool IsLevelTransitionCharacter < default=FALSE >
	bool IsUI < default=FALSE >
}
