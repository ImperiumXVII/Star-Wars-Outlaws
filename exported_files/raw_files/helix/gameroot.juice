include snowdrop/modules/core/gamedatabase/gameroot.fruit

GameRoot myGameRoot
{
	myGameName helix
	myPlatformDefinitionList
	{
	}
	myPrefabIODefinitionList
	{
		PrefabIODefinition particles
		{
			myDefinitionName Particles
			myIOFruit "helix/graph objects/particles/particlesio.fruit"
		}
	}
	myGamePrefabTypesList
	{
		GamePrefabType prop
		{
			myPrefabTypeName Prop
			myPrefabTypeFolder "graph objects/prop/"
			myPrefabIOFruit "helix/graph objects/prop/propio.fruit"
		}
		GamePrefabType microdetail
		{
			myPrefabTypeName MicroDetail
			myPrefabTypeFolder "graph objects/microdetail/"
		}
		GamePrefabType building
		{
			myPrefabTypeName Building
			myPrefabTypeFolder "graph objects/building/"
			myPrefabGraphTemplate "helix/graph objects/building/New_Building_Graph_Template.mgraphobject"
		}
		GamePrefabType walls
		{
			myPrefabTypeName Walls
			myPrefabTypeFolder "graph objects/walls/"
			myPrefabGraphTemplate "helix/graph objects/walls/New_Building_Graph_Template Walls.mgraphobject"
		}
		GamePrefabType interior
		{
			myPrefabTypeName Interior
			myPrefabTypeFolder "graph objects/interior/"
			myPrefabGraphTemplate "helix/graph objects/interior/New_Interior_Graph_Template.mgraphobject"
		}
		GamePrefabType interiorwalls
		{
			myPrefabTypeName InteriorWalls
			myPrefabTypeFolder "graph objects/interiorwalls/"
			myPrefabGraphTemplate "helix/graph objects/interiorwalls/New_Interior_Graph_Template_Walls.mgraphobject"
		}
		GamePrefabType projectile
		{
			myPrefabTypeName Projectile
			myPrefabTypeFolder "graph objects/projectile/"
			myPrefabIOFruit "helix/graph objects/projectile/projectileio.fruit"
		}
		GamePrefabType character
		{
			myPrefabTypeName Character
			myPrefabTypeFolder "graph objects/character/"
			myPrefabIOFruit "helix/graph objects/character/characterio.fruit"
		}
		GamePrefabType weapon
		{
			myPrefabTypeName Weapon
			myPrefabTypeFolder "graph objects/weapon/"
			myPrefabIOFruit "helix/graph objects/weapon/weaponio.fruit"
		}
		GamePrefabType equipment
		{
			myPrefabTypeName Equipment
			myPrefabTypeFolder "graph objects/equipment/"
			myPrefabIOFruit "helix/graph objects/equipment/equipmentio.fruit"
		}
		GamePrefabType gear
		{
			myPrefabTypeName Gear
			myPrefabTypeFolder "graph objects/gear/"
			myPrefabIOFruit "helix/graph objects/gear/geario.fruit"
		}
		GamePrefabType addon
		{
			myPrefabTypeName Addon
			myPrefabTypeFolder "graph objects/addon/"
		}
		GamePrefabType gameplayobject
		{
			myPrefabTypeName GameplayObject
			myPrefabTypeFolder "graph objects/gameplayobject/"
			myPrefabIOFruit "helix/graph objects/gameplayobject/gameplayobjectio.fruit"
		}
		GamePrefabType vehiclegear
		{
			myPrefabTypeName VehicleGear
			myPrefabTypeFolder "graph objects/vehiclegear/"
			myPrefabIOFruit "helix/graph objects/gear/geario.fruit"
		}
		GamePrefabType vehiclecharacter
		{
			myPrefabTypeName VehicleCharacter
			myPrefabTypeFolder "graph objects/vehiclecharacter/"
			myPrefabIOFruit "helix/graph objects/character/characterio.fruit"
		}
	}
	myGameConfigFiles
	{
		file myFontFamilies "helix/game system data/juice/ui/font/fontfamilies.juice"
		file myFontPresets "helix/game system data/juice/ui/font/fontpresets.juice"
		file myPresetColorSchemes "helix/game system data/juice/ui/presetcolorschemes.juice"
		file myUIButtonRepresentations "helix/game system data/juice/ui/buttonrepresentations.juice"
		file myCoverSystem "helix/game system data/juice/cover/coversystem.juice"
		file mySoundSettings "helix/game system data/juice/sound/soundsettings.juice"
		file myInputSettings "helix/game system data/juice/input/input.juice"
		file myGameActionsConfig "helix/game system data/juice/input/gameactionsconfig.juice"
		file myCollisionSoundPresets "helix/game system data/juice/sound/collisionsoundpresets.juice"
		file myCollisionSoundSettings "helix/game system data/juice/sound/collisionsoundsettings.juice"
		file myCollisionMaterials "helix/game system data/juice/collisionmaterials/collisionmaterials.juice"
		file myDeformableSurfaceSettings "helix/game system data/juice/deformablesurface/deformablesurfacesettings.juice"
		file myDeformableSurfaceVolumeSettings "helix/game system data/juice/deformablesurface/deformablesurfacevolumesettings.juice"
		file myInteractiveWaterSettings "helix/game system data/juice/water/interactivewatersettings.juice"
		file myJuiceAssetTypes "helix/game system data/juice/juiceassettypes.juice"
		file myLanguageInfos "helix/game system data/juice/languages/languages.juice"
		file mySKUInfo "helix/game system data/juice/languages/skus.juice"
		file myDestructionSettings "helix/game system data/juice/destruction/destructionsettings.juice"
		file myClothMaterials "helix/game system data/juice/clothmaterials/clothmaterials.juice"
		file myPhysicsSettings "helix/game system data/juice/physics/physicsSettings.juice"
		file myInputLocalization "helix/game system data/juice/input/inputlocalization.juice"
		file myAudioProperGationSettings "helix/game system data/juice/sound/propergation_settings.juice"
		file myAudioLevelBankLoaderSettings "helix/game system data/juice/sound/level_bank_loader_settings.juice"
		file myAudioLevelEventPlayerSettings "helix/game system data/juice/sound/level_event_player_settings.juice"
		file myAudioSlapbackSettings "helix/game system data/juice/sound/slapback_settings.juice"
		file myAudioBubbleSpaceSettings "helix/game system data/juice/sound/bubblespacesettings.juice"
		file myAudioDefaultListenerSettings "helix/game system data/juice/sound/defaultlistenersettings.juice"
		file myAudioWeatherPortalSettings "helix/game system data/juice/sound/weather_portal_emitters_settings.juice"
		file myAudioEventCategories helix/audio/audio_event_categories.juice
		file myAudioEffortsSettings helix/audio/effortssettings.juice
		file myAudioBillboardingSettings helix/audio/billboardsettings.juice
		file myAudioBillboardingCategories helix/audio/billboardingcategories.juice
		file myAudioBillboardingStates helix/audio/billboardingstates.juice
		file myAudioBillboardingRules helix/audio/billboardingrules.juice
		file myAudioBillboardingPresetBanks helix/audio/billboardingpresetbanks.juice
		file myAudioEmitterLabels helix/audio/emitterlabels.juice
		file myAudioEnvironmentSettings helix/audio/environmentmanager.juice
		file myAudioWindSimulationSettings helix/audio/audiowindsimulationsettings.juice
		file myAudioVOModerators helix/audio/vomoderators.juice
		file myAudioVOTypes helix/audio/votypes.juice
		file myAudioDopplerSettings helix/audio/dopplersettings.juice
		file myAudioZoneWaterSettings "helix/game system data/juice/sound/audiozonewatersettings.juice"
		file myAudioRainSettings "helix/game system data/juice/sound/audiorainsettings.juice"
		file myAIDialogueSettings "helix/game system data/juice/ai/aidialogue_settings.juice"
		file myAmbienceDefinitions helix/audio/ambiencedefinitions.juice
		file myAmbienceSamplingSettings helix/audio/ambiencesampling.juice
		file myMusicSyncedEventSettings helix/audio/musicsyncedeventsettings.juice
		file myRegionMappings "helix/game system data/juice/regionmapping/regionmapping.juice"
		file myNavMeshGenerationSettings "helix/game system data/juice/ai/pathfinding/navmesh_generation_settings.juice"
		file myUserEdgeGenerationSettings "helix/game system data/juice/ai/pathfinding/user_edge_generation_settings.juice"
		file myAgentNavigationMetrics "helix/game system data/juice/ai/pathfinding/agent_navigation_metrics.juice"
		file myContextPopupSettings "helix/game system data/juice/ui/contextpopups.juice"
		file myUIEvents "helix/game system data/juice/ui/uievents.juice"
		file myRumbleLibraries "helix/game system data/juice/rumble/rumble.juice"
		file myWaterVolumeSettings "helix/game system data/juice/water/watervolumesettings.juice"
		file myInteractiveWaterSettings "helix/game system data/juice/water/interactivewatersettings.juice"
		file myWaterSettings "helix/game system data/juice/water/watersettings.juice"
		file myTacticalPositionsSettings "helix/game system data/juice/ai/pathfinding/tactical_positions_generation_settings.juice"
		file myDebugCommandMenu snowdrop/modules/debug/commandmenu.juice
		file myAudioPropagationSettings helix/audio/audiopropagationsettings.juice
		file myWindSettings "helix/game system data/juice/wind/wind_settings.juice"
		file myAudioForestTrackerSettings helix/audio/audioforesttrackersettings.juice
		file myAudioPropDensitySettings helix/audio/propdensitysettings.juice
		file myAnimationSlotsConfig "helix/game system data/juice/animation/animationslotsconfig.juice"
		file mySpeechSettings helix/audio/speechsettings.juice
		file myTrophyGroups "helix/game system data/juice/achievement/trophygroups.juice"
	}
	
	myGameConfigFilesManualLoad
	{
		file myHighContrastConfig "helix/game system data/juice/accessibility/highcontrastcolorpreset.juice"
	}

	myBinkSubtitleFolder "helix/game system data/juice/binksubtitles/"
	myWebmSubtitleFolder "helix/game system data/juice/webmsubtitles/"
	myCharacterDatabaseFolder "helix/game system data/juice/dialogue character/databases/*"
	myLocalizationPackageFolder helix/localization/packages
	myLocalizationPatchFolder helix/localization/patches
	myLinesImporterLocation localization/lines_importer
}

