include snowdrop/modules/core/audio/speechsettings.fruit

mySpeechSettings Settings
{
	myWordReplacementList
	{
		WordReplacement Cantonica
		{
			myFromWord cantonica
			myToWord cantonika
			myIgnoreCase TRUE
		}
		WordReplacement Kijmi
		{
			myFromWord kijimi
			myToWord "kee-gee mee"
			myIgnoreCase TRUE
		}
		WordReplacement Tatooine
		{
			myFromWord tatooine
			myToWord tahtoo-een
			myIgnoreCase TRUE
		}
		WordReplacement Toshara
		{
			myFromWord toshara
			myToWord toe-shah-rah
			myIgnoreCase TRUE
		}
		WordReplacement Sabacc
		{
			myFromWord sabacc
			myToWord suh-bock
			myIgnoreCase TRUE
		}
		WordReplacement Resume
		{
			myFromWord resume
			myToWord ree-zum
			myIgnoreCase TRUE
		}
		WordReplacement Ubisoft
		{
			myFromWord ubisoft
			myToWord yoo-bee-soft
			myIgnoreCase TRUE
		}
		WordReplacement Coarseweave
		{
			myFromWord coarseweave
			myToWord "coarse weave"
			myIgnoreCase TRUE
		}
		WordReplacement Thieves'
		{
			myFromWord Thieves'
			myToWord Thieves
			myIgnoreCase TRUE
			myToWordAddSpaces FALSE
		}
		WordReplacement Jabba's
		{
			myFromWord Jabba's
			myToWord Jabbas
			myIgnoreCase TRUE
		}
		WordReplacement Slash
		{
			myFromWord /
			myToWord ,
			myIgnoreCase TRUE
			myToWordAddSpaces TRUE
		}
		WordReplacement Apostrophe
		{
			myFromWord '
			myToWord ""
			myIgnoreCase TRUE
			myToWordAddSpaces FALSE
		}
		WordReplacement Ampersand
		{
			myFromWord &
			myToWord and
			myIgnoreCase TRUE
			myToWordAddSpaces TRUE
		}
		WordReplacement Begamor
		{
			myFromWord Begamor
			myToWord "beh gah mor"
			myIgnoreCase TRUE
		}
	}
}

